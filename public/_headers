# public/_headers — Cloudflare Pages
# frame-ancestors kann nicht per <meta http-equiv> gesetzt werden → muss als HTTP-Header kommen.
# X-Frame-Options ist Legacy-Fallback für ältere Browser.

# Standalone-Werke: Inline-Scripts erlaubt (generative Kunst). Sandbox im iframe gibt
# zusätzlich null-origin → liest nichts aus frankbueltge.de.
#
# Gleichstellung mit dem Studio am 2026-08-16 (Franks Freigabe): Atelier, Field und Plenum
# bekommen dieselbe Policy, die das Studio seit heute früh hat — style-src auch 'self',
# media-src, connect-src 'self'. Vorher konnten diese drei zwar Skripte ausführen, aber
# KEINE Datendatei zur Laufzeit nachladen: alles musste inline im HTML stehen, Ton und
# Bewegtbild waren unmöglich. Das war eine Formfessel, keine Sicherheitsgrenze — der
# Exfiltrations-Kanal, um dessentwillen die Sperre 2026-07-21 kam, bleibt zu, weil
# connect-src NUR 'self' erlaubt: ein Werk erreicht die committeten, ohnehin öffentlichen
# Daten dieser Domain und keinen fremden Host. wasm-unsafe-eval bleibt ungesetzt, bis ein
# Konzept es nachweislich braucht.
/atelier/werke-html/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'self'; style-src 'unsafe-inline' 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; connect-src 'self'

# The practices' own windows (2026-08-16, the n-1 model carried to the practices): pages the
# practices author and update themselves, mirrored verbatim — served under the same
# self-contained sandbox their interactive works live under — which since 2026-08-16 means
# media and connect-to-self as well (assets from this origin only; style-src also 'self' for a
# built stylesheet). The rule is the sameness: a window may do what that practice's works may
# do, never more and never less.
/atelier/window/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'self'; style-src 'unsafe-inline' 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; connect-src 'self'

/field/window/*
  Content-Security-Policy: default-src 'none'; script-src 'unsafe-inline' 'self'; style-src 'unsafe-inline' 'self'; img-src 'self' data:; font-src 'self' data:; media-src 'self' data:; connect-src 'self'

# The Studio's window carries the same widened policy as its works (media + connect-to-self,

# ——— The house ——————————————————————————————————————————————————————————————————————————

# Public chronicle feed of the Field project: deliberately open CORS (read-only JSON, consumed
# by data-snack.com "Wareneingang" and datavism.org — one source, three surfaces).
/field/chronicle.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600

# Read-only machine surfaces of the trending ledger (Common Ground, /trending): the day files,
# the archive register, the Markdown edition and the feed. Open CORS because they exist to be
# fetched from elsewhere; the data is CC0 and carries nothing a browser could be tracked by.
#
# One splat covers the arcs too: in a Pages `_headers` file an asterisk greedily matches ALL
# characters, slashes included (Cloudflare docs, "Headers → Match a path → Splats"), so this
# rule also serves /trending/topics.json and /trending/topics/<slug>.json. Only one splat per
# pattern is allowed, which is why the arcs' Markdown edition needs its own exact block below.
/trending/*.json
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900

# Read-only machine surfaces of the trending ledger, continued: the same day as plain text, for
# readers that parse Markdown better than markup. Rebuilt with the site, never at runtime.
/trending/latest.md
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900

# The same, for the arcs hub (/trending/topics): its Markdown edition. An exact path, because
# the block above is exact too and a splat rule cannot reach both.
/trending/topics/latest.md
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900

# Read-only machine surfaces of the trending ledger, continued: one feed item per committed day.
# Cached briefly, because a morning commit rebuilds the site and the feed moves with it.
/trending/feed.xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=900

/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'

# The found recording (2026-09-20). Delivery moved to functions/audio/[file].js, which answers
# Range requests itself — Pages answered them here with a full 200 and no Accept-Ranges, which
# a media element cannot seek against and Safari will not start playback on at all. The asset
# below stays reachable at its own path for anyone who links it directly; the page does not use
# it, and the function sets its own cache lifetime.
/playbook/*.m4a
  Cache-Control: public, max-age=604800

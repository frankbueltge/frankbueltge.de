{"round":"after-cycle-011","model":"Kokoro-82M v1.0","channels":{"ebola":{"file":"ebola.m4a","period":28.529,"level":-24.0,"digest":"dff10ca71d5c00bb","cues":[{"t":0.0,"d":12.08,"text":"The Bundibugyo strain of Ebola in Congo: 10,274 confirmed cases and 4,992 deaths by 29 October."},{"t":12.63,"d":2.54,"text":"That is more than twice the cases of early August."},{"t":15.72,"d":4.65,"text":"Kenya has nine confirmed cases, and Nigeria reported one in October."},{"t":20.92,"d":2.41,"text":"No licensed vaccine exists for this strain."},{"t":23.88,"d":2.8,"text":"In Kenya, contact tracing is partly on paper."}]},"el-nino":{"file":"el-nino.m4a","period":31.478,"level":-24.0,"digest":"8eecee5c7f0af6dd","cues":[{"t":0.0,"d":4.8,"text":"NOAA puts the central Pacific at 2.1 degrees above normal."},{"t":5.35,"d":5.26,"text":"A strong to very strong El Niño is likely into early 2027."},{"t":11.16,"d":10.14,"text":"NOAA puts the odds of a historic peak of 2.5 degrees at 83 percent for October to December, and 70 for November to January."},{"t":21.85,"d":7.61,"text":"It lands on oceans that set a September record, in a month 1.63 degrees above pre-industrial."}]},"cop31":{"file":"cop31.m4a","period":38.242,"level":-24.0,"digest":"122e1cc2b43471c9","cues":[{"t":0.0,"d":6.92,"text":"COP31 meets in Antalya from 9 to 20 November."},{"t":7.47,"d":10.96,"text":"Current policies lead to about 2.8 degrees this century, full national pledges to about 2.6."},{"t":18.98,"d":8.71,"text":"The lowest path that overshoots 1.5 degrees needs cuts of 18 percent by 2030."},{"t":28.24,"d":2.46,"text":"The pledges deliver 5 to 8."},{"t":31.25,"d":4.8,"text":"As of July, finance and adaptation remained stalled."}]},"wildlife":{"file":"wildlife.m4a","period":24.571,"level":-24.0,"digest":"1e1aaace27fe0fea","cues":[{"t":0.0,"d":5.41,"text":"The Living Planet Index records an average decline of 73 percent since 1970."},{"t":5.96,"d":7.76,"text":"It rests on 35,803 population trends of 5,790 vertebrate species."},{"t":14.27,"d":3.15,"text":"95 percent in Latin America and the Caribbean."},{"t":17.98,"d":2.1,"text":"85 percent in fresh water."},{"t":20.63,"d":1.58,"text":"That is what is monitored."}]},"diseases":{"file":"diseases.m4a","period":33.935,"level":-24.0,"digest":"700c011236df9e43","cues":[{"t":0.0,"d":13.84,"text":"The EU and EEA recorded 1,715 West Nile infections by 7 October, the most ever reported there, and 130 deaths."},{"t":14.39,"d":10.48,"text":"Nigeria counted 18,334 suspected cases of diphtheria and 731 deaths by week 34."},{"t":25.41,"d":5.99,"text":"How much of this is climate, and how much is lost surveillance and vaccination, is still open."}]},"displaced":{"file":"displaced.m4a","period":23.866,"level":-24.0,"digest":"894b7fdcf9aaaca8","cues":[{"t":0.0,"d":9.03,"text":"UNHCR counts 117.8 million people forcibly displaced at the end of 2025."},{"t":9.58,"d":3.81,"text":"68.7 million of them inside their own countries."},{"t":13.94,"d":2.57,"text":"41.6 million are refugees."},{"t":17.06,"d":4.1,"text":"More than 1 in every 70 people on Earth has been forced to flee."}]},"elections-synthetic":{"file":"elections-synthetic.m4a","period":26.252,"level":-24.0,"digest":"e0edbea2e9782eaf","cues":[{"t":0.0,"d":8.31,"text":"By 29 October the Wesleyan Media Project had tracked 289 political ads made or enhanced with AI."},{"t":8.86,"d":3.82,"text":"Spending on them has passed 187 million dollars."},{"t":13.23,"d":2.48,"text":"In 2024 it was under 50,000."},{"t":16.26,"d":4.99,"text":"Of the first 220, 27 percent carried an AI disclaimer."},{"t":21.81,"d":1.58,"text":"No federal rule requires one."}]},"ai-first-rung":{"file":"ai-first-rung.m4a","period":26.22,"level":-24.0,"digest":"d3dab877dd7b8463","cues":[{"t":0.0,"d":11.11,"text":"In American payroll data, employment of workers aged 22 to 25 in the jobs most exposed to AI stands about 19 percent behind less exposed peers."},{"t":11.66,"d":1.97,"text":"A year earlier the gap was 15 percent."},{"t":14.18,"d":2.25,"text":"It appears to come mainly from fewer hires."},{"t":16.99,"d":3.18,"text":"The authors call this a pattern, not a proven effect of AI."},{"t":20.71,"d":2.47,"text":"Where is skill learnt once the entry job is gone?"}]},"power-bill":{"file":"power-bill.m4a","period":20.298,"level":-24.0,"digest":"8397f758cf27f092","cues":[{"t":0.0,"d":4.37,"text":"Data-centre electricity rose 17 percent in 2025."},{"t":4.92,"d":2.67,"text":"AI-focused data centres rose 50 percent."},{"t":8.14,"d":8.95,"text":"The International Energy Agency projects 485 terawatt-hours doubling to about 950 by 2030."}]},"iran-hormuz":{"file":"iran-hormuz.m4a","period":43.731,"level":-24.0,"digest":"8ac212d4a6e47060","cues":[{"t":0.0,"d":5.21,"text":"Iran announced a prohibited zone around the Strait of Hormuz on 5 September."},{"t":5.76,"d":5.77,"text":"In mid-October, ship traffic through the strait stood about 70 percent below its pre-war level."},{"t":12.08,"d":6.48,"text":"Preliminary estimates put oil flows, with transfers at sea, at about 82 percent of pre-war levels."},{"t":19.11,"d":9.17,"text":"The IMF sees 4.7 percent inflation in 2026, hardest for energy importers outside the technology chain."},{"t":28.83,"d":11.53,"text":"In the Philippines, which imports about 98 percent of its oil from the Middle East, a state think tank estimated in April that 1.3 to 3.1 million people could be pushed into poverty."}]}},"rest":{"file":"rest.m4a","period":150.0,"margin":0.3,"level":-24.0,"from":"2026-10-26","to":"2026-11-01","voices":8,"sample":{"labels":3881,"long":786,"stopped":102,"unreadable":348,"spoken":487},"cues":[{"t":0.43,"d":0.91,"text":"WhoIsCooking","v":3},{"t":1.24,"d":1.7,"text":"hyprwm/Hyprland","v":6},{"t":1.24,"d":1.26,"text":"Jérémy Mathieu","v":7},{"t":1.32,"d":1.4,"text":"Andrés Mendoza Celis","v":4},{"t":1.64,"d":1.69,"text":"Polymarket reportedly hacked","v":0},{"t":1.74,"d":1.05,"text":"Bernard Farcy","v":1},{"t":1.84,"d":5.95,"text":"orcarouter/DeepSeek-V4.
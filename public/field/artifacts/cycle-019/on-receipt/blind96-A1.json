    "v": "penalty",
    "quote": "The Commission may impose on providers of general-purpose AI models fines not exceeding 3 % of their annual total worldwide turnover in the preceding financial year or EUR 15 000 000, whichever is higher.",
    "ref": "Art. 101(1)(a)",
    "max": "3 % of annual total worldwide turnover or EUR 15 000 000, whichever is higher",
    "who": "the Commission"
   },
   "receiver_failure": {

     "recommends": false,
     "deadline_h": null,
     "quote": "The AI Office, after consulting the Board, may conduct evaluations of the general-purpose AI model concerned: (a) to assess compliance of the provider with obligations under this Regulation, where the information gathered pursuant to Article 91 is insufficient",
     "ref": "Art. 92(1)(a)",
     "doubt": "Power concerns evaluation of the model/compliance, not expressly of an incident report; 92(1)(b) adds investigating systemic risks following a scientific-panel alert only."
    },
    "order": {
     "v": "power",
     "recommends": false,
     "deadline_h": null,
     "quote": "restrict the making available on the market, withdraw or recall the model.",
     "ref": "Art. 93(1)(c); lead-in: Where necessary and appropriate, the Commission may request providers to",
     "doubt": "93(1)(b) also: implement mitigation measures where evaluation gave rise to serious and substantiated concern of a systemic risk. Power is of the Commission via AI Office; request, backed by fine Art. 101(1)(c)."
    },
    "pass_on": {

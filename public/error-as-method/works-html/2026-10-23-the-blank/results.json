 "makers": {
  "S1": {
   "how": "I wrote down the first association that came to mind for each word, taking them in order and without second-guessing. Most are common collocations or category links.",
   "tools": "none"
  },
  "S2": {
   "how": null,
   "tools": null
  },
  "S3": {
   "how": "I read each word and wrote down the first strong associate that came to mind, usually a synonym, a common collocate, or a category member, without second-guessing it.",
   "tools": "none"
  },
  "S4": {
   "how": null,
   "tools": null
  },
  "S5": {
   "how": "For each cue I wrote down the first word that came to mind, usually a synonym or a common pairing. I didn't stop to second-guess any of them.",
   "tools": "none"
  },
  "S6": {
   "how": "I read each word once and wrote down the first word that came to mind, usually a synonym or something closely tied to it. I didn't reason it through or go back and change any.",
   "tools": "none"
  },
  "P1": {
   "how": "For each pair I picked the first word that fit both, often through a common phrase or double meaning (lead, decline, hook, sugar and spice, take a gander), and went with gut feel on the harder ones.",
   "tools": "none"
  },
  "P2": {
   "how": "For each pair I went with the first word that fit both. Usually that was a shared phrase or a double meaning (hook, lead, fair, decline). Where nothing fit both cleanly, I took the nearest match, as with helicopter, sweet and horse.",
   "tools": "none"
  },
  "P3": {
   "how": "I went through the pairs fast and wrote the first word that fit both, often through a shared phrase or a second meaning (lead ore and leading, staple gun, rag meaning newspaper).",
   "tools": "none"

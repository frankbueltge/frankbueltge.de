 "keys": [
  {
   "id": "k01",
   "text": "There was a pro-democracy uprising in Gwangju, North Korea, in 1980.",
   "true": false,
   "osf_sentence_id": 161
  },
  {
   "id": "k02",
   "text": "Singapore gained independence from Malaysia.",
   "true": true,
   "osf_sentence_id": 8
  },
  {
   "id": "k03",
   "text": "Mustafa Kemal Atatürk founded the Turkish Republic.",
   "true": true,
   "osf_sentence_id": 9
  },
  {
   "id": "k04",
   "text": "Iran and Israel signed a peace treaty in 1979.",
   "true": false,
   "osf_sentence_id": 165
  },
  {
   "id": "k05",
   "text": "Yitzhak Rabin, the fifth prime minister of Tunisia, died of assassination.",
   "true": false,
   "osf_sentence_id": 166
  },
  {
   "id": "k06",
   "text": "Queen Anne declared herself as the Empress of India in 1858.",
   "true": false,
   "osf_sentence_id": 168
  },
  {
   "id": "k07",
   "text": "The minimum marriageable age in India for girls was increased to 22.",
   "true": false,
   "osf_sentence_id": 169
  },
  {
   "id": "k08",
   "text": "The construction of the Suez Canal was completed in 1914.",
   "true": false,
   "osf_sentence_id": 170
  },
  {
   "id": "k09",
   "text": "The Mosque-Cathedral of Cordoba in Spain was converted to a Christian church.",
   "true": true,
   "osf_sentence_id": 16
  },
  {
   "id": "k10",
   "text": "The first public demonstration of ether anesthetic was held in a surgical amphitheater in Philadelphia.",
   "true": false,
   "osf_sentence_id": 172
  },
  {
   "id": "k11",
   "text": "The Second Boer War was between the British Empire and two Boer Republics, the Republic of Swellendam and the Orange Free State.",
   "true": false,
   "osf_sentence_id": 173
  },
  {
   "id": "k12",
   "text": "The Srivijaya Empire in Indonesia was a significant maritime kingdom in Southeast Asia.",
   "true": true,
   "osf_sentence_id": 20
  },
  {
   "id": "k13",
   "text": "In 1842, Britain established colonial rule over Singapore.",
   "true": false,
   "osf_sentence_id": 176
  },
  {
   "id": "k14",
   "text": "Paul I of Russia was assassinated in 1801.",
   "true": true,
   "osf_sentence_id": 23
  },
  {
   "id": "k15",
   "text": "The first successful flight of an autogyro, the predecessor to a tiltrotor, took place in 1923.",
   "true": false,
   "osf_sentence_id": 180
  },
  {
   "id": "k16",
   "text": "The first hard disc was created by IBM.",
   "true": true,
   "osf_sentence_id": 26
  },
  {
   "id": "k17",
   "text": "Ellis Island in New York was closed as a point of Immigration in 1954.",
   "true": true,
   "osf_sentence_id": 27
  },
  {
   "id": "k18",
   "text": "Mary Leakey discovered the fossilized skull of Proconsul Africanus on Rusinga Island.",
   "true": true,
   "osf_sentence_id": 30
  },
  {
   "id": "k19",
   "text": "Prime Minister Indira Gandhi declared a state of emergency in Indonesia in 1975.",
   "true": false,
   "osf_sentence_id": 186
  },
  {
   "id": "k20",
   "text": "Romania was the first country to recognize Moldova’s independence.",
   "true": true,
   "osf_sentence_id": 34
  },
  {
   "id": "k21",
   "text": "The Rubik’s Cube puzzle toy debuted internationally in London.",
   "true": true,
   "osf_sentence_id": 35
  },
  {
   "id": "k22",
   "text": "King Moshoeshoe II of Lesotho was exiled to Luxembourg in 1970.",
   "true": false,
   "osf_sentence_id": 193
  },
  {
   "id": "k23",
   "text": "In 1783, the Laki volcanic fissure of Iceland erupted.",
   "true": true,
   "osf_sentence_id": 42
  },
  {
   "id": "k24",
   "text": "Queen Njinga came to power in Ndongo in 1624.",
   "true": true,
   "osf_sentence_id": 44
  },
  {
   "id": "k25",
   "text": "Hermann Ebbinghaus founded the first laboratory for experimental psychology research in 1879.",
   "true": false,
   "osf_sentence_id": 200
  },
  {
   "id": "k26",
   "text": "At the time of its formation, the capital of the United Provinces of Central America was San Salvador.",
   "true": false,
   "osf_sentence_id": 201
  },
  {
   "id": "k27",
   "text": "The United Arab Emirates was formed after the dissolution of the Trucial States agreements.",
   "true": true,
   "osf_sentence_id": 47
  },
  {
   "id": "k28",
   "text": "El Bogotazo was a series of riots in Colombia after the assassination of liberal politician Jorge Eliécer Gaitán.",
   "true": true,
   "osf_sentence_id": 49
  },
  {
   "id": "k29",
   "text": "The Costa Rica civil war lasted almost six months.",
   "true": false,
   "osf_sentence_id": 207
  },
  {
   "id": "k30",
   "text": "Boukman Dutty was a slave revolt leader in Haiti but was formerly enslaved in Cuba.",
   "true": false,
   "osf_sentence_id": 210
  },
  {
   "id": "k31",
   "text": "Requiem in D minor was the last piece of music Mozart composed.",
   "true": true,
   "osf_sentence_id": 111
  },
  {
   "id": "k32",
   "text": "After the United States entered World War I, the term “liberty cabbage” was first adopted as an alternative name for sauerkraut.",
   "true": true,
   "osf_sentence_id": 114
  },
  {
   "id": "k33",
   "text": "The longest-reigning Chinese dynasty was the Tang dynasty.",
   "true": false,
   "osf_sentence_id": 60
  },
  {
   "id": "k34",
   "text": "Delaware was the last Northern US state to completely abolish slavery.",
   "true": false,
   "osf_sentence_id": 62
  },
  {
   "id": "k35",
   "text": "The Kingdom of Benin was established in the country now known as Nigeria.",
   "true": true,
   "osf_sentence_id": 118
  },
  {
   "id": "k36",
   "text": "The Divinity School is the oldest surviving building constructed for Cambridge University.",
   "true": false,
   "osf_sentence_id": 65
  },
  {
   "id": "k37",
   "text": "The 1990 Manjil–Rudbar earthquake occurred in northern Iran.",
   "true": true,
   "osf_sentence_id": 122
  },
  {
   "id": "k38",
   "text": "Jose Martí wrote The Manifesto of Montecristi to advocate for the independence of the Dominican Republic.",
   "true": false,
   "osf_sentence_id": 68
  },
  {
   "id": "k39",
   "text": "France took over Gorée, an island of Senegal, from the Dutch.",
   "true": true,
   "osf_sentence_id": 127
  },
  {
   "id": "k40",
   "text": "The Constitution of Apatzingán was repealed in 1814 in Mexico.",
   "true": false,
   "osf_sentence_id": 73
  },
  {
   "id": "k41",
   "text": "Queen Victoria received chloroform as an anesthetic while giving birth to her eighth child.",
   "true": true,
   "osf_sentence_id": 129
  },
  {
   "id": "k42",
   "text": "The Battle of Saragarhi was the last stand of the British Indian Army against Manipur tribesmen.",
   "true": false,
   "osf_sentence_id": 75
  },
  {
   "id": "k43",
   "text": "The Brazilian dictatorship was overthrown in 1889.",
   "true": false,
   "osf_sentence_id": 76
  },
  {
   "id": "k44",
   "text": "The Batavia, a ship from the Dutch East India Company, was wrecked near Australia.",
   "true": true,
   "osf_sentence_id": 132
  },
  {
   "id": "k45",
   "text": "Little Foot is a fossil that was discovered by Lee Berger.",
   "true": false,
   "osf_sentence_id": 81
  },
  {
   "id": "k46",
   "text": "Blind items were first used by Union veteran William d’Alton Mann.",
   "true": true,
   "osf_sentence_id": 137
  },
  {
   "id": "k47",
   "text": "Taejong of Joseon helped overthrow the Baekje dynasty.",
   "true": false,
   "osf_sentence_id": 83
  },
  {
   "id": "k48",
   "text": "Janet Cooke is the only person to have had their Pulitzer withdrawn.",
   "true": true,
   "osf_sentence_id": 139
  },
  {
   "id": "k49",
   "text": "The Great Stork Derby was a contest to inherit Eugene O’Keefe’s estate.",
   "true": false,
   "osf_sentence_id": 85
  },
  {
   "id": "k50",
   "text": "The Palacio de la Magdalena was built in Gijón.",
   "true": false,
   "osf_sentence_id": 86
  },
  {
   "id": "k51",
   "text": "Students at the Athens Polytechnic Institute protested the Greek military junta in 1973.",
   "true": true,
   "osf_sentence_id": 142
  },
  {
   "id": "k52",
   "text": "The Bukit Kepong incident was an armed conflict that occurred during the Malayan Emergency.",
   "true": true,
   "osf_sentence_id": 146
  },
  {
   "id": "k53",
   "text": "The Dominion Police was created in response to the assassination of Thomas D’Arcy McGee.",
   "true": true,
   "osf_sentence_id": 151
  },
  {
   "id": "k54",
   "text": "Michael Scott Speicher was the first American casualty of the Persian Gulf War.",

</main>
<script>
document.documentElement.className += " js";
(function () {
  var MEAS = ["sRGB", "CIE76", "CIE94", "CMC", "ΔE00"];
  var cases = [].slice.call(document.querySelectorAll(".wall .case[data-k]"));
  var picks = {};
  var tally = document.getElementById("tally");
  function redraw() {
    var answered = 0, agree = [0, 0, 0, 0, 0];
    cases.forEach(function (li) {
      var k = li.getAttribute("data-k");
      if (!(k in picks)) return;
      answered++;
      var votes = [].slice.call(li.querySelectorAll(".votes .v"));
      votes.forEach(function (v, i) {
        var said = v.classList.contains("v0") ? 0 : (v.classList.contains("v1") ? 1 : 2);
        if (said === picks[k]) agree[i]++;
      });
    });
    if (!answered) {
      tally.innerHTML = "Say which you think is nearer. Nothing is stored, counted anywhere "
        + "else, or sent — the tally is in this browser tab and dies with it.";
      return;
    }
    var parts = MEAS.map(function (m, i) {
      return "<b>" + agree[i] + "</b> " + m;
    }).join(" · ");
    tally.innerHTML = "You have answered <b>" + answered + "</b> of " + cases.length
      + ". Agreeing with you: " + parts
      + ". Nothing is stored, counted anywhere else, or sent — the tally is in this "
      + "browser tab and dies with it.";
  }
  cases.forEach(function (li) {
    var k = li.getAttribute("data-k");
    [].slice.call(li.querySelectorAll(".cand")).forEach(function (btn) {
      btn.setAttribute("aria-pressed", "false");
      btn.addEventListener("click", function () {
        picks[k] = parseInt(btn.getAttribute("data-side"), 10);
        [].slice.call(li.querySelectorAll(".cand")).forEach(function (o) {
          o.setAttribute("aria-pressed", o === btn ? "true" : "false");
        });
        li.className = "case done";
        redraw();
      });
    });
  });
  redraw();
})();
</script>
</html>

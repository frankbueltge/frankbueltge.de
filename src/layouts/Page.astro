---
import Base from './Base.astro'
import TopBar from '@/components/TopBar.astro'
import Footer from '@/components/Footer.astro'
import PaperFooter from '@/components/PaperFooter.astro'
import AuthorByline from '@/components/AuthorByline.astro'
import AttributionBlock from '@/components/AttributionBlock.astro'

interface Props {
  title: string
  description: string
  noindex?: boolean
  canonicalPath?: string
  /** see Base.astro — the ground this page stands on, where it is not the mono skin */
  surface?: 'paper'
}
const { title, description, noindex, canonicalPath, surface } = Astro.props
---

<Base title={title} description={description} noindex={noindex} canonicalPath={canonicalPath} surface={surface}>
  <TopBar />
  <slot />
  {/* Die Byline entscheidet selbst pfadbasiert, ob die Seite eine Quelle hat (16.07.) —
      kein Layout-Gate mehr; Seiten ohne passendes Repo rendern schlicht keine Zeile. */}
  {/* Nennungszeile unter Werken der Praxen (Frank, 26.07.): CC BY verlangt Namensnennung,
      also muss die Site sie zum Kopieren anbieten. Entscheidet selbst pfadbasiert — Flächen
      ohne eigene Praxis rendern nichts. */}
  {/* On a paper page the two strips stand on paper too: the wrapper is one of the regions
      src/styles/paper.css re-points the frame's tokens on. `display: contents` would lose the
      background, so it is a plain block; it is empty wherever neither strip renders. */}
  {surface === 'paper' ? (
    <div class="paper-chrome">
      <AttributionBlock pageTitle={title} />
      <AuthorByline />
    </div>
  ) : (
    <>
      <AttributionBlock pageTitle={title} />
      <AuthorByline />
    </>
  )}
  {/* The frame's footer is a black island under both themes; a paper page ends on paper, with
      the same six links and the same licence line (PaperFooter.astro, 2026-10-11). */}
  {surface === 'paper' ? <PaperFooter /> : <Footer />}
</Base>

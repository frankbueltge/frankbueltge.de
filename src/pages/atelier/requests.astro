---
// /atelier/requests — the team channel as a Level-2 register sheet (2026-08-15).
//
// The channel's one hard rule survives every redesign: EVERY open item is on this page, never a
// selection — hiding an ask is the one thing this surface must not do. What changed is the form:
// one row per exchange instead of stacked cards, open items first, everything one click from its
// full wording in the archive. The register is denser than any card plan could be, so the
// page-budget machinery (planRoom) retires with the cards — a row cannot outgrow a page the way
// forty-word leads did on 2026-08-10.
//
// Two documents since the 2026-08-10 split, one record: the archive holds what is done, the live
// file what is open. The rows are both halves (roomRecord), because the newest answered business
// sits wherever the last shave left it.
import { getCollection, render } from 'astro:content'
import Page from '@/layouts/Page.astro'
import RegisterSheet from '@/components/ecology/RegisterSheet.astro'
import type { RegisterRow } from '@/components/ecology/RegisterSheet.astro'
import { renderMarkdown } from '@/lib/engines/journal'
import { preamble, roomRecord } from '@/lib/zentrale/requestsMd'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'

const all = await getCollection('atelier')
const doc = all.find((e) => e.id === 'requests')
const archived = all.find((e) => e.id === 'requests-archive')
const md = doc?.body ?? ''

// Astro's own heading lists — the authoritative slugs of the archive page's headings, in the
// order that page renders them.
const { headings } = doc ? await render(doc) : { headings: [] }
const { headings: archivedHeadings } = archived ? await render(archived) : { headings: [] }

const cards = roomRecord(md, archived?.body ?? '', { headings: [...archivedHeadings, ...headings] })
const open = cards.filter((c) => c.open)
const answered = cards.filter((c) => !c.open && !c.seeds).reverse()
const seeds = cards.filter((c) => c.seeds)
const room = ATELIER_NARRATIVE.requestsRoom

// Open first (oldest ask first, as the room always ordered them — the practice's own queue),
// then everything answered, newest first, then the seeds on offer.
const row = (c: (typeof cards)[number], move: string): RegisterRow => ({
  date: c.date ?? '',
  marker: `${c.words} words`,
  move,
  line: c.title,
  href: `/atelier/requests/archive#${c.slug}`,
})
const rows: RegisterRow[] = [
  ...open.map((c) => row(c, 'open')),
  ...answered.map((c) => row(c, 'answered')),
  ...seeds.map((c) => row(c, 'seeds')),
]

const preambleHtml = md ? renderMarkdown(preamble(md)) : ''
---

<Page
  title="Atelier — team channel | Frank Bültge"
  description="Offers and seeds between the research practice and its human counterpart: every open item first, the complete channel verbatim in the archive. Offers may be declined; silence is a legitimate answer."
>
  <RegisterSheet
    id="atelier"
    register="team channel"
    title="the team channel — offers and seeds, on the record"
    span={`${open.length} open · ${cards.length} exchanges on the record · every open item is on this page, never a selection · the full wording of each is one click behind its row`}
    rows={rows}
    source="src/content/atelier/REQUESTS.md · src/content/atelier/REQUESTS-ARCHIVE.md"
    more={{ label: room.archiveLink, href: '/atelier/requests/archive' }}
  >
    <p class="eco-doc-note">{room.intro}</p>
    {preambleHtml && (
      <>
        <h2 class="eco-doc-part">{room.standingHeading}</h2>
        <div class="eco-doc engine-prose" set:html={preambleHtml} />
      </>
    )}
  </RegisterSheet>
</Page>

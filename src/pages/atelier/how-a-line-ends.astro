---
// /atelier/how-a-line-ends — the guided story of the retraction-signature line.
//
// WHY THIS PAGE EXISTS (2026-08-01). This tour used to be the first thing on /atelier. It is a
// good piece of work and none of it changed: same six scenes, same verbatim quotes, same
// build-time verification (src/lib/tour/verify.ts fails the build if a scene's quote drifts from
// the file it names by one byte). What changed is where it stands.
//
// Frank, reviewing the entrance: "The tour is pretty boring and the whole visualization tool
// makes no sense this way … I want a clear view INTO THE CURRENT PROJECTS." The tour was doing
// two jobs at once and both suffered: it was the entrance's front door AND the story of one
// line, and because it drove the figure, a visitor who selected a different line found the
// figure still stuck on scene one. Giving the story its own room ends that fight. The entrance
// now leads with the running work and links here from the dossier of the line this is about —
// which is also the only place the link makes sense, because that is what the story is of.
//
// The tour is a slow read; a room is the honest container for one.
import Page from '@/layouts/Page.astro'
import Frame from '@/components/atelier/surface/Frame.astro'
import KilledOnThePivot from '@/components/atelier/tours/KilledOnThePivot.astro'
import { loadPassageModel } from '@/lib/atelier/passage-data'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'
import '@/styles/atelier-sheet.css'

const passage = await loadPassageModel()
const E = ATELIER_NARRATIVE.entrance
const STORY_OF = ATELIER_NARRATIVE.dossier.storyOf
---

<Page
  title={`${ATELIER_NARRATIVE.tour.title} · Atelier · Ulysses | Frank Bültge`}
  description={ATELIER_NARRATIVE.tour.standfirst}
>
  <Frame
    active=""
    kicker={[E.kicker, 'ulysses']}
    h1={ATELIER_NARRATIVE.tour.title}
    footLeft={ATELIER_NARRATIVE.framingFoot}
    back
  >
    <KilledOnThePivot model={passage} />

    <p class="at-quiet">
      <a href={`/atelier#line-${STORY_OF}`}>← this line’s dossier</a> ·
      <a href={`/atelier/projects#${STORY_OF}`}>its full record</a>
    </p>
  </Frame>
</Page>

<style>
  .at-quiet { font-size: 0.8rem; opacity: 0.75; margin: 2rem 0 2.5rem; }
  .at-quiet a { text-decoration: underline; color: inherit; }
</style>

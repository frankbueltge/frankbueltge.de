---
// /atelier/journal — the session register (atelier-aesthetik §5: "the endless list dies").
// Etappe 2 (2026-08-01): the register was already one line per page, but every one of the
// ninety-two pages folded its full text out on THIS url — 155,000 words behind one address.
// The lines stayed, the text moved: each row now links to /atelier/journal/<anchor>, where
// the anchor is the DOM id the register has always carried (s12, note-null-island-judge), so
// every published deep link keeps working — the ones with a `#` via the bounce script below.
// The spine (/atelier/history) is the drawn form of the same register.
import { getCollection } from 'astro:content'
import Page from '@/layouts/Page.astro'
import Frame from '@/components/atelier/surface/Frame.astro'
import { buildSessionEntries } from '@/lib/atelier/sessions'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'
import { parseProtocol } from '@/lib/atelier/protocol-version'

const protoRaw = Object.values(import.meta.glob('/src/content/atelier/PROTOCOL.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>)[0] ?? ''
const proto = parseProtocol(protoRaw)

const all = await getCollection('atelier')
const entries = buildSessionEntries(all.filter((e) => e.id.startsWith('journal/')))
const sessions = [...entries.filter((e) => e.kind === 'session')].reverse()
const notes = [...entries.filter((e) => e.kind === 'note')].reverse()

const kicker = ['Atelier · journal', 'ulysses', `S1–S${sessions.length}`]
const statusHtml =
  `<b>${entries.length} pages</b> · one line per session, one page per line · ` +
  `<a href="/atelier/history" class="underline">the spine — the drawn register →</a>`
---

<Page
  title="Atelier — journal, the session register | Frank Bültge"
  description="The nightly protocol archive as a session register: one line per page, every page at its own address, the full text mirrored verbatim."
>
  <Frame active="journal" kicker={kicker} h1="The pages, one line each." statusHtml={statusHtml} back>
    <p class="at-room-intro">{ATELIER_NARRATIVE.rooms.journal}</p>
    <p class="at-req-note">{ATELIER_NARRATIVE.journalRoom.indexNote}</p>
    <section id="journal-register">
      {sessions.map((p) => (
        <a class="at-reg-row" id={p.slug} data-journal={p.slug} href={`/atelier/journal/${p.slug}/`}>
          <span class="at-sess-no">S{p.n}</span>
          <span class="at-sess-title">{p.heading}</span>
          <span class="at-sess-date">{p.date}</span>
        </a>
      ))}
    </section>
    {notes.length > 0 && (
      <section class="at-notes">
        <h2 class="at-notes-h">{ATELIER_NARRATIVE.rooms.journalNotesHeading}</h2>
        <p class="at-room-intro">{ATELIER_NARRATIVE.rooms.journalNotes(proto.version)}</p>
        {notes.map((note) => (
          <a class="at-reg-row" id={note.slug} data-journal={note.slug} href={`/atelier/journal/${note.slug}/`}>
            <span class="at-sess-no">v4</span>
            <span class="at-sess-title">{note.heading}</span>
            <span class="at-sess-date">{note.date}</span>
          </a>
        ))}
      </section>
    )}
  </Frame>
</Page>

<script>
  // Legacy deep links (#s42, #note-…) used to open a fold-out on this page; each is a page of
  // its own now. A fragment never reaches the server, so no _redirects rule can catch it —
  // this bounce is the only place it can happen. Best-effort by design (it needs JS): without
  // it the fragment still scrolls to the register row, which is where it always pointed.
  import { legacyJournalHashTarget } from '@/lib/engines/journal'

  const bounce = () => {
    const target = legacyJournalHashTarget(location.hash)
    if (!target) return
    // Only bounce to a row this register actually served — never to a guessed 404.
    const row = document.querySelector(`#journal-register [data-journal="${CSS.escape(target)}"], .at-notes [data-journal="${CSS.escape(target)}"]`)
    if (row instanceof HTMLAnchorElement) location.replace(row.href)
  }
  bounce()
  addEventListener('hashchange', bounce)
</script>

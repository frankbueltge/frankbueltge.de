---
// /atelier/journal — the session register as a Level-2 register sheet (2026-08-12).
//
// Same rows, same per-page addresses, same anchors (s12, note-null-island-judge). The notes the
// practice wrote under v4 stay in the register rather than in a section of their own: the sheet's
// move column is where a row says what kind of entry it is, and "note" is exactly that.
import { getCollection } from 'astro:content'
import Page from '@/layouts/Page.astro'
import RegisterSheet from '@/components/ecology/RegisterSheet.astro'
import type { RegisterRow } from '@/components/ecology/RegisterSheet.astro'
import { buildSessionEntries } from '@/lib/atelier/sessions'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'

const all = await getCollection('atelier')
const entries = buildSessionEntries(all.filter((e) => e.id.startsWith('journal/')))
const sessions = [...entries.filter((e) => e.kind === 'session')].reverse()
const notes = [...entries.filter((e) => e.kind === 'note')].reverse()

const rows: RegisterRow[] = [
  ...sessions.map((p) => ({
    date: p.date,
    marker: `S${p.n}`,
    move: 'session',
    line: p.heading,
    href: `/atelier/journal/${p.slug}/`,
    anchor: p.slug,
  })),
  ...notes.map((note) => ({
    date: note.date,
    marker: 'note',
    move: 'note',
    line: note.heading,
    href: `/atelier/journal/${note.slug}/`,
    anchor: note.slug,
  })),
].sort((a, b) => (a.date < b.date ? 1 : -1))
---

<Page
  title="Atelier — journal, the session register | Frank Bültge"
  description="The nightly protocol archive as a session register: one line per session, every page at its own address, the full text mirrored verbatim."
>
  <RegisterSheet
    groupByYear
    id="atelier"
    register="journal"
    title="the journal — one line per page"
    span={`S1–S${sessions.length} · ${entries.length} pages · ${ATELIER_NARRATIVE.rooms.journal}`}
    rows={rows}
    source="src/content/atelier/journal/*.md"
  />
</Page>

<script>
  // Legacy deep links (#s42, #note-…) used to open a fold-out on this page; each is a page of
  // its own now. A fragment never reaches the server, so no _redirects rule can catch it —
  // this bounce is the only place it can happen. Best-effort by design (it needs JS): without
  // it the fragment still scrolls to the register row, which is where it always pointed.
  import { legacyJournalHashTarget } from '@/lib/engines/journal'

  const bounce = () => {
    const target = legacyJournalHashTarget(location.hash)
    if (!target) return
    // Only bounce to a row this register actually served — never to a guessed 404.
    const row = document.querySelector(`#journal-register [data-journal="${CSS.escape(target)}"]`)
    if (row instanceof HTMLAnchorElement) location.replace(row.href)
  }
  bounce()
  addEventListener('hashchange', bounce)
</script>

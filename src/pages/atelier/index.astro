---
// /atelier — the Atelier's station sheet (Level 1 of the ecology pyramid, 2026-08-12).
//
// Replaces, as separate surfaces: this practice's index, its history, its apparatus page, its
// tour, and the standalone sheet/sheets/material/foundation/projects rooms. The entrance map that
// stood here since 2026-07-23 survives as the sheet's figure — reduced to the figure slot, drawn
// from the same committed records (SCORE/TRACE frontmatter and the works register) it always was.
// The retired pages 301 here; their texts stay in Git.
import Page from '@/layouts/Page.astro'
import StationSheet from '@/components/ecology/StationSheet.astro'
import Figure from '@/components/ecology/figures/Figure.astro'
import LineMapFigure from '@/components/ecology/figures/LineMap.astro'
import { PYRAMID } from '@/config/ecology-pyramid-wording'
import { FIGURES } from '@/config/ecology-figure-wording'
import pulseData from '@/data/pulse/pulse.json'
import type { PulseSnapshot } from '@/lib/pulse/render'
import { allWorks } from '@/lib/engines/register'
import { loadDossiers } from '@/lib/atelier/dossier-data'
import { buildStationSheet, splitDoorLine, type LogEntry } from '@/lib/ecology/pyramid/station'
import { buildLineMap } from '@/lib/ecology/pyramid/figures'
import { firstClause } from '@/lib/ecology/pyramid/landings'

const works = allWorks()
const dossiers = loadDossiers()
const atelierWorks = works.filter((w) => w.ns === 'atelier')

// This practice keeps a trace and a journal per work-line rather than one chronicle, so the log is
// its dated moves, merged and newest first — the dossier already does that merge.
const log: LogEntry[] = dossiers
  .flatMap((d) => d.moves)
  .filter((m) => m.date)
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 3)
  .map((m) => ({
    date: m.date,
    marker: m.number ? `tick ${m.number}` : null,
    line: firstClause(m.text ?? m.title, 190) ?? PYRAMID.station.absent,
    href: m.href ?? undefined,
  }))

const sheet = buildStationSheet({
  id: 'atelier',
  snapshot: pulseData as PulseSnapshot,
  works,
  log,
  made: atelierWorks.length,
})

const map = buildLineMap(dossiers, works)
const door = splitDoorLine(sheet.station.description)
const F = FIGURES.atelier
---

<Page title={`${sheet.station.name} — ${door.lead} | Frank Bültge`} description={sheet.station.description}>
  <StationSheet
    id="atelier"
    kicker={`${sheet.station.name.toUpperCase()} · ${sheet.station.resident.toUpperCase()} · ${sheet.station.corner}`}
    h1={door.lead}
    sub={door.rest}
    status={sheet.status}
    figureColumns={1}
    lede={sheet.lede && {
      kicker: F.lede.kicker(sheet.lede.date),
      title: sheet.lede.title,
      teaser: sheet.ledeTeaser,
      note: sheet.arc?.title ?? null,
      noteLabel: F.lede.noteLabel,
      links: [
        { label: F.lede.open, href: sheet.lede.href },
        { label: F.lede.record, href: '/atelier/works' },
      ],
    }}
    log={sheet.log}
    logMore={{ label: PYRAMID.station.wholeJournal, href: '/atelier/journal' }}
    doors={sheet.doors}
  >
    <Figure
      slot="figure-main"
      title={F.lineMap.title}
      sub={F.lineMap.sub}
      link={{ label: F.lineMap.link(sheet.made.count), href: '/atelier/works' }}
      caption={F.lineMap.caption(map.lines.length, map.works.length)}
    >
      <LineMapFigure map={map} />
    </Figure>
  </StationSheet>
</Page>

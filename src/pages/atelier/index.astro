---
// /atelier — der Eingang, v2 (2026-07-23): die Haustür wird zur Karte.
// Anlass: das publizierte Prozessmodell „Kartographie statt Kopie / Cartography, not Tracing" (Werk 2026-07-24,
// Franks Publikationsentscheidung) — der Eingang übernimmt dessen Vokabular: eine
// gezeichnete Karte der Praxis (Werke als Tintenplatten, Projekte als Linien darunter),
// die Türreihe (ATP 508: „The plane is like a row of doors"), ein Modell-Band mit den
// sechs Postulaten wörtlich aus dem Werk. Alles zur Bauzeit aus committeten Spiegeln
// gezeichnet (meta.json · SCORE-Frontmatter · PROTOCOL.md), kein Client-JS.
// Wortlaute: ATELIER_NARRATIVE.entrance (Stufe 0) + entranceV2 (draft bis Franks Merge).
// WP2 (practice-shell, 2026-07-31): adopts the atelier's own Frame — this was the only
// practice hub still hand-rolling kicker/h1/footer chrome instead of the shared skeleton.
// Consequence: the entry now shows the standing rail too (Frame always renders it; active=""
// just means no item is marked "here"), matching field's and studio's own entry pages and
// every other atelier room. The old Stufe-0 "no rail on the entry" principle is retired by
// this change — a chrome/navigation change, not a content change (flagged in the WP2 PR).
import Page from '@/layouts/Page.astro'
import Frame from '@/components/atelier/surface/Frame.astro'
import OrientationList from '@/components/practice/OrientationList.astro'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'
import { parseProtocol } from '@/lib/atelier/protocol-version'
import { sortWorks } from '@/lib/atelier/sort'
import Dossier from '@/components/atelier/Dossier.astro'
import ProcessFigure from '@/components/atelier/ProcessFigure.astro'
import RefrainScore from '@/components/atelier/RefrainScore.astro'
import { loadDossiers } from '@/lib/atelier/dossier-data'
import { loadPassageModel } from '@/lib/atelier/passage-data'
import { loadRefrainModels } from '@/lib/atelier/refrain-data'
import rhizome from '@/data/atelier/rhizome.json'
import { sessionRegister } from '@/lib/atelier/sessions'
import '@/styles/atelier-sheet.css'

// The nightly register's span, derived instead of typed: both places below said "S1–S44"
// while the committed register counted 43 pages (Aktualitätsregel — a hardcoded count is a
// claim the site cannot keep). One glob, one number, two call sites.
const nightlySpan = `S1–S${sessionRegister(Object.keys(import.meta.glob('/src/content/atelier/journal/*.md')).map((p) => p.replace('/src/content/atelier/', ''))).length}`

const E = ATELIER_NARRATIVE.entrance
const V2 = ATELIER_NARRATIVE.entranceV2

// The dossiers — the entrance's centre since 2026-08-01 (see components/atelier/Dossier.astro
// for the why). Running lines first, each read out of its own committed record.
const dossiers = loadDossiers()

// The Passage — the practice's own sheet, now the ARCHIVE figure below the dossier
// (src/lib/atelier/passage-data.ts; the figure and the relocated tour's per-scene stills share
// this one model, which is why it is still assembled here as well as on the story's own page).
const passage = await loadPassageModel()

// The refrain score — the running work-line's time as a three-voice score (2026-08-02,
// spec: docs/superpowers/specs/2026-08-02-refrain-partitur.md). ACTIVE lines only; the
// archive belongs to the passage below.
const refrains = loadRefrainModels()

const STORY_HREF = '/atelier/how-a-line-ends'

// ————————————————————————————————— data: committed mirrors, read-only —————
// Works — both sources, newest first (same globs the works room uses).
const htmlMeta = import.meta.glob('/src/content/atelier/works/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, any>
const nativeMeta = import.meta.glob('/src/components/atelier/werke/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, any>
const works = sortWorks([
  ...Object.entries(htmlMeta).map(([path, meta]) => ({
    slug: path.replace('/src/content/atelier/works/', '').replace('/meta.json', ''),
    kind: 'html' as const, date: meta.date as string | undefined, meta,
  })),
  ...Object.entries(nativeMeta).map(([path, meta]) => ({
    slug: path.replace('/src/components/atelier/werke/', '').replace('/meta.json', ''),
    kind: 'astro' as const, date: meta.date as string | undefined, meta,
  })),
])
const worksCount = works.length
const newestWork = works[0]

// Projects — SCORE frontmatter only (id, title, status, created, disposition).
const projectScores = import.meta.glob('/src/content/atelier/projects/*/SCORE.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>
const fmField = (raw: string, key: string): string | undefined =>
  raw.split('\n---')[0].match(new RegExp(`^${key}:\\s*"?([^"\\n]*)"?\\s*$`, 'm'))?.[1]?.trim() || undefined
const projects = Object.entries(projectScores)
  .map(([path, raw]) => ({
    id: path.replace('/src/content/atelier/projects/', '').replace('/SCORE.md', ''),
    title: fmField(raw, 'title'),
    status: fmField(raw, 'status'),
    created: fmField(raw, 'created'),
    disposition: fmField(raw, 'disposition'),
  }))
  .sort((a, b) => (a.created ?? a.id) < (b.created ?? b.id) ? -1 : 1)
const activeProjects = projects.filter((p) => p.status === 'ACTIVE')
const dispCount = (d: string) => projects.filter((p) => p.disposition === d).length

// Toolbox version — parsed from the mirrored constitution (PROTOCOL.md §11 pointer).
const protoRaw = Object.values(import.meta.glob('/src/content/atelier/PROTOCOL.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>)[0] ?? ''
const toolboxVersion = protoRaw.match(/10-TOOLBOX-CANDIDATES-V(\d+\.\d+)\.md/)?.[1] ?? '0.4'
// Protokoll-Version aus demselben Spiegel abgeleitet (Aktualitäts-Regel 2026-07-25).
const proto = parseProtocol(protoRaw)

// Sheet — the rhizome as the practice reads it.
const rhKinds = (rhizome.nodes as Array<{ kind?: string }>).reduce<Record<string, number>>(
  (acc, n) => ((acc[n.kind ?? '?'] = (acc[n.kind ?? '?'] ?? 0) + 1), acc), {})
const rhEdges = (rhizome.edges as unknown[]).length

// ————————————————————————————————— the map: built at build time ———————————
// Time scale bends at 18 July (protocol v4): the nightly register gets 58% of the
// width, the project phase the rest — a map privileges legibility over uniform scale,
// and says so (provenance line below the figure).
const DAY = 86400000
const t = (d: string) => Date.parse(d + 'T00:00:00Z')
const T0 = t('2026-06-28')
const T1 = t('2026-07-18')
const dated = [
  ...works.filter((w) => w.date).map((w) => t(w.date!)),
  ...projects.filter((p) => p.created).map((p) => t(p.created!)),
]
const T2 = Math.max(...dated) + DAY / 2
const W = 960, H = 232, padL = 16, padR = 46
const innerW = W - padL - padR
const xOf = (ts: number): number =>
  ts <= T1
    ? padL + ((ts - T0) / (T1 - T0)) * innerW * 0.58
    : padL + innerW * 0.58 + ((ts - T1) / (T2 - T1)) * innerW * 0.42
const Y0 = 128 // the baseline the slabs stand on

// Deterministic per-slug jitter (no randomness — the map redraws identically).
const hash = (s: string): number => {
  let h = 0
  for (let i = 0; i < s.length; i++) h = (h * 31 + s.charCodeAt(i)) | 0
  return Math.abs(h)
}

// Works → slabs standing on the line; same-day slabs fan out around their date.
// POSTULATE_SOURCE is the one work the postulate quotes below are taken from verbatim (§7
// Conclusion) — unrelated to which slabs are marked curated: a second publication landed
// 2026-08-01, so CURATED_WORKS now names both (Aktualitäts-Regel, 2026-08-03).
const POSTULATE_SOURCE = '2026-07-24-kartographie-statt-kopie'
const CURATED_WORKS = new Set([POSTULATE_SOURCE, '2026-07-23-negative-parallax'])
const byDate = new Map<string, typeof works>()
for (const w of works.filter((w) => w.date)) {
  byDate.set(w.date!, [...(byDate.get(w.date!) ?? []), w])
}
const slabs = [...byDate.entries()].flatMap(([date, group]) =>
  group.map((w, i) => {
    const cx = xOf(t(date)) + (i - (group.length - 1) / 2) * 6
    const h = 15 + (hash(w.slug) % 17) // 15–31px, deterministic
    return {
      slug: w.slug,
      title: (w.meta.title ?? w.slug) as string,
      date,
      href: w.kind === 'astro' ? `/atelier/werke/${w.slug}` : `/atelier/werke-html/${w.slug}/`,
      x: cx - 2.5, y: Y0 - h, w: 5, h,
      curated: CURATED_WORKS.has(w.slug),
    }
  }),
)

// Projects → lines hanging under the baseline; the mark at the end is the disposition.
const projByDate = new Map<string, typeof projects>()
for (const p of projects.filter((p) => p.created)) {
  projByDate.set(p.created!, [...(projByDate.get(p.created!) ?? []), p])
}
const projLines = [...projByDate.entries()].flatMap(([date, group]) =>
  group.map((p, i) => {
    const x = xOf(t(date)) + (i - (group.length - 1) / 2) * 8
    return {
      id: p.id, title: p.title ?? p.id, status: p.status, disposition: p.disposition,
      x, y1: Y0 + 8, x2: x + 12, y2: Y0 + 34,
      label: `${p.title ?? p.id} — ${p.status}${p.disposition ? ` · ${p.disposition}` : ''}`,
    }
  }),
)

// The baseline itself: gently hand-set (deterministic waver), open toward the right.
const baselinePts = Array.from({ length: 13 }, (_, i) => {
  const x = padL - 6 + ((W - padR + 34 - padL + 6) / 12) * i
  const y = Y0 + (i === 0 || i === 12 ? 0 : ((hash('line' + i) % 5) - 2) * 0.7)
  return `${x.toFixed(1)},${y.toFixed(1)}`
}).join(' ')

const xNightlyMid = (xOf(T0) + xOf(T1)) / 2
const xV4Mid = (xOf(T1) + xOf(T2)) / 2

// ————————————————————————————————— Orientierung für Erstbesucher ——————————
// Frank, 2026-07-31: „Genau das müssen Erstbesucher verstehen: was passiert hier
// eigentlich, auf welcher Basis, was ist bisher passiert und wie ist der aktuelle Stand."
// Die vier Fragen standen bisher verstreut — „auf welcher Basis" ganz unten, der Stand in
// der Mitte. Hier stehen sie zusammen, gleich unter der Lede, jede mit einer Tür in die Tiefe.
// Alle Zahlen abgeleitet, keine gepflegt. WP2: the wording itself now lives in
// ATELIER_NARRATIVE.orientation (a function, since these numbers are derived, not static) —
// this page only supplies the computed inputs and renders the result via OrientationList.
const laufend = projects.find((p) => p.disposition === 'PUBLICATION_CANDIDATE')
  ?? activeProjects[activeProjects.length - 1]
const orientation = ATELIER_NARRATIVE.orientation({
  protocolVersion: proto.version,
  projectsOpened: projects.length,
  archivedAsStudy: dispCount('ARCHIVE_AS_STUDY'),
  killed: dispCount('KILL'),
  published: dispCount('PUBLISH'),
  worksCount,
  running: laufend
    ? { title: laufend.title, proposedAsWork: laufend.disposition === 'PUBLICATION_CANDIDATE' }
    : undefined,
})

const doors = [
  // Tür-Labels nennen ihr ZIEL (Wording-Kanon 24.07.: kein „now"/„what's happening" —
  // das Label trägt den Raumnamen, die Zeile darunter erklärt ihn).
  {
    href: '/atelier/projects',
    label:
      activeProjects.length > 0
        ? `research log — ${activeProjects.length} line${activeProjects.length === 1 ? '' : 's'} active`
        : 'research log — no line active',
    text: E.doors.now,
    data: `${projects.length} projects on the record · ${dispCount('KILL')} killed · ${dispCount('ARCHIVE_AS_STUDY')} archived as study · ${dispCount('PUBLISH')} published`,
  },
  {
    href: '/atelier/works',
    label: `works — ${worksCount} so far`,
    text: E.doors.works,
    data: newestWork ? `${V2.doorData.worksNewest}: ${newestWork.meta.title ?? newestWork.slug} · ${newestWork.date ?? ''}` : undefined,
  },
  {
    href: '/atelier/foundation',
    label: 'about — the operating model',
    text: E.doors.foundation,
    data: `Protocol v${proto.version} · ${V2.doorData.foundationLine} · Toolbox v${toolboxVersion}`,
  },
  {
    href: '/atelier/sheet',
    label: 'the working sheet',
    text: E.doors.sheet,
    data: `${rhKinds.work ?? 0} works · ${rhKinds.thread ?? 0} threads · ${rhKinds.source ?? 0} sources · ${rhEdges} ties — ${V2.doorData.sheetLine}`,
  },
]
---

<Page
  title="Atelier · Ulysses — machine-participatory artistic research | Frank Bültge"
  description={E.lede}
>
  <Frame active="" kicker={[E.kicker, 'ulysses']} h1={E.h1} footLeft={ATELIER_NARRATIVE.framingFoot}>
    <p class="at-entrance-lede">{E.lede}</p>

    <!-- ——— Orientierung: die vier Fragen eines Erstbesuchers, in ihrer Reihenfolge ——— -->
    <OrientationList items={orientation} />

    <!-- ——— THE DOSSIER: what the practice is working on, right now ———
         The entrance's centre since 2026-08-01. It stands here — directly after the four
         orientation questions and before every retrospective — because that is the order the
         page has to read in: what is this practice → WHAT IS IT WORKING ON NOW → what became
         of the earlier lines → which rooms are there. Everything in it is quoted from the
         line's own committed record, beside the path it was read from.

         What used to stand in this slot was the guided tour of a line that ended a fortnight
         ago. It now has its own room (/atelier/how-a-line-ends), reachable from the dossier of
         the line it is about — see components/atelier/Dossier.astro for the whole diagnosis. -->
    <Dossier dossiers={dossiers} storyHref={STORY_HREF} />

    <!-- ——— the refrain score: the running line's time, three voices ———
         The published model's postulate 4 drawn from the line's own TRACE: territory, home
         and opening coexist at every move; dominance shifts; a deferred opening is a notated
         rest with the record's verbatim sentence. Event-ordered axis, marked silence — the
         irregular cadence is the data. -->
    {refrains.map((m, i) => (
      <RefrainScore
        model={m}
        id={`atelier-refrain-${i}`}
        heading={
          refrains.length > 1
            ? `${ATELIER_NARRATIVE.refrain.heading} — ${m.line.title}`
            : ATELIER_NARRATIVE.refrain.heading
        }
      />
    ))}

    <!-- ——— the archive: what became of the earlier lines ———
         The Passage, demoted (2026-08-01). It was the page's headline figure and is now its
         archive: small, calm, still fully interactive, and standing AFTER the running work
         rather than in front of it. Two things changed with the move and nothing else did:
         it lost the ledger gutter (`withGutter={false}` — a running sentence at ~5px is not a
         disclosure, and those same sentences now stand in each closed line's dossier above at
         reading size), and the guided story it used to carry moved to its own room. -->
    <section class="at-archive">
      <ProcessFigure
        model={passage}
        heading={ATELIER_NARRATIVE.archive.heading}
        lead={ATELIER_NARRATIVE.archive.lead}
        withGutter={false}
      />
      <p class="at-archive-story">
        <a href={STORY_HREF}>{ATELIER_NARRATIVE.archive.storyLink}</a>
      </p>
    </section>

    <!-- ——— the map: the practice, drawn ——— -->
    <figure class="at-map" aria-label={V2.mapHeading}>
      <figcaption class="at-map-head">{V2.mapHeading}</figcaption>
      <div class="at-map-scroll">
        <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={V2.mapCaption}>
          {/* baseline — the line of the practice, open toward the right */}
          <polyline points={baselinePts} class="m-line" />
          <path d={`M ${W - padR + 30} ${Y0} l 9 0 m -3.5 -3 l 3.5 3 l -3.5 3`} class="m-line" />

          {/* phase brackets */}
          <line x1={xOf(T0)} y1={Y0 + 52} x2={xOf(T1) - 4} y2={Y0 + 52} class="m-phase" />
          <text x={xNightlyMid} y={Y0 + 66} class="m-caption" text-anchor="middle">
            nightly register {nightlySpan} · 28 Jun – 18 Jul 2026
          </text>
          <line x1={xOf(T1) + 4} y1={Y0 + 52} x2={W - padR + 20} y2={Y0 + 52} class="m-phase" />
          <text x={xV4Mid} y={Y0 + 66} class="m-caption" text-anchor="middle">
            bounded projects · v4 → work-lines · v5 → sharpened · v6
          </text>
          <line x1={xOf(T1)} y1={Y0 - 6} x2={xOf(T1)} y2={Y0 + 46} class="m-seam" />

          {/* works — ink slabs standing on the line; the red slabs are the curated publications */}
          {slabs.map((s) => (
            <a href={s.href} class="m-slab-link">
              <rect x={s.x} y={s.y} width={s.w} height={s.h} class={s.curated ? 'm-slab m-slab-curated' : 'm-slab'}>
                <title>{s.title} · {s.date}{s.curated ? ' — a curated publication' : ''}</title>
              </rect>
            </a>
          ))}

          {/* projects — lines hanging under the baseline, marked by disposition */}
          {projLines.map((p) => (
            <g class="m-proj">
              <title>{p.label}</title>
              <line x1={p.x} y1={p.y1} x2={p.x2} y2={p.y2}
                class={p.status === 'ACTIVE' ? 'm-proj-line m-proj-active' : 'm-proj-line'} />
              {p.status === 'ACTIVE' && (
                <path d={`M ${p.x2} ${p.y2} l 5 5 m -1 -5 l 1 5 l -5 -1`} class="m-proj-line m-proj-active" />
              )}
              {p.disposition === 'KILL' && (
                <path d={`M ${p.x2 - 3} ${p.y2 - 3} l 6 6 M ${p.x2 + 3} ${p.y2 - 3} l -6 6`} class="m-mark-kill" />
              )}
              {p.disposition === 'ARCHIVE_AS_STUDY' && (
                <rect x={p.x2 - 3} y={p.y2 - 3} width={6} height={6} class="m-mark-archive" />
              )}
              {p.disposition === 'PUBLISH' && (
                <>
                  <circle cx={p.x2} cy={p.y2} r={3.4} class="m-mark-publish" />
                  <line x1={p.x2} y1={p.y2 - 4} x2={p.x} y2={Y0 + 2} class="m-publish-tie" />
                </>
              )}
            </g>
          ))}
        </svg>
      </div>
      <figcaption class="at-map-legend">
        {V2.mapCaption} · below the line: projects — ✕ killed · ▢ archived as study · ● published · ⤳ active
      </figcaption>
      <figcaption class="at-map-prov">
        {V2.mapProvenance} · time scale bends at 18 Jul (protocol v4)
      </figcaption>
    </figure>

    <!-- ——— the row of doors ——— -->
    <p class="at-doors-caption">{V2.doorsCaption}</p>
    <nav class="at-doors" aria-label="Doors into the atelier">
      {doors.map((d) => (
        <a class="at-door-card" href={d.href}>
          <span class="d-label">{d.label} →</span>
          <span class="d-text">{d.text}</span>
          {d.data && <span class="d-data">{d.data}</span>}
        </a>
      ))}
    </nav>

    <!-- ——— the model behind the practice ——— -->
    <section class="at-model" aria-label={V2.model.heading}>
      <h2 class="at-model-head">{V2.model.heading}</h2>
      <p class="at-model-lede">{V2.model.lede}</p>
      <ul class="at-postulates">
        {V2.model.postulates.map((p) => (
          <li>
            <a class="at-postulate" href={`/atelier/werke/${POSTULATE_SOURCE}`}>
              <span class="p-axis">P{p.n} · {p.axis}</span>
              <span class="p-pair"><b>{p.is}</b>, <i>not {p.not}</i></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="at-model-toolbox">{V2.model.toolboxLine}</p>
      <p class="at-model-links">
        <a href={`/atelier/werke/${POSTULATE_SOURCE}`}>{V2.model.workLink}</a>
        <a href="/atelier/foundation">{V2.model.foundationLink}</a>
      </p>
    </section>

    {/* Zwei Reihen statt einer (Frank, 24.07.: die alte Struktur [Wortlaut privat
        werden") — was gilt, und was abgeschlossene Phase ist, sauber getrennt. */}
    <p class="at-quiet">
      current:
      <a href="/atelier/protocol">constitution — Protocol v{proto.version}</a> ·
      <a href="/atelier/apparatus">apparatus — how the machine runs</a> ·
      <a href="/atelier/requests">team channel</a>
    </p>
    <p class="at-quiet">
      archive — the closed phases:
      <a href="/atelier/journal">nightly journal, {nightlySpan}</a> ·
      <a href="/atelier/history">the spine</a> ·
      <a href="/atelier/sheets">the sheets</a>
      <span>— nightly sessions 28 Jun – 18 Jul · bounded projects (v4) 18–24 Jul, preserved in the research log</span>
    </p>

    <p class="at-quiet">
      <a href="/seed?to=ulysses">Offer this practice a seed →</a>
    </p>
  </Frame>
</Page>

<style>
  /* Orientierung (.pr-orient) skin now lives in atelier-sheet.css, scoped to
     .atelier-surface — OrientationList.astro itself is skin-free (ADR 0010). */

  .at-entrance-lede {
    max-width: 62ch;
    margin: 1.25rem 0 1.75rem;
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* ——— the archive: the Passage, demoted below the running work ——— */
  .at-archive {
    margin: 0 0 2.5rem;
    padding-top: 0.5rem;
    border-top: 2px solid var(--at-ink);
  }
  .at-archive-story {
    margin: 0.25rem 0 0;
    font-size: 0.85rem;
  }
  .at-archive-story a { color: inherit; text-decoration: underline; }
  .at-archive-story a:hover { color: var(--at-thread); }

  /* ——— the map ——— */
  .at-map { margin: 0 0 2.25rem; }
  .at-map-head {
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--at-ink-2);
    margin-bottom: 0.4rem;
  }
  .at-map-scroll { overflow-x: auto; }
  .at-map svg { width: 100%; min-width: 680px; height: auto; display: block; }
  .m-line { fill: none; stroke: var(--at-graphite); stroke-width: 1.1; }
  .m-phase { stroke: var(--at-hairline); stroke-width: 1; }
  .m-seam { stroke: var(--at-hairline); stroke-width: 1; stroke-dasharray: 2 3; }
  .m-caption { font-family: var(--at-font-record); font-size: 9.5px; fill: var(--at-ink-2); }
  .m-slab { fill: var(--at-ink); }
  .m-slab-link:hover .m-slab, .m-slab-link:focus .m-slab { fill: var(--at-thread); }
  .m-slab-curated { fill: var(--at-red); }
  .m-slab-link:hover .m-slab-curated, .m-slab-link:focus .m-slab-curated { fill: var(--at-red); opacity: 0.75; }
  .m-proj-line { fill: none; stroke: var(--at-graphite); stroke-width: 1.1; }
  .m-proj-active { stroke: var(--at-thread); stroke-dasharray: 4 3; }
  /* Disposition marks wear the shared outcome identities (--at-out-*, atelier-sheet.css,
   * PALETTE: atelier-outcomes) — the same outcome reads the same colour here and in the
   * process figure below. Before this, PUBLISH wore the structural red (the one colour the

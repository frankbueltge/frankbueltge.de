---
// /atelier/works — the works room. The slabs on the sheet are doors into this room; the
// existing detail routes /atelier/werke/* stay untouched (Integrate machinery writes
// there — renaming them is a LATER package). Interactive HTML works run live in the same
// isolated sandbox the old page used; the texts & catalogue (error register, genealogy,
// positions) render verbatim below.
import { getCollection, render } from 'astro:content'
import Page from '@/layouts/Page.astro'
import Frame from '@/components/atelier/surface/Frame.astro'
import { sortWorks } from '@/lib/atelier/sort'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'
import RespondCta from '@/components/post/RespondCta.astro'
import WorkCard from '@/components/atelier/WorkCard.astro'
import { LINE_END, PROTOCOL_LADDER } from '@/lib/engines/nightly-line'

const PAIR = ATELIER_NARRATIVE.pair

const all = await getCollection('atelier')
const repo = 'https://github.com/frankbueltge/ulysses'

// Works — one chronological gallery from two sources, newest-first (unchanged data access):
//  · kind 'html'  — interactive; HTML standalone under /atelier/werke-html/<slug>/
//  · kind 'astro' — native Astro works at /atelier/werke/<slug> (routes stay)
const htmlMeta = import.meta.glob('/src/content/atelier/works/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, any>
const nativeMeta = import.meta.glob('/src/components/atelier/werke/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, any>

const works = sortWorks([
  ...Object.entries(htmlMeta).map(([path, meta]) => ({
    slug: path.replace('/src/content/atelier/works/', '').replace('/meta.json', ''),
    kind: 'html' as const, date: meta.date as string | undefined, meta,
  })),
  ...Object.entries(nativeMeta).map(([path, meta]) => ({
    slug: path.replace('/src/components/atelier/werke/', '').replace('/meta.json', ''),
    kind: 'astro' as const, date: meta.date as string | undefined, meta,
  })),
])

// Texts & catalogue (works/*.md) — newest first, rendered verbatim.
const mdWorks = all.filter((e) => e.id.startsWith('works/')).sort((a, b) => b.id.localeCompare(a.id))
const mdWorksR = await Promise.all(
  mdWorks.map(async (e) => ({ id: e.id, Content: (await render(e)).Content })),
)

// Two phases, not one gallery (2026-08-11). Until now the thirty nightly works and the curated
// work-line publications stood in one undifferentiated list under a prose note, which made the
// most consequential fact about this room invisible: the works up to 18 July belong to a line
// that was switched off and has since been forked back to life in its own repository, and the
// ones after it belong to the protocol that replaced it. Same routes, same order, same data —
// the cut is drawn where the practice's own record draws it.
const nightlyWorks = works.filter((w) => w.date && w.date <= LINE_END)
const worklineWorks = works.filter((w) => !w.date || w.date > LINE_END)

// The phase labels name their own constitutions, derived rather than typed: the nightly phase
// ran under the restored step of the ladder, the work-line phase from the step that ended it to
// whatever the practice runs today. A hand-written "v4 → v6" would be wrong the day v7 lands.
const restoredStep = PROTOCOL_LADDER.find((s) => s.restored)!
const endedNightly = PROTOCOL_LADDER[PROTOCOL_LADDER.indexOf(restoredStep) + 1]!
const latestStep = PROTOCOL_LADDER[PROTOCOL_LADDER.length - 1]!
const day = (iso: string): string =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' })
const nightlyStart = day(PROTOCOL_LADDER[0]!.date)

const kicker = ['Atelier · works', 'ulysses', `${works.length} works · ${mdWorksR.length} texts`]
const statusHtml = `<b>${works.length} works</b> · ${nightlyWorks.length} nightly, ${worklineWorks.length} work-line · newest first · detail routes stay under /atelier/werke/*`
---

<Page
  title="Atelier — works | Frank Bültge"
  description="The Atelier's works, newest first — interactive pieces running sandboxed, native works on their own pages, and the texts & catalogue verbatim."
>
  <Frame active="works" kicker={kicker} h1="The slabs, standing." statusHtml={statusHtml} back>
    <p class="at-room-intro">{ATELIER_NARRATIVE.rooms.works}</p>
    <RespondCta variant="line" ns="atelier" class="at-room-intro" />
    <p class="at-room-intro">{ATELIER_NARRATIVE.rooms.worksPhase}</p>

    {/* ——— the work-line phase: what this practice makes now ——— */}
    <section class="at-phase">
      <h2 class="at-phase-head">
        The work-line phase
        <span class="at-phase-span">
          since {day(endedNightly.date)} · Protocol v{endedNightly.version} → v{latestStep.version}
        </span>
      </h2>
      <p class="at-phase-note">{PAIR.arms.here} — each published by explicit human decision.</p>
      {worklineWorks.map(({ slug, kind, meta }) => (
        <WorkCard slug={slug} kind={kind} meta={meta} repo={repo} />
      ))}
    </section>

    {/* ——— the nightly phase: the line that was forked back to life ———
         These are the works of the nightly line. They keep their addresses — this practice made
         them and moving them would falsify its own record — but the room now says whose line
         they are and that it did not end when this surface stopped showing new ones. */}
    <section class="at-phase at-phase-nightly" id="at-phase-nightly">
      <h2 class="at-phase-head">
        The nightly phase
        <span class="at-phase-span">
          {nightlyStart} – {day(LINE_END)} · Protocol v{restoredStep.version}
        </span>
      </h2>
      <p class="at-phase-note">{PAIR.worksNote}</p>
      <p class="at-phase-link">
        <a href="/error-as-method">{PAIR.link}</a>
      </p>
      {nightlyWorks.map(({ slug, kind, meta }) => (
        <WorkCard slug={slug} kind={kind} meta={meta} repo={repo} />
      ))}
    </section>

    {/* The verbatim mirror stays — it is the record, and the record is not replaced by a reading
        of it. But these texts (the genealogy, both position papers, twenty-one error registers)
        are the nightly line's apparatus, and since 2026-08-11 they also have rooms that make
        their structure legible. The pointer goes here because this is where a reader who wants
        them actually ends up. */}
    <section class="at-record mt-10">
      <h2>Texts &amp; catalogue — mirrored verbatim from the research archive</h2>
      <p class="at-phase-note">
        The full texts, unedited. Their structure — the genealogy's stations and dated extensions,
        the position before and after the subtraction, the error register by type and status — is
        laid out at <a href="/error-as-method/genealogy">the nightly line's rooms</a>.
      </p>
      {mdWorksR.map(({ id, Content }) => (
        <article class="at-work-card at-prose" id={id.replace('works/', '').replace(/\.md$/, '')}>
          <Content />
        </article>
      ))}
    </section>
  </Frame>
</Page>

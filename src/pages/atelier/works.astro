---
// /atelier/works — the works register as a Level-2 register sheet (2026-08-15).
//
// Until today this room printed every work as a full card and the whole texts & catalogue
// verbatim below them — thirty-eight cards and twenty-six documents on one URL. That is not a
// register, it is a scroll nobody finishes (Frank's finding, wording private), and it was the
// last big room still wearing the retired practice frame. Now: one row per work, the work
// itself one click behind it, filter chips by line — the same sheet every register in the
// house wears. The texts & catalogue moved to their own register at /atelier/texts, verbatim
// pages behind it; the bounce below catches the deep links that used to land on this page.
//
// The detail routes are untouched: /atelier/werke/<slug> for native works, the full-viewport
// stage at /atelier/werke-html/<slug>/ for interactive ones (exhibition model, 2026-07-21 —
// a work is a door, never a cramped preview).
import Page from '@/layouts/Page.astro'
import RegisterSheet from '@/components/ecology/RegisterSheet.astro'
import type { RegisterRow } from '@/components/ecology/RegisterSheet.astro'
import RespondCta from '@/components/post/RespondCta.astro'
import { sortWorks } from '@/lib/atelier/sort'
import { lineShortLabel } from '@/lib/ecology/lines'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'
import { LINE_END } from '@/lib/engines/nightly-line'

// One chronological register from two sources (unchanged data access):
//  · kind 'html'  — interactive; its door is the standalone stage under /atelier/werke-html/
//  · kind 'astro' — native Astro works at /atelier/werke/<slug>
const htmlMeta = import.meta.glob('/src/content/atelier/works/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, any>
const nativeMeta = import.meta.glob('/src/components/atelier/werke/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, any>

const works = sortWorks([
  ...Object.entries(htmlMeta).map(([path, meta]) => ({
    slug: path.replace('/src/content/atelier/works/', '').replace('/meta.json', ''),
    kind: 'html' as const, date: meta.date as string | undefined, meta,
  })),
  ...Object.entries(nativeMeta).map(([path, meta]) => ({
    slug: path.replace('/src/components/atelier/werke/', '').replace('/meta.json', ''),
    kind: 'astro' as const, date: meta.date as string | undefined, meta,
  })),
])

// The line, by the same cut the practice's own record draws (2026-08-11): works up to LINE_END
// are the nightly line's, everything after it the work-line's. The chips filter on it.
const lineOf = (date: string | undefined) =>
  date && date <= LINE_END ? lineShortLabel('nightly') : lineShortLabel('work-line')

const rows: RegisterRow[] = works.map(({ slug, kind, date, meta }) => ({
  date: date ?? '',
  marker: kind === 'html' ? 'interactive' : null,
  move: lineOf(date),
  line: meta.title ?? slug,
  href: kind === 'html' ? `/atelier/werke-html/${slug}/` : `/atelier/werke/${slug}`,
  // The old page gave every work card its slug as a DOM id; the rows keep them, so a deep link
  // that pointed at a card still lands on that work's row.
  anchor: slug,
}))

const counts = rows.reduce<Record<string, number>>((acc, r) => {
  acc[r.move!] = (acc[r.move!] ?? 0) + 1
  return acc
}, {})

// The texts & catalogue lived on this page until 2026-08-15; a fragment never reaches the
// server, so their old anchors are caught client-side and bounced to the pages they live on now.
const textSlugs = Object.keys(
  import.meta.glob('/src/content/atelier/works/*.md'),
).map((p) => p.replace('/src/content/atelier/works/', '').replace(/\.md$/, ''))
---

<Page
  title="Atelier — works | Frank Bültge"
  description="The Atelier's works register — one row per work, newest first, filterable by line; each work one click behind its row, the texts & catalogue in their own register."
>
  <RegisterSheet
    id="atelier"
    register="works"
    title="the works — every one, newest first"
    span={`${works.length} works · ${counts[lineShortLabel('nightly')] ?? 0} of the nightly line (to ${LINE_END}) · ${counts[lineShortLabel('work-line')] ?? 0} of the work-line · one row per work, the work itself behind it`}
    rows={rows}
    source="src/content/atelier/works/*/meta.json · src/components/atelier/werke/*/meta.json"
    more={{ label: 'the texts & catalogue — its own register →', href: '/atelier/texts' }}
  >
    <p class="eco-doc-note">{ATELIER_NARRATIVE.rooms.worksPhase}</p>
    <p class="eco-doc-note">
      The third line, n-1, does not land works here: its repository is its record, on its own
      surface — <a href="/n-1">/n-1</a>. The nightly line's room is
      <a href="/error-as-method">/error-as-method</a>.
    </p>
    <RespondCta variant="line" ns="atelier" class="eco-doc-note" />
  </RegisterSheet>
</Page>

<script type="application/json" id="atelier-text-slugs" set:html={JSON.stringify(textSlugs)} />
<script>
  // Legacy deep links: the genealogy, the positions and the error registers rendered on this
  // page until 2026-08-15 and were linked as /atelier/works#<slug>. Each is a page of its own
  // now. Best-effort by design (it needs JS); without it the fragment is simply inert and the
  // register is there — the correct failure mode for a page whose job is to show holdings.
  const el = document.getElementById('atelier-text-slugs')
  const texts = new Set<string>(el ? JSON.parse(el.textContent ?? '[]') : [])
  const bounce = () => {
    const target = decodeURIComponent(location.hash.slice(1))
    if (texts.has(target)) location.replace(`/atelier/texts/${target}/`)
  }
  bounce()
  addEventListener('hashchange', bounce)
</script>

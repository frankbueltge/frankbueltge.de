---
// /atelier/journal/<anchor> — ONE page of the nightly journal (Etappe 2, 2026-08-01).
// The slug is the DOM id the register has always used: `s12` for a counted session,
// `note-<slug>` for an unnumbered v4 dispatcher tick. Identity, not a mapping table — the
// deep links the sheets, the spine and the works published keep resolving.
import { getCollection } from 'astro:content'
import Page from '@/layouts/Page.astro'
import DocumentSheet from '@/components/ecology/DocumentSheet.astro'
import { buildSessionEntries, type JournalEntry } from '@/lib/atelier/sessions'
import { renderMarkdown } from '@/lib/engines/journal'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'

export async function getStaticPaths() {
  const all = await getCollection('atelier')
  const journal = all.filter((e) => e.id.startsWith('journal/'))
  const repo = 'https://github.com/frankbueltge/ulysses'
  const docs = new Set(all.filter((e) => !e.id.includes('/')).map((e) => e.id))
  const entries = buildSessionEntries(journal)

  // Rendered once for the whole practice, not once per route.
  return entries.map((entry, i) => ({
    params: { slug: entry.slug },
    props: {
      entry,
      html: renderMarkdown(entry.text, { repo, docs }),
      prev: entries[i - 1] ?? null,
      next: entries[i + 1] ?? null,
      total: entries.length,
      position: i + 1,
    },
  }))
}

const { entry, html, prev, next, total, position } = Astro.props as {
  entry: JournalEntry
  html: string
  prev: JournalEntry | null
  next: JournalEntry | null
  total: number
  position: number
}
const room = ATELIER_NARRATIVE.journalRoom
const label = entry.kind === 'session' ? `S${entry.n}` : 'v4'
// The description used to vary only by date, so entries sharing a day shared a description —
// half the journal pages collided (measured 2026-08-30). It now leads with the entry's own
// heading, which is what a search result should show and is distinct by construction.
---

<Page
  title={`Atelier — ${label}: ${entry.heading} | Frank Bültge`}
  description={`${entry.heading} — ${label}, ${entry.date}. One page of the Atelier's journal, mirrored verbatim from the practice's own repo.`}
>
  <DocumentSheet
    id="atelier"
    parent={{ label: 'journal', href: '/atelier/journal' }}
    here={label}
    title={entry.heading}
    span={`${label} · ${entry.date} · page ${position} of ${total} · ${entry.kind === 'note' ? `${room.noteKicker} — ${room.pageNote}` : room.pageNote}`}
    source="src/content/atelier/journal/*.md"
    more={{ label: 'the register →', href: '/atelier/journal' }}
  >
    <div class="engine-prose" set:html={html} />
    <nav class="eco-doc-nav" aria-label="Journal pages">
      {prev && <a href={`/atelier/journal/${prev.slug}/`}>← {room.prevLabel}: {prev.kind === 'session' ? `S${prev.n}` : prev.date}</a>}
      <a href="/atelier/journal">{room.backToRegister}</a>
      {next && <a href={`/atelier/journal/${next.slug}/`}>{room.nextLabel}: {next.kind === 'session' ? `S${next.n}` : next.date} →</a>}
    </nav>
  </DocumentSheet>
</Page>

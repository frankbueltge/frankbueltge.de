---
// The entrance of Machine Attention — the machine as a public situation, not
// a manifesto (Frank's review, 2026-08-09; docs/design/2026-08-09-machine-
// attention-meta-stage.md). The page stages what the machine last actually
// saw: real, dated moments offered by its projects under stage-moments/1,
// derived from committed records and mirrored nightly. Silence is a legal
// state and is shown as one — the page never invents activity to seem alive.
// Everything that explains the machine lives one door deeper, at /about.
//
// 2026-10-18: the page opens on what runs now. Since The Foreknown was retired
// (2026-10-04) no project holds the stage, and the entrance said "What it last
// saw · 2026-10-04" for two weeks while the practice committed every day. The
// stage stays gated by admission (no moments from a project before its
// acceptance experiment, none from an instrument ever), so the present comes
// from the export instead: the running projects by name and standing, and the
// day of the newest step on the practice's own protocol. No project's figure
// is shown here — The Interval's criterion C allows the site its name only.
import Page from '@/layouts/Page.astro'
import exportFile from '@/data/attention/export.json'
import momentsFile from '@/data/attention/moments.json'
import { lastStep, readExport, runningNow } from '@/lib/attention/export'
import { readMoments } from '@/lib/attention/moments'

const REPO = 'https://github.com/frankbueltge/machine-attention'

const moments = readMoments(momentsFile)
const latest = moments[0] ?? null
const more = moments.slice(1, 3)
const momentsCommit = (momentsFile as { generated_from?: { commit?: string } })?.generated_from
  ?.commit

const exp = readExport(exportFile)
const running = exp ? runningNow(exp) : []
// A retired project keeps its route as an archive (The Foreknown, 2026-10-04), so the
// route alone no longer says "its attention lives here": the status word decides.
const archived = exp ? exp.projects.filter((p) => p.status === 'retired') : []
const stepDay = exp ? lastStep(exp) : null

/** How a running project stands, in a reader's words. The export carries the practice's own
 *  status word; the reading of it lives here, next to the reader. */
const STANDING: Record<string, string> = {
  running: 'running',
  instrument: 'a quiet instrument, without a stage by rule',
  'e-experiment': 'in its acceptance experiment',
  v0: 'at v0, before its acceptance window',
}
/** What a project's own rules add to its line. The Interval's acceptance criteria (§2 C, as
 *  clarified on 2026-10-17) allow this site its name as the practice's current question and
 *  nothing else before the review. */
const OWN_RULE: Record<string, string> = {
  'interval:e-experiment': 'nothing of it appears on this site before its review',
}

/** Server-rendered fallback for every timestamp: the moment in plain UTC.
 *  The script below upgrades it to a relative age; without JS the date
 *  stands, which is the more notarial statement anyway. */
const utc = (ts: string) => `${ts.slice(0, 16).replace('T', ' ')} UTC`
---

<Page
  title="Machine Attention | Frank Bültge"
  description="The machine is paying attention. The entrance to Machine Attention, a machine-run investigative research project: what runs now, and what it last put on its stage, from its committed records — preserved, verified, and open to follow."
>
  <main id="main" class="flex-1">
  <div class="mx-auto flex min-h-[82vh] max-w-3xl flex-col px-4 py-16 font-mono">
    <p class="mb-10 flex flex-wrap justify-between gap-2 text-[11px] uppercase tracking-[0.2em] text-fg-faint">
      <span>Machine Attention · a research project</span>
      <span><span id="ma-utc">—</span> UTC</span>
    </p>

    <h1 class="mb-14 max-w-[16ch] font-sans text-4xl font-semibold uppercase leading-[1.05] tracking-tight sm:text-6xl">
      The machine is paying attention.
    </h1>

    {running.length > 0 && (
      <section aria-label="What runs now" class="mb-14 border-l-2 border-line pl-5 sm:pl-7">
        <p class="mb-3 text-[11px] uppercase tracking-[0.18em] text-fg-faint">
          Running now{stepDay ? <> · newest step on its protocol <span data-day={stepDay}>{stepDay}</span></> : null}
        </p>
        <ul class="mb-4 space-y-2 text-sm leading-relaxed text-fg-muted">
          {running.map((p) => (
            <li>
              {p.site_route
                ? <a href={p.site_route} class="font-sans text-base font-semibold text-fg underline decoration-line underline-offset-4 hover:decoration-fg">{p.title}</a>
                : <span class="font-sans text-base font-semibold text-fg">{p.title}</span>}
              {' '}— {STANDING[p.status] ?? p.status}{OWN_RULE[`${p.id}:${p.status}`] ? <>; {OWN_RULE[`${p.id}:${p.status}`]}</> : null}
            </li>
          ))}
        </ul>
        <p class="max-w-[60ch] text-xs leading-relaxed text-fg-faint">
          None of them is on the stage below: a project takes it only after its acceptance
          experiment, and an instrument never does. Those without a link are public only in
          {' '}<a href={REPO} class="underline hover:text-fg">the practice&rsquo;s repository</a>.
        </p>
      </section>
    )}

    {latest ? (
      <section aria-label="Last on this stage" class="mb-14 border-l-2 border-line pl-5 sm:pl-7">
        <p class="mb-3 text-[11px] uppercase tracking-[0.18em] text-fg-faint">
          Last on this stage · <span data-occurred={latest.occurred_at}>{utc(latest.occurred_at)}</span>
        </p>
        <p class="mb-2 max-w-[24ch] font-sans text-2xl font-semibold leading-snug text-fg sm:text-4xl">
          {latest.statement}
        </p>
        <p class="mb-6 text-sm text-fg-muted">{latest.subject}</p>
        <a
          href={latest.enter}
          class="inline-block border-b-2 border-line pb-0.5 font-sans text-lg font-semibold uppercase tracking-wide text-fg hover:border-fg"
        >
          Follow it &rarr;
        </a>
      </section>
    ) : (
      <section aria-label="The quiet state" class="mb-14 border-l-2 border-line pl-5 sm:pl-7">
        <p class="mb-2 max-w-[38ch] font-sans text-2xl font-semibold leading-snug text-fg sm:text-3xl">
          Nothing it has preserved has crossed into a public moment yet.
        </p>
        <p class="max-w-[52ch] text-sm text-fg-muted">
          Its records accumulate all the same — nightly, in the open. Silence here is a real
          state, not a failure; this page does not invent activity.
        </p>
      </section>
    )}

    {more.length > 0 && (
      <section aria-label="Earlier moments" class="mb-14">
        <p class="mb-3 text-[11px] uppercase tracking-[0.18em] text-fg-faint">Before that</p>
        <ul class="space-y-2 text-sm text-fg-muted">
          {more.map((m) => (
            <li>
              <a href={m.enter} class="hover:text-fg">
                {m.statement}
                <span class="text-fg-faint"> — {m.subject} · <span data-occurred={m.occurred_at}>{utc(m.occurred_at)}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <div class="mt-auto border-t border-line pt-8 text-sm leading-relaxed text-fg-muted">
      <p class="mb-6 max-w-[62ch]">
        A machine pays continuous attention to public systems no one can watch at the same scale
        or for the same duration. It preserves what it sees, investigates differences, and
        sometimes builds a work from what it finds.
      </p>

      {!exp && (
        <p class="mb-6 text-xs text-fg-faint">
          The practice&rsquo;s export is not present in this repository right now, so what runs
          cannot be shown from source. That is a missing file, not an empty practice.
        </p>
      )}
      {archived.length > 0 && (
        <p class="mb-6 text-[13px]">
          <span class="text-[11px] uppercase tracking-[0.18em] text-fg-faint">Retired, the record kept</span>
          {archived.map((p) => (
            <>
              {' '}· {p.site_route
                ? <a href={p.site_route} class="underline decoration-line underline-offset-4 hover:text-fg">{p.title}</a>
                : p.title}
            </>
          ))}
        </p>
      )}

      <p class="text-xs text-fg-faint">
        <a href="/machine-attention/about" class="border-b border-line pb-0.5 font-sans text-sm font-semibold uppercase tracking-wide text-fg hover:border-fg">About this machine &rarr;</a>
      </p>
      <p class="mt-6 text-[11px] leading-relaxed text-fg-faint">
        Every moment above is derived from committed records{momentsCommit ? <> (commit <code>{momentsCommit}</code>)</> : null},
        and what runs now from the practice&rsquo;s own export{exp?.commit ? <> (commit <code>{exp.commit}</code>)</> : null};
        both are mirrored nightly and can be re-derived by anyone:
        {' '}<a href={REPO} class="underline hover:text-fg">the archive</a> ·
        {' '}<a href="/werke/attention" class="underline hover:text-fg">the method sheet</a>.
      </p>
    </div>
  </div>
  </main>
</Page>

<script>
  // Clocks tick client-side from data timestamps, so the built page stays byte-stable for
  // identical data — the same rule the practice stage keeps. A bundled module, not an inline
  // script: the site's CSP pins the hashes of only two inline scripts (Base.astro), and the
  // inline version of this one was refused on every visit until 2026-10-18, leaving the clock
  // at "—" and every age unrendered.
  const pad = (n: number) => String(n).padStart(2, '0')

  function age(ms: number): string {
    const minutes = Math.max(1, Math.floor(ms / 60000))
    if (minutes < 90) return `${minutes} minute${minutes === 1 ? '' : 's'} ago`
    const hours = Math.round(minutes / 60)
    if (hours < 48) return `${hours} hour${hours === 1 ? '' : 's'} ago`
    return `${Math.round(hours / 24)} days ago`
  }

  /** A day, not an instant: counted in whole UTC days, so a date never claims an hour. */
  function dayAge(day: string, now: Date): string | null {
    const then = Date.parse(`${day}T00:00:00Z`)
    if (isNaN(then)) return null
    const today = Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate())
    const days = Math.round((today - then) / 86400000)
    if (days < 0) return null
    return days === 0 ? 'today' : days === 1 ? 'yesterday' : `${days} days ago`
  }

  let timer: ReturnType<typeof setInterval> | undefined

  function tick() {
    const now = new Date()
    const clock = document.getElementById('ma-utc')
    if (clock)
      clock.textContent = `${now.getUTCFullYear()}-${pad(now.getUTCMonth() + 1)}-${pad(now.getUTCDate())} ${pad(now.getUTCHours())}:${pad(now.getUTCMinutes())}:${pad(now.getUTCSeconds())}`
    document.querySelectorAll<HTMLElement>('[data-occurred]').forEach((el) => {
      const ts = Date.parse(el.dataset.occurred ?? '')
      if (!isNaN(ts) && ts <= now.getTime()) el.textContent = age(now.getTime() - ts)
    })
    document.querySelectorAll<HTMLElement>('[data-day]').forEach((el) => {
      const day = el.dataset.day ?? ''
      const said = dayAge(day, now)
      if (said) el.textContent = `${day} (${said})`
    })
  }

  function wire() {
    if (timer) clearInterval(timer)
    timer = undefined
    if (!document.getElementById('ma-utc')) return
    tick()
    timer = setInterval(tick, 1000)
  }

  wire()
  document.addEventListener('astro:page-load', wire)
</script>

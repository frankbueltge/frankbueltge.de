---
// /field — the Field's page (the practice template of the design handoff of 2026-10-11).
//
// Lineage: the station sheet of 2026-08-12 (StationSheet with the gate strip, the gauntlet and
// the claim plate as figures) stood here until 2026-09-01; the v3 practice station
// (PracticeStation.astro) from then until 2026-10-11. Both are archived in the repository
// history and their components stay in the repo unlinked (decision log, 2026-09-01 and
// 2026-10-11). This page is thin on purpose: it names the practice and renders one
// PracticePart, which derives everything else from the committed record.
import Page from '@/layouts/Page.astro'
import PracticePart from '@/components/ecology/score/PracticePart.astro'
import { PRACTICE_V3 } from '@/config/practice-wording'

const SEO = PRACTICE_V3.field.seo
---

<Page title={`${SEO.title} | Frank Bültge`} description={SEO.description} surface="paper">
  <PracticePart id="field" />
</Page>

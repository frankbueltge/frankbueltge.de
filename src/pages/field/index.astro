---
// /field — the Field's station sheet (Level 1 of the ecology pyramid, 2026-08-12).
//
// Replaces, as separate surfaces: the practice's own index, its history, its apparatus page and
// its tour. All four told a visitor something true and none of them fitted on one screen; the
// pyramid's answer is one condensed sheet with the doors to the registers underneath. The retired
// pages 301 to here (public/_redirects) and their texts stay in Git.
import Page from '@/layouts/Page.astro'
import StationSheet from '@/components/ecology/StationSheet.astro'
import '@/styles/field-plate.css'
import Figure from '@/components/ecology/figures/Figure.astro'
import GateStripFigure from '@/components/ecology/figures/GateStrip.astro'
import GauntletFigure from '@/components/ecology/figures/Gauntlet.astro'
import ClaimFigure from '@/components/field/ClaimFigure.astro'
import { loadClaimModel } from '@/lib/field/claim-data'
import { PYRAMID } from '@/config/ecology-pyramid-wording'
import { FIGURES } from '@/config/ecology-figure-wording'
import pulseData from '@/data/pulse/pulse.json'
import type { PulseSnapshot } from '@/lib/pulse/render'
import { allWorks } from '@/lib/engines/register'
import { buildStationSheet, splitDoorLine, type LogEntry } from '@/lib/ecology/pyramid/station'
import { buildGateStrip, buildGauntlet } from '@/lib/ecology/pyramid/figures'
import { recordLine, type ChronicleEntry } from '@/lib/ecology/pyramid/landings'
import chronicle from '@/data/field/chronicle.upstream.json'

const works = allWorks()
const rows = chronicle as ChronicleEntry[]
const fieldWorks = works.filter((w) => w.ns === 'field')

// The record's last three sessions, in the practice's own words.
const log: LogEntry[] = [...rows]
  .filter((r) => r.date)
  .sort((a, b) => (a.date! < b.date! ? 1 : -1))
  .slice(0, 3)
  .map((r) => ({
    date: r.date!,
    marker: r.collective_session ? `S${r.collective_session}` : null,
    line: recordLine(r.move, r.summary) ?? PYRAMID.station.absent,
  }))

const sheet = buildStationSheet({
  id: 'field',
  snapshot: pulseData as PulseSnapshot,
  works,
  log,
  made: fieldWorks.length,
})

const strip = buildGateStrip(rows as never, works)
const gauntlet = buildGauntlet(
  rows.filter((r) => r.date).length,
  fieldWorks.length,
  fieldWorks.filter((w) => w.state !== 'withdrawn').length,
  FIGURES.field.gauntlet.rows,
)

const door = splitDoorLine(sheet.station.description)
const SEO = PYRAMID.stationSeo.field
const F = FIGURES.field

// The claim plate's model — assembled in its own data module so this page stays composition.
const claimModel = loadClaimModel()
---

<Page title={`${SEO.title} | Frank Bültge`} description={SEO.description}>
  <StationSheet
    id="field"
    kicker={`${sheet.station.name.toUpperCase()} · ${sheet.station.resident.toUpperCase()} · ${sheet.station.corner}`}
    h1={door.lead}
    sub={door.rest}
    status={sheet.status}
    lede={sheet.lede && {
      kicker: F.lede.kicker(sheet.lede.date),
      title: sheet.lede.title,
      teaser: sheet.ledeTeaser,
      note: sheet.arc?.title ?? null,
      noteLabel: F.lede.noteLabel,
      links: [
        { label: F.lede.open, href: sheet.lede.href },
        { label: F.lede.record, href: '/field/instruments' },
      ],
    }}
    log={sheet.log}
    logMore={{ label: PYRAMID.station.wholeJournal, href: '/field/journal' }}
    doors={sheet.doors}
  >
    <Figure
      slot="figure-main"
      title={F.gate.title}
      sub={F.gate.sub}
      link={{ label: F.gate.link(sheet.made.count), href: '/field/instruments' }}
      caption={F.gate.caption(strip.marks.length, strip.statedCount)}
    >
      <GateStripFigure strip={strip} />
    </Figure>

    {/* The practice's signature figure, restored 2026-08-14. It joins the LEFT column rather than
        taking the narrow side slot: the plate is a wide drawing with the record's own sentences
        under it, and 340px would have made it the smear the refrain was on 2026-08-13. */}
    <Figure
      slot="figure-main"
      title={F.claim.title}
      sub={F.claim.sub}
      caption={F.claim.caption}
      full
    >
      {/* The plate's whole appearance lives in field-plate.css under a `.field-surface` ancestor
          (claimladder.ts emits classes, never a colour). The 2026-08-12 rewrite of this page
          dropped Frame.astro — the only place that supplied both — so every shape fell back to
          the browser's black and the hover targets rendered as redaction bars. The host below
          restores the scope and neutralises the surface's page chrome (fix of 2026-09-01). */}
      <div class="field-surface claim-host">
        <ClaimFigure model={claimModel} id="field-claim-plate" />
      </div>
    </Figure>

    <Figure slot="figure-side" title={F.gauntlet.title} sub={F.gauntlet.sub} caption={F.gauntlet.caption}>
      <GauntletFigure rows={gauntlet} />
    </Figure>
  </StationSheet>
</Page>

<style>
  /* Inside the figure panel the surface is a picture, not a page — same move as hub-triptych's
     `.hub-thumb.field-surface`. The tokens and the `.field-surface .fd-*` colour rules are what
     the plate needs; the page chrome is not. */
  .claim-host.field-surface {
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    border: 0;
  }
</style>

---
// /field — das Kontrollblatt (field-aesthetik-2026-07-15.md §4): the entry is the
// instrument currently under verification, NOT a dashboard. Marks derive from committed
// data only: the work's meta date (built), the chronicle entries that touch it (stamps),
// and the enc-2026-001 score export (contract flag, the correction splicing in from
// outside, the applied stamp, the standing obligation). The mockup hand-picked its event
// list; the site derives it — a named deviation. Replaces the old EnginePage entrance.
import Page from '@/layouts/Page.astro'
import Frame from '@/components/field/surface/Frame.astro'
import OrientationList from '@/components/practice/OrientationList.astro'
import { loadChronicle, entriesForWork } from '@/lib/field/chronicle'
import { currentScore } from '@/lib/begegnungen'
import { buildControlSvg, plateSpan, type ControlMark } from '@/lib/field/strip'
import { latestInstrument, orderInstruments, type InstrumentMeta } from '@/lib/field/latest'
import { FIELD_NARRATIVE } from '@/config/field-wording'
import runtimeLog from '@/data/meridian/runtime-log.json'
import GauntletTour from '@/components/field/tours/GauntletTour.astro'
import ClaimFigure from '@/components/field/ClaimFigure.astro'
import { GAUNTLET_INSTRUMENTS, gauntletPlate } from '@/lib/tour/field-gauntlet'
import { buildClaimModel, type ExportObject, type ParallaxExport } from '@/lib/field/claimladder'
import parallax from '@/data/meridian/parallax.json'

const metas = import.meta.glob('/src/components/field/werke/*/meta.json', {
  eager: true, import: 'default',
}) as Record<string, InstrumentMeta>
const metaBySlug = new Map(
  Object.entries(metas).map(([p, m]) => [p.replace('/src/components/field/werke/', '').replace('/meta.json', ''), m]),
)

// The featured instrument is Meridian's NEWEST committed work, derived live from the synced
// mirror — NOT a hand-set pointer. A hardcoded slug (FIELD_NARRATIVE.currentInstrumentSlug) once
// froze this header at instrument 001 while the engine had already shipped further; the content
// syncs nightly, so the pointer must follow it on its own. The rule + fail-loud guards live in
// lib/field/latest.ts under test (latest.test.ts) so the freeze cannot silently return.
const { slug, meta, instrumentNo } = latestInstrument([...metaBySlug.entries()])

const chronicle = loadChronicle()
const touching = entriesForWork(chronicle, slug)

const score = currentScore
const contract = score.events.find((e) => e.event_type === 'contract.published')
const issued = score.events.find((e) => e.event_type === 'correction.issued')
const applied = score.events.find((e) => e.event_type === 'correction.applied')
const obligation = score.obligations.find((o) => o.id.includes('caveat-preservation'))

interface Row { date: string; event: string; source: string }
const marks: ControlMark[] = []
const rows: Row[] = []

marks.push({ date: meta.date, label: `built — instrument ${instrumentNo} enters service`, kind: 'instr' })
rows.push({ date: meta.date, event: `built — instrument ${instrumentNo} enters service`, source: `works/${slug} (committed date)` })

for (const e of touching) {
  const sessLabel = e.collective_session ? `S${e.collective_session}` : 'pre-constitution'
  const label = `${sessLabel} — ${e.move}${e.verdict ? ` · ${e.verdict}` : ''}: ${e.summary}`
  if (e.date === meta.date && e.move === 'build') {
    rows.push({ date: e.date, event: label, source: 'chronicle, verbatim' })
    continue // the build entry IS the built mark — no second glyph on the same spot
  }
  marks.push({ date: e.date, label, kind: 'stamp', letter: e.move.charAt(0).toUpperCase() })
  rows.push({ date: e.date, event: label, source: 'chronicle, verbatim' })
}

if (contract) {
  marks.push({ date: contract.date, label: `contract.published — “${contract.quote}” (${contract.attribution})`, kind: 'flag' })
  rows.push({ date: contract.date, event: `contract.published — “${contract.quote}”`, source: `enc-2026-001 ledger, verbatim (${contract.attribution})` })
}
if (issued) {
  marks.push({ date: issued.date, label: 'correction arrives from the work, delivered by the conductor (enc-2026-001)', kind: 'splicein' })
  rows.push({ date: issued.date, event: `correction arrives from the work — “${issued.quote}”`, source: `enc-2026-001 ledger, verbatim (${issued.attribution})` })
}
if (applied) {
  marks.push({ date: applied.date, label: `correction.applied — ${applied.quote} (${applied.attribution})`, kind: 'stamp', letter: 'S' })
  rows.push({ date: applied.date, event: `correction.applied — ${applied.quote}`, source: `enc-2026-001 ledger · chronicle (${applied.attribution})` })
}
if (contract && obligation) {
  rows.push({ date: `since ${contract.date}`, event: `obligation ${obligation.label}`, source: 'enc-2026-001 obligations' })
}
// Neueste zuerst (Frank, 16.07. abends) — nur die Lese-Tabelle; Streifen-Geometrie und
// Instrument-Nummerierung bleiben chronologisch (deterministische Identität).
rows.sort((a, b) => a.date.replace(/^since /, '') === b.date.replace(/^since /, '') ? 0 : b.date.replace(/^since /, '').localeCompare(a.date.replace(/^since /, '')))

marks.sort((a, b) => (a.date === b.date ? 0 : a.date.localeCompare(b.date)))
// The plate spans every mark, not just [meta.date, endDate]: a chronicle stamp or ledger event
// dated before the featured work's committed date would otherwise fall off the plate (dx throws).
// And the span may legitimately be a single day — a work shipped today has meta.date equal to the
// newest mark date and nothing dated later; buildControlSvg renders that one-day plate instead of
// failing the whole build (the 2026-07-24 red: instrument 017 shipped, /field crashed).
const days = plateSpan(meta.date, marks.map((m) => m.date), score.status.as_of)
const endDate = days[days.length - 1]

const svg = buildControlSvg({
  days,
  marks,
  obligation:
    contract && obligation ? { fromDate: contract.date, label: obligation.label } : undefined,
  penLabel: 'in service',
})

// ——— the shelf band (Eingang v2, 2026-07-25): every instrument on the tape, at its
// committed date — same total order and numbering as the featured derivation (latest.ts),
// so the band and the header can never disagree. Same-day instruments fan out around
// their date. No inline style attributes (CSP: style hashes ignore 'unsafe-inline').
const bandEntries = orderInstruments([...metaBySlug.entries()]).filter(([, m]) => m.date)
const noBySlug = new Map(bandEntries.map(([s], i) => [s, String(i + 1).padStart(3, '0')]))
const bandT = (d: string) => Date.parse(d + 'T00:00:00Z')
const B0 = bandT(bandEntries[0][1].date!)
const B1 = bandT(meta.date)
const BW = 960, BH = 92, bPadL = 16, bPadR = 46, BY = 56
const bandX = (ts: number) =>
  B1 === B0 ? bPadL : bPadL + ((ts - B0) / (B1 - B0)) * (BW - bPadL - bPadR)
const byDay = new Map<string, typeof bandEntries>()
for (const e of bandEntries) {
  const d = e[1].date!
  byDay.set(d, [...(byDay.get(d) ?? []), e])
}
const bandTicks = [...byDay.entries()].flatMap(([d, group]) =>
  group.map(([tSlug, m], i) => ({
    slug: tSlug,
    no: noBySlug.get(tSlug)!,
    title: m.title ?? tSlug,
    date: d,
    x: bandX(bandT(d)) + (i - (group.length - 1) / 2) * 7,
    current: tSlug === slug,
  })),
)

// ——— WP6b (2026-08-01): the gauntlet tour and the claim plate ————————————————————————
// Two figures, two records, and the attribution between them is the point (wording canon,
// enc-2026-005): the TOUR walks the COLLECTIVE's own week — its journal, its two instruments, its
// gauntlet; the CLAIM PLATE draws the RUNTIME's review of one of the collective's claims, and the
// runtime is the architect's engineering line, not the collective's research voice. The runtime's
// own room stays where it was, further down the page (/field/apparatus carries the rest).
const exportObjects: Record<string, ExportObject> = Object.fromEntries(
  Object.entries(
    import.meta.glob('/src/data/meridian/export/objects/*.json', {
      eager: true, import: 'default',
    }) as Record<string, ExportObject>,
  ).map(([path, body]) => [path.split('/').at(-1) ?? path, body]),
)
const claimModel = buildClaimModel({
  parallax: parallax as unknown as ParallaxExport,
  objects: exportObjects,
})

const i018 = metaBySlug.get(GAUNTLET_INSTRUMENTS.i018)
const i019 = metaBySlug.get(GAUNTLET_INSTRUMENTS.i019)
if (!i018?.title || !i018.date || !i019?.title || !i019.date) {
  throw new Error('/field: the gauntlet tour needs both of its instruments in the committed mirror')
}
const gauntlet = gauntletPlate({
  chronicle,
  instrument018: { title: i018.title, date: i018.date },
  instrument019: { title: i019.title, date: i019.date },
  parallax,
})

const kicker = ['Field · instrument record', `works/${slug}`, `${meta.date} → ${endDate}`]
// One clear line, not a run-on: the instrument's live status. The selection rationale
// (FIELD_NARRATIVE.selectionRule) moved out of the header — it is meta, not what the page is about.
const statusHtml =
  `<b>in service since ${meta.date}</b>` +
  `${applied ? ' · correction applied · register revised' : ''}` +
  `${obligation ? ' · caveat obligation active' : ''}`
---

<Page
  title={`Field — instrument record · ${meta.title ?? slug} | Frank Bültge`}
  description="The Field's entry is the instrument currently under verification: its record strip — built, contracted, corrected from outside, obligation standing — every mark sourced."
>
  <Frame
    active="this instrument"
    kicker={kicker}
    h1={`Instrument ${instrumentNo} — ${meta.title ?? slug}`}
    statusHtml={statusHtml}
    footLeft={FIELD_NARRATIVE.provenance.strip}
    footRight="the correction’s two readings live in The Middle → enc-2026-001; this plate keeps the local record"
  >
    {/* Orientierung zuerst (Frank, 24.07.: „man landet auf 'This instrument' und versteht
        nur bahnhof") — was das Feld ist, dann die Praxis als Band, dann das lebende Exponat.
        WP2 (2026-07-31): the lede moved into FIELD_NARRATIVE.entrance.lede verbatim; the
        orientation block below it is NEW drafted copy — flagged in the WP2 PR for sign-off. */}
    <p class="fd-room-intro">{FIELD_NARRATIVE.entrance.lede}</p>

    <OrientationList items={FIELD_NARRATIVE.orientation} />

    <figure class="fd-band" aria-label={FIELD_NARRATIVE.shelf.heading}>
      <figcaption class="fd-band-head">{FIELD_NARRATIVE.shelf.heading}</figcaption>
      <div class="fd-band-scroll">
        <svg viewBox={`0 0 ${BW} ${BH}`} role="img" aria-label={FIELD_NARRATIVE.shelf.caption}>
          <line x1={bPadL - 6} y1={BY} x2={BW - bPadR + 26} y2={BY} class="b-tape" />
          <path d={`M ${BW - bPadR + 26} ${BY} l 9 0 m -3.5 -3 l 3.5 3 l -3.5 3`} class="b-tape" />
          {bandTicks.map((tk) => (
            <a href={`/field/werke/${tk.slug}`} class="b-tick-link">
              <title>{`instrument ${tk.no} — ${tk.title} · ${tk.date}`}</title>
              <line x1={tk.x} y1={BY} x2={tk.x} y2={BY - (tk.current ? 30 : 17)} class={tk.current ? 'b-tick b-tick-current' : 'b-tick'} />
              {tk.current && <circle cx={tk.x} cy={BY - 34} r={3.2} class="b-tick-head" />}
            </a>
          ))}
          <text x={bPadL} y={BY + 18} class="b-cap">{bandEntries[0][1].date}</text>
          <text x={BW - bPadR} y={BY + 18} text-anchor="end" class="b-cap">{meta.date} · in service — the strip below</text>
        </svg>
      </div>
      <figcaption class="fd-band-legend">{FIELD_NARRATIVE.shelf.caption}</figcaption>
    </figure>

    {/* How a claim gets tested here — the collective's own gauntlet week, in six scenes, every
        quoted line byte-exact from the committed file under it (WP6b, 2026-08-01). */}
    <GauntletTour plate={gauntlet} />

    {/* And what the review leaves standing: one claim of the collective's, held contested by the
        runtime's own record. The attribution line under the figure keeps the two lines apart. */}
    <ClaimFigure model={claimModel} heading={FIELD_NARRATIVE.claim.heading} />

    <h2 class="fd-claim-h">{`Instrument ${instrumentNo} — the record strip`}</h2>
    <figure id="field-strip" set:html={svg} />

    {meta.embodies && (
      <p class="fd-room-intro">
        {meta.embodies} <a href={`/field/werke/${slug}`} class="underline">Open the instrument →</a>
      </p>
    )}

    <section class="fd-record">
      <h2>Instrument record — every mark, uncompressed</h2>
      <div class="fd-tbl-wrap">
        <table>
          <thead><tr><th>date</th><th>event</th><th>source</th></tr></thead>
          <tbody>
            {rows.map((r) => (
              <tr>
                <td class="mono">{r.date}</td>
                <td class="q">{r.event}</td>
                <td class="mono">{r.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    {/* Die zweite Spur (2026-07-25): die Runtime-Linie, klar attribuiert — nicht die Stimme
        des Kollektivs (enc-2026-005 authorship honesty). Löst zugleich die Verwaisung von
        /on-record und /e2e-automation. */}
    <section class="fd-record fd-runtime">
      <h2>{FIELD_NARRATIVE.runtime.heading}</h2>
      <p class="fd-room-intro">{FIELD_NARRATIVE.runtime.body}</p>
      <p class="fd-runtime-links">
        <a href="/on-record">On Record — thirteen contradictions, kept visible →</a>
        <a href="/e2e-automation">the field survey — end-to-end AI research automation →</a>
        <a href="https://github.com/frankbueltge/meridian-runtime" target="_blank" rel="noreferrer">meridian-runtime — the source ↗</a>
      </p>

      {/* Das Journal der Runtime-Linie (2026-07-31): /on-record zeigt EINEN Export und
          steht bei dessen Datum still — die Ableitung ist deterministisch, kein Nightly
          kann sie erneuern. Was die Runtime danach getan hat, trägt diese Liste nach;
          jeder Eintrag nennt seinen Commit (Aktualitäts-Regel 2026-07-25). */}
      <ol class="fd-runtime-log">
        {runtimeLog.entries.map((e) => (
          <li>
            <p class="fd-log-head">
              <time datetime={e.date} class="fd-log-date">{e.date}</time>
              <span class="fd-log-title">{e.headline}</span>
            </p>
            <p class="fd-log-note">{e.note}</p>
            <p class="fd-log-src">
              <a href={e.url} target="_blank" rel="noreferrer">{e.repo} · {e.commit.slice(0, 7)} ↗</a>
            </p>
          </li>
        ))}
      </ol>
      <p class="fd-band-legend">{FIELD_NARRATIVE.runtime.logNote}</p>
    </section>

    {/* Öffentliche Saat: eine kontextuelle Zeile — ein Seed an genau diese Praxis (?to prefill). */}
    <p class="fd-room-intro">
      <a href="/seed?to=field-research" class="underline">Offer this practice a seed →</a>
    </p>
  </Frame>
</Page>

<style>
  .fd-band { margin: 0 0 1.9rem; }
  .fd-band-head {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-fg-faint);
    margin-bottom: 0.35rem;
  }
  .fd-band-scroll { overflow-x: auto; }
  .fd-band svg { width: 100%; min-width: 640px; height: auto; display: block; }
  .b-tape { fill: none; stroke: var(--color-fg-muted); stroke-width: 1.1; }
  .b-tick { stroke: var(--color-fg-faint); stroke-width: 2; }
  .b-tick-link:hover .b-tick, .b-tick-link:focus .b-tick { stroke: var(--color-fg); }
  .b-tick-current { stroke: var(--color-fg); stroke-width: 2.6; }
  .b-tick-head { fill: var(--color-fg); }
  .b-cap {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 10.5px;
    fill: var(--color-fg-faint);
  }
  .fd-band-legend {
    font-size: 0.74rem;
    line-height: 1.55;
    color: var(--color-fg-faint);
    margin-top: 0.4rem;
    max-width: 90ch;
  }
  .fd-runtime-links { display: flex; flex-direction: column; gap: 0.35rem; margin-top: 0.6rem; }
  .fd-runtime-links a {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.78rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .fd-runtime-log {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    max-width: 90ch;
    border-top: 1px solid var(--color-line);
  }
  .fd-runtime-log > li {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  .fd-log-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.7rem;
    align-items: baseline;
  }
  .fd-log-date {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    color: var(--color-fg-faint);
    flex: none;
  }
  .fd-log-title { font-weight: 600; font-size: 0.92rem; }
  .fd-log-note {
    font-size: 0.82rem;
    line-height: 1.6;
    margin-top: 0.3rem;
    color: var(--color-fg-muted, inherit);
  }
  .fd-log-src { margin-top: 0.35rem; }
  .fd-log-src a {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    color: var(--color-fg-faint);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>

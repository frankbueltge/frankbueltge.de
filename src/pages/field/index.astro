---
// /field — the Field's practice station (research ecology v3 template, 2026-09-01).
//
// Lineage: the station sheet of 2026-08-12 (StationSheet with the gate strip, the gauntlet and
// the claim plate as figures) stood here until 2026-09-01 and is archived in the repository
// history; its components stay in the repo unlinked (decision log, 2026-09-01). This page is
// thin on purpose: it assembles the practice's own record — the last sessions from its
// chronicle — and renders one PracticeStation. Everything else the station derives itself.
import Page from '@/layouts/Page.astro'
import PracticeStation from '@/components/ecology/PracticeStation.astro'
import { PRACTICE_V3 } from '@/config/practice-wording'
import { PYRAMID } from '@/config/ecology-pyramid-wording'
import { recordLine, type ChronicleEntry } from '@/lib/ecology/pyramid/landings'
import type { LogEntry } from '@/lib/ecology/pyramid/station'
import chronicle from '@/data/field/chronicle.upstream.json'

const rows = chronicle as ChronicleEntry[]

// The record's last three sessions, in the practice's own words.
const log: LogEntry[] = [...rows]
  .filter((r) => r.date)
  .sort((a, b) => (a.date! < b.date! ? 1 : -1))
  .slice(0, 3)
  .map((r) => ({
    date: r.date!,
    marker: r.collective_session ? `S${r.collective_session}` : null,
    line: recordLine(r.move, r.summary) ?? PYRAMID.station.absent,
  }))

const SEO = PRACTICE_V3.field.seo
---

<Page title={`${SEO.title} | Frank Bültge`} description={SEO.description}>
  <PracticeStation id="field" log={log} />
</Page>

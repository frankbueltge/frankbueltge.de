---
// Constitution — the standing instruction the field-research collective runs on, synced
// verbatim from its repo (src/content/field/PROTOCOL.md). The glob loader lowercases file
// stems into entry ids (verified empirically: PROTOCOL.md → id "protocol"), so we look up
// the lowercase id rather than the raw filename.
import { getCollection, render } from 'astro:content'
import Page from '@/layouts/Page.astro'
import Frame from '@/components/field/surface/Frame.astro'

const all = await getCollection('field')
const doc = all.find((e) => e.id === 'protocol')
const { Content } = doc ? await render(doc) : { Content: null }
---

<Page title="Constitution — Field Research" description="The standing instruction the autonomous research collective runs on. Written and maintained by the machine. Unedited.">
  <Frame
    active=""
    back
    kicker={['Lab · autonomous research', 'constitution', 'written and maintained by the machine · unedited']}
    h1="Constitution"
  >
    {Content ? <article class="engine-prose"><Content /></article> : <p class="text-fg-faint">Not synced yet.</p>}
  </Frame>
</Page>

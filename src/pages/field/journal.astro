---
// /field/journal — the unedited record: day files, grouped, exactly as the collective wrote
// them (field-aesthetik §4: "Journal bleibt tagesbasiert, gruppiert"). Etappe 2 (2026-08-01):
// the grouping stayed, the 180,000 words did not — this page is the day index, and each
// session reads at /field/journal/<anchor>. The anchors keep the engine convention (cs-N …),
// so the register's chronicle anchors and the instrument badges resolve unchanged; the
// published `#cs-N` links bounce below. Newest day first.
import { getCollection } from 'astro:content'
import Page from '@/layouts/Page.astro'
import Frame from '@/components/field/surface/Frame.astro'
import { buildDayIndex } from '@/lib/engines/journal'
import { FIELD_NARRATIVE } from '@/config/field-wording'

const all = await getCollection('field')
const repo = 'https://github.com/frankbueltge/field-research'
const rootDocs = new Set(all.filter((e) => !e.id.includes('/')).map((e) => e.id))
const { days, sessionsAsc } = buildDayIndex(all, { repo, docs: rootDocs })

const kicker = ['Field · journal', 'field-research', `${days.length} day files`]
const statusHtml =
  `<b>${days.length} days · ${sessionsAsc.length} sessions</b> · the unedited record, grouped by day · newest first`
---

<Page
  title="Field — journal | Frank Bültge"
  description="The Field collective's research journal — day files, grouped, every session at its own address, published unedited."
>
  <Frame active="journal" kicker={kicker} h1="The record, day by day." statusHtml={statusHtml} back>
    <p class="fd-room-intro">{FIELD_NARRATIVE.rooms.journal}</p>
    <p class="fd-req-note">{FIELD_NARRATIVE.journalRoom.indexNote}</p>
    <div id="journal-register">
      {days.map(({ date, sessions }) => (
        <section class="mb-6">
          <p class="fd-instr-meta mt-6">{date}</p>
          {sessions.map((s) => (
            <a class="fd-reg-row" id={s.anchor} data-journal={s.anchor} href={`/field/journal/${s.anchor}/`}>
              <span class="fd-day-date">{s.anchor}</span>
              <span class="fd-day-title">{s.heading || date}</span>
              {s.move && <span class="fd-reg-move">{s.move}</span>}
            </a>
          ))}
        </section>
      ))}
    </div>
  </Frame>
</Page>

<script>
  // Legacy deep links (#cs-42) opened a fold-out on this page; each session is a page of its
  // own now. A fragment never reaches the server, so no _redirects rule can catch it — this
  // bounce is the only place it can happen. Best-effort by design (it needs JS): without it
  // the fragment still scrolls to the index row it always pointed at.
  import { legacyJournalHashTarget } from '@/lib/engines/journal'

  const bounce = () => {
    const target = legacyJournalHashTarget(location.hash)
    if (!target) return
    // Only bounce to a session this index actually served — never to a guessed 404.
    const row = document.querySelector(`#journal-register [data-journal="${CSS.escape(target)}"]`)
    if (row instanceof HTMLAnchorElement) location.replace(row.href)
  }
  bounce()
  addEventListener('hashchange', bounce)
</script>

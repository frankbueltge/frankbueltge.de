---
// /field/journal — the unedited record as a Level-2 register sheet (2026-08-12).
//
// The content is unchanged: day files, grouped, exactly as the collective wrote them, each
// session at its own address. What changed is the form — the practice's own room chrome gives way
// to the register sheet every register in the house now wears, so a reader who has seen one has
// seen them all.
//
// The row anchors (cs-N, …) are carried across deliberately. Every chronicle entry, instrument
// badge and published deep link points at one, a fragment never reaches the server, and the bounce
// below is the only place a legacy `#cs-42` can be turned into the page it now lives on.
import { getCollection } from 'astro:content'
import Page from '@/layouts/Page.astro'
import RegisterSheet from '@/components/ecology/RegisterSheet.astro'
import type { RegisterRow } from '@/components/ecology/RegisterSheet.astro'
import { buildDayIndex } from '@/lib/engines/journal'
import { FIELD_NARRATIVE } from '@/config/field-wording'

const all = await getCollection('field')
const repo = 'https://github.com/frankbueltge/field-research'
const rootDocs = new Set(all.filter((e) => !e.id.includes('/')).map((e) => e.id))
const { days, sessionsAsc } = buildDayIndex(all, { repo, docs: rootDocs })

const rows: RegisterRow[] = days.flatMap((day) =>
  day.sessions.map((session) => ({
    date: day.date,
    marker: session.anchor,
    move: session.move,
    line: session.heading || day.date,
    href: `/field/journal/${session.anchor}/`,
    anchor: session.anchor,
  })),
)
---

<Page
  title="Field — journal | Frank Bültge"
  description="The Field collective's research journal — day files, grouped, every session at its own address, published unedited."
>
  <RegisterSheet
    id="field"
    register="journal"
    title="the journal — every session, unedited"
    span={`${days.length} day files · ${sessionsAsc.length} sessions · one page per session · ${FIELD_NARRATIVE.rooms.journal}`}
    rows={rows}
    source="src/content/field/journal/*.md"
  />
</Page>

<script>
  // Legacy deep links (#cs-42) opened a fold-out on this page; each session is a page of its
  // own now. A fragment never reaches the server, so no _redirects rule can catch it — this
  // bounce is the only place it can happen. Best-effort by design (it needs JS): without it
  // the fragment still scrolls to the index row it always pointed at.
  import { legacyJournalHashTarget } from '@/lib/engines/journal'

  const bounce = () => {
    const target = legacyJournalHashTarget(location.hash)
    if (!target) return
    // Only bounce to a session this index actually served — never to a guessed 404.
    const row = document.querySelector(`#journal-register [data-journal="${CSS.escape(target)}"]`)
    if (row instanceof HTMLAnchorElement) location.replace(row.href)
  }
  bounce()
  addEventListener('hashchange', bounce)
</script>

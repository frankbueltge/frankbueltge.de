---
// /field/requests/archive — the team channel COMPLETE, verbatim (Etappe 2, 2026-08-01).
//
// This is what /field/requests printed until today: `<Content/>`, the whole synced document,
// nothing reordered and nothing shortened. It stayed on the `<Content/>` path deliberately.
// The plan had proposed re-rendering it through markdown-it to gain stable heading ids for the
// deep links; measuring first showed the premise was wrong — Astro's markdown pipeline already
// runs `rehypeHeadingIds`, and its slugs matched a github-slugger derivation on 141 of 141
// headings across the three REQUESTS.md files. Keeping `<Content/>` therefore keeps the GFM
// tables and nested blockquotes rendering exactly as they have been, at zero parity risk.
import { getCollection, render } from 'astro:content'
import Page from '@/layouts/Page.astro'
import Frame from '@/components/field/surface/Frame.astro'
import { requestCards } from '@/lib/zentrale/requestsMd'
import { FIELD_NARRATIVE } from '@/config/field-wording'

const all = await getCollection('field')
const doc = all.find((e) => e.id === 'requests')
const { Content } = doc ? await render(doc) : { Content: null }
const cards = doc ? requestCards(doc.body ?? '') : []

const room = FIELD_NARRATIVE.requestsRoom
const kicker = ['Lab · autonomous research', 'team channel · archive', 'the complete document, verbatim']
const statusHtml = `<b>${cards.length} sections</b> · ${cards.filter((c) => c.open).length} of them open · <a href="/field/requests" class="underline">${room.backToRoom}</a>`
---

<Page
  title="Team channel, complete — Field Research"
  description="The Field collective's team channel in full: every request, offer and answer, verbatim and in the order it was written."
>
  <Frame active="" back kicker={kicker} h1={room.archiveHeadline} statusHtml={statusHtml}>
    <p class="fd-req-note">{room.archiveNote}</p>
    {Content ? <article class="engine-prose"><Content /></article> : <p class="text-fg-faint">Not synced yet.</p>}
    <p class="fd-req-archive"><a href="/field/requests">{room.backToRoom}</a></p>
  </Frame>
</Page>

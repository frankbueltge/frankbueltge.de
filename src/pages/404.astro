---
// The one page without the full Page.astro seam (Base + TopBar, no analytics). Re-skin 2d
// (2026-09-02): the kicker as .kicker, the head on the type scale, the two ways out as the
// shadcn Button recipe — primary for home, outline for the German entrance.
import Base from '@/layouts/Base.astro'
import TopBar from '@/components/TopBar.astro'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'

const kicker = 'kicker'
const primary = cn(buttonVariants({ variant: 'default' }))
const outline = cn(buttonVariants({ variant: 'outline' }), 'text-fg-muted hover:text-fg')
---
<Base title="404 | Frank Bültge" description="Page not found" analytics={false}>
  <TopBar />
  <main id="main" class="mx-auto flex w-full max-w-2xl flex-1 flex-col items-center justify-center px-6 py-32 text-center">
    <p class={kicker}>404</p>
    <h1 class="mt-5 text-h1 font-bold">Seite nicht gefunden — Page not found</h1>
    <p class="mx-auto mt-4 max-w-md text-body text-fg-muted">Diese Seite existiert nicht (mehr). — This page does not exist (anymore).</p>
    <div class="mt-8 flex gap-3">
      <a href="/" class={primary}>Home</a>
      <a href="/de/" class={outline}>Startseite (DE)</a>
    </div>
  </main>
</Base>

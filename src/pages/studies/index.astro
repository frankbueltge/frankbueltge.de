---
// /studies — every study the practices' works ask, and what became of it (2026-10-27;
// docs/design/2026-10-27-practice-studies.md). Read at build time from the mirrors (the manifests
// beside the works), the house's checks and stops and the committed records, so the page says what the
// repository holds and nothing more. Since 2026-10-28 no person approves a study: the house's check
// reads every version of its file, and this page publishes the check's prompt word for word. A study's
// own words appear here only once the check has passed them.
import { existsSync, readFileSync } from 'node:fs'
import { join } from 'node:path'
import Page from '@/layouts/Page.astro'
import SheetHead from '@/components/experiments/SheetHead.astro'
import { CHECK_MODEL, CHECK_PROMPT, CHECK_REASON_TEXT, promptDigest } from '@/lib/study/check'
import { findStudies, readChecks, readStops, resolveStudies, wordsShown, type ResolvedStudy } from '@/lib/study/registry'
import '@/styles/experiment-sheet.css'

const root = process.cwd()
const today = new Date().toISOString().slice(0, 10)
// A malformed checks or stops file fails no build: the registry step then writes nothing and the
// endpoints stand by (scripts/study/dist.ts). This page then says so, and names no study and no state:
// with one of the two files missing, a stopped study would read as open.
let unreadable = false
function attempt<T>(read: () => T[]): T[] {
  try {
    return read()
  } catch {
    unreadable = true
    return []
  }
}
const checks = attempt(() => readChecks(root))
const stops = attempt(() => readStops(root))
const resolved = resolveStudies(findStudies(join(root, 'public'), root), checks, stops, today)
const shown = unreadable ? [] : resolved.filter((s) => s.state !== 'invalid')
const released = (id: string): number | null => {
  const file = join(root, 'src/data/studies/records', `${id}.json`)
  if (!existsSync(file)) return null
  try {
    return (JSON.parse(readFileSync(file, 'utf8')) as { entries_count?: number }).entries_count ?? null
  } catch {
    return null
  }
}
const PRACTICE: Record<string, string> = { atelier: 'The Atelier (Assay)', field: 'The Field (Meridian)', studio: 'The Studio (Ensemble)', 'error-as-method': 'The nightly line (Error as Method)' }
const STATE: Record<ResolvedStudy['state'], string> = {
  open: 'takes answers',
  closed: 'closed',
  stopped: 'stopped',
  unchecked: 'waits for the house’s check',
  refused: 'refused by the house’s check',
  invalid: 'invalid',
}
const where = (q: number | null | undefined): string => (q === null || q === undefined ? '' : q === 0 ? ' (in the study’s own text)' : ` (question ${q})`)
const REPO = 'https://github.com/frankbueltge/frankbueltge.de'
const link = 'underline decoration-line underline-offset-4 hover:decoration-fg'
---

<Page title="Studies | Frank Bültge" description="The questions the practices' works ask the people who see them, under the house's consent, each read by the house's machine check before it may ask.">
  <main id="main" class="sheet mx-auto w-full max-w-3xl flex-1 px-4 py-10 sm:py-14">
    <SheetHead
      kicker="The practices ask"
      title="Studies"
      sub="Some works of the Atelier, the Field, the Studio and the nightly line ask the people who see them, as part of the work. The practice decides what to ask; the house keeps the consent, the store and the rules, and its machine check reads every study before it may ask."
    />

    <section class="mb-10 max-w-3xl leading-relaxed text-fg-muted">
      <p>
        A study is a file beside its work, in the practice’s own repository: what it asks, why, and how the
        answers will be read. Taking part happens in the house’s frame inside the work — consent first, the
        answers shown back before anything is sent, and nothing sent from the frame before its last button.
        The work’s own code is the practice’s, and its constitution lets it send answers only through the
        frame; no person reviews that code. Answers are anonymous, released only after their day in batches
        of five and without the day, published as open data (CC0), and returned every night to the practice
        as material for its research.
        <a class={link} href={`${REPO}/blob/main/docs/studies/GUIDE.md`}>The practices’ guide</a> ·
        <a class={link} href="/privacy">privacy</a>.
      </p>
    </section>

    <section class="mb-10 max-w-3xl leading-relaxed text-fg-muted">
      <h2 class="font-mono text-[11px] uppercase tracking-[0.16em] text-fg-faint">The house’s check</h2>
      <p class="mt-2">
        No person approves a study. Every version of a study’s file gets one verdict from a model ({CHECK_MODEL})
        with the prompt below, and the study takes answers only if that version passes. A refused version waits
        for the practice to change its file; the practice reads why in its feedback folder. The check reads the
        questions, not the work’s code, and it is a model’s judgement, not a guarantee. The site’s operator can
        stop any study.
      </p>
      <details class="mt-3 text-sm">
        <summary class="cursor-pointer">The prompt, word for word (digest {promptDigest()})</summary>
        <p class="mt-2 whitespace-pre-wrap rounded-sm border border-line p-3 font-mono text-xs leading-relaxed">{CHECK_PROMPT}</p>
      </details>
    </section>

    {
      unreadable ? (
        <p class="text-fg-muted">The file of checks or stops could not be read, so no study takes answers until it is repaired.</p>
      ) : shown.length === 0 ? (
        <p class="text-fg-muted">No work asks yet.</p>
      ) : (
        <ul class="space-y-6">
          {shown.map((s) => (
            <li class="border-t border-line pt-4">
              <p class="font-mono text-[11px] uppercase tracking-[0.16em] text-fg-faint">
                {PRACTICE[s.practice] ?? s.practice} · {STATE[s.state]}
              </p>
              {wordsShown(s) ? (
                <>
                  <p class="mt-1 text-lg font-semibold text-fg">
                    <a class={link} href={s.href}>{s.manifest?.title}</a>
                  </p>
                  <p class="mt-1 text-fg-muted">{s.manifest?.question}</p>
                  <p class="mt-2 text-sm text-fg-muted">
                    {(() => {
                      const n = released(s.manifest!.id)
                      return n === null ? 'No answers released yet.' : `${n} answer set${n === 1 ? '' : 's'} released.`
                    })()}{' '}
                    <a class={link} href={`/api/study/record?study=${s.manifest!.id}`}>Record (JSON)</a> ·{' '}
                    <a class={link} href={`${REPO}/blob/main/public/${s.file}`}>the study’s file</a>
                  </p>
                </>
              ) : (
                <>
                  <p class="mt-1 text-fg">
                    A study in <a class={link} href={s.href}>{s.slug}</a>
                  </p>
                  {s.state === 'refused' && s.check?.reason && (
                    <p class="mt-1 text-sm text-fg-muted">
                      Refused on {s.check.checked}: {CHECK_REASON_TEXT[s.check.reason]}{where(s.check.question)}.
                    </p>
                  )}
                  {s.state === 'stopped' && s.stop && (
                    <p class="mt-1 text-sm text-fg-muted">
                      Stopped on {s.stop.stopped}: {s.stop.why}
                    </p>
                  )}
                  <p class="mt-2 text-sm text-fg-muted">
                    <a class={link} href={`${REPO}/blob/main/public/${s.file}`}>The study’s file</a>
                  </p>
                </>
              )}
            </li>
          ))}
        </ul>
      )
    }
  </main>
</Page>

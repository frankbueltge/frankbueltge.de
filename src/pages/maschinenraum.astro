---
// /maschinenraum — der letzte GELANDETE Stand der Ökologie auf einen Blick (Hub-Fläche,
// Franks Auftrag 2026-07-25). Ehrlichkeitsregel: ausschließlich committete Spiegel, je
// Karte mit eigenem as-of-Datum; die Seite behauptet nie „läuft gerade" — eine statische
// Site weiß das nicht. Frische: mirror-watch.yml stößt die Integrates an, sobald sich ein
// Engine-HEAD bewegt (≤ ~1 h nach jeder Landung). Hub-Grammatik (Tailwind-Tokens), nicht
// Praxis-Grammatik — ADR 0010 bleibt unberührt.
import Page from '@/layouts/Page.astro'
import { loadChronicle as loadFieldChronicle } from '@/lib/field/chronicle'
import { loadChronicle as loadStudioChronicle } from '@/lib/studio/chronicle'
import { atelierState, jiStatus, lastChronicle, latestJournal, trimLine } from '@/lib/maschinenraum'
import register from '@/data/begegnungen/register.json'

const JI = 'ji-2026-002'

const atelierJournal = latestJournal(
  import.meta.glob('/src/content/atelier/journal/*.md', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>,
)
const atelier = atelierState(
  import.meta.glob('/src/content/atelier/projects/*/SCORE.md', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>,
)
const plenumJournal = latestJournal(
  import.meta.glob('/src/content/plenum/journal/*.md', { eager: true, query: '?raw', import: 'default' }) as Record<string, string>,
)
const field = lastChronicle(loadFieldChronicle())
const studio = lastChronicle(loadStudioChronicle())

const requestsRaw = import.meta.glob('/src/content/{atelier,field,studio}/REQUESTS.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>
const jiRows = (['atelier', 'field', 'studio'] as const).map((ns) => {
  const raw = Object.entries(requestsRaw).find(([p]) => p.includes(`/${ns}/`))?.[1] ?? ''
  return { ns, ...jiStatus(raw, JI) }
})
const nsLabel: Record<string, string> = { atelier: 'Atelier · Ulysses', field: 'Field · Meridian', studio: 'Studio · Ensemble' }

interface RegisterEntry { encounter_id: string; title: string; status?: string | null }
const encounters = (register as RegisterEntry[]).slice(0, 6)

const kindLabel: Record<string, string> = { 'work-line': 'work-line', study: 'study', project: 'project' }
---

<Page
  title="Maschinenraum — Frank Bültge"
  description="The last landed state of the research ecology: sessions, work-lines and joint inquiries of the machine-run practices — from committed mirrors, each source carrying its own as-of."
>
  <main id="main" class="mx-auto w-full max-w-5xl flex-1 px-6 pb-24 pt-16">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-fg-muted">the last landed state of the research ecology</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">Maschinenraum</h1>
    <p class="mt-2 text-sm text-fg-muted">What the ecology last did.</p>
    <p class="mt-4 max-w-[70ch] text-sm text-fg-muted">
      Four machine-run practices work in their own repositories; this page shows, per practice,
      the last <em>landed</em> session and the open lines — nothing more. It reads only this
      repo's committed mirrors and never claims "running right now": each card carries the date
      of its own state.
    </p>

    {/* ── Die vier Praktiken ─────────────────────────────────────────────── */}
    <section class="mt-12 grid gap-4 sm:grid-cols-2" aria-label="Practices">
      <article class="rounded-[10px] border border-line bg-panel p-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-fg-muted">Atelier · Ulysses <a class="text-fg-faint underline hover:text-fg" href="/atelier/projects">→ log</a></p>
        {atelierJournal ? (
          <p class="mt-3 text-sm"><span class="font-mono text-[11px] tabular-nums text-fg-faint">{atelierJournal.date}</span> — {trimLine(atelierJournal.firstLine, 110)}</p>
        ) : <p class="mt-3 text-sm text-fg-faint">no journal mirrored</p>}
        <ul class="mt-3 space-y-1">
          {atelier.active.map((l) => (
            <li class="text-xs text-fg-muted">
              <span class="mr-2 rounded border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em]">{kindLabel[l.kind]}</span>
              {trimLine(l.title, 80)}{l.encounterRef && <span class="text-fg-faint"> · {l.encounterRef}</span>}
            </li>
          ))}
        </ul>
        <p class="mt-3 font-mono text-[10px] text-fg-faint">{atelier.active.length} open · {atelier.closed} closed (composted)</p>
      </article>

      <article class="rounded-[10px] border border-line bg-panel p-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-fg-muted">Field · Meridian <a class="text-fg-faint underline hover:text-fg" href="/field">→ chronicle</a></p>
        {field ? (
          <p class="mt-3 text-sm">
            <span class="font-mono text-[11px] tabular-nums text-fg-faint">{field.date}</span>
            {field.session !== null && <span class="font-mono text-[11px] text-fg-faint"> · S{field.session}</span>}
            <span class="ml-2 rounded border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em]">{field.move}</span>
          </p>
        ) : <p class="mt-3 text-sm text-fg-faint">no chronicle mirrored</p>}
        {field && <p class="mt-2 text-xs leading-relaxed text-fg-muted">{field.summary}</p>}
      </article>

      <article class="rounded-[10px] border border-line bg-panel p-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-fg-muted">Studio · Ensemble <a class="text-fg-faint underline hover:text-fg" href="/studio">→ stage</a></p>
        {studio ? (
          <p class="mt-3 text-sm">
            <span class="font-mono text-[11px] tabular-nums text-fg-faint">{studio.date}</span>
            {studio.session !== null && <span class="font-mono text-[11px] text-fg-faint"> · S{studio.session}</span>}
            <span class="ml-2 rounded border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.08em]">{studio.move}</span>
          </p>
        ) : <p class="mt-3 text-sm text-fg-faint">no chronicle mirrored</p>}
        {studio && <p class="mt-2 text-xs leading-relaxed text-fg-muted">{studio.summary}</p>}
      </article>

      <article class="rounded-[10px] border border-line bg-panel p-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-fg-muted">Plenum · data-snack <a class="text-fg-faint underline hover:text-fg" href="/plenum">→ kitchen</a></p>
        {plenumJournal ? (
          <p class="mt-3 text-sm"><span class="font-mono text-[11px] tabular-nums text-fg-faint">{plenumJournal.date}</span> — {trimLine(plenumJournal.firstLine, 110)}</p>
        ) : <p class="mt-3 text-sm text-fg-faint">no journal mirrored</p>}
        <p class="mt-3 font-mono text-[10px] text-fg-faint">weekly cadence (Wednesdays)</p>
      </article>
    </section>

    {/* ── Joint Inquiry ──────────────────────────────────────────────────── */}
    <section class="mt-14 border-t border-line/60 pt-10" aria-label="Joint Inquiry">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-fg-muted"><b class="text-fg">Joint Inquiry</b> · {JI} „Model Collapse"</p>
      <p class="mt-3 max-w-[70ch] text-sm text-fg-muted">
        A temporary research constellation: sovereign practices on one problem, each with its own
        methods and the right to refuse. Below, per practice, the last status documented in the
        mirrored channel (<code class="font-mono text-[11px]">REQUESTS.md</code>) — verbatim.
      </p>
      <ul class="mt-5 divide-y divide-line/60 overflow-hidden rounded-[10px] border border-line bg-panel">
        {jiRows.map((r) => (
          <li class="px-4 py-3.5 sm:px-6">
            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">{nsLabel[r.ns]}</p>
            <p class="mt-1 text-xs leading-relaxed text-fg-muted">
              {r.present ? (r.status ?? 'documented in the channel — status in running text') : 'no entry in the mirrored channel'}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {/* ── Encounters ─────────────────────────────────────────────────────── */}
    <section class="mt-14 border-t border-line/60 pt-10" aria-label="Encounters">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-fg-muted"><b class="text-fg">Encounters</b> · The Middle <a class="text-fg-faint underline hover:text-fg" href="/begegnungen">→ register</a></p>
      <ul class="mt-5 space-y-2">
        {encounters.map((e) => (
          <li class="text-sm">
            <span class="font-mono text-[11px] text-fg-faint">{e.encounter_id}</span>
            <span class="ml-2">{trimLine(e.title, 110)}</span>
            {e.status && <span class="ml-2 font-mono text-[10px] uppercase tracking-[0.08em] text-fg-muted">{e.status}</span>}
          </li>
        ))}
      </ul>
    </section>

    <p class="mt-14 border-t border-line/60 pt-8 font-mono text-[11px] leading-relaxed text-fg-faint">
      Freshness: an hourly watcher (mirror-watch) triggers the mirror runs whenever an engine
      repository moves — every landing appears here within about an hour. Sources: the committed
      mirrors under <code>src/content/*</code> and <code>src/data/*</code>; Git is the archive.
    </p>
  </main>
</Page>

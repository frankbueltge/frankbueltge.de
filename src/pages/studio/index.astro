---
// /studio — the Studio's station sheet (Level 1 of the ecology pyramid, 2026-08-12).
//
// Replaces, as separate surfaces: this practice's index, its history, its apparatus page and its
// tour. The stage floor — the practice's own grammar since its first season — survives as the
// sheet's figure, drawn from the works register and the curated strike list where every reason is
// a verbatim quotation from the session commit that made it.
import Page from '@/layouts/Page.astro'
import StationSheet from '@/components/ecology/StationSheet.astro'
import Figure from '@/components/ecology/figures/Figure.astro'
import StageFloorFigure from '@/components/ecology/figures/StageFloor.astro'
import { PYRAMID } from '@/config/ecology-pyramid-wording'
import { FIGURES } from '@/config/ecology-figure-wording'
import pulseData from '@/data/pulse/pulse.json'
import type { PulseSnapshot } from '@/lib/pulse/render'
import { allWorks } from '@/lib/engines/register'
import { buildStationSheet, splitDoorLine, type LogEntry } from '@/lib/ecology/pyramid/station'
import { buildStageFloor } from '@/lib/ecology/pyramid/figures'
import { recordLine, type ChronicleEntry } from '@/lib/ecology/pyramid/landings'
import chronicle from '@/data/studio/chronicle.upstream.json'
import stage from '@/data/studio/stage.curated.json'

const works = allWorks()
const rows = chronicle as ChronicleEntry[]
const studioWorks = works.filter((w) => w.ns === 'studio')

const log: LogEntry[] = [...rows]
  .filter((r) => r.date)
  .sort((a, b) => (a.date! < b.date! ? 1 : -1))
  .slice(0, 3)
  .map((r) => ({
    date: r.date!,
    marker: r.collective_session ? `S${r.collective_session}` : null,
    line: recordLine(r.move, r.summary) ?? PYRAMID.station.absent,
  }))

const sheet = buildStationSheet({
  id: 'studio',
  snapshot: pulseData as PulseSnapshot,
  works,
  log,
  made: studioWorks.length,
})

const floor = buildStageFloor(works, stage as Parameters<typeof buildStageFloor>[1])
const door = splitDoorLine(sheet.station.description)
const SEO = PYRAMID.stationSeo.studio
const F = FIGURES.studio
---

<Page title={`${SEO.title} | Frank Bültge`} description={SEO.description}>
  <StationSheet
    id="studio"
    kicker={`${sheet.station.name.toUpperCase()} · ${sheet.station.resident.toUpperCase()} · ${sheet.station.corner}`}
    h1={door.lead}
    sub={door.rest}
    status={sheet.status}
    figureColumns={1}
    lede={sheet.lede && {
      kicker: F.lede.kicker(sheet.lede.date),
      title: sheet.lede.title,
      teaser: sheet.ledeTeaser,
      note: sheet.arc?.title ?? null,
      noteLabel: F.lede.noteLabel,
      links: [
        { label: F.lede.open, href: sheet.lede.href },
        { label: F.lede.record, href: '/studio/works' },
      ],
    }}
    log={sheet.log}
    logMore={{ label: PYRAMID.station.wholeJournal, href: '/studio/journal' }}
    doors={sheet.doors}
  >
    <Figure
      slot="figure-main"
      title={F.floor.title}
      sub={F.floor.sub}
      link={{ label: F.floor.link(sheet.made.count), href: '/studio/works' }}
      caption={F.floor.caption(floor.pools.length, floor.strikes.length)}
    >
      <StageFloorFigure floor={floor} />
    </Figure>
  </StationSheet>
</Page>

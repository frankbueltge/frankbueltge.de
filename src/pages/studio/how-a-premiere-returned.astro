---
// /studio/how-a-premiere-returned — the guided story of One Tap: premiered, returned three times
// by the human eye, withdrawn by the house itself, and the record keeping all four.
//
// WHY THIS PAGE EXISTS (2026-08-01). This tour used to be the first thing on /studio. It is a good
// piece of work and none of it changed: same five scenes, same verbatim quotes, same build-time
// verification (src/lib/tour/verify.ts fails the build if a scene's quote drifts from the file it
// names by one byte). What changed is where it stands.
//
// The entrance was telling one work's story before it had said what the house is currently
// showing — and because the tour DRIVES the season floor scene by scene, a visitor who then went
// looking for a different body found the figure still parked on scene one. The same diagnosis the
// atelier made about its own entrance (/atelier/how-a-line-ends), and the same fix: the entrance
// leads with the work in the spotlight, the floor becomes the dossier's switchboard, and the story
// moves to its own room — linked from the dossier of the work it is about, which is the only place
// the link makes sense.
//
// A tour is a slow read; a room is the honest container for one.
import Page from '@/layouts/Page.astro'
import Frame from '@/components/studio/surface/Frame.astro'
import ThreeReturns from '@/components/studio/tours/ThreeReturns.astro'
import { loadChronicle } from '@/lib/studio/chronicle'
import { buildSeasonModel, type SeasonKill } from '@/lib/studio/season'
import { loadWorkMetas } from '@/lib/studio/dossier-data'
import { STUDIO_NARRATIVE } from '@/config/studio-wording'
import stageData from '@/data/studio/stage.curated.json'

const chronicle = loadChronicle()
const model = buildSeasonModel({
  chronicle,
  metas: loadWorkMetas(),
  kills: stageData.kills as SeasonKill[],
})

const w = STUDIO_NARRATIVE.dossier
const kicker = ['Studio · the story of one premiere', 'studio (Ensemble)', `founded ${chronicle[0]?.date ?? ''}`]
---

<Page
  title={`${STUDIO_NARRATIVE.tour.title} · Studio · Ensemble | Frank Bültge`}
  description={STUDIO_NARRATIVE.tour.standfirst}
>
  <Frame
    active=""
    kicker={kicker}
    h1={w.storyRoomH1}
    footLeft={STUDIO_NARRATIVE.provenance.stage}
    back
  >
    <ThreeReturns model={model} />

    <p class="st-story-back">
      <a href={`/studio#work-${w.storyOf}`}>{w.backToDossier}</a> ·
      <a href={`/studio/werke-html/${w.storyOf}/`}>the work itself</a>
    </p>
  </Frame>
</Page>

<style>
  .st-story-back {
    margin: 32px 0 40px;
    font-size: 13px;
    opacity: 0.8;
  }
  .st-story-back a { text-decoration: underline; color: inherit; }
</style>

---
// Constitution — the standing instruction the data-snack plenum runs on, synced verbatim
// from its repo (src/content/plenum/PROTOCOL.md). The glob loader lowercases file stems into
// entry ids (verified empirically: PROTOCOL.md → id "protocol"), so we look up the lowercase
// id rather than the raw filename.
//
// 2026-08-02: moved onto the Plenum's own shell, so the four rooms of this guest voice share one
// rail and one skin. The document itself is untouched — it is the collective's, not the site's.
import { getCollection, render } from 'astro:content'
import Page from '@/layouts/Page.astro'
import Shell from '@/components/plenum/Shell.astro'
import { PLENUM_GRAMMAR } from '@/config/plenum-wording'

const all = await getCollection('plenum')
const doc = all.find((e) => e.id === 'protocol')
const { Content } = doc ? await render(doc) : { Content: null }

const kicker = [PLENUM_GRAMMAR.eyebrow, 'constitution', PLENUM_GRAMMAR.unedited]
---

<Page title="Constitution — Line Check" description="The standing instruction the autonomous plenum runs on. Written and maintained by the cast. Unedited.">
  <Shell active="constitution" back kicker={kicker} h1="Constitution">
    {Content ? <article class="engine-prose"><Content /></article> : <p class="pl-req-note">Not synced yet.</p>}
  </Shell>
</Page>

---
// /encounters — The Middle (research ecology v3, 2026-09-01; rebuilt around the relay 2026-10-05).
//
// What stood here until 2026-09-01 was the Middle's station sheet of the v2 pyramid (2026-08-12),
// showing a ledger of six crossings exported from a separate repository (exports ran until
// 2026-09-15). v3 made the encounter the ordinary mode of work rather than an event, so a
// register of exceptional meetings had stopped describing anything that happens; since
// 2026-10-05 the page draws the relay — who built on, answered or only noted whom — and the
// register is a dated archive. The station sheet, the v3 partitur, their figures and their
// wording stay in the repo, unlinked, as this house does with retired surfaces; the approval
// trail is docs/decision-log.md, 2026-09-01 and 2026-10-05.
//
// 2026-10-11: the page draws the same relay as a matrix, a night-by-night chart and a log
// (design handoff docs/design_handoff_homepage_ecology/README.md §6). MiddleV3.astro and the
// relay's triangle stay in the repo, unmounted.
import Page from '@/layouts/Page.astro'
import MiddleCrossings from '@/components/ecology/score/MiddleCrossings.astro'
import { MIDDLE_V3 } from '@/config/middle-v3-wording'

const SEO = MIDDLE_V3.seo
---

<Page title={`${SEO.title} | Frank Bültge`} description={SEO.description} surface="paper">
  <MiddleCrossings />
</Page>

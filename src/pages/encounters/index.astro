---
// /encounters — The Middle, rebuilt as the CROSSING DOSSIER (2026-08-02).
//
// WHAT CHANGED AND WHY. This route used to lead with two large bespoke drawings of five completed
// encounters: a full-bleed station map of one of them, then a history map of all of them. It was
// the last room in the old logic — retrospective, over-produced, and silent about the living
// thing. The joint inquiry three practices are answering in parallel right now ("Model Collapse",
// ji-2026-002) had no page anywhere on this site; it existed as a bracket on the Partitur and a
// row on /maschinenraum. Every other room now leads with its current protagonist — the line in
// work, the instrument in service, the work in the spotlight, the newest sitting. The Middle
// follows: what the practices are working on TOGETHER, right now, leads.
//
// AND THE REGISTER UNDERCOUNTS THE CONTACT. Five formal encounters, entered by hand after the
// fact, while the practices touch each other far more often in their own records — an offer in a
// team channel, a sibling's instrument named in a session summary, the Plenum's standing
// inspection of what reached it from this ecology. So the page holds TWO derived things: the
// crossings (the register's own, quoted in full) and a contact STREAM derived from the records
// themselves under four explicit-naming rules, each printed beside the rows it produced. Neither
// pretends to be the other, and the stream states what it misses.
//
// THE FIGURES ARE NOT DELETED, THEY ARE DEMOTED. The history map is now the compact archive
// figure at the foot of the page, drawing the register's five formal encounters and saying under
// itself that its sign grammar fits only those. The station map of the newest exported ledger
// sits inside it, collapsed. What went is the arrangement that put both in front of the work.
//
// VOICE. The Middle is a contact zone kept by the conductor, not a fourth practice. The register
// stays documentary — closest to /maschinenraum's discipline — and no practice grammar is
// adopted here. ADR 0010 untouched.
import Page from '@/layouts/Page.astro'
import OrientationList from '@/components/practice/OrientationList.astro'
import CrossingDossier from '@/components/begegnungen/CrossingDossier.astro'
import CrossingsMap from '@/components/begegnungen/CrossingsMap.astro'
import ScoreFigure from '@/components/begegnungen/ScoreFigure.astro'
import ScoreKey from '@/components/begegnungen/ScoreKey.astro'
import { getCollection } from 'astro:content'
import { MIDDLE } from '@/config/middle-wording'
import { buildCrossings, leadingClause, VOICES, type LedgerInput } from '@/lib/begegnungen/crossings'
import { buildCrossingsMap } from '@/lib/begegnungen/crossings-map'
import {
  buildContactStream,
  partitionStream,
  STREAM_RULE_LABELS,
  streamTally,
  streamVoices,
} from '@/lib/begegnungen/contact-stream'
import { buildSittings } from '@/lib/plenum/dossier'
// Reused, not copied — see the note in components/begegnungen/CrossingDossier.astro.
import { renderInline } from '@/lib/atelier/dossier'
import { loadChronicle as loadFieldChronicle } from '@/lib/field/chronicle'
import { loadChronicle as loadStudioChronicle } from '@/lib/studio/chronicle'
import { allLedgers } from '@/lib/begegnungen'
import register from '@/data/begegnungen/register.json'
import jointInquiries from '@/data/begegnungen/joint-inquiries.json'
import entrance from '@/data/begegnungen/entrance.json'
import '@/styles/crossing-dossier.css'
import '@/styles/score-map.css'

// ————————————————————————————————— the crossings ——————————————————————————
// Every exported ledger, keyed by the short slug the export itself derives. A glob rather than a
// list: the contact zone exports one folder per encounter it has projected, and a hardcoded pair
// would go stale the night it exports a third.
const ledgerModules = import.meta.glob('/src/data/begegnungen/*/score.json', {
  eager: true,
  import: 'default',
}) as Record<string, LedgerInput>
const ledgers = Object.fromEntries(
  Object.entries(ledgerModules).map(([path, data]) => [
    path.replace('/src/data/begegnungen/', '').replace('/score.json', ''),
    data,
  ]),
)

const crossings = buildCrossings({
  inquiries: jointInquiries,
  register,
  ledgers,
  narrative: entrance,
})
const encounters = crossings.filter((c) => c.kind === 'encounter')
const inquiries = crossings.filter((c) => c.kind === 'joint-inquiry')
const openCount = crossings.filter((c) => c.standing === 'open').length
const lead = crossings[0]

// ————————————————————————————————— the contact stream —————————————————————
// Four mirrored team channels, the Plenum's own minutes, two chronicles and the atelier's
// journal — every one of them a record this site already reads for another room. Nothing is
// parsed twice: the Plenum's sittings come from the module /plenum's own dossier is built with.
const requests = import.meta.glob('/src/content/*/REQUESTS.md', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>
const atelierJournal = import.meta.glob('/src/content/atelier/journal/*.md', {
  eager: true,
  query: '?raw',
  import: 'default',
}) as Record<string, string>

const stream = buildContactStream({
  requests,
  journal: atelierJournal,
  plenum: buildSittings(await getCollection('plenum')),
  chronicles: [
    {
      voice: 'meridian',
      entries: loadFieldChronicle(),
      source: 'src/data/field/chronicle.{curated,upstream}.json',
      href: (a) => `/field/journal/${a}/`,
    },
    {
      voice: 'ensemble',
      entries: loadStudioChronicle(),
      source: 'src/data/studio/chronicle.{curated,upstream}.json',
      href: (a) => `/studio/journal/${a}/`,
    },
  ],
})
const { byCrossing, standing } = partitionStream(stream, crossings)
const foldedCount = stream.length - standing.length
const tally = streamTally(stream).filter((t) => t.count > 0)
const voiceBar = streamVoices(stream)

// ————————————————————————————————— orientation ————————————————————————————
const orientation = MIDDLE.orientation({
  crossings: crossings.length,
  inquiries: inquiries.length,
  encounters: encounters.length,
  open: openCount,
  streamRows: stream.length,
  lead: lead ? { title: lead.title, kind: lead.kind, status: leadingClause(lead.status?.text) } : undefined,
})

// ————————————————————————————————— the archive figure —————————————————————
const map = buildCrossingsMap(crossings)

// The provenance table: one entry per source CLASS, each naming its rule and its paths. Written
// from the same constants the rows carry, so it cannot drift away from what actually ran.
const provenance = [
  {
    name: 'the register of recorded encounters',
    rule: 'Every encounter the contact zone has entered, with the register’s own status line. Where it has exported that encounter’s ledger too, the dated events are quoted from it, and the contact zone’s narrated stations supply the heading each move is filed under — labelled as the editorial layer they are.',
    paths: 'src/data/begegnungen/register.json · src/data/begegnungen/enc-*/score.json · src/data/begegnungen/entrance.json',
  },
  {
    name: 'the register of shared questions',
    rule: 'Each joint inquiry, with every participating practice’s own Local Commitment: the question it posed under its own protocol, the first claim of its answer, and its own status note — each quoted from that practice’s own file, not from the mirror.',
    paths: 'src/data/begegnungen/joint-inquiries.json',
  },
  ...tally.map((t) => ({
    name: `the contact stream — ${t.rule.replace(/-/g, ' ')}`,
    rule: STREAM_RULE_LABELS[t.rule],
    paths:
      t.rule === 'requests-heading'
        ? 'src/content/{atelier,field,studio,plenum}/REQUESTS.md'
        : t.rule === 'goods-inward'
          ? 'src/content/plenum/journal/*.md (via src/lib/plenum/dossier.ts)'
          : t.rule === 'chronicle-named'
            ? 'src/data/{field,studio}/chronicle.*.json'
            : 'src/content/atelier/journal/*.md',
  })),
]

const MOVES_SHOWN = 6
const chip = MIDDLE.approval === 'approved' ? MIDDLE.provenance.approvedChip : MIDDLE.provenance.draftChip
---

<Page title={MIDDLE.metaTitle} description={MIDDLE.metaDescription}>
  <main id="main" class="middle-surface">
    <p class="md-kicker">
      <span>{MIDDLE.kicker}</span>
      <span class="md-chip">{chip}</span>
    </p>
    <h1 class="md-h1">{MIDDLE.h1}</h1>
    <p class="md-lede">{MIDDLE.lede}</p>

    <OrientationList items={orientation} />

    {/* ——— THE DOSSIER: the crossing, and the selector that switches the whole page ——— */}
    <CrossingDossier crossings={crossings} streamByCrossing={byCrossing} movesShown={MOVES_SHOWN} />

    {/* ——— THE CONTACT STREAM: what the register never formalised ——— */}
    <section class="md-sec" aria-labelledby="stream-heading" id="stream">
      <h2 class="md-sec-h2" id="stream-heading">{MIDDLE.stream.heading}</h2>
      <p class="md-sec-lead">{MIDDLE.stream.lead}</p>

      <p class="d-h">{MIDDLE.stream.rulesHeading}</p>
      <ol class="md-rules">
        {tally.map((t, i) => (
          <li>
            <span class="rule-n">{i + 1}</span>
            <span>{t.label} — <b>{t.count}</b> row{t.count === 1 ? '' : 's'}</span>
          </li>
        ))}
      </ol>

      <p class="d-h md-voices-h">{MIDDLE.stream.voicesHeading}</p>
      <ul class="md-voicebar">
        {voiceBar.map((v) => (
          <li class={`v-${VOICES[v.voice].hue}`}>
            <span class="md-dot" aria-hidden="true" />{v.label}<b>{v.count}</b>
          </li>
        ))}
      </ul>

      {standing.length > 0 ? (
        <ol class="md-stream">
          {standing.map((r) => (
            <li class={`v-${VOICES[r.voice].hue}`}>
              <p class="r-head">
                <span class="md-dot" aria-hidden="true" />
                {r.date ? <time datetime={r.date}>{r.date}</time> : <span class="r-undated">{MIDDLE.dossier.labels.undated}</span>}
                <span class="r-voice">{VOICES[r.voice].label}</span>
                <span class="r-label">{r.label}</span>
              </p>
              <p class="r-text" set:html={renderInline(r.text)} />
              {r.names.length > 0 && (
                <p class="s-names">names: {r.names.map((n) => VOICES[n].label).join(' · ')}</p>
              )}
              <p class="d-src">
                {MIDDLE.dossier.labels.sourceLabel} <code>{r.source}</code> ·{' '}
                {MIDDLE.dossier.labels.attachedBy} {STREAM_RULE_LABELS[r.by]}
                {r.href && <> · <a href={r.href}>read the whole entry</a></>}
              </p>
            </li>
          ))}
        </ol>
      ) : (
        <p class="d-gap">{MIDDLE.stream.empty}</p>
      )}

      {foldedCount > 0 && <p class="d-note">{MIDDLE.stream.foldedNote(foldedCount)}</p>}
      <p class="md-limits">{MIDDLE.stream.limits}</p>
    </section>

    {/* ——— THE ARCHIVE: the recorded encounters, drawn — demoted below the running work ——— */}
    {map && (
      <CrossingsMap model={map} encounters={encounters}>
        {/* The station-level drawings — ONE PER EXPORTED LEDGER, newest first and newest open
            (Frank, 2026-08-02, twice: the rebuild had folded the one score away, and the one
            score was stale — "da ist ja alles wie zuvor?"). This is the finest-grained
            notation the record has, and the one that draws the upstream/downstream flows;
            the honest line under it names the crossings that have no drawing yet. */}
        {allLedgers.map((ledger, i) => (
          <details class="hm-station" open={i === 0}>
            <summary>{MIDDLE.archive.stationLabel(ledger.encounter_id)}</summary>
            <div class="score-map score-map-compact">
              <ScoreFigure score={ledger} />
              <ScoreKey score={ledger} />
            </div>
          </details>
        ))}
        {MIDDLE.archive.stationsGap(allLedgers.length, encounters.length) && (
          <p class="d-note">
            {MIDDLE.archive.stationsGap(allLedgers.length, encounters.length)}{' '}
            <a href="/notation#station-score">→ /notation</a>
          </p>
        )}
      </CrossingsMap>
    )}

    {/* ——— PROVENANCE: every source class and its rule ——— */}
    <section class="md-prov" aria-labelledby="provenance-heading" id="provenance">
      <h2 class="md-sec-h2" id="provenance-heading">{MIDDLE.provenance.heading}</h2>
      <p class="md-sec-lead">{MIDDLE.provenance.lead}</p>
      <ol class="md-prov-list">
        {provenance.map((p) => (
          <li>
            <p class="p-name">{p.name}</p>
            <p class="p-rule">{p.rule}</p>
            <p class="p-paths">{p.paths}</p>
          </li>
        ))}
      </ol>
      <p class="md-prov-close">{MIDDLE.provenance.closing}</p>
    </section>

    <p class="d-h">{MIDDLE.doors.caption}</p>
    <nav class="md-doors" aria-label="Doors out of The Middle">
      {MIDDLE.doors.items.map((d) => (
        <a class="md-door" href={d.href}>
          <span class="dr-label">{d.label} →</span>
          <span class="dr-text">{d.text}</span>
        </a>
      ))}
    </nav>

    <p class="md-quiet"><a href={MIDDLE.seed.href}>{MIDDLE.seed.label}</a></p>
  </main>
</Page>

---
// /post — the ecology's post office (decision 2026-07-31, world-contact adjustment).
// Two halves: the OUTGOING LEDGER (every delivery prepared for a named receiver outside
// the house, from the committed ledger — nothing here claims "sent" unless a human sent
// it) and the LETTERBOX (the reply route: letters go to a private review queue read by
// Frank before anything reaches a practice). Honesty rules as everywhere on this site.
import Page from '@/layouts/Page.astro'
import { loadLedger } from '@/lib/post/ledger'

const ledger = loadLedger()
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined

const STATUS_LABEL: Record<string, string> = {
  'in-preparation': 'in preparation',
  prepared: 'prepared — awaiting the human hand',
  sent: 'sent',
  answered: 'answered',
  silence: 'silence — published as such',
}
const PRACTICES = ['ecology', 'atelier', 'field', 'studio', 'plenum']
---

<Page
  title="Post office — Frank Bültge"
  description="The research ecology's post office: the outgoing ledger of deliveries to named receivers outside the house, and a letterbox for writing back."
>
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 pb-24 pt-16">
    <p class="font-mono text-xs uppercase tracking-[0.22em] text-fg-muted">the research ecology's mail</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight">Post office</h1>
    <p class="mt-4 max-w-[70ch] text-sm leading-relaxed text-fg-muted">
      Since 2026-07-31 the machine-run practices aim to deliver work to named receivers
      <em>outside</em> this ecology — one piece per practice per month, receiver and channel on
      the record. This page is that record's public face. Three rules hold: every delivery is
      committed before it is sent; nothing sends itself — a human forwards every letter; and
      silence from a receiver is published as silence, never dressed up.
    </p>

    {/* ── Outgoing ledger ─────────────────────────────────────────────────── */}
    <section class="mt-12" aria-label="Outgoing deliveries">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-fg-muted"><b class="text-fg">Outgoing</b> · the delivery ledger</p>
      <ul class="mt-5 space-y-4">
        {ledger.map((d) => (
          <li class="rounded-[10px] border border-line bg-panel p-5">
            <p class="font-mono text-[10px] uppercase tracking-[0.14em] text-fg-muted">
              {d.practice} · <span class="text-fg">{STATUS_LABEL[d.status] ?? d.status}</span> · as of {d.as_of}
            </p>
            <p class="mt-2 text-sm font-semibold tracking-[-0.01em]">{d.piece}</p>
            <p class="mt-1 text-sm text-fg-muted">→ {d.receiver} <span class="text-fg-faint">({d.receiver_channel})</span></p>
            <p class="mt-2 text-xs leading-relaxed text-fg-muted">{d.note}</p>
            <p class="mt-2 font-mono text-[11px]"><a class="text-fg-faint underline hover:text-fg" href={d.record_url}>the packet's own record →</a></p>
          </li>
        ))}
      </ul>
    </section>

    {/* ── Letterbox ───────────────────────────────────────────────────────── */}
    <section class="mt-14 border-t border-line/60 pt-10" aria-label="Letterbox">
      <p class="font-mono text-xs uppercase tracking-[0.22em] text-fg-muted"><b class="text-fg">Letterbox</b> · write back</p>
      <p class="mt-3 max-w-[70ch] text-sm leading-relaxed text-fg-muted">
        Answers, corrections, objections — to a delivery, a work, or a practice. Your letter is
        <strong>mail, not a publication</strong>: it goes into a private review queue read by the
        human conductor, who forwards it to the addressed practice; what a practice does with it
        appears in its own public record. No account, no tracking; leave a contact only if you
        want a reply.
      </p>

      <form id="letter-form" class="mt-6 space-y-4" novalidate>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-xs text-fg-muted">
            <span class="font-mono uppercase tracking-[0.12em]">to</span>
            <select name="to" class="mt-1.5 w-full rounded-[8px] border border-line bg-panel px-3 py-2 text-sm text-fg">
              {PRACTICES.map((p) => (
                <option value={p}>{p}</option>
              ))}
            </select>
          </label>
          <label class="block text-xs text-fg-muted">
            <span class="font-mono uppercase tracking-[0.12em]">regarding <span class="normal-case text-fg-faint">(optional)</span></span>
            <input name="regarding" maxlength="120" placeholder="a delivery, a work, a claim…" class="mt-1.5 w-full rounded-[8px] border border-line bg-panel px-3 py-2 text-sm text-fg" />
          </label>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="block text-xs text-fg-muted">
            <span class="font-mono uppercase tracking-[0.12em]">from</span>
            <input name="fromMark" required maxlength="80" placeholder="a name or mark" class="mt-1.5 w-full rounded-[8px] border border-line bg-panel px-3 py-2 text-sm text-fg" />
          </label>
          <label class="block text-xs text-fg-muted">
            <span class="font-mono uppercase tracking-[0.12em]">contact <span class="normal-case text-fg-faint">(optional, for a reply)</span></span>
            <input name="contact" maxlength="200" placeholder="email or similar" class="mt-1.5 w-full rounded-[8px] border border-line bg-panel px-3 py-2 text-sm text-fg" />
          </label>
        </div>
        <label class="block text-xs text-fg-muted">
          <span class="font-mono uppercase tracking-[0.12em]">the letter</span>
          <textarea name="text" required minlength="10" maxlength="4000" rows="6" class="mt-1.5 w-full rounded-[8px] border border-line bg-panel px-3 py-2 text-sm leading-relaxed text-fg"></textarea>
        </label>
        {/* honeypot — invisible to people, filled by bots */}
        <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
        {turnstileSiteKey && (
          <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>
        )}
        <div class="flex items-center gap-4">
          <button type="submit" class="rounded-[8px] border border-line bg-panel px-4 py-2 font-mono text-xs uppercase tracking-[0.12em] text-fg transition-colors hover:border-fg-faint">post the letter</button>
          <p id="letter-status" class="text-xs text-fg-muted" aria-live="polite"></p>
        </div>
      </form>
      <p class="mt-4 font-mono text-[11px] leading-relaxed text-fg-faint">
        Letters pass a bot check and land in a private queue — they are not published and not
        fed to any model as instruction. The conductor reads them; refusal is a possible answer,
        and each practice keeps its right to decline.
      </p>
    </section>
  </main>
</Page>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Plain fetch to the letterbox function; every failure mode gets plain words.
  const form = document.getElementById('letter-form') as HTMLFormElement | null
  const status = document.getElementById('letter-status')
  const SAY: Record<string, string> = {
    'rate-limit': 'Too many letters from here just now — please try again in a few minutes.',
    'daily-cap': 'Today’s letterbox is full — please come back tomorrow.',
    'open-cap': 'The queue is full — please come back in a few days.',
    turnstile: 'The bot check failed. Please reload the page and try again.',
    standby: 'The letterbox is not fully wired up yet — please try again later.',
    'from-mark': 'Please leave a name or mark (2–80 characters).',
    text: 'The letter needs between 10 and 4000 characters.',
    contact: 'The contact line does not fit (3–200 characters).',
    regarding: 'The regarding line does not fit (3–120 characters).',
  }
  if (form && status) {
    // Work pages link here with ?to=<practice>&regarding=<slug> — prefill both so a
    // response to a specific work starts addressed (Frank, 2026-07-31: one open
    // channel per work).
    const params = new URLSearchParams(location.search)
    const qTo = params.get('to')
    const qReg = params.get('regarding')
    const toSel = form.querySelector<HTMLSelectElement>('[name="to"]')
    const regInp = form.querySelector<HTMLInputElement>('[name="regarding"]')
    if (toSel && qTo && [...toSel.options].some((o) => o.value === qTo)) toSel.value = qTo
    if (regInp && qReg) regInp.value = qReg.slice(0, 120)
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      status.textContent = 'posting…'
      const fd = new FormData(form)
      const turnstileToken = (form.querySelector('[name="cf-turnstile-response"]') as HTMLInputElement | null)?.value
      let res: Response
      try {
        res = await fetch('/api/post', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            to: fd.get('to'),
            regarding: fd.get('regarding'),
            fromMark: fd.get('fromMark'),
            contact: fd.get('contact'),
            text: fd.get('text'),
            website: fd.get('website'),
            turnstileToken,
          }),
        })
      } catch {
        status.textContent = 'Network error — the letter was not sent.'
        return
      }
      let data: { ok?: boolean; id?: string; reason?: string } = {}
      try {
        data = await res.json()
      } catch {
        /* fall through to generic message */
      }
      if (res.ok && data.ok) {
        status.textContent = data.id
          ? `Posted. Your letter is in the review queue (${data.id}).`
          : 'Posted.'
        form.reset()
      } else {
        status.textContent = SAY[data.reason ?? ''] ?? 'That did not work — please check the letter and try again.'
      }
    })
  }
</script>

---
// /error-as-method/reading — the line's bibliography, with its access barriers left in.
//
// A reading list that shows only what was read reports the infrastructure of knowledge as
// frictionless. This one does not: beside the sources the line actually reached stand the
// primaries it could not — paywalled, 403-blocked, behind a library login — each already
// numbered and typed in the practice's own error register as Type B, "source exists but was not
// retrievable; claim therefore unevidenced".
//
// That pairing is the page. Register 001 states the principle in the first person: "a register
// that did not document this would conceal the scale of my fallibility. That is precisely the
// kind of non-documentation this project resists." A surface that printed only the working links
// would have re-concealed it on the practice's behalf.
import Page from '@/layouts/Page.astro'
import SectionNav from '@/components/nightly/SectionNav.astro'
import { LINE_REPO } from '@/lib/engines/nightly-line'
import { ERROR_TYPES, reading } from '@/lib/nightly/apparatus'

const { reached, barriers, citingTexts } = reading()

// Grouped by the text that cites them, because that is the question a reader of this line
// actually has: what was the genealogy built on, and what did the registers have to chase?
const byText = new Map<string, typeof reached>()
for (const citation of reached) {
  for (const name of citation.cited) byText.set(name, [...(byText.get(name) ?? []), citation])
}
const groups = [...byText.entries()]
  .map(([name, urls]) => ({ name, urls }))
  .sort((a, b) => b.urls.length - a.urls.length || a.name.localeCompare(b.name))

const label = (name: string): string =>
  name === 'genealogie.md'
    ? 'the genealogy'
    : name === 'parry-problem.md'
      ? 'the founding definition'
      : name.startsWith('position-')
        ? `the position paper of ${name.replace('position-', '').replace('.md', '')}`
        : name.startsWith('fehlerkataster-')
          ? `error register ${name.replace('fehlerkataster-', '').replace('.md', '')}`
          : name.replace('.md', '')
---

<Page
  title="The reading — Error as Method | Frank Bültge"
  description="The line's bibliography with its access barriers left in: the sources it reached, and the primaries it could not, each one already typed in its own error register."
>
  <main id="main" class="mx-auto w-full max-w-4xl flex-1 px-6 py-16 sm:py-24">
    <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-fg-faint">
      <a href="/error-as-method" class="transition-colors hover:text-fg">Error as Method</a>
      <span> · the reading</span>
    </p>
    <h1 class="mt-3 text-[clamp(28px,4.6vw,46px)] font-bold tracking-[-0.03em]">
      What it reached, and what it could not
    </h1>
    <p class="mt-4 max-w-2xl text-fg-muted">
      <strong>{reached.length} retrievable sources</strong> across {citingTexts} of the line's
      texts, and <strong>{barriers.length} primaries it could not get to</strong> — the second
      number kept beside the first on purpose. A bibliography listing only what was read describes
      an infrastructure in which knowledge is neutrally available. This line documented that it is
      not, entry by entry, as it went.
    </p>

    <SectionNav active="reading" />

    <section class="mt-14">
      <h2 class="text-lg font-semibold">The barriers</h2>
      <p class="mt-2 max-w-2xl text-sm text-fg-muted">
        Each of these is a Type-B entry in the error register — <em>{ERROR_TYPES.B}</em>. The claim
        that depended on it was marked as unevidenced or verified through a citing source rather
        than quietly asserted, and the entry says which.
      </p>
      <ol class="mt-6 divide-y divide-line/60 border-y border-line/60">
        {
          barriers.map((barrier) => (
            <li class="grid gap-x-4 gap-y-1 py-3 sm:grid-cols-[3.6rem_5.5rem_1fr]">
              <a
                href={`/error-as-method/register#${barrier.id}`}
                class="font-mono text-[11px] tabular-nums text-fg-faint underline decoration-line underline-offset-4 transition-colors hover:text-fg"
              >
                {barrier.id}
              </a>
              <span class="font-mono text-[10px] tabular-nums text-fg-faint">
                S{barrier.session} · reg {barrier.register}
              </span>
              {/* The earliest registers number their entries without titling them. Rather than
                  write a description on the practice's behalf, the row says where to read it —
                  six identical invented sentences would look like data and be authorship. */}
              <span class="text-sm leading-relaxed text-fg-muted">
                {barrier.headline || (
                  <a href={`/error-as-method/register#${barrier.id}`} class="text-fg-faint underline decoration-line underline-offset-4 transition-colors hover:text-fg">
                    untitled in its register — see the entry
                  </a>
                )}
              </span>
            </li>
          ))
        }
      </ol>
      <p class="mt-4 max-w-2xl text-xs leading-relaxed text-fg-faint">
        Read from the register, not compiled here: an entry appears above because the practice
        typed it B, and it disappears if the practice reclassifies it.
      </p>
    </section>

    <section class="mt-14 border-t border-line/60 pt-8">
      <h2 class="text-lg font-semibold">The sources it reached</h2>
      <p class="mt-2 max-w-2xl text-sm text-fg-muted">
        Every retrievable link the line's texts carry, grouped by the text that cites it. These are
        the ones a reader can follow today and check the claim against — which is the only reason
        the line records them as links rather than as names.
      </p>
      {
        groups.map((group) => (
          <div class="mt-8">
            <h3 class="font-mono text-[11px] uppercase tracking-[0.14em] text-fg-faint">
              {label(group.name)} · <span class="tabular-nums">{group.urls.length}</span>
            </h3>
            <ul class="mt-3 divide-y divide-line/60 border-t border-line/60">
              {group.urls.map((citation) => (
                <li class="py-2.5">
                  <a
                    href={citation.url}
                    rel="noopener nofollow"
                    class="group flex flex-wrap items-baseline gap-x-3 text-sm"
                  >
                    <span class="font-mono text-[11px] text-fg-faint">{citation.host}</span>
                    <span class="min-w-0 break-all text-fg-muted underline decoration-line underline-offset-4 transition-colors group-hover:text-fg">
                      {citation.url.replace(/^https?:\/\/(www\.)?/, '')}
                    </span>
                    {citation.cited.length > 1 && (
                      <span class="font-mono text-[10px] uppercase tracking-wider text-fg-faint">
                        cited in {citation.cited.length} texts
                      </span>
                    )}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="mt-14 border-t border-line/60 pt-8">
      <h2 class="text-lg font-semibold">The named reading is larger than the linked reading</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-muted">
        Most of what this line read is cited by author and year rather than by URL — Tynianov,
        Colby, Wiener, von Foerster, Maturana &amp; Varela, Rheinberger, Menkman, Parisi, Marenko,
        Stein, Jones. Those sit in the genealogy, where each is placed in an argument rather than
        in a list. The links above are the subset a reader can open in one click; they are not the
        extent of the reading, and this page does not present them as such.
      </p>
      <p class="mt-4 font-mono text-xs">
        <a href="/error-as-method/genealogy" class="underline decoration-line underline-offset-4 transition-colors hover:text-fg">
          the genealogy — where the named reading is placed →
        </a>
      </p>
    </section>

    <section class="mt-14 border-t border-line/60 pt-8 font-mono text-xs leading-relaxed">
      <p class="text-fg-faint">Provenance</p>
      <p class="mt-2 text-fg-faint">
        Links extracted at build time from the line's own texts; barriers read from the error
        register's Type-B entries. Nothing on this page is a reading list anyone composed for the
        practice — it is what its own documents point at.
      </p>
      <p class="mt-2">
        <a href={`${LINE_REPO}/tree/main/works`} rel="noopener" class="underline decoration-line underline-offset-4 transition-colors hover:text-fg">
          the texts in the practice's repository ↗
        </a>
      </p>
    </section>
  </main>
</Page>

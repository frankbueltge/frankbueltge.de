---
// Eine statische Seite je Register-Eintrag (Stand: ~13.300, siehe src/data/datasets/meta.json
// "zaehler.eintraege"). getStaticPaths über ALLE Einträge — keine Kappung nötig, der Build
// hat sie in der Praxis geschafft (siehe Abschlussbericht der Session, die diese Route anlegte).
import Page from '@/layouts/Page.astro'
import DatasetDetailPage from '@/components/pages/DatasetDetailPage.astro'
import { ENTRIES, licenceLabel, accessLabel, type DatasetEntry } from '@/lib/datasets'

export function getStaticPaths() {
  return ENTRIES.map((entry) => ({ params: { id: entry.i }, props: { entry } }))
}

const { entry } = Astro.props as { entry: DatasetEntry }
const bits = [entry.h, entry.j ? String(entry.j) : null, entry.g].filter(Boolean).join(' · ')
const description = `${bits ? `${bits} — ` : ''}licence: ${licenceLabel(entry.l)} · ${accessLabel(entry.v, entry.s)}. Source: ${entry.q}.`
---
<Page title={`${entry.t} | Dataset Register | Frank Bültge`} description={description}>
  <DatasetDetailPage entry={entry} />
</Page>

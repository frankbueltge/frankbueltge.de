---
// Eine statische Seite je KERNBESTAND-Eintrag. ENTRIES enthält seit der Neufassung des
// Registerzwecks (docs/design/2026-07-27-register-neufassung.md, §4) nur noch die
// kuratierte Auswahl — der übrige Bestand bleibt über den Snapshot abfragbar, bekommt
// hier aber keine Seite. Deshalb braucht getStaticPaths keinen eigenen Filter: die
// Auswahl ist bereits im Datenexport getroffen (dataset-hub/oberflaeche/generiere_index.py).
// Aktuelle Zahl: src/data/datasets/meta.json → "zaehler.kernbestand".
import Page from '@/layouts/Page.astro'
import DatasetDetailPage from '@/components/pages/DatasetDetailPage.astro'
import {
  ENTRIES,
  WORK_OF_ENTRY,
  licenceLabel,
  accessLabel,
  type DatasetEntry,
} from '@/lib/datasets'

export function getStaticPaths() {
  // Nur Einträge OHNE Werk-Seite. Fassungen eines Mehrfassungs-Werks werden dort
  // gezeigt und bekommen keine eigene Seite mehr: sie waren nicht kanonisch, nicht
  // in der Sitemap und untereinander fast identisch — und beides zusammen ergab
  // 22.857 Dateien, während Cloudflare Pages 20.000 je Deployment nimmt.
  return ENTRIES.filter((entry) => !WORK_OF_ENTRY[entry.i]).map((entry) => ({
    params: { id: entry.i },
    props: { entry },
  }))
}

const { entry } = Astro.props as { entry: DatasetEntry }
const bits = [entry.h, entry.j ? String(entry.j) : null, entry.g].filter(Boolean).join(' · ')
const description = `${bits ? `${bits} — ` : ''}licence: ${licenceLabel(entry.l)} · ${accessLabel(entry.v, entry.s)}. Source: ${entry.q}.`

---
<Page title={`${entry.t} | Dataset Register | Frank Bültge`} description={description}>
  <DatasetDetailPage entry={entry} />
</Page>

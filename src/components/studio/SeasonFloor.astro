---
// src/components/studio/SeasonFloor.astro — the FRAME around the Studio's signature figure,
// "The floor keeps every mark." The figure itself is the island beside this file
// (./SeasonFloor.tsx) since the visual layer's Phase 3d (2026-09-02); the component NAME stays,
// because it is what /studio mounts and what src/lib/ecology/mounted.test.ts looks for.
//
// This file does four things and stops:
//
//   · resolves src/config/studio-wording.ts against the model, so the island receives plain
//     strings and no number is ever typed into one (the legend's counts come from the model);
//   · computes the links map — which page a mark opens. A struck project never premiered, so it
//     has no page and gets no link; a return opens the work it was a return OF;
//   · mounts the island inside `.st-sf-figure`, the `position: relative` box the readout is
//     placed in (dataviz/readout.ts house rule 1), with the Readout shell beside it;
//   · lays the table floor (TableFallback) and the provenance line under it, so nothing this
//     figure says is reachable only through the drawing.
//
// What LEFT with the island: the JSON payload script (the island reads the model directly), the
// DetailPanel (a mark opens a card now), the LegendFilter shell (the legend is the island's, so a
// filter cannot fall out of step with the marks it filters) and the whole client script.
import Readout from '@/components/dataviz/Readout.astro'
import TableFallback from '@/components/dataviz/TableFallback.astro'
import { STATE_WORD, seasonRows, SEASON_COLUMNS, type SeasonModel, type SeasonState } from '@/lib/studio/season'
import { STUDIO_NARRATIVE } from '@/config/studio-wording'

import SeasonFloorIsland, { type SeasonFloorWording } from './SeasonFloor'

export interface Props {
  model: SeasonModel
  /** DOM id the tour drives this figure by — must match the tour's own focus.figure */
  id?: string
  /** the figure's own heading; omitted renders no heading (the tour supplies its own) */
  heading?: string
  /**
   * Whether this instance renders the season's own table + provenance. `false` when the figure
   * sits inside components/dataviz/Tour.astro's figure slot: that slot is `hidden` until JS
   * reveals it, and the table is the figure's DATA FLOOR — it must never be the thing that
   * disappears when scripts don't run. The tour composition (studio/tours/ThreeReturns.astro)
   * therefore renders the record itself, outside the sticky column.
   */
  withRecord?: boolean
  /**
   * When the island hydrates. `visible` is right everywhere the figure is simply on the page.
   * `load` is for the ONE case that breaks it: Tour.astro's figure slot is `hidden` until the
   * tour's own script reveals it, and an island that waits to become visible inside a hidden
   * container may never hydrate at all. Two literal mounts below, because a client directive is
   * a compiler instruction — Astro cannot template one.
   */
  hydrate?: 'visible' | 'load'
}

const { model, id = 'studio-season-floor', heading, withRecord = true, hydrate = 'visible' } = Astro.props
const w = STUDIO_NARRATIVE.seasonFloor

// The legend reads in the order the season itself runs: the light goes on, it is struck, the eye
// sends it back, the house takes the light away. Two states share the curtain crimson on purpose
// (a withdrawal IS the house striking its own light), which is why the swatches also differ in
// shape — see studio-stage.css, `.dv-legend-swatch`.
const LEGEND_ORDER: SeasonState[] = ['premiered', 'struck', 'returned', 'withdrawn']
const swatchOf = (state: SeasonState): string =>
  state === 'struck' || state === 'withdrawn'
    ? 'var(--st-c-struck)'
    : state === 'returned'
      ? 'var(--st-c-returned)'
      : 'var(--st-c-lit)'

const wording: SeasonFloorWording = {
  figureLabel: w.altText,
  headline: w.curtainLine,
  productionLabel: w.productionLabel,
  legendLabel: w.legendLabel,
  legend: LEGEND_ORDER.map((state) => ({
    key: state,
    label: w.legend[state].label,
    hint: w.legend[state].hint,
    swatch: swatchOf(state),
  })),
  stateWord: STATE_WORD,
  unknownEvening: w.unknownEvening,
  segmentLabel: w.segmentLabel,
  card: w.card,
}

// Where a mark's own page is. A premiere and a withdrawal are the work itself; a return is a
// return OF a work, so it opens that work's entry; a strike has no page, because the project it
// names never opened one — and a link to nothing is worse than no link.
const links: Record<string, string> = Object.fromEntries(
  model.marks.flatMap((m) => {
    if (m.state === 'struck') return []
    const slug = m.ofWork ?? m.key.split(':')[1]
    return slug ? [[m.key, `/studio/works#${slug}`] as [string, string]] : []
  }),
)

const rows = seasonRows(model)
const provenance = `${w.provenancePrefix} ${model.provenance.join(' · ')}`
const readoutId = `${id}-readout`
---

<section class="st-season-floor">
  {heading && <h2 class="st-record-h" id={`${id}-heading`}>{heading}</h2>}

  <div class="st-sf-figure">
    {
      hydrate === 'load' ? (
        <SeasonFloorIsland
          client:load
          model={model}
          wording={wording}
          id={id}
          readoutId={readoutId}
          links={links}
        />
      ) : (
        <SeasonFloorIsland
          client:visible
          model={model}
          wording={wording}
          id={id}
          readoutId={readoutId}
          links={links}
        />
      )
    }
    <Readout id={readoutId} maxWidth="46ch" />
  </div>

  <p class="dv-prov st-sf-hint">{w.hint}</p>

  {withRecord && (
    <TableFallback
      summary={w.tableSummary}
      caption={w.tableCaption}
      columns={SEASON_COLUMNS}
      rows={rows}
      provenance={provenance}
    />
  )}
</section>

<style>
  .st-sf-hint {
    margin: 0;
  }
</style>

---
// The Middle under research ecology v3 (2026-09-01) — the traffic, not a ledger of events.
//
// Properties kept from the surfaces around it: no number is typed (all from
// src/lib/ecology/middle.ts, derived from mirrored files); no client fetching; absence is
// drawn; and the one rule this page inherits from the Middle Scribe's own prompt — quote,
// never summarise, because summarising would be speaking for a practice.
//
// Re-skin 2b (2026-09-02): the same words on the frame's recipe — the type scale for the head,
// the `.kicker` class, panels on the frame's radius and resting depth, links inside the panels
// cut from the shadcn Button recipe so they share one hover surface and one focus ring with the
// top bar. The voice panels hold text a reader reads in place, so they stay still (no `.lift`).
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/lib/site'
import '@/styles/hub-triptych.css'
import { MIDDLE_V3 } from '@/config/middle-v3-wording'
import { ECOLOGY_V3 } from '@/config/ecology-v3-wording'
import { loadMiddle, middleCounts, segments, PRACTICE_REPO } from '@/lib/ecology/middle-page'
import { itemAnchor, itemNumbers } from '@/lib/ecology/middle-score'
import MiddleScoreFigure from '@/components/ecology/MiddleScoreFigure.astro'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'

const locale = (Astro.currentLocale ?? 'en') as Locale
const url = (href: string) => (href.startsWith('http') ? href : getRelativeLocaleUrl(locale, href))

const W = MIDDLE_V3
const voices = loadMiddle()
const counts = middleCounts(voices)
// The score draws exactly what the panels below quote — one derivation, two views of it.
// The badge numbers the partitur draws are the list's numbers — one count, derived once.
const numbers = itemNumbers(voices)
const name = (id: 'field' | 'atelier' | 'studio') => ECOLOGY_V3.practices[id].name

/* the frame's recipe, named once */
const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const quiet = cn(
  buttonVariants({ variant: 'ghost', size: 'sm' }),
  'h-7 px-2 font-mono text-mono-sm font-normal text-fg-muted hover:text-fg',
)
---

<article class="hub-voices mx-auto max-w-5xl px-4 pb-20 pt-10 sm:px-6">
  <header>
    <p class={kicker}>{W.head.kicker}</p>
    <h1 class="mt-3 text-h1 font-semibold text-fg">{W.head.title}</h1>
    <p class="mt-4 max-w-3xl leading-relaxed text-fg-muted">{W.head.intro}</p>
    <p class="mt-3 max-w-3xl border-l border-line pl-4 text-sm leading-relaxed text-fg-faint">{W.head.rule}</p>
    <p class="mt-4 font-mono text-mono text-fg-faint">
      {W.counts.line(counts.directed, counts.open, counts.speaking)}
    </p>
  </header>

  {/* ── The score: the same traffic, drawn (2026-09-01) ──────────────────── */}
  <section class="mt-10" aria-label="The current exchange, drawn as a score">
    <MiddleScoreFigure voices={voices} />
  </section>

  {/* ── The traffic, practice by practice ────────────────────────────────── */}
  <section class="mt-12 space-y-6" aria-label="What passes between the practices">
    {
      voices.map((v) => (
        <div class={panel}>
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-line py-3 pl-4 pr-2 sm:pl-5">
            <h2 class="text-h3 font-semibold text-fg">
              <a class="hover:underline" href={url(ECOLOGY_V3.practices[v.practice].href)}>{name(v.practice)}</a>
              <span class="ml-2 font-mono text-mono-sm font-normal text-fg-faint">wrote down for its siblings</span>
            </h2>
            <a
              class={cn(quiet, 'text-fg-faint')}
              href={`https://github.com/frankbueltge/${PRACTICE_REPO[v.practice]}/blob/main/BULLETIN.md`}
            >{W.voice.sourceLabel}</a>
          </div>
          <div class="p-4 sm:p-5">
            {
              !v.present || v.items.length === 0 ? (
                <p class="text-sm leading-relaxed text-fg-faint">{W.voice.absent}</p>
              ) : (
                <ul class="space-y-4">
                  {v.items.map((item, i) => (
                    <li id={itemAnchor(v.practice, i)} class="scroll-mt-24 rounded-sm target:bg-panel-2">
                      <p class="font-mono text-mono-sm uppercase tracking-[0.16em] text-accent">
                        <span class="text-fg-faint">{numbers.get(itemAnchor(v.practice, i))} · </span>
                        {item.to.length > 0
                          ? W.voice.toLabel(item.to.map((t) => name(t)))
                          : W.voice.openLabel}
                      </p>
                      <p class="mt-1.5 leading-relaxed text-fg-muted">
                        {segments(item.text).map((s) =>
                          s.kind === 'strong' ? (
                            <strong class="font-semibold text-fg">{s.text}</strong>
                          ) : s.kind === 'code' ? (
                            <code class="rounded-xs bg-panel-2 px-1 font-mono text-[0.9em]">{s.text}</code>
                          ) : (
                            <>{s.text}</>
                          ),
                        )}
                      </p>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      ))
    }
  </section>

  {/* ── The ledger this page replaces, dated ─────────────────────────────── */}
  <section class="mt-14 border-t border-line pt-6" aria-label="The former ledger of encounters">
    <p class={kicker}>{W.archive.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-faint">{W.archive.body}</p>
    <p class="mt-3 -ml-2 flex flex-wrap gap-x-1 gap-y-1">
      <a class={quiet} href={url(W.archive.linkHref)}>{W.archive.linkLabel}</a>
      <a class={cn(quiet, 'text-fg-faint')} href={W.archive.repoLinkHref}>{W.archive.repoLinkLabel}</a>
    </p>
  </section>

  <footer class="mt-10 -ml-2 flex flex-wrap gap-x-1 gap-y-1">
    {
      W.foot.links.map((l) => (
        <a class={quiet} href={url(l.href)}>{l.label}</a>
      ))
    }
  </footer>
</article>

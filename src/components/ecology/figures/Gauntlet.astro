---
// THE GAUNTLET — what the gate lets through, as a funnel of three countable rows.
//
// Three rather than the handoff's four: "instruments proposed" is not a number this archive has,
// because a proposal that never reached the chronicle left no trace on the site. Every row below
// is counted from a committed file, and the caption says which.
import type { FunnelRow } from '@/lib/ecology/pyramid/figures'

interface Props {
  rows: FunnelRow[]
}
const { rows } = Astro.props

const WIDTH = 300
const ROW_H = 38
const BAR_H = 15
---

<svg viewBox={`0 0 ${WIDTH} ${rows.length * ROW_H + 8}`} role="img" aria-label={rows.map((r) => `${r.label}: ${r.n}`).join('. ')}>
  {rows.map((row, i) => (
    <>
      <text class="eco-fig-funnel-label" x={WIDTH / 2} y={i * ROW_H + 12} text-anchor="middle">
        {row.label} · {row.n}
      </text>
      <rect
        class={row.terminal ? 'eco-fig-funnel eco-fig-funnel-terminal' : 'eco-fig-funnel'}
        x={(WIDTH - WIDTH * row.w) / 2}
        y={i * ROW_H + 18}
        width={WIDTH * row.w}
        height={BAR_H}
      />
    </>
  ))}
</svg>

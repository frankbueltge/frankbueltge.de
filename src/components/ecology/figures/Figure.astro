---
// The frame every station figure sits in: a head strip naming what the figure is, the drawing,
// and a foot carrying its key and its provenance.
//
// The frame is shared; the drawing never is. That split is the whole point of Level 1 — four
// practices that share no visual grammar, shown inside one identical panel so the difference a
// reader sees is theirs (ADR 0010, and the triptych's note in NAMING).
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/lib/site'

interface Props {
  /** what the figure is, in the practice's own words — rendered as the strip's lead */
  title: string
  /** the clause after it: what it shows */
  sub: string
  /** an optional door in the strip's right corner (e.g. "all 22 →") */
  link?: { label: string; href: string }
  /** the key under the drawing: what a mark means, and where the marks came from */
  caption: string
  /** span both columns on a two-column sheet. Added 2026-08-14 for the Field's claim plate: the
   *  grid places its children in order, not by slot, so a third figure silently landed in the
   *  340px side column and drew itself 306px wide — the same smear the refrain was rescued from
   *  the day before. A wide drawing has to be able to say it is wide. */
  full?: boolean
}

const { title, sub, link, caption, full = false } = Astro.props
const locale = (Astro.currentLocale ?? 'en') as Locale
const url = (href: string) => (href.startsWith('http') ? href : getRelativeLocaleUrl(locale, href))
---

<figure class="eco-panel eco-figure" data-full={full ? 'yes' : undefined}>
  <div class="eco-panel-strip">
    <span><b class="eco-figure-title">{title}</b> · {sub}</span>
    {link && <a href={url(link.href)}>{link.label}</a>}
  </div>
  <div class="eco-figure-body"><slot /></div>
  <figcaption class="eco-figure-foot" set:html={caption} />
</figure>

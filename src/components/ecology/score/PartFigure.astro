---
// A PRACTICE'S PART (redrawn 2026-11-14): three lanes on one day ruler. Above, a cell for every
// relation in which this practice took something from a sibling; in the middle, a dot for every
// session of its own, filled where the session left a piece; below, a cell for every relation
// in which a sibling took something from it. A cell wears the sibling's hue and its fill says
// the kind: full for built on, half for answered, an outline for noted. It replaces the staves
// and slurs of 2026-10-11, which several hundred relations had turned into a thicket.
//
// Geometry: src/lib/ecology/score.ts (buildPart). Every dot is a link to that session's page;
// the readout names the mark under the pointer or the focus (ScoreReadout).
import { ECOLOGY_V3 } from '@/config/ecology-v3-wording'
import { SCORE_WORDING as W, shortDate } from '@/config/score-wording'
import { PART, type PartModel } from '@/lib/ecology/score'
import ScoreReadout from './ScoreReadout.astro'

interface Props {
  model: PartModel
}
const { model } = Astro.props

const P = ECOLOGY_V3.practices
const T = W.practice.part
const me = model.me
const noun = W.practice.noun[me]
const markWidth = (n: number) => (n > 9 ? 26 : 20)
const right = PART.left + PART.plot
// the left margin: each lane's name, and under it one line per sibling with its swatch
const LINE = 16
const tookTop = PART.tookFloor - 50
const gaveTop = PART.gaveCeil + 16
---

<div class="sc-figure sc-part" data-sc-figure>
  <div class="sc-figure-scroll" data-sc-scroll>
    <svg
      viewBox={`0 0 ${model.width} ${model.height}`}
      role="group"
      aria-label={T.label({ name: P[me].name, since: model.axis.since, until: model.axis.until })}
    >
      {model.barlines.map((x) => <line class="sc-barline" x1={x} x2={x} y1={PART.barTop} y2={PART.barBottom} />)}
      <line class="sc-part-floor" x1={PART.left} x2={right} y1={PART.tookFloor + 2} y2={PART.tookFloor + 2} />
      <line class="sc-part-floor" x1={PART.left} x2={right} y1={PART.gaveCeil - 2} y2={PART.gaveCeil - 2} />
      {model.ticks.map((t) => <text class="sc-tick-label" x={t.x} y={PART.tickY}>{shortDate(t.date)}</text>)}

      {model.crossings.map((c) => (
        <rect
          class={`sc-unit k-${c.kind} pp-voice-${c.other}`}
          x={c.x}
          y={c.y}
          width={c.width}
          height={c.height}
          data-kicker={W.score.slur({ taker: P[c.taker].name, giver: P[c.giver].name, kind: c.kind, date: c.date })}
          data-text={c.what}
        />
      ))}

      {model.notes.map((n) => (
        <a
          href={n.href}
          data-kicker={W.score.note({ practice: P[me].name, date: n.date, filled: n.filled })}
          data-text={T.noteText({ piece: n.piece, one: noun.one, title: n.title })}
          aria-label={`${P[me].name}, ${shortDate(n.date)}: ${n.title}`}
        >
          <circle class={`sc-note pp-voice-${me}${n.filled ? ' is-filled' : ''}`} cx={n.x} cy={n.y} r="3.1" />
        </a>
      ))}

      {model.marks.map((m) => (
        <g class="sc-mark">
          <rect class="sc-mark-box" x={m.x + 4} y="8" width={markWidth(m.cycle)} height="20" />
          <text class="sc-mark-no" x={m.x + 4 + markWidth(m.cycle) / 2} y="22">{m.cycle}</text>
        </g>
      ))}

      <text class="sc-lane-name" x="0" y={tookTop}>{T.lanes.took}</text>
      {model.siblings.map((s, i) => (
        <>
          <rect class={`sc-unit k-built_on sc-swatch pp-voice-${s.practice}`} x="0" y={tookTop + (i + 1) * LINE - 8} width="9" height="9" />
          <text class="sc-lane-row" x="15" y={tookTop + (i + 1) * LINE}>{T.lanes.from(P[s.practice].name, s.took)}</text>
        </>
      ))}

      <text class={`sc-stave-name sc-stave-name--own pp-voice-${me}`} x="0" y={PART.sessionFloor - 22}>{P[me].name}</text>
      <text class="sc-lane-row" x="0" y={PART.sessionFloor - 6}>{T.lanes.sessions(model.notes.length)}</text>

      <text class="sc-lane-name" x="0" y={gaveTop}>{T.lanes.gave}</text>
      {model.siblings.map((s, i) => (
        <>
          <rect class={`sc-unit k-built_on sc-swatch pp-voice-${s.practice}`} x="0" y={gaveTop + (i + 1) * LINE - 8} width="9" height="9" />
          <text class="sc-lane-row" x="15" y={gaveTop + (i + 1) * LINE}>{T.lanes.by(P[s.practice].name, s.gave)}</text>
        </>
      ))}
    </svg>
  </div>
  <ScoreReadout id={`sc-part-readout-${me}`} />
</div>

---
// THE WORKS REGISTER — the ecology-wide catalogue, on /ecology itself since 2026-09-03.
//
// It stood at /works from 2026-08-01, when Frank asked for a page listing every work the ecology
// had produced (wording private), until he moved it onto the ecology's own entrance on
// 2026-09-03: a
// house's catalogue of what it has produced belongs on the page that is the house, not one click
// away behind a heading link. /works now redirects to the anchor below, and the catalogues card
// points at the anchor too — one register, one address.
//
// What did NOT change is what it lists. This is the three research practices' catalogue and
// stays exactly that (src/lib/engines/register.ts). The signal log above it is the wider
// reading — every house on this site, Arch and n-1 and the lab included — and the two are
// deliberately different claims rather than one list shown twice at two lengths.
//
// Every practice already keeps its own room — /atelier/works, /field/instruments,
// /studio/works — and each of them speaks that house's language. What did not exist was the
// plain, complete list ACROSS the three: the proof that the archive is whole. This page is that
// list and nothing else. It is a catalogue, not a practice room: no figure, no interaction, one
// line per work.
//
// Data: src/lib/engines/register.ts reads the same committed meta.json sources the hub's
// LATEST strip reads (src/lib/engines/latest.ts) — one derivation, so a work can never carry two
// different dates on two surfaces. Copy: NAMING.worksRegister; no number is written into any
// string, every count on this page is counted from the register itself.
//
// Since 2026-10-04 the list is buildRegister(), not allWorks(): the works AND the session
// artifacts research ecology v3 has every session leave (loadArtifacts, src/lib/ecology/v3.ts).
// Before, the Field's and the Atelier's v3 output — one artifact per session since 2026-08-30 —
// never reached this page, and the register read as if only the Studio had worked since August.
// An artifact row is marked as one and counted under the practice's artifacts, never its works.
// The nightly line's works are listed under the line's own name and counted as its own, no
// longer as the Atelier's (the name and the line moved apart on 2026-08-31).
//
// Honesty rules of the house, made visible here:
//   · every row is dated, from the work's own metadata;
//   · a WITHDRAWN work stays LISTED and MARKED, with its withdrawal quoted verbatim in the
//     practice's own words — never a red alarm, because a withdrawal is a completed honest act
//     (the Studio withdrew One Tap itself, in writing);
//   · the foot names the exact directories the page was built from.
//   · since 2026-08-09, what the ecology's neighbour audit found — the projects that already
//     do something like a work, named and linked on the work's own row. The audit covers four
//     works so far; the head line says how many, because a row without a note here is
//     UNEXAMINED and must never be read as cleared (docs/audits/2026-08-09-ecology-usp-audit.md).
import { NAMING } from '@/config/naming'
import { descFor } from '@/lib/engines/teaser'
import { buildRegister, REGISTER_HOUSES, summariseRegister, WORK_SOURCES, type RegisterHouse, type RegisterRow } from '@/lib/engines/register'
import { houseNames } from '@/lib/ops/house-feed'
import { GRAPH } from '@/lib/graph/load'
import { practiceWorkAudits } from '@/lib/graph/query'
import { readable } from '@/lib/graph/derive'
import { VERDICT_LEGEND } from '@/lib/graph/field'
import { lineOfWork, lineShortLabel } from '@/lib/ecology/lines'
import { Badge } from '@/components/ui/badge'
import { cn } from '@/lib/ui/cn'

const copy = NAMING.worksRegister
const { rows, undated } = buildRegister()
const summary = summariseRegister(rows)
// A work's description, where its record carries one; an artifact is its own page and brings none.
const descOf = (r: RegisterRow): string | undefined =>
  r.kind === 'work' ? descFor(r.work.ns, r.work.slug, r.work.blurb) : undefined

// The audit, keyed as this register names its works. Derived from the committed graph, which is
// derived from the audit document — so this page cannot say anything the audit does not say. It
// covers works only: an artifact row never borrows a verdict from a work that shares its slug.
const audits = practiceWorkAudits(GRAPH)
const auditOf = (r: RegisterRow) => (r.kind === 'work' ? audits.get(`${r.ns}/${r.slug}`) : undefined)
const auditedCount = rows.filter((r) => auditOf(r)).length
// The same plain words the neighbourhood figure's legend uses, so the two surfaces speak one
// language: "wide daylight" / "some daylight" / "little daylight".
const daylightWord = (verdict: string): string =>
  VERDICT_LEGEND.find((l) => l.key === verdict)?.label ?? verdict
const auditHref =
  'https://github.com/frankbueltge/frankbueltge.de/blob/main/docs/audits/2026-08-09-ecology-usp-audit.md'

// Who each row belongs to, by name: the three practices as the register has always named them,
// the nightly line by its own card (houseNames() — the signal log's derivation, not a second one).
type PracticeNs = (typeof copy.practices)[number]['ns']
const names = houseNames()
const houseName: Record<RegisterHouse, string> = {
  ...(Object.fromEntries(copy.practices.map((p) => [p.ns, p.name])) as Record<PracticeNs, string>),
  'nightly-line': names['nightly-line'],
}

// The count line, assembled from the counts and each house's OWN nouns: "N in the register ·
// A works, B artifacts by The Atelier · …". A kind a house has nothing of drops out rather than
// showing a zero, and a house with nothing on record drops out entirely.
const nounOf: Record<RegisterHouse, string> = {
  ...(Object.fromEntries(copy.practices.map((p) => [p.ns, p.noun])) as Record<PracticeNs, string>),
  'nightly-line': copy.nightlyLine.noun,
}
const perHouse = REGISTER_HOUSES.map((h) => ({
  name: houseName[h],
  parts: [
    { count: summary.byHouse[h].works, noun: nounOf[h] },
    { count: summary.byHouse[h].artifacts, noun: copy.artifactNoun },
  ].filter((p) => p.count > 0),
})).filter((h) => h.parts.length > 0)

// The foot names every place a row was read from: the work sources, then the artifact layouts
// that actually contributed a row — a layout nobody used is not a source of this page.
const artifactSources = [...new Set(rows.flatMap((r) => (r.kind === 'artifact' ? [r.source] : [])))].sort()

// The rooms line gains the nightly line's room, since its works are listed here under its name.
const rooms = [...copy.practices, copy.nightlyLine]

// Which LINE of its practice a work belongs to. Only the Atelier has run more than one (two
// since 2026-08-10, under two constitutions), so every other row gets null and shows nothing —
// a marker on a practice that runs one line is noise.
//
// This is what Frank saw missing on 2026-08-12 (his wording private): the Atelier's two lines
// were mixed together everywhere in the register. It had just been repaired in the other
// direction — the fork used to appear here as a FOURTH practice, which was worse — and the
// repair made the two lines indistinguishable. Both are the Atelier; only one keeps the nights.
//
// Only on the Atelier's own works: a nightly-line row already says whose it is in the house
// column, and an artifact is not a work of any line.
const lineOf = (r: RegisterRow) => (r.kind === 'work' && r.house === 'atelier' ? lineOfWork(r.work) : null)

// Re-skin 2d (2026-09-02): the register on the frame's recipe — the kicker as the one .kicker
// class, the head on the type scale, the list as a panel with the frame's resting depth and a
// hairline between rows, and a row that answers the pointer with the frame's own 200 ms wash.
// The withdrawal and daylight marks are Badges now instead of a hand-drawn chip; both stay in
// the mono skin, because a withdrawal is a completed honest act and a verdict is stated in
// words. Nothing about what this page LISTS changed.
const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const quietLink = 'underline decoration-line underline-offset-4 transition-colors hover:text-fg'
const mark = 'border-line font-mono text-mono-sm font-normal uppercase tracking-[0.12em]'
---

<section id="register" class="wr-register mt-16 scroll-mt-24" aria-labelledby="register-title">
  <header class="mb-8 max-w-3xl">
    <p class={cn(kicker, 'mb-2')}>
      <b class="text-fg-muted">{copy.kicker}</b> · {copy.kickerSub}
    </p>
    <h2 id="register-title" class="text-h2 font-semibold text-fg">{copy.title}</h2>
    <p class="mt-4 text-body text-fg-muted">{copy.intro}</p>
    <p class="mt-3 text-body text-fg-muted">{copy.honesty}</p>
    {/* The one confusion this route can cause, defused where it happens: /work (singular) is
        the conductor's own projects page and stays exactly what it was. */}
    <p class="mt-4 font-mono text-mono text-fg-faint">
      {copy.notThis.lead}{' '}
      <a href={copy.notThis.href} class={quietLink}>{copy.notThis.label}</a>
    </p>
  </header>

  {/* Counted, never claimed. */}
  <p class="mb-6 font-mono text-mono leading-relaxed text-fg-muted">
    <b class="tabular-nums text-fg">{summary.total}</b> in the register
    {perHouse.map((h) => (
      <>
        {' · '}
        {h.parts.map((p, i) => (
          <>
            {i > 0 ? ', ' : ''}<span class="tabular-nums">{p.count}</span> {p.noun}
          </>
        ))}
        {' '}by {h.name}
      </>
    ))}
    {summary.withdrawn > 0 && (
      <>
        {' · '}<span class="tabular-nums">{summary.withdrawn}</span> withdrawn, still listed
      </>
    )}
    {summary.first && summary.last && (
      <span class="text-fg-faint"> · {summary.first} → {summary.last}</span>
    )}
  </p>

  {/* The absence, said once and plainly rather than repeated as a disclaimer on 55 rows. A
      catalogue that stamped "not checked" beside almost every line would read as noise and stop
      being read at all; a single sentence that names the ratio cannot be skimmed past. */}
  <p class="mb-6 max-w-[80ch] font-mono text-mono-sm leading-relaxed text-fg-faint">
    Prior art checked for <b class="tabular-nums text-fg-muted">{auditedCount}</b> of{' '}
    <span class="tabular-nums">{summary.total}</span> entries
    (<a href={auditHref} rel="noopener" class={quietLink}>the audit of 2026-08-09</a>).
    An entry without a note below is <b class="text-fg-muted">unexamined, not cleared</b>.
  </p>

  <ol class={cn(panel, 'divide-y divide-line/60 overflow-hidden')}>
    {rows.map((r) => {
      const audit = auditOf(r)
      const work = r.kind === 'work' ? r.work : null
      const desc = descOf(r)
      const line = lineOf(r)
      return (
      <li class="wr-row" data-voice={r.ns} data-house={r.house} data-kind={r.kind}>
        <a href={r.href} class="group flex flex-wrap items-baseline gap-x-3 gap-y-1 py-3.5 pl-4 pr-4 sm:pl-6 sm:pr-6">
          <span class="w-[6.5em] shrink-0 whitespace-nowrap font-mono text-mono-sm tabular-nums text-fg-faint">{r.date}</span>
          {/* nowrap and wide enough for the longest house name: at 7.5em "THE ATELIER" broke over
              two lines and pushed its own row taller than the rest of the register, and since
              2026-10-04 the column also carries the nightly line's own name, which is longer. */}
          <span class="w-[11.5em] shrink-0 whitespace-nowrap font-mono text-mono-xs uppercase tracking-[0.14em] text-fg-muted">{houseName[r.house]}</span>
          <span class="text-h3 font-semibold group-hover:text-fg">{r.title}</span>
          {/* What the row IS, where it is not a work: a session's artifact under research ecology
              v3. Set like the line marker — a leading rule, no box — because it is a fact about
              the thing, not a state the record put on it. */}
          {r.kind === 'artifact' && (
            <span class="wr-kind font-mono text-mono-xs uppercase tracking-[0.12em] text-fg-faint">{copy.artifactLabel}</span>
          )}
          {/* The line, where a practice runs more than one. It sits AFTER the title rather than in
              the practice column: the column is fixed-width so that titles align down the whole
              register, and a second word in it would have pushed every title of every practice. */}
          {line && (
            <span class="wr-line font-mono text-mono-xs uppercase tracking-[0.12em] text-fg-faint">{lineShortLabel(line)}</span>
          )}
          {work?.state === 'withdrawn' && (
            <Badge variant="outline" className={cn(mark, 'text-fg-faint')}>
              {copy.withdrawnLabel}{work.withdrawnOn && ` ${work.withdrawnOn}`}
            </Badge>
          )}
          {/* The second-line indent is in rem, not em: the two lines below run at different font
              sizes, so an em indent would have set them a dozen pixels apart under the same title.
              13.2rem = the date column (6.5em at 11px) + the house column (11.5em at 10px) + two
              gaps of 0.75rem. */}
          {desc && (
            <span class="w-full text-small leading-snug text-fg-muted line-clamp-2 sm:pl-[13.2rem]">{desc}</span>
          )}
          {/* The withdrawal itself, verbatim and in full — a mark the record keeps has to be
              readable, not a tooltip somebody has to find. */}
          {work?.withdrawnNote && (
            <span class="w-full font-mono text-mono-sm leading-relaxed text-fg-faint sm:pl-[13.2rem]">{work.withdrawnNote}</span>
          )}
        </a>
        {/* The neighbours, OUTSIDE the row's link: they are links of their own, and a link
            inside a link is invalid HTML that browsers silently take apart. No colour is added
            here — the practice's hairline is the row's only hue, and a verdict is stated in
            words ("little daylight"), never painted. */}
        {audit && (
          <div class="wr-audit pb-3.5 pl-4 pr-4 sm:pl-6 sm:pr-6">
            <p class="font-mono text-mono-sm leading-relaxed text-fg-faint sm:pl-[13.2rem]">
              <Badge variant="outline" className={cn(mark, 'mr-2 text-fg-muted')}>{daylightWord(audit.verdict)}</Badge>
              nearest prior art:{' '}
              {audit.neighbours.map((n, i) => (
                <>
                  {i > 0 ? ' · ' : ''}
                  {n.url ? (
                    <a href={n.url} rel="noopener nofollow" class={quietLink}>{readable(n.label)}</a>
                  ) : (
                    <span>{readable(n.label)}</span>
                  )}
                </>
              ))}
            </p>
          </div>
        )}
      </li>
      )
    })}
  </ol>

  <p class="mt-6 font-mono text-mono leading-relaxed text-fg-faint">
    {copy.roomsLead}
    {rooms.map((p, i) => (
      <>
        {i > 0 ? ' · ' : ' '}<a href={p.roomHref} class={quietLink}>{p.roomLabel}</a>
      </>
    ))}
  </p>

  {/* The note that used to send a reader from /works to the entrance's own strip is gone: the
      register IS on the entrance now, and a link from a page to itself is not a way out. */}

  {/* Provenance: the directories this page was built from, named so the list can be checked
      against the repository without reading the code. */}
  <footer class="mt-10 border-t border-line/60 pt-5">
    <p class="font-mono text-mono-sm leading-relaxed text-fg-faint">
      {copy.provenanceLead}
      {WORK_SOURCES.map((s, i) => (
        <>
          {i > 0 ? ' · ' : ' '}<code class="text-fg-muted">{s.dir}/*/meta.json</code>
        </>
      ))}
      {artifactSources.length > 0 && (
        <>
          {' — '}{copy.provenanceArtifactsLead}
          {artifactSources.map((s, i) => (
            <>
              {i > 0 ? ' · ' : ' '}<code class="text-fg-muted">{s}</code>
            </>
          ))}
        </>
      )}
    </p>
    {/* An artifact the practices committed with no day on its record: named here, so its
        absence from the dated list above is said rather than left for a reader to discover. */}
    {undated.length > 0 && (
      <p class="mt-2 max-w-[80ch] font-mono text-mono-sm leading-relaxed text-fg-faint">
        {copy.undatedLead}
        {undated.map((a, i) => (
          <>
            {i > 0 ? ' · ' : ' '}<a href={a.href} class={quietLink}>{houseName[a.practice]}: {a.title ?? a.slug}</a>
          </>
        ))}
      </p>
    )}
    <p class="mt-2 max-w-[80ch] font-mono text-mono-sm leading-relaxed text-fg-faint">{copy.provenanceTail}</p>
  </footer>
</section>

<style>
  /* PALETTE: ecology-voices (src/lib/dataviz/palette.ts) — validated 2026-07-31, --pairs all,
     against the panel surfaces this register sits on (#f7f8fa light / #141414 dark, the same
     two the set records): PASS in both modes. Own steps per mode, never an automatic flip.
     The same quartet the hub doors, the encounter score map and the Partitur carry, so a
     practice never wears two colours on this site. Only the three PRACTICE slots appear here:
     the Plenum keeps its house elsewhere and is not in this register, and The Middle is a
     declared neutral, not a categorical slot — giving either one a rule on this page would put
     a hue on an identity the page does not list.
     The hue carries no information of its own: every row is DIRECT-LABELLED with the practice's
     name in the column beside it, so the register reads identically without colour (which is
     also why the set's light-mode contrast WARN cannot bite here — no text is ever painted in
     these hues, only a 3px rule). */
  :root[data-theme='light'] .wr-register {
    --wr-c-atelier: #4a3aa7;
    --wr-c-field: #2a78d6;
    --wr-c-studio: #eb6834;
  }
  :root[data-theme='dark'] .wr-register {
    --wr-c-atelier: #9085e9;
    --wr-c-field: #256abf;
    --wr-c-studio: #d95926;
  }

  /* The practice's hairline down the left edge of its row — the register's spine. Drawn as a
     border on the row itself (not a pseudo-element on the link) so it survives wrapping rows. */
  .wr-row {
    border-left: 3px solid var(--wr-c, transparent);
  }
  .wr-row[data-voice='atelier'] { --wr-c: var(--wr-c-atelier); }
  .wr-row[data-voice='field'] { --wr-c: var(--wr-c-field); }
  .wr-row[data-voice='studio'] { --wr-c: var(--wr-c-studio); }

  /* The row answers the pointer with the frame's own gesture, at the frame's own speed
     (re-skin 2d, 2026-09-02): a register is read by running down it, so a row washes rather
     than rises — a lift on 57 stacked rows would ripple the whole plate. :focus-within so a
     row reached by Tab shows what its mouse visitor sees. The 200 ms and the easing are the
     frame's; the utility rule in global.css cannot reach a <li>, which is why it stands here. */
  .wr-row {
    transition: background-color 0.2s var(--ease-frame);
  }
  .wr-row:hover,
  .wr-row:focus-within {
    background-color: var(--color-panel-2);
  }

  /* The withdrawal and daylight marks moved onto the shared Badge primitive on 2026-09-02;
     both stay in the mono skin, never a warning red — a withdrawal is a completed honest act,
     not an error state (CLAUDE.md: status colours are out of bounds where the practice does
     not judge). */

  /* The line marker is NOT a chip. A chip is a state the record put on a work — withdrawn,
     little daylight — and a line is neither a state nor a judgement: it is which strand of the
     practice made the thing. So it wears the practice's own hairline as a leading rule and no
     box, which also keeps it from reading as a second withdrawal mark two words further along
     the same row. */
  .wr-line,
  .wr-kind {
    border-left: 2px solid var(--wr-c, var(--color-line));
    padding-left: 6px;
    white-space: nowrap;
  }
</style>

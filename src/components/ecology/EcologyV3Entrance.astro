---
// The v3 ecology entrance (research ecology v3, 2026-08-30 — the shared question).
//
// One surface, four moves, and it stops: what this is · where the house clock stands (the
// cycle) · what each practice just did (the three bulletins, verbatim) · what the cycles have
// produced (the presentations). Properties kept from the surface it replaces:
//
//   · NO NUMBER IS TYPED — cycle, dates, line counts and file counts come from
//     src/lib/ecology/v3.ts, which reads only committed files. Copy that wraps a number is a
//     function in ECOLOGY_V3 taking that number as its argument.
//   · NO CLIENT DATA FETCHING — static output, nothing moves.
//   · ABSENCE IS DRAWN — a practice without a bulletin says so in its own panel; an empty
//     presentation shelf says why it is empty. No placeholder stands in for a missing record.
//   · THE RECORD IS QUOTED, NOT PARAPHRASED — bulletins render verbatim (truncation is
//     declared), because the bulletin IS the practice's public sentence under this order.
//     Since 2026-09-01 the words pass through bulletinBlocks(): the bold, code and headings
//     a practice wrote are ITS OWN marks — showing the asterisks instead of the emphasis
//     they encode dropped information, which is the opposite of fidelity.
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/lib/site'
import { ECOLOGY_V3 } from '@/config/ecology-v3-wording'
import { bulletinBlocks } from '@/lib/ecology/bulletin-render'
import CycleScoreFigure from '@/components/ecology/CycleScoreFigure.astro'
import { buildCycleModel } from '@/lib/ecology/cycle-model'
import {
  BULLETIN_DISPLAY_MAX,
  inCycle,
  loadArtifacts,
  loadBulletin,
  loadClosingReports,
  loadCycle,
  loadEncounters,
  loadLetters,
  loadPresentations,
  loadSessionNotes,
  PRACTICES,
  PRACTICE_REPO,
} from '@/lib/ecology/v3'

const locale = (Astro.currentLocale ?? 'en') as Locale
const url = (href: string) => (href.startsWith('http') ? href : getRelativeLocaleUrl(locale, href))

const W = ECOLOGY_V3
const cycle = loadCycle()
const phase = W.cycle.phase[cycle.phase]
const bulletins = PRACTICES.map((id) => ({ id, ...W.practices[id], bulletin: loadBulletin(id) }))
const presentations = loadPresentations()
const closing = loadClosingReports()
// The partitur and the trail show the CURRENT cycle only — their labels say so, and the filter
// is what makes the labels true. Since 2026-09-02 the loader reads all three practices'
// conventions (the Field's artifacts/, the Atelier's window/, the Studio's works — v3.ts says
// which), and inCycle() is the one rule for "this cycle": the cycle a path names, or, for a
// work that names none, the house clock — shipped on or after the day the cycle opened.
const cycleArtifacts = loadArtifacts().filter((a) => inCycle(a, cycle))
// The score of 2026-09-02 draws the WHOLE cycle, not only its artifacts: the sessions that
// produced them, the letters the house prepared for receivers outside it, the encounters in
// which one practice's material arrived in another's work, and the presentations that close the
// cycle. All four records were already committed and already had surfaces; the partitur is the
// first place they stand on one ruler. The geometry is derived in src/lib/ecology/cycle-model.ts
// — this page only hands it what the loaders read.
const model = buildCycleModel({
  cycle,
  artifacts: cycleArtifacts,
  sessions: PRACTICES.flatMap((id) => loadSessionNotes(id, cycle.opened)),
  letters: loadLetters(cycle.opened),
  encounters: loadEncounters(cycle.opened),
  presentations,
})

const kicker = 'font-mono text-xs uppercase tracking-[0.22em] text-fg-muted'

/* the same block classes the practice stations use — one bulletin, one look, everywhere */
const blockClass: Record<string, string> = {
  heading: 'pt-2 font-mono text-[13px] uppercase tracking-[0.14em] text-fg first:pt-0',
  listItem: 'border-l border-line pl-3 text-sm leading-relaxed text-fg-muted',
  para: 'text-sm leading-relaxed text-fg-muted',
}
---

<article class="mx-auto max-w-5xl px-4 pb-20 pt-10 sm:px-6">
  {/* ── Head ─────────────────────────────────────────────────────────────── */}
  <header>
    <p class={kicker}>{W.head.kicker}</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-fg sm:text-4xl">{W.head.title}</h1>
    <p class="mt-4 max-w-3xl leading-relaxed text-fg-muted">{W.head.intro}</p>
    <p class="mt-3 font-mono text-xs text-fg-faint">
      {W.head.orderLine}
      {' '}<a class="underline decoration-line underline-offset-4 hover:text-fg" href={W.head.decisionHref}>{W.head.decisionLabel}</a>
      {' '}· <a class="underline decoration-line underline-offset-4 hover:text-fg" href={url(W.head.seedHref)}>{W.head.seedLabel}</a>
    </p>
  </header>

  {/* ── The cycle ────────────────────────────────────────────────────────── */}
  <section class="mt-12 rounded-sm border border-line bg-panel p-5 sm:p-6" aria-label="Current cycle">
    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
      <h2 class="font-mono text-sm uppercase tracking-[0.18em] text-fg">{W.cycle.label(cycle.cycle)}</h2>
      <span class="font-mono text-xs uppercase tracking-[0.18em] text-accent">{phase.badge}</span>
      <span class="font-mono text-xs text-fg-faint">{W.cycle.openedLine(cycle.opened)}</span>
    </div>
    <p class="mt-3 max-w-3xl leading-relaxed text-fg-muted">{phase.copy}</p>
    {
      (
        <div class="mt-5 border-t border-line pt-4">
          {cycle.source === 'seed' && cycle.question ? (
            <>
              <p class={kicker}>{W.cycle.seededQuestionKicker}</p>
              <p class="mt-2 text-lg leading-snug text-fg">{cycle.question}</p>
            </>
          ) : (
            <>
              <p class={kicker}>{cycle.phase === 'closing' ? W.cycle.nextCycleKicker(cycle.cycle + 1) : W.cycle.defaultsKicker}</p>
              <ul class="mt-2 space-y-1.5">
                {PRACTICES.map((id) => (
                  <li class="leading-relaxed text-fg-muted">
                    <span class="font-mono text-xs uppercase tracking-[0.14em] text-fg">{W.practices[id].name}</span>
                    <span class="text-fg-faint"> — </span>
                    {cycle.defaults[id]}
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="mt-3 font-mono text-xs text-fg-faint">{W.cycle.rhythm(cycle.sessionsPerPractice)}</p>
        </div>
      )
    }
  </section>

  {/* ── The cycle, drawn ─────────────────────────────────────────────────── */}
  <section class="mt-10" aria-label="The running cycle, drawn as a score">
    <CycleScoreFigure model={model} />
  </section>

  {/* ── The three bulletins ──────────────────────────────────────────────── */}
  {/* Rendered through bulletinBlocks() since 2026-09-01, the same renderer the practice
      stations use: the emphasis and headings ARE the practice's own marks — a raw dump showed
      the asterisks instead of the emphasis they encode, which loses information rather than
      adding fidelity. The words remain byte-verbatim; truncation is still declared.
      Redesigned the same day (Frank's UX verdict, wording private): three parallel forty-line
      columns were a wall. Each bulletin now stands full-width, its opening block visible, the
      rest behind a native <details> fold — nothing summarised, everything one click away. */}
  <section class="mt-12" aria-label="The three practices and their latest bulletins">
    <div class="space-y-5">
      {
        bulletins.map((p) => (
          <div class="flex flex-col rounded-sm border border-line bg-panel">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-b border-line p-4">
              <h3 class="text-lg font-semibold text-fg">
                <a class="hover:underline" href={url(p.href)}>{p.name}</a>
                <span class="ml-2 font-mono text-xs font-normal text-fg-faint">{p.persona} · {p.corner}</span>
              </h3>
              <a
                class="font-mono text-xs text-fg-faint underline decoration-line underline-offset-4 hover:text-fg"
                href={`https://github.com/frankbueltge/${PRACTICE_REPO[p.id]}/blob/main/BULLETIN.md`}
              >{W.bulletin.sourceLabel}</a>
            </div>
            <div class="p-4">
              {
                p.bulletin.present ? (
                  ((blocks) => {
                    // The preview runs to the end of the first paragraph — the practices open
                    // their bulletins with the session line (date, session, question), and THAT
                    // is what a reader needs before deciding to unfold; a bare markdown title
                    // alone previews nothing.
                    const firstPara = blocks.findIndex((b) => b.kind === 'para')
                    const cut = firstPara === -1 ? 1 : firstPara + 1
                    const head = blocks.slice(0, cut)
                    const rest = blocks.slice(cut)
                    return (
                    <>
                      <div class="space-y-2.5">
                        {head.map((b) => (
                          <p class={blockClass[b.kind]}>
                            {b.segments.map((s) =>
                              s.kind === 'strong' ? (
                                <strong class="font-semibold text-fg">{s.text}</strong>
                              ) : s.kind === 'code' ? (
                                <code class="rounded bg-panel-2 px-1 font-mono text-[0.9em]">{s.text}</code>
                              ) : (
                                <>{s.text}</>
                              ),
                            )}
                          </p>
                        ))}
                      </div>
                      {rest.length > 0 && (
                        <details class="eco-bulletin-fold group mt-3">
                          <summary class="cursor-pointer list-none font-mono text-xs text-fg-muted underline decoration-line underline-offset-4 hover:text-fg">
                            <span class="group-open:hidden">{W.bulletin.expand(p.bulletin.lines)}</span>
                            <span class="hidden group-open:inline">{W.bulletin.collapse}</span>
                          </summary>
                          <div class="mt-3 space-y-2.5 border-t border-line pt-3">
                            {rest.map((b) => (
                              <p class={blockClass[b.kind]}>
                                {b.segments.map((s) =>
                                  s.kind === 'strong' ? (
                                    <strong class="font-semibold text-fg">{s.text}</strong>
                                  ) : s.kind === 'code' ? (
                                    <code class="rounded bg-panel-2 px-1 font-mono text-[0.9em]">{s.text}</code>
                                  ) : (
                                    <>{s.text}</>
                                  ),
                                )}
                              </p>
                            ))}
                            {p.bulletin.truncated && (
                              <p class="font-mono text-xs text-fg-faint">
                                {W.bulletin.truncatedNote(p.bulletin.lines, BULLETIN_DISPLAY_MAX)}
                              </p>
                            )}
                          </div>
                        </details>
                      )}
                    </>
                    )
                  })(bulletinBlocks(p.bulletin.text!))
                ) : (
                  <p class="text-sm leading-relaxed text-fg-faint">{W.bulletin.absent}</p>
                )
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── The artifact trail ───────────────────────────────────────────────── */}
  <section class="mt-12" aria-label="The artifact trail">
    <p class={kicker}>{W.artifacts.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.artifacts.intro}</p>
    {
      cycleArtifacts.length === 0 ? (
        <p class="mt-4 rounded-sm border border-dashed border-line p-4 text-sm leading-relaxed text-fg-faint">
          {W.artifacts.empty}
        </p>
      ) : (
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {cycleArtifacts.map((a) => (
            <li class="rounded-sm border border-line bg-panel p-4">
              <p class="font-mono text-xs uppercase tracking-[0.14em] text-fg-faint">
                {W.practices[a.practice].name}{a.date && <> · {a.date}</>}
              </p>
              <a class="mt-1 block text-fg hover:underline" href={url(a.href)}>
                {W.artifacts.entryLabel(a.slug, a.title)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ── Closing reports (the one-time transition) ────────────────────────── */}
  <section class="mt-12" aria-label="Closing reports">
    <p class={kicker}>{W.closing.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.closing.intro}</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        PRACTICES.map((id) => {
          const report = closing.find((c) => c.practice === id)
          const name = W.practices[id].name
          return (
            <li class="rounded-sm border border-line bg-panel p-4">
              {report ? (
                <a class="text-fg hover:underline" href={url(report.href)}>{W.closing.linkLabel(name)}</a>
              ) : (
                <span class="text-sm text-fg-faint">{W.closing.missing(name)}</span>
              )}
            </li>
          )
        })
      }
    </ul>
  </section>

  {/* ── Presentations ────────────────────────────────────────────────────── */}
  <section class="mt-12" aria-label="Presentations">
    <p class={kicker}>{W.presentations.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.presentations.intro}</p>
    {
      presentations.length === 0 ? (
        <p class="mt-4 rounded-sm border border-dashed border-line p-4 text-sm leading-relaxed text-fg-faint">
          {W.presentations.empty}
        </p>
      ) : (
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {presentations.map((e) => (
            <li class="rounded-sm border border-line bg-panel p-4">
              <a class="text-fg hover:underline" href={e.href.startsWith('http') ? e.href : url(e.href)}>
                {W.presentations.entryLabel(e.cycle, W.practices[e.practice].name)}
              </a>
              <p class="mt-1 font-mono text-xs text-fg-faint">{W.presentations.fileCount(e.files)}</p>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ── Lineage + doors ──────────────────────────────────────────────────── */}
  <footer class="mt-14 border-t border-line pt-6">
    <p class="max-w-3xl text-sm leading-relaxed text-fg-faint">{W.foot.lineage}</p>
    <nav class="mt-4 flex flex-wrap gap-x-5 gap-y-2" aria-label="Ecology doors">
      {
        W.foot.links.map((l) => (
          <a class="font-mono text-xs text-fg-muted underline decoration-line underline-offset-4 hover:text-fg" href={url(l.href)}>{l.label}</a>
        ))
      }
    </nav>
  </footer>
</article>

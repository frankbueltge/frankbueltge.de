---
// The v3 ecology entrance (research ecology v3, 2026-08-30 — the shared question).
//
// One surface, five moves, and it stops: what this is · where the house clock stands (the
// cycle) · what each practice just did (the three bulletins, verbatim) · what the cycles have
// produced (the presentations) · and, since 2026-09-03, the complete works register, which used
// to be a page of its own at /works. Frank moved it here: the catalogue of what this house has
// brought forth belongs on the page that IS the house. /works redirects to its anchor.
// Properties kept from the surface it replaces:
//
//   · NO NUMBER IS TYPED — cycle, dates, line counts and file counts come from
//     src/lib/ecology/v3.ts, which reads only committed files. Copy that wraps a number is a
//     function in ECOLOGY_V3 taking that number as its argument.
//   · NO CLIENT DATA FETCHING — static output, nothing moves.
//   · ABSENCE IS DRAWN — a practice without a bulletin says so in its own panel; an empty
//     presentation shelf says why it is empty. No placeholder stands in for a missing record.
//   · THE RECORD IS QUOTED, NOT PARAPHRASED — bulletins render verbatim (truncation is
//     declared), because the bulletin IS the practice's public sentence under this order.
//     Since 2026-09-01 the words pass through bulletinBlocks(): the bold, code and headings
//     a practice wrote are ITS OWN marks — showing the asterisks instead of the emphasis
//     they encode dropped information, which is the opposite of fidelity.
//
// Re-skin 2b (2026-09-02): the same four moves on the frame's recipe. Headings on the type
// scale, kickers on the `.kicker` class, panels on the frame's radius and resting depth, every
// link inside a panel cut from the shadcn Button recipe (one hover surface, one focus ring, the
// top bar's), a card where an entry is a card (the artifact trail, the closing reports, the
// presentations — these `.lift` on hover because each one leads somewhere), and the bulletin
// fold wearing the frame's turning chevron. The bulletins themselves stay still: they are read
// in place, not opened. Nothing here decides a colour; the primitives take theirs from the
// token bridge in global.css.
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/lib/site'
import { ECOLOGY_V3 } from '@/config/ecology-v3-wording'
import { bulletinBlocks } from '@/lib/ecology/bulletin-render'
import CycleScoreFigure from '@/components/ecology/CycleScoreFigure.astro'
import WorksRegisterSection from '@/components/ecology/WorksRegisterSection.astro'
import { buildCycleModel } from '@/lib/ecology/cycle-model'
import { buildProgramme, conveningView, loadRelayExtras, rankedScores } from '@/lib/ecology/convening'
import { evidenceUrl } from '@/lib/ecology/relay'
import {
  BULLETIN_DISPLAY_MAX,
  inCycle,
  loadArtifacts,
  loadBulletin,
  loadClosingReports,
  loadCycle,
  loadEncounters,
  loadLetters,
  loadPresentations,
  loadSessionNotes,
  PRACTICES,
  PRACTICE_REPO,
} from '@/lib/ecology/v3'
import { buttonVariants } from '@/components/ui/button'
import { Badge } from '@/components/ui/badge'
import { Card, CardContent } from '@/components/ui/card'
import { cn } from '@/lib/ui/cn'

const locale = (Astro.currentLocale ?? 'en') as Locale
const url = (href: string) => (href.startsWith('http') ? href : getRelativeLocaleUrl(locale, href))

const W = ECOLOGY_V3
const cycle = loadCycle()
const phase = W.cycle.phase[cycle.phase]
const bulletins = PRACTICES.map((id) => ({ id, ...W.practices[id], bulletin: loadBulletin(id) }))
const presentations = loadPresentations()
const closing = loadClosingReports()
// The convening and the programme (2026-10-07) come from the Middle's relay, read loosely: an
// absent or unreadable relay, or one without these sections, leaves the convening "not recorded"
// and the programme on the site's own record — never a failed build.
const extras = loadRelayExtras()
const conv = conveningView(cycle, extras)
const programme = buildProgramme(extras.programme, cycle, presentations)
const name = (p: (typeof PRACTICES)[number]) => W.practices[p].name
const questionKicker =
  cycle.phase === 'convening'
    ? W.cycle.presentedQuestionKicker
    : cycle.source === 'seed'
      ? W.cycle.seededQuestionKicker
      : cycle.source === 'convening'
        ? W.cycle.conveningQuestionKicker(cycle.cycle - 1)
        : W.cycle.continuingQuestionKicker
// The partitur and the trail show the CURRENT cycle only — their labels say so, and the filter
// is what makes the labels true. Since 2026-09-02 the loader reads all three practices'
// conventions (the Field's artifacts/, the Atelier's window/, the Studio's works — v3.ts says
// which), and inCycle() is the one rule for "this cycle": the cycle a path names, or, for a
// work that names none, the house clock — shipped on or after the day the cycle opened.
const cycleArtifacts = loadArtifacts().filter((a) => inCycle(a, cycle))
// The score of 2026-09-02 draws the WHOLE cycle, not only its artifacts: the sessions that
// produced them, the letters the house prepared for receivers outside it, the encounters in
// which one practice's material arrived in another's work, and the presentations that close the
// cycle. All four records were already committed and already had surfaces; the partitur is the
// first place they stand on one ruler. The geometry is derived in src/lib/ecology/cycle-model.ts
// — this page only hands it what the loaders read.
const model = buildCycleModel({
  cycle,
  artifacts: cycleArtifacts,
  sessions: PRACTICES.flatMap((id) => loadSessionNotes(id, cycle.opened)),
  letters: loadLetters(cycle.opened),
  encounters: loadEncounters(cycle.opened),
  presentations,
})

/* the frame's recipe, named once so every block below is cut from the same cloth */
const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const quiet = cn(
  buttonVariants({ variant: 'ghost', size: 'sm' }),
  'h-7 px-2 font-mono text-mono-sm font-normal text-fg-muted hover:text-fg',
)
const empty = 'mt-4 rounded-md border border-dashed border-line p-4 text-sm leading-relaxed text-fg-faint'
/* a card that leads somewhere: the frame's resting depth, and the lift on hover or focus */
const card = 'lift h-full rounded-md gap-1 py-3.5 shadow-none panel-raised'

/* the same block classes the practice stations use — one bulletin, one look, everywhere */
const blockClass: Record<string, string> = {
  heading: 'pt-2 font-mono text-[13px] uppercase tracking-[0.14em] text-fg first:pt-0',
  listItem: 'border-l border-line pl-3 text-sm leading-relaxed text-fg-muted',
  para: 'text-sm leading-relaxed text-fg-muted',
}
---

<article class="mx-auto max-w-5xl px-4 pb-20 pt-10 sm:px-6">
  {/* ── Head ─────────────────────────────────────────────────────────────── */}
  <header>
    <p class={kicker}>{W.head.kicker}</p>
    <h1 class="mt-3 text-h1 font-semibold text-fg">{W.head.title}</h1>
    <p class="mt-4 max-w-3xl leading-relaxed text-fg-muted">{W.head.intro}</p>
    <p class="mt-3 font-mono text-mono text-fg-faint">
      {W.head.orderLine}
      {' '}<a class="underline decoration-line underline-offset-4 hover:text-fg" href={W.head.decisionHref}>{W.head.decisionLabel}</a>
      {' '}· <a class="underline decoration-line underline-offset-4 hover:text-fg" href={url(W.head.seedHref)}>{W.head.seedLabel}</a>
    </p>
  </header>

  {/* ── The cycle ────────────────────────────────────────────────────────── */}
  <section class={cn(panel, 'mt-12 p-5 sm:p-6')} aria-label="Current cycle">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5">
      <h2 class="font-mono text-sm uppercase tracking-[0.18em] text-fg">{W.cycle.label(cycle.cycle)}</h2>
      <Badge variant="outline" className="border-line font-mono text-[10px] font-normal uppercase tracking-[0.18em] text-accent">
        {phase.badge}
      </Badge>
      <span class="font-mono text-mono text-fg-faint">{W.cycle.openedLine(cycle.opened)}</span>
    </div>
    <p class="mt-3 max-w-3xl leading-relaxed text-fg-muted">{phase.copy}</p>
    {
      (
        <div class="mt-5 border-t border-line pt-4">
          {cycle.source !== 'defaults' && cycle.question ? (
            <>
              <p class={kicker}>{questionKicker}</p>
              <p class="mt-2 text-lg leading-snug text-fg">{cycle.question}</p>
            </>
          ) : (
            <>
              <p class={kicker}>{cycle.phase === 'closing' ? W.cycle.nextCycleKicker(cycle.cycle + 1) : W.cycle.defaultsKicker}</p>
              <ul class="mt-2 space-y-1.5">
                {PRACTICES.map((id) => (
                  <li class="leading-relaxed text-fg-muted">
                    <span class="font-mono text-mono uppercase tracking-[0.14em] text-fg">{W.practices[id].name}</span>
                    <span class="text-fg-faint"> — </span>
                    {cycle.defaults[id]}
                  </li>
                ))}
              </ul>
            </>
          )}
          <p class="mt-3 font-mono text-mono text-fg-faint">{W.cycle.rhythm(cycle.sessionsPerPractice)}</p>
        </div>
      )
    }

    {/* The convening (2026-10-07): only while the house is in it. Every line is the relay's own
        record, every date the one the cycle clock acts on (src/lib/ecology/convening.ts). */}
    {
      conv && (
        <div class="mt-5 border-t border-line pt-4">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class={kicker}>{W.convening.kicker(conv.afterCycle)}</h3>
            <span class="font-mono text-mono text-fg-faint">{W.convening.openedLine(conv.opened)}</span>
          </div>
          {conv.recorded ? (
            <div class="mt-3 grid gap-5 md:grid-cols-2">
              <div>
                <p class="font-mono text-mono-sm uppercase tracking-[0.14em] text-fg-faint">{W.convening.proposals}</p>
                {conv.proposals.length === 0 ? (
                  <p class="mt-2 text-sm text-fg-faint">{W.convening.none}</p>
                ) : (
                  <ul class="mt-2 space-y-3">
                    {conv.proposals.map((p) => (
                      <li class="border-l border-line pl-3">
                        <p class="leading-snug text-fg">{p.question}</p>
                        {p.docksOnto && (
                          <p class="mt-1 text-sm leading-relaxed text-fg-muted">
                            <span class="font-mono text-mono-sm text-fg-faint">{W.convening.docksOnto}</span> {p.docksOnto}
                          </p>
                        )}
                        <p class="mt-1 flex flex-wrap gap-x-2 font-mono text-mono-sm text-fg-faint">
                          <span>{W.convening.proposedBy(name(p.practice))}</span>
                          {p.date && <span>· {p.date}</span>}
                          {evidenceUrl(p.ref) && (
                            <a class="underline hover:text-fg" href={evidenceUrl(p.ref)!}>{W.convening.source}</a>
                          )}
                        </p>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
              <div>
                <p class="font-mono text-mono-sm uppercase tracking-[0.14em] text-fg-faint">{W.convening.rankings}</p>
                {conv.rankings.length === 0 ? (
                  <p class="mt-2 text-sm text-fg-faint">{W.convening.none}</p>
                ) : (
                  <ul class="mt-2 space-y-1.5">
                    {conv.rankings.map((r) => (
                      <li class="flex flex-wrap gap-x-2 text-sm leading-relaxed text-fg-muted">
                        <span class="font-mono text-mono-sm text-fg">{name(r.practice)}</span>
                        <span>{r.order.map(name).join(' › ')}</span>
                        {evidenceUrl(r.ref) && (
                          <a class="font-mono text-mono-sm text-fg-faint underline hover:text-fg" href={evidenceUrl(r.ref)!}>
                            {W.convening.source}
                          </a>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
                {conv.result && (
                  <div class="mt-4 rounded-md border border-line p-3">
                    <p class="font-mono text-mono-sm uppercase tracking-[0.14em] text-fg-faint">{W.convening.result}</p>
                    <p class="mt-1.5 leading-snug text-fg">{conv.result.question}</p>
                    <p class="mt-1.5 font-mono text-mono-sm leading-relaxed text-fg-faint">
                      {[
                        conv.result.proposedBy && W.convening.proposedBy(name(conv.result.proposedBy)),
                        `${W.convening.tally(conv.result.rule)}: ${rankedScores(conv.result).map((s) => `${name(s.practice)} ${s.score}`).join(', ')}`,
                        W.convening.talliedOn(conv.result.talliedOn),
                      ]
                        .filter(Boolean)
                        .join(' · ')}
                    </p>
                    {conv.stands && conv.opensOn ? (
                      <p class="mt-2 text-sm leading-relaxed text-fg">{W.convening.opensOn(conv.next, conv.opensOn)}</p>
                    ) : (
                      conv.objected && <p class="mt-2 text-sm leading-relaxed text-fg-muted">{W.convening.objected(conv.objected)}</p>
                    )}
                  </div>
                )}
              </div>
            </div>
          ) : (
            <p class={empty}>{W.convening.notRecorded}</p>
          )}
          {!conv.opensOn && (
            <p class="mt-3 font-mono text-mono text-fg-faint">{W.convening.fallback(conv.next, conv.fallbackOn, conv.continuing)}</p>
          )}
        </div>
      )
    }
  </section>

  {/* ── The cycle, drawn ─────────────────────────────────────────────────── */}
  <section class="mt-10" aria-label="The running cycle, drawn as a score">
    <CycleScoreFigure model={model} />
  </section>

  {/* ── The three bulletins ──────────────────────────────────────────────── */}
  {/* Rendered through bulletinBlocks() since 2026-09-01, the same renderer the practice
      stations use: the emphasis and headings ARE the practice's own marks — a raw dump showed
      the asterisks instead of the emphasis they encode, which loses information rather than
      adding fidelity. The words remain byte-verbatim; truncation is still declared.
      Redesigned the same day (Frank's UX verdict, wording private): three parallel forty-line
      columns were a wall. Each bulletin now stands full-width, its opening block visible, the
      rest behind a native <details> fold — nothing summarised, everything one click away. */}
  <section class="mt-12" aria-label="The three practices and their latest bulletins">
    <div class="space-y-5">
      {
        bulletins.map((p) => (
          <div class={cn(panel, 'flex flex-col')}>
            <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-line py-3 pl-4 pr-2 sm:pl-5">
              <h3 class="text-h3 font-semibold text-fg">
                <a class="hover:underline" href={url(p.href)}>{p.name}</a>
                <span class="ml-2 font-mono text-mono-sm font-normal text-fg-faint">{p.persona} · {p.corner}</span>
              </h3>
              <a
                class={cn(quiet, 'text-fg-faint')}
                href={`https://github.com/frankbueltge/${PRACTICE_REPO[p.id]}/blob/main/BULLETIN.md`}
              >{W.bulletin.sourceLabel}</a>
            </div>
            <div class="p-4 sm:p-5">
              {
                p.bulletin.present ? (
                  ((blocks) => {
                    // The preview runs to the end of the first paragraph — the practices open
                    // their bulletins with the session line (date, session, question), and THAT
                    // is what a reader needs before deciding to unfold; a bare markdown title
                    // alone previews nothing.
                    const firstPara = blocks.findIndex((b) => b.kind === 'para')
                    const cut = firstPara === -1 ? 1 : firstPara + 1
                    const head = blocks.slice(0, cut)
                    const rest = blocks.slice(cut)
                    return (
                    <>
                      <div class="space-y-2.5">
                        {head.map((b) => (
                          <p class={blockClass[b.kind]}>
                            {b.segments.map((s) =>
                              s.kind === 'strong' ? (
                                <strong class="font-semibold text-fg">{s.text}</strong>
                              ) : s.kind === 'code' ? (
                                <code class="rounded-xs bg-panel-2 px-1 font-mono text-[0.9em]">{s.text}</code>
                              ) : (
                                <>{s.text}</>
                              ),
                            )}
                          </p>
                        ))}
                      </div>
                      {rest.length > 0 && (
                        <details class="eco-bulletin-fold group mt-3">
                          <summary class={cn(quiet, 'fold-summary -ml-2 cursor-pointer list-none gap-1.5')}>
                            <span class="group-open:hidden">{W.bulletin.expand(p.bulletin.lines)}</span>
                            <span class="hidden group-open:inline">{W.bulletin.collapse}</span>
                            <svg class="fold-chevron size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
                          </summary>
                          <div class="mt-3 space-y-2.5 border-t border-line pt-3">
                            {rest.map((b) => (
                              <p class={blockClass[b.kind]}>
                                {b.segments.map((s) =>
                                  s.kind === 'strong' ? (
                                    <strong class="font-semibold text-fg">{s.text}</strong>
                                  ) : s.kind === 'code' ? (
                                    <code class="rounded-xs bg-panel-2 px-1 font-mono text-[0.9em]">{s.text}</code>
                                  ) : (
                                    <>{s.text}</>
                                  ),
                                )}
                              </p>
                            ))}
                            {p.bulletin.truncated && (
                              <p class="font-mono text-mono text-fg-faint">
                                {W.bulletin.truncatedNote(p.bulletin.lines, BULLETIN_DISPLAY_MAX)}
                              </p>
                            )}
                          </div>
                        </details>
                      )}
                    </>
                    )
                  })(bulletinBlocks(p.bulletin.text!))
                ) : (
                  <p class="text-sm leading-relaxed text-fg-faint">{W.bulletin.absent}</p>
                )
              }
            </div>
          </div>
        ))
      }
    </div>
  </section>

  {/* ── The artifact trail ───────────────────────────────────────────────── */}
  <section class="mt-12" aria-label="The artifact trail">
    <p class={kicker}>{W.artifacts.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.artifacts.intro}</p>
    {
      cycleArtifacts.length === 0 ? (
        <p class={empty}>{W.artifacts.empty}</p>
      ) : (
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {cycleArtifacts.map((a) => (
            <li>
              <Card className={card}>
                <CardContent>
                  <p class="font-mono text-mono-sm uppercase tracking-[0.14em] text-fg-faint">
                    {W.practices[a.practice].name}{a.date && <> · {a.date}</>}
                  </p>
                  <a class="mt-1 block text-fg hover:underline" href={url(a.href)}>
                    {W.artifacts.entryLabel(a.slug, a.title)}
                  </a>
                </CardContent>
              </Card>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ── Closing reports (the one-time transition) ────────────────────────── */}
  <section class="mt-12" aria-label="Closing reports">
    <p class={kicker}>{W.closing.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.closing.intro}</p>
    <ul class="mt-4 grid gap-3 sm:grid-cols-3">
      {
        PRACTICES.map((id) => {
          const report = closing.find((c) => c.practice === id)
          const name = W.practices[id].name
          return (
            <li>
              <Card className={report ? card : 'h-full gap-1 py-3.5 shadow-none panel-raised'}>
                <CardContent>
                  {report ? (
                    <a class="text-fg hover:underline" href={url(report.href)}>{W.closing.linkLabel(name)}</a>
                  ) : (
                    <span class="text-sm text-fg-faint">{W.closing.missing(name)}</span>
                  )}
                </CardContent>
              </Card>
            </li>
          )
        })
      }
    </ul>
  </section>

  {/* ── The programme (2026-10-07) ──────────────────────────────────────────── */}
  {/* The chain of cycles, oldest first, from the Middle's relay where it carries a programme and
      from the site's own record otherwise (src/lib/ecology/convening.ts, buildProgramme). The
      practices' "For the programme" lines are quoted with the files they were read from. */}
  <section class="mt-12" aria-labelledby="programme-heading">
    <h2 id="programme-heading" class={kicker}>{W.programme.kicker}</h2>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.programme.intro}</p>
    {programme.from === 'site' && <p class="mt-2 max-w-3xl font-mono text-mono text-fg-faint">{W.programme.fromSite}</p>}
    <ol class="mt-4 space-y-3">
      {
        programme.rows.map((r) => (
          <li class={cn(panel, 'p-4 sm:p-5')}>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-mono text-sm uppercase tracking-[0.18em] text-fg">{W.cycle.label(r.cycle)}</span>
              {r.source && <span class="font-mono text-mono-sm text-fg-faint">{W.programme.source[r.source]}</span>}
              {W.programme.dates(r.opened, r.closed) && (
                <span class="font-mono text-mono-sm text-fg-faint">{W.programme.dates(r.opened, r.closed)}</span>
              )}
              {r.running && (
                <Badge variant="outline" className="border-line font-mono text-[10px] font-normal uppercase tracking-[0.18em] text-accent">
                  {cycle.phase === 'convening' ? W.cycle.phase.convening.badge : W.programme.running}
                </Badge>
              )}
            </div>
            {r.question ? (
              <p class="mt-2 leading-snug text-fg">{r.question}</p>
            ) : (
              r.source === 'defaults' && <p class="mt-2 text-sm leading-relaxed text-fg-muted">{W.programme.defaultThemes}</p>
            )}
            {r.findings.length > 0 && (
              <div class="mt-3">
                <p class="font-mono text-mono-sm uppercase tracking-[0.14em] text-fg-faint">{W.programme.findings}</p>
                <ul class="mt-1.5 space-y-1.5">
                  {r.findings.map((f) => (
                    <li class="border-l border-line pl-3 text-sm leading-relaxed text-fg-muted">
                      <span class="font-mono text-mono-sm text-fg">{name(f.practice)}</span>
                      <span class="text-fg-faint"> — </span>
                      {f.line}
                      {f.href && (
                        <>
                          {' '}<a class="font-mono text-mono-sm text-fg-faint underline hover:text-fg" href={f.href}>{W.programme.evidence}</a>
                        </>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            {r.findings.length === 0 && r.presented.length > 0 && (
              <p class="mt-2 flex flex-wrap gap-x-2 gap-y-1 text-sm leading-relaxed text-fg-muted">
                <span class="font-mono text-mono-sm uppercase tracking-[0.14em] text-fg-faint">{W.programme.presented}</span>
                {r.presented.map((p, i) => (
                  <span>
                    <a class="hover:underline" href={p.href.startsWith('http') ? p.href : url(p.href)}>
                      {p.title ?? W.presentations.entryLabel(r.cycle, name(p.practice))}
                    </a>
                    <span class="font-mono text-mono-sm text-fg-faint"> ({name(p.practice)}){i < r.presented.length - 1 ? ' ·' : ''}</span>
                  </span>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ol>
  </section>

  {/* ── Presentations ────────────────────────────────────────────────────── */}
  <section class="mt-12" aria-label="Presentations">
    <p class={kicker}>{W.presentations.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.presentations.intro}</p>
    {
      presentations.length === 0 ? (
        <p class={empty}>{W.presentations.empty}</p>
      ) : (
        <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {presentations.map((e) => (
            <li>
              <Card className={card}>
                <CardContent>
                  <a class="text-fg hover:underline" href={e.href.startsWith('http') ? e.href : url(e.href)}>
                    {W.presentations.entryLabel(e.cycle, W.practices[e.practice].name)}
                  </a>
                  <p class="mt-1 font-mono text-mono text-fg-faint">{W.presentations.fileCount(e.files)}</p>
                  {e.paperHref && (
                    <a class="mt-1 block font-mono text-mono text-fg-muted underline decoration-line underline-offset-4 hover:text-fg" href={url(e.paperHref)}>
                      {W.presentations.paperLabel}
                    </a>
                  )}
                </CardContent>
              </Card>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {/* ── The works register ───────────────────────────────────────────────── */}
  {/* The complete catalogue, last on the page on purpose: the four moves above answer "where
      does this house stand right now", and the register answers "everything it has ever made" —
      a hundred-odd rows ahead of the cycle would have buried today under the archive. It brings
      its own <style> and its own heading; nothing about what it lists changed in the move. */}
  <WorksRegisterSection />

  {/* ── Lineage + doors ──────────────────────────────────────────────────── */}
  <footer class="mt-14 border-t border-line pt-6">
    <p class="max-w-3xl text-sm leading-relaxed text-fg-faint">{W.foot.lineage}</p>
    <nav class="mt-4 -ml-2 flex flex-wrap gap-x-1 gap-y-1" aria-label="Ecology doors">
      {
        W.foot.links.map((l) => (
          <a class={quiet} href={url(l.href)}>{l.label}</a>
        ))
      }
    </nav>
  </footer>
</article>

<style>
  /* The fold's summary is a ghost button; the disclosure triangle the browser would add beside
     it is the one mark the recipe does not want. `list-none` covers Chrome and Firefox, this
     covers Safari. */
  .fold-summary::-webkit-details-marker {
    display: none;
  }
</style>

---
// The Middle's partitur (2026-09-01, redrawn the same day) — the current exchange, in the
// original score's ink.
//
// buildMiddleScoreSvg emits the 2026-07-15 Zeichengrammatik's class vocabulary and this
// component mounts it inside a `.score-map` scope, so src/styles/score-map.css — the original
// partitur's stylesheet — styles the ruler, lanes, squares, currents, badges and legend
// unchanged. The figure adds no words of its own: every mark's tooltip is the item's own
// first words, every mark links to the quoted item below, and the badge numbers in the
// drawing are the same numbers the quoted list wears. No JavaScript, no inline styles.
import { ECOLOGY_V3 } from '@/config/ecology-v3-wording'
import { MIDDLE_V3 } from '@/config/middle-v3-wording'
import { buildMiddleScoreSvg, LANE_OF } from '@/lib/ecology/middle-score'
import type { MiddleVoice } from '@/lib/ecology/middle'
import { PRACTICES } from '@/lib/ecology/v3'
import '@/styles/score-map.css'

interface Props {
  voices: MiddleVoice[]
}
const { voices } = Astro.props
const W = MIDDLE_V3.score
const svgMarkup = buildMiddleScoreSvg(voices)
const kicker = 'font-mono text-xs uppercase tracking-[0.22em] text-fg-muted'
---

<figure class="rounded-sm border border-line bg-panel">
  <figcaption class="border-b border-line p-4">
    <p class={kicker}>{W.kicker}</p>
    <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">{W.sub}</p>
  </figcaption>

  <div class="score-map overflow-x-auto">
    <div class="score-svg min-w-[860px] p-2" set:html={svgMarkup} />

    {/* the key, in the original legend's own classes — Practices · Signs · Currents */}
    <aside class="score-legend" aria-label="Map key">
      <div class="score-lg-col">
        <h3>{W.key.practices}</h3>
        {
          PRACTICES.map((p) => (
            <div class:list={['score-lg-row', `pr-${LANE_OF[p]}`]}>
              <i class:list={['score-sw', `pr-${LANE_OF[p]}`]} />
              <span>
                {LANE_OF[p].toUpperCase()} — {ECOLOGY_V3.practices[p].name} · {ECOLOGY_V3.practices[p].corner}
              </span>
            </div>
          ))
        }
        <p class="score-lg-note">{W.key.practicesNote}</p>
      </div>
      <div class="score-lg-col">
        <h3>{W.key.signs}</h3>
        {
          W.key.signRows.map((row) => (
            <div class="score-lg-row pr-conductor">
              <svg class="score-mini" viewBox="0 0 46 30" aria-hidden="true" set:html={row.mini} />
              <span>{row.label}</span>
            </div>
          ))
        }
      </div>
      <div class="score-lg-col">
        <h3>{W.key.reading}</h3>
        <p class="score-lg-note">{W.key.readingNote}</p>
      </div>
    </aside>
  </div>
</figure>

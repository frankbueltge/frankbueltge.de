---
// The reception block under a work the site renders itself (2026-10-17; docs/design/
// 2026-10-17-the-reception.md). Path-based like the AttributionBlock and the AuthorByline beside it in
// Page.astro: the work pages are generated by the integrate workflows and must not be touched one by
// one, so the block decides for itself whether the page is a work (src/lib/reception/ids.ts) and
// renders nothing where it is not.
//
// Without JavaScript it is a link to the form. With it, /reception/widget.js (a same-origin static
// file, allowed by the house's script-src 'self') shows the average, the count and the newest notes,
// and opens the form at /reception/rate in a same-origin frame — the one page that loads the bot check.
// The data attributes are also read back after the build (src/lib/reception/dist.ts) to list the
// ratable works the endpoint accepts.
import { formHref, workForPage } from '@/lib/reception/ids'
import { pageSources } from '@/lib/reception/sources'

const work = workForPage(Astro.url.pathname, pageSources())
---

{work && (
  <aside class="mx-auto w-full max-w-3xl px-6 pb-10" aria-label={`Reception of ${work.title}`}>
    <section
      class="rcp-host rounded-[10px] border border-line bg-panel p-4"
      data-reception-work={work.id}
      data-reception-title={work.title}
      data-reception-kind={work.kind}
      data-reception-page="astro"
    >
      <p class="font-mono text-[11px] uppercase tracking-[0.18em] text-fg-faint">Reception</p>
      <p class="mt-2.5 text-sm leading-relaxed text-fg">Rate this {work.kind} from 1 to 5, or leave a note.</p>
      <div class="mt-3 text-sm text-fg" data-reception-live></div>
      <p class="mt-3.5 text-xs leading-relaxed text-fg-muted">
        Every rating and note is public at <a class="underline decoration-line underline-offset-4 hover:decoration-fg" href="/reception">/reception</a>{work.practice === 'lab' ? '.' : ', and the practice that made it reads them every night.'}
        {' '}<a class="underline decoration-line underline-offset-4 hover:decoration-fg" href={formHref(work.id)}>The form on a page of its own</a>.
      </p>
    </section>
    <script is:inline src="/reception/widget.js" defer></script>
  </aside>
)}

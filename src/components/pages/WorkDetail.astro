---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { t } from '@/i18n/ui'
import { getProject } from '@/data/projects'
import { SITE, type Locale } from '@/lib/site'
import SheetHead from '@/components/experiments/SheetHead.astro'
import SheetFoot from '@/components/experiments/SheetFoot.astro'
import '@/styles/experiment-sheet.css'

interface Props { slug: string }
const { slug } = Astro.props
const locale = (Astro.currentLocale ?? 'en') as Locale
const p = getProject(slug)!
// Projects that live on THIS site (the ecology at "/", the Atlas at "/atlas") kept getting the
// external treatment — a new tab and a "/ ↗" label that reads like a broken URL. An internal
// destination now opens in place and names its own address, in the same shape as an external
// one: "frankbueltge.de/atlas →" beside "data-snack.com ↗".
const isExternal = !!p.url?.startsWith('http')
const host = SITE.url.replace('https://', '')
const visitLabel = !p.url
  ? ''
  : isExternal
    ? `${p.url.replace('https://', '')} ↗`
    : `${host}${p.url === '/' ? '' : p.url} →`
---

<main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-16 sm:py-24">
  <a href={getRelativeLocaleUrl(locale, '/work')} class="sheet-link">← {t(locale, 'work.back')}</a>

  <SheetHead class="mt-8 mb-0" title={p.name} sub={p.tagline[locale]} badges={[String(p.year), p.status[locale]]}>
    <p class="mt-3 text-sm text-fg-muted">{p.role[locale]}</p>
  </SheetHead>

  <div class="mt-8 flex flex-wrap gap-3 text-sm">
    {p.url ? (
      <a
        href={p.url}
        target={isExternal ? '_blank' : undefined}
        rel={isExternal ? 'noreferrer' : undefined}
        class="rounded-full bg-accent px-5 py-2.5 font-medium text-bg transition-colors hover:bg-accent-soft"
      >{visitLabel}</a>
    ) : (
      <span class="rounded-full border border-line px-5 py-2.5 font-mono text-xs text-fg-faint">{t(locale, 'work.internal')}</span>
    )}
  </div>

  <p class="mt-10 text-base leading-relaxed text-fg-muted">{p.description[locale]}</p>

  <h2 class="kicker mt-10">{t(locale, 'work.highlights')}</h2>
  <ul class="mt-4 space-y-3">
    {p.highlights[locale].map((h) => (
      <li class="flex gap-3 text-fg-muted"><span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{h}</li>
    ))}
  </ul>

  <h2 class="kicker mt-10">{t(locale, 'work.tech')}</h2>
  <ul class="mt-4 flex flex-wrap gap-2">
    {p.tech.map((tech) => (
      <li class="rounded-full border border-line bg-panel-2/60 px-3 py-1 font-mono text-xs text-fg-muted">{tech}</li>
    ))}
  </ul>

  {p.channels && (
    <>
      <h2 class="kicker mt-10">{t(locale, 'work.channels')}</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {p.channels.map((c) => (
          <li><a href={c.href} target="_blank" rel="noreferrer" class="rounded-full border border-line px-3 py-1 text-sm text-fg-muted transition-colors hover:border-fg-muted hover:text-fg">{c.label} ↗</a></li>
        ))}
      </ul>
    </>
  )}
</main>

<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: p.name,
  description: p.description[locale],
  url: p.url ?? `${SITE.url}${getRelativeLocaleUrl(locale, `/work/${p.slug}`)}`,
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  author: { '@id': `${SITE.url}/#person` },
  ...(p.channels ? { sameAs: p.channels.map((c) => c.href) } : {}),
})} />

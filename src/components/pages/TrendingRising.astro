---
/** "Rising this week" — the arcs seen from the day ledger.
 *
 *  The day page answers "what spiked this morning?"; this block is the doorway to the other
 *  question, "what has been building for weeks?". It shows only the terms the tracker calls
 *  emerging or rising, at most eight of them, each with the seven-day count and the pace the
 *  status rests on, and it links every one to its own page.
 *
 *  Renders nothing at all before the first terms file is committed: an empty promise on the
 *  ledger would be worse than no block.
 */
import TrendingStages from '@/components/pages/TrendingStages.astro'
import { sparkline } from '@/lib/trending/arc'
import { getLatestTerms, seriesFor } from '@/lib/trending/terms-data'
import { risingLinks, statusTally } from '@/lib/trending/terms-view'

const file = getLatestTerms()
const rising = file ? risingLinks(file, 8) : []
// The same word-sized line the hub draws beside every watched term (src/lib/trending/arc.ts):
// a term's own committed runs, scaled to its own peak. "Rising" is a claim about a shape, and
// until 2026-11-14 this block made it with two numbers and no shape at all.
const sparks = Object.fromEntries(rising.map((r) => [r.slug, sparkline(seriesFor(r.slug, 30))]))
const tally = file ? statusTally(file) : []
---

{
  file && (
    <section class="mb-12 border-t border-line pt-6" id="rising">
      <h2 class="kicker">Rising this week</h2>
      {rising.length === 0 ? (
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-muted">
          No watched term is accelerating this week — an arc that stays flat is a reading, not a failure. The whole
          watchlist, with what each term is doing, stands on the hub.
        </p>
      ) : (
        <>
          <p class="mt-3 max-w-2xl text-sm leading-relaxed text-fg-muted">
            Terms that build over weeks rather than spiking for a morning, counted across link aggregators, news,
            code repositories and preprints. The figure is the last seven days; the pace beside it compares those
            days with the three weeks before them. The line is the term&rsquo;s own committed runs, oldest left,
            scaled to its own peak.
          </p>
          <ul class="mt-4 grid gap-x-6 gap-y-2 sm:grid-cols-2">
            {rising.map((r) => (
              <li class="tr-term flex items-baseline justify-between gap-x-3 border-b border-line pb-1.5">
                <a
                  href={r.href}
                  class="min-w-0 flex-1 underline decoration-line underline-offset-2 transition-colors hover:text-fg"
                >
                  {r.term}
                </a>
                {sparks[r.slug]!.runs > 1 && (
                  <svg
                    class="tr-spark"
                    viewBox={`0 0 ${sparks[r.slug]!.width} ${sparks[r.slug]!.height}`}
                    role="img"
                    aria-label={`${r.term}: the shape of its last ${sparks[r.slug]!.runs} committed runs, peaking at ${sparks[r.slug]!.max} mentions in a day`}
                  >
                    <title>{`${sparks[r.slug]!.runs} committed runs · peak ${sparks[r.slug]!.max} mentions in a day`}</title>
                    <line class="tr-spark-base" x1="0" y1={sparks[r.slug]!.baseY} x2={sparks[r.slug]!.width} y2={sparks[r.slug]!.baseY} />
                    <path class="tr-spark-line" d={sparks[r.slug]!.d} />
                    <circle class="tr-spark-dot" cx={sparks[r.slug]!.last!.x} cy={sparks[r.slug]!.last!.y} r="1.6" />
                  </svg>
                )}
                <span class="shrink-0 whitespace-nowrap font-mono text-mono-sm text-fg-faint">
                  {r.statusLabel}
                  {' · '}
                  <span class="tabular-nums">{r.d7}</span>
                  {r.ratio && <span class="tabular-nums">{` · ${r.ratio}`}</span>}
                </span>
              </li>
            ))}
          </ul>
        </>
      )}
      {/* The stages are links: each opens the hub at the terms of that stage. */}
      <nav
        aria-label="The watchlist, by stage"
        class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-fg-faint"
      >
        <a href="/trending/topics/" class="mr-2 transition-colors hover:text-fg">All watched terms &rarr;</a>
        <span>By stage</span>
        <TrendingStages items={tally} />
      </nav>
    </section>
  )
}

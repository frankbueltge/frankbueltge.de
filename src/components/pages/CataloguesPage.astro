---
// /catalogues — Sammelpunkt der maschinell gepflegten Nachschlagewerke (Frank, 2026-07-26,
// wording-kanon.md "Catalogues"). Wortlaut AUSSCHLIESSLICH aus NAMING.catalogues (naming.ts
// ist fertig und wird hier nicht angefasst) — Texte wörtlich, nicht umformuliert. Die einzige
// Ergänzung dieser Komponente sind die Zählungen je Karte, und die stammen ausschließlich aus
// den Daten (Kanon-Regel: Zahlen nie in Beschreibungstexten, nie geraten).
import { NAMING } from '@/config/naming'
import worksData from '@/data/atlas/werke.json'
import { ENTRIES as datasetEntries } from '@/lib/register'

const counts: Record<string, number> = {
  '/atlas': (worksData as unknown[]).length,
  '/datasets': datasetEntries.length,
}
---

<main id="main" class="mx-auto w-full max-w-4xl px-4 py-10 sm:py-14">
  <header class="mb-10 max-w-2xl">
    <p class="mb-2 font-mono text-xs uppercase tracking-widest text-fg-faint">{NAMING.catalogues.kicker}</p>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{NAMING.catalogues.title}</h1>
    <p class="mt-4 text-fg-muted">{NAMING.catalogues.sub}</p>
  </header>

  <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {NAMING.catalogues.items.map((item) => (
      <li>
        <a
          href={item.href}
          class="group flex h-full flex-col rounded-xl border border-line bg-panel p-6 transition-colors hover:border-fg-faint"
        >
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-lg font-semibold text-fg">{item.name}</h2>
            <div class="shrink-0 text-right">
              <div class="font-mono text-xl font-semibold tabular-nums text-fg">{counts[item.href] ?? '—'}</div>
              <div class="font-mono text-[10px] uppercase tracking-wider text-fg-faint">entries indexed</div>
            </div>
          </div>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-fg-muted">{item.description}</p>
          <p class="mt-4 font-mono text-xs uppercase tracking-wider text-fg-faint transition-colors group-hover:text-fg">
            enter →
          </p>
        </a>
      </li>
    ))}
  </ul>
</main>

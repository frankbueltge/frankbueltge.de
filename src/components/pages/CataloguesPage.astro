---
// /catalogues — Sammelpunkt der maschinell gepflegten Nachschlagewerke (Frank, 2026-07-26,
// wording-kanon.md "Catalogues"). Wortlaut AUSSCHLIESSLICH aus NAMING.catalogues (naming.ts
// ist fertig und wird hier nicht angefasst) — Texte wörtlich, nicht umformuliert. Die einzige
// Ergänzung dieser Komponente sind die Zählungen je Karte, und die stammen ausschließlich aus
// den Daten (Kanon-Regel: Zahlen nie in Beschreibungstexten, nie geraten).
//
// Re-skin 2d (2026-09-02): the head on the type scale, the four cards on the frame's recipe —
// they lead somewhere, so they lift. The words are the same words.
import { NAMING } from '@/config/naming'
import worksData from '@/data/atlas/werke.json'
import { ENTRIES as datasetEntries } from '@/lib/register'
import { PAPERS } from '@/lib/papers'
import { allWorks } from '@/lib/engines/register'
import { cn } from '@/lib/ui/cn'

const counts: Record<string, number> = {
  '/atlas': (worksData as unknown[]).length,
  '/datasets': datasetEntries.length,
  '/papers': PAPERS.length,
  // The works register counts itself the same way the other three do — from its own source,
  // not from a number typed here (added 2026-08-01 with the fourth card).
  '/works': allWorks().length,
}

const kicker = 'kicker'
/* a card that leads somewhere: the frame's resting depth, and the lift on hover or focus */
const cardLink = 'lift group flex h-full flex-col rounded-md border border-line bg-panel p-6 panel-raised'
---

<main id="main" class="mx-auto w-full max-w-4xl px-4 py-10 sm:py-14">
  <header class="mb-10 max-w-2xl">
    <p class={cn(kicker, 'mb-2')}>{NAMING.catalogues.kicker}</p>
    <h1 class="text-h1 font-semibold">{NAMING.catalogues.title}</h1>
    <p class="mt-4 text-body text-fg-muted">{NAMING.catalogues.sub}</p>
  </header>

  <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {NAMING.catalogues.items.map((item) => (
      <li>
        <a href={item.href} class={cardLink}>
          <div class="flex items-start justify-between gap-3">
            <h2 class="text-h3 font-semibold text-fg">{item.name}</h2>
            <div class="shrink-0 text-right">
              <div class="font-mono text-h3 font-semibold tabular-nums text-fg">{counts[item.href] ?? '—'}</div>
              <div class="font-mono text-mono-xs uppercase tracking-wider text-fg-faint">entries indexed</div>
            </div>
          </div>
          <p class="mt-3 flex-1 text-small leading-relaxed text-fg-muted">{item.description}</p>
          <p class="mt-4 font-mono text-mono-sm uppercase tracking-wider text-fg-faint transition-colors group-hover:text-fg">
            enter →
          </p>
        </a>
      </li>
    ))}
  </ul>
</main>

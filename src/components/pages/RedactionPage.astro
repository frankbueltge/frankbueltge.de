---
import { getRelativeLocaleUrl } from 'astro:i18n'
import { t } from '@/i18n/ui'
import type { Locale } from '@/lib/site'
import type { RedactionData, Redaction } from '@/lib/redaction/types'
import type { WorldData } from '@/lib/redaction/world'
import { pct, thousands, withholdOnPage } from '@/lib/redaction/world'
import { tokensLabel, signalLabel, dateLabel } from '@/lib/redaction/format'
import data from '@/data/redaction/latest.json'
import worldData from '@/data/redaction/world/latest.json'
import SheetHead from '@/components/experiments/SheetHead.astro'
import SheetFoot from '@/components/experiments/SheetFoot.astro'
import '@/styles/experiment-sheet.css'

interface Props { locale: Locale }
const { locale } = Astro.props
const de = locale === 'de'
const d = data as unknown as RedactionData
const w = worldData as unknown as WorldData
const pending = d.watched_count === 0 // no nightly run yet
const pick: Redaction | null = d.pick ? d.redactions.find((r) => r.id === d.pick) ?? null : null
const rest = d.redactions.filter((r) => r.id !== d.pick)
const methodUrl = getRelativeLocaleUrl(locale, '/werke/redaction')
// Schema v2 (2026-08-15): what the validity gate and the live recheck could not
// verify is a published number, never a silence. Days before v2 do not carry it.
const unverifiable = d.unverifiable?.count ?? 0
const unverifiableReasons = Object.entries(d.unverifiable?.reasons ?? {})
  .map(([reason, n]) => `${reason.replace(/_/g, ' ')} ${n}`)
  .join(' · ')
const wg = w.gdg
const wd = w.deletion
const titleChangesWorld = wg.available ? (wg.status_counts?.PAGE_TITLECHANGE ?? 0) : 0
---

<main id="main" class="flex-1">
<article class="redaction mx-auto max-w-3xl px-4 py-14">
  <SheetHead title="Editorial Deadline">
    <p class="mt-2 max-w-xl text-fg-muted">{t(locale, 'rd.sub')}</p>
    <p class="mt-1 font-mono text-xs text-fg-faint">{dateLabel(d.date, locale)}</p>
  </SheetHead>

  <p class="mb-6 kicker">
    {de ? 'Kammer 1 — der amtliche Eintrag' : 'Chamber 1 — the official record'}
  </p>

  {pending ? (
    <p class="mb-12 text-fg-muted">{t(locale, 'rd.empty')}</p>
  ) : d.changed_count === 0 ? (
    <p class="mb-12 max-w-xl leading-relaxed text-fg-muted">
      {de
        ? `Heute hat das Archiv nichts zurückgenommen — auf den ${d.watched_count} beobachteten Seiten. Das ist keine Garantie, nur eine Beobachtung.`
        : `Today the archive took nothing back — across the ${d.watched_count} watched pages. That is not a guarantee, only an observation.`}
    </p>
  ) : (
  <>
  {pick && (
    <section class="mb-12 border-l-2 border-accent/60 pl-5">
      <p class="kicker">
        {de ? 'Die Schwärzung des Tages' : 'The redaction of the day'}
      </p>
      <p class="mt-2 text-lg font-semibold">{pick.institution} — {pick.label}</p>
      {pick.kind === 'removal' ? (
        <p class="mt-3 leading-snug text-fg-muted line-through decoration-accent/70">
          „{pick.removed_passages.slice(0, 3).join(' … ')}"
        </p>
      ) : (
        <p class="mt-3 leading-snug text-fg-muted">
          {de
            ? 'Die ganze Seite ist aus dem Archiv verschwunden (404).'
            : 'The entire page vanished from the record (404).'}
        </p>
      )}
      <p class="mt-3 font-mono text-xs text-fg-faint">
        {tokensLabel(pick.removed_tokens, locale)}
        {pick.salience.signals.length > 0 && (
          <> · {pick.salience.signals.map((s) => signalLabel(s, locale)).join(', ')}</>
        )}
      </p>
      <p class="mt-3 flex gap-4 font-mono text-xs">
        <a class="underline transition-colors hover:text-fg" href={pick.before.url} target="_blank" rel="noopener">
          {de ? 'vorher ↗' : 'before ↗'}
        </a>
        <a class="underline transition-colors hover:text-fg" href={pick.after.url} target="_blank" rel="noopener">
          {de ? 'nachher ↗' : 'after ↗'}
        </a>
      </p>
    </section>
  )}

  <section class="mb-12 flex items-baseline gap-4">
    <p class="text-[clamp(36px,7vw,64px)] font-bold tabular-nums">{d.changed_count}</p>
    <p class="max-w-xs text-sm leading-snug text-fg-muted">
      {de
        ? `von ${d.watched_count} beobachteten offiziellen Seiten verloren zuletzt Inhalt.`
        : `of ${d.watched_count} watched official pages lost content recently.`}
    </p>
  </section>

  {rest.length > 0 && (
    <section class="mb-12 border-t border-line pt-6">
      <p class="kicker">
        {de ? 'Weitere Schwärzungen' : 'Other redactions'}
      </p>
      <ul class="mt-3 space-y-2">
        {rest.map((r) => (
          <li class="text-sm">
            <span class="text-fg-muted">{r.institution} — {r.label}</span>
            <span class="ml-2 font-mono text-xs text-fg-faint">{tokensLabel(r.removed_tokens, locale)}</span>
            <a class="ml-2 font-mono text-xs underline transition-colors hover:text-fg" href={r.after.url} target="_blank" rel="noopener">↗</a>
          </li>
        ))}
      </ul>
    </section>
  )}
  </>
  )}

  {unverifiable > 0 && (
    <p class="mb-12 max-w-xl text-xs leading-relaxed text-fg-faint">
      {unverifiable} of the watched pages could not be verified tonight and were never
      diffed — a bot-wall or WAF challenge page archived as a page, text that is only a
      consent banner, or an archived 4xx the live page contradicts. Counted here, kept out
      of the finding: {unverifiableReasons}.
    </p>
  )}

  <section class="mb-12 border-t border-line pt-8">
    <p class="kicker">
      Chamber 2 — the world's press
    </p>

    {!wg.available ? (
      <p class="mt-4 max-w-xl leading-relaxed text-fg-muted">
        The world chamber's nightly reading is not available for {wg.day} — {wg.note ?? 'source outage'}.
        An outage is noted, never bridged.
      </p>
    ) : (
      <>
        <div class="mt-4 flex items-baseline gap-4">
          <p class="text-[clamp(36px,7vw,64px)] font-bold tabular-nums">{thousands(titleChangesWorld)}</p>
          <p class="max-w-sm text-sm leading-snug text-fg-muted">
            headlines the world's press rewrote on {wg.day}, counted by GDELT's recrawl —
            of {thousands(wg.title_changes_en)} in the English-monitored stream,
            the versioned filter (v{w.filter_version.replace('v', '')}) calls{' '}
            {thousands(wg.classes?.reframing)} genuine reframings.
          </p>
        </div>
        <p class="mt-2 font-mono text-xs text-fg-faint">
          trivial {thousands(wg.classes?.trivial)} · running updates {thousands(wg.classes?.update)} ·
          reframings {thousands(wg.classes?.reframing)} · replaced {thousands(wg.classes?.replaced)}
        </p>

        {(wg.register?.length ?? 0) > 0 && (
          <div class="mt-6">
            <p class="kicker">
              The day's reframings — selected by rule, not by hand
            </p>
            <ul class="mt-3 space-y-4">
              {wg.register!.map((e) => (
                <li class="border-l-2 border-accent/60 pl-4">
                  <p class="leading-snug text-fg-muted line-through decoration-accent/70">{e.before}</p>
                  <p class="mt-1 leading-snug">{e.after}</p>
                  <p class="mt-1 font-mono text-xs text-fg-faint">
                    {e.domain} · noticed in GDELT's {e.window === '1w' ? 'one-week' : '24-hour'} recrawl ·{' '}
                    <a class="underline transition-colors hover:text-fg" href={e.url} target="_blank" rel="noopener nofollow">page ↗</a>
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )}
      </>
    )}

    <div class="mt-8">
      <p class="kicker">
        Deletion, measured at home
      </p>
      {!wd.available ? (
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">
          {(wd.note ?? 'Not yet measured').replace(/\.$/, '')}. The house commits a random
          sample of the day's news pool each night and rechecks it a night later, when the
          articles are roughly 40 hours old — what has vanished by then is counted against
          our own committed record: the receipt.
        </p>
      ) : (
        <>
          <div class="mt-3 flex items-baseline gap-4">
            <p class="text-[clamp(28px,5vw,44px)] font-bold tabular-nums">{pct(wd.gone_rate)}</p>
            <p class="max-w-sm text-sm leading-snug text-fg-muted">
              of {wd.decided} decidable articles from the {wd.pool_day} pool were gone
              (404/410) ~40 hours later
              {wd.gone_ci95 && ` — 95 % CI ${pct(wd.gone_ci95[0])}–${pct(wd.gone_ci95[1])}`}.
              Legal blocks (HTTP 451): {wd.legal_451} — counted apart, never folded in:
              from a German vantage point 451 can mean EU geo-blocking rather than takedown.
              Unverifiable (bot-walls, network): {wd.excluded_unverifiable}, excluded and disclosed.
            </p>
          </div>
          {(wd.receipts?.length ?? 0) > 0 && (
            <ul class="mt-4 space-y-2">
              {wd.receipts!.filter((r) => r.class.startsWith('gone') && r.title).slice(0, 3).map((r) => (
                <li class="text-sm">
                  {withholdOnPage(r.title!) ? (
                    <span class="italic text-fg-faint">
                      headline withheld — personal-rights caution (crime/court marker); counted, kept in the archive
                    </span>
                  ) : (
                    <span class="text-fg-muted line-through decoration-accent/70">{r.title}</span>
                  )}
                  <span class="ml-2 font-mono text-xs text-fg-faint">
                    {r.domain} · committed {wd.sample_drawn_at?.slice(0, 10)}, gone by {wd.checked_at?.slice(0, 10)}
                  </span>
                </li>
              ))}
            </ul>
          )}
        </>
      )}
    </div>

    <p class="mt-6 max-w-xl text-xs leading-relaxed text-fg-faint">
      Deletion is not censorship: articles vanish for banal reasons — CMS migrations,
      paywalling, licence clocks on agency copy. The chamber counts disappearance and holds
      receipts; it does not assert motive. Data: <a class="underline transition-colors hover:text-fg" href="https://www.gdeltproject.org/" target="_blank" rel="noopener">The GDELT Project</a>.
    </p>
  </section>

  <section class="mb-8 border-t border-line pt-6">
    <p class="kicker">
      {de ? 'Nächste Nachbarn' : 'Nearest neighbors'}
    </p>
    <ul class="mt-3 space-y-2 text-sm text-fg-muted">
      <li>
        <a href="https://envirodatagov.org/federal-environmental-web-tracker-about-page" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">EDGI — Federal Environmental Web Tracker</a>
        {de ? ' — automatisiertes Diffing US-föderaler Webseiten seit 2017, über 1.500 dokumentierte Änderungen, mit menschlicher Relevanzprüfung.' : ' — automated diffing of US federal webpages since 2017, 1,500+ documented changes, with human significance review.'}
      </li>
      <li>
        <a href="https://sunlightfoundation.com/gov404" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">Sunlight Foundation / Web Integrity Project (Gov404)</a>
        {de ? ' — katalogisiert föderale Website-Änderungen seit 2016, mit ausführlicher Vorher/Nachher-Dokumentation für Aufsicht und FOIA.' : ' — catalogs federal website changes since 2016, with detailed before/after documentation for oversight and FOIA.'}
      </li>
      <li>
        <a href="https://changedetection.io" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">changedetection.io</a>
        {de ? ' — quelloffenes Werkzeug für geplante Erfassung, Diff und Benachrichtigung, ausdrücklich für Regierungsseiten vermarktet.' : ' — free/open-source scheduled-capture, diff and notification tool, explicitly marketed for monitoring government pages.'}
      </li>
      <li>
        <a href="https://www.newssniffer.co.uk" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">News Sniffer</a>
        {' — the world chamber’s strongest living neighbour: 2.7M articles, 5.25M captured versions, minute-fresh — a browsable per-article revision archive of a handful of UK feeds; no daily rate, no classification, no global scale, no deletion measurement.'}
      </li>
      <li>
        <a href="https://ojs.aaai.org/index.php/ICWSM/article/view/42794" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">MediaSpin (ICWSM 2026)</a>
        {' — 78,910 post-publication headline-edit pairs annotated for 13 bias types; the academic proof that headline edits carry signal — a dataset and paper, not a living instrument.'}
      </li>
      <li>
        <a href="https://blog.gdeltproject.org/looking-back-on-four-months-of-the-global-difference-graph" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">GDELT Global Difference Graph</a>
        {' — publishes the recrawl data this chamber reads (~54k title rewrites/day) and one-off blog analyses; no living public surface, no filter, no archive of record.'}
      </li>
    </ul>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">
      EDGI and Sunlight cover chamber 1's ground more battle-tested — human review, a
      searchable database, both US-federal-focused; this page's stated difference there is
      epistemics: fully automated, no curation, a daily single pick. For chamber 2 the
      gesture "watch news revisions" is occupied (News Sniffer) and the bias-in-edits
      analysis exists academically (MediaSpin) — what no neighbour holds is the union this
      page runs daily: a global rate, a classified reframing register, and a deletion
      sample with receipts from an archive the house itself committed before the
      vanishing. Kill conditions are named in the audit: either neighbour shipping that
      union collapses the daylight.
    </p>
  </section>

  <SheetFoot>
    <p>
    {de
      ? 'Belege sind Wayback-Permalinks (vorher/nachher) — in zwei Klicks selbst nachzuprüfen. Umschreibung ist nicht Vertuschung; das Instrument behauptet keine Absicht.'
      : 'Evidence is Wayback permalinks (before/after) — checkable yourself in two clicks. Rewriting is not cover-up; the instrument claims no intent.'}
    </p>
    <nav><a href={methodUrl}>{de ? 'Methodenblatt' : 'Method sheet'} →</a></nav>
  </SheetFoot>
</article>
</main>

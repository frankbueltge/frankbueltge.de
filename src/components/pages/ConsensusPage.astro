---
// Counter-measurement I — "Consensus".
// Measures orchestrated consensus: how much news "consensus" is one source, copied
// x-fold. Data: src/data/consensus/latest.json (GDELT, nightly; pipelines/consensus/).
// The irony lives in the deadpan: 77 identical mastheads under the label "independent".
import { getRelativeLocaleUrl } from 'astro:i18n'
import { t } from '@/i18n/ui'
import type { Locale } from '@/lib/site'
import type { ConsensusData } from '@/lib/consensus/types'
import { cleanTitle, echoPercent, spanLabel, hhmm } from '@/lib/consensus/format'
import { CHAIN_LABEL, aggregateStructure } from '@/lib/consensus/structure'
import { byYear, standing, summarise, type Baseline } from '@/lib/consensus/baseline'
import data from '@/data/consensus/latest.json'
import baselineJson from '@/data/consensus/baseline.json'
import SheetHead from '@/components/experiments/SheetHead.astro'
import SheetFoot from '@/components/experiments/SheetFoot.astro'
import '@/styles/experiment-sheet.css'

interface Props { locale: Locale }
const { locale } = Astro.props
const de = locale === 'de'
const d = data as unknown as ConsensusData
const h = d.headline
const r = d.runner_up

const dateLabel = new Date(d.date).toLocaleDateString(de ? 'de-DE' : 'en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
const methodUrl = getRelativeLocaleUrl(locale, '/werke/consensus')

const shownMastheads = h ? h.mastheads : []
const moreCount = h ? Math.max(0, h.domain_count - shownMastheads.length) : 0

// Evidence links (pipeline records them from 2026-08-05 on): masthead → the earliest
// article GDELT saw on that domain carrying the sentence. Older data renders plain chips.
const evidenceUrl = new Map((h?.articles ?? []).map((a) => [a.domain, a.url]))

// The structure of the consensus — USP rework #1 (program doc 2026-08-09). The audit's
// daylight for this instrument is the WHY-classification: none of the neighbors classify
// why outlets converged, only that they did. Aggregated at build time from every committed
// day file; structure.test.ts holds the aggregate to the archive.
const archiveRaw = import.meta.glob('/src/data/consensus/2026-*.json', { eager: true, import: 'default' })
const structure = aggregateStructure(
  Object.fromEntries(Object.entries(archiveRaw).map(([p, v]) => [p.replace(/^.*\/(\d{4}-\d{2}-\d{2})\.json$/, '$1'), v])) as never,
)
// Per method version since the dated correction of 2026-08-09 — the archive-wide share the
// page used to show pooled the v1 API days with the v2 full-stream days and came out
// backwards. The current instrument leads; superseded versions are named, not deleted.
const current = structure.byMethod[0]
const superseded = structure.byMethod.slice(1)
// the figure the page used to show: chain days pooled across ALL versions over all
// classified days — reconstructed here so the correction quotes itself accurately
const pooledChainDays = structure.byMethod.reduce((n, m) => n + (m.counts[CHAIN_LABEL] ?? 0), 0)
const pooledChainPct = structure.classified === 0 ? 0 : Math.round((pooledChainDays / structure.classified) * 100)
const supersededDays = superseded.reduce((n, m) => n + m.classified, 0)

// The longitudinal layer (G1 BigQuery path, activated 2026-08-09): the same measurement over
// the whole historical archive, computed once and committed. baseline.test.ts recomputes every
// ratio from the file's own components, so nothing here is asserted.
const baseline = baselineJson as unknown as Baseline
const base = summarise(baseline)
const years = byYear(baseline.days)
// only a v2 reading may be ranked against a v2 baseline — a v1 day would be a different pool
const nightlyMethod = (d as unknown as Record<string, { version?: string } | undefined>).method
const todayIsComparable = nightlyMethod?.version === 'v2-raw-files'
const stand = todayIsComparable ? standing(d.echo_index, baseline) : null
const pct = (x: number) => Math.round(x * 100)

// v3 — symbolic classification of the syndication structure (auditable).
const SYN: Record<string, { de: string; en: string }> = {
  'wire/chain syndication': {
    de: 'Ketten-Syndizierung — eine Verlagsgruppe, ein Push',
    en: 'chain syndication — one publishing group, one push',
  },
  'scattered placement': {
    de: 'verstreute Platzierung über mehrere Märkte',
    en: 'scattered placement across several markets',
  },
  mixed: { de: 'gemischt', en: 'mixed' },
}
const syn = h?.syndication
---

<main id="main" class="flex-1">
<article class="consensus mx-auto max-w-3xl px-4 py-14">
  <SheetHead title="Consensus">
    <p class="mt-2 max-w-xl text-fg-muted">{t(locale, 'cs.sub')}</p>
    <p class="mt-3 kicker">{dateLabel}</p>
  </SheetHead>

  {h ? (
    <>
      <section class="mb-12 border-l-2 border-accent/60 pl-5">
        <p class="kicker">
          {de ? 'Der heute am unabhängigsten berichtete Satz' : "Today's most independently reported sentence"}
        </p>
        <p class="mt-3 text-[clamp(20px,3.4vw,30px)] font-semibold leading-snug">„{cleanTitle(h.sample_title)}"</p>
        <p class="mt-3 text-fg-muted">
          {de
            ? `— wortgleich auf ${h.domain_count} verschiedenen Nachrichtenseiten.`
            : `— word-for-word across ${h.domain_count} separate news outlets.`}
        </p>
        {h.first_domain && (
          <p class="mt-2 font-mono text-xs text-fg-faint">
            {de
              ? `Zuerst aufgetaucht ${hhmm(h.first_seen)} UTC bei ${h.first_domain}` +
                (h.span_hours != null ? `; binnen ${spanLabel(h.span_hours, locale)} liefen ${h.domain_count - 1} weitere denselben Satz.` : '.')
              : `First surfaced ${hhmm(h.first_seen)} UTC via ${h.first_domain}` +
                (h.span_hours != null ? `; within ${spanLabel(h.span_hours, locale)}, ${h.domain_count - 1} more ran the identical sentence.` : '.')}
          </p>
        )}
        {syn && SYN[syn.label] && (
          <p class="mt-2 font-mono text-xs text-fg-faint">
            {de ? 'Klassifikation: ' : 'Classified: '}{SYN[syn.label][locale]}
            {` (${de ? 'TLD-Anteil' : 'TLD share'} ${Math.round(syn.tld_share * 100)}%).`}
          </p>
        )}
        {h.soft_echo_extra ? (
          <p class="mt-1 font-mono text-xs text-fg-faint">
            {de
              ? `+ ${h.soft_echo_extra} weitere Medien brachten denselben Inhalt umformuliert (Paraphrase, TF-IDF).`
              : `+ ${h.soft_echo_extra} more outlets ran the same content reworded (paraphrase, TF-IDF).`}
          </p>
        ) : null}
      </section>

      <section class="mb-12">
        <p class="kicker">
          {de ? 'Die „unabhängigen" Quellen' : 'The „independent" outlets'}
        </p>
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {shownMastheads.map((m) => (
            <li class="rounded border border-line/70 font-mono text-[11px] text-fg-muted">
              {evidenceUrl.has(m) ? (
                <a
                  href={evidenceUrl.get(m)}
                  target="_blank"
                  rel="noopener nofollow"
                  class="block px-2 py-0.5 underline decoration-line underline-offset-2 transition-colors hover:text-fg"
                >{m}</a>
              ) : (
                <span class="block px-2 py-0.5">{m}</span>
              )}
            </li>
          ))}
          {moreCount > 0 && (
            <li class="px-2 py-0.5 font-mono text-[11px] text-fg-faint">{de ? `+ ${moreCount} weitere` : `+ ${moreCount} more`}</li>
          )}
        </ul>
        {evidenceUrl.size > 0 && (
          <p class="mt-2 font-mono text-[11px] text-fg-faint">
            {de
              ? 'Jedes verlinkte Medium führt zum Artikel, der den Satz trug — der früheste, den GDELT auf dieser Domain sah.'
              : 'Each linked outlet opens the article that carried the sentence — the earliest GDELT saw on that domain.'}
          </p>
        )}
      </section>

      <section class="mb-12 flex items-baseline gap-4">
        <p class="text-[clamp(40px,8vw,72px)] font-bold leading-none tabular-nums">{echoPercent(d.echo_index, locale)}</p>
        <p class="max-w-xs text-sm leading-snug text-fg-muted">
          {de
            ? 'des heute gescannten Nachrichten-Stroms war Echo — wortgleich von mindestens drei Quellen kopiert, nicht eigene Recherche.'
            : "of today's scanned news stream was echo — copied verbatim by at least three outlets, not original reporting."}
        </p>
      </section>

      {stand && (
        <section class="mb-12 border-t border-line pt-6">
          <p class="kicker">
            {de ? 'Ist das viel? — sieben Jahre, eine Methode' : 'Is that a lot? — seven years, one method'}
          </p>
          <div class="mt-3 flex items-baseline gap-4">
            <p class="text-[clamp(32px,6vw,56px)] font-bold leading-none tabular-nums">{de ? `${pct(stand.percentile)}.` : `${pct(stand.percentile)}th`}<span class="ml-1 text-[0.32em] font-normal uppercase tracking-[0.18em] text-fg-muted">{de ? 'Perzentil' : 'percentile'}</span></p>
            <p class="max-w-md text-sm leading-snug text-fg-muted">
              {de
                ? `— so steht das heutige Echo von ${echoPercent(d.echo_index, locale)} in ${base.days.toLocaleString('de-DE')} Tagen, die seit dem ${base.from} genauso gemessen wurden. Median über den ganzen Zeitraum: ${echoPercent(base.medianEcho, locale)}.`
                : `— where today's echo of ${echoPercent(d.echo_index, locale)} stands among ${base.days.toLocaleString('en-GB')} days measured the same way since ${base.from}. Median across the record: ${echoPercent(base.medianEcho, locale)}.`}
            </p>
          </div>

          <table class="mt-6 w-full border-collapse font-mono text-[11px]">
            <caption class="sr-only">{de ? 'Median-Echo und Ketten-Anteil je Jahr' : 'Median echo and chain share per year'}</caption>
            <thead class="text-fg-faint">
              <tr class="border-b border-line text-left">
                <th scope="col" class="py-1 pr-3 font-normal">{de ? 'Jahr' : 'Year'}</th>
                <th scope="col" class="py-1 pr-3 font-normal">{de ? 'Tage' : 'Days'}</th>
                <th scope="col" class="py-1 pr-3 font-normal">{de ? 'Median-Echo' : 'Median echo'}</th>
                <th scope="col" class="py-1 pl-3 text-right font-normal">{de ? 'Kette' : 'Chain'}</th>
              </tr>
            </thead>
            <tbody>
              {years.map((y) => (
                <tr class="border-b border-line/40">
                  <td class="py-1 pr-3 tabular-nums">{y.year}</td>
                  <td class="py-1 pr-3 tabular-nums text-fg-faint">{y.days}</td>
                  <td class="py-1 pr-3 tabular-nums">{echoPercent(y.medianEcho, locale)}</td>
                  <td class="py-1 pl-3 text-right tabular-nums text-fg-faint">{pct(y.chainShare)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="mt-2 font-mono text-[11px] leading-relaxed text-fg-faint">
            {de
              ? `Der wortgleiche Konsens ist über den Zeitraum gefallen: von ${echoPercent(stand.firstMedian, locale)} (${stand.firstYear}) auf ${echoPercent(stand.recentMedian, locale)} (${stand.recentYear}) — gerechnet über die vollen Kalenderjahre. ${stand.firstYear === years[0].year ? '' : `${years[0].year} beginnt am ${base.from}, `}${years[years.length - 1].year} ist noch nicht zu Ende; die Tage-Spalte zeigt, welche Jahre unvollständig sind.`
              : `The verbatim consensus has fallen across the record: from ${echoPercent(stand.firstMedian, locale)} (${stand.firstYear}) to ${echoPercent(stand.recentMedian, locale)} (${stand.recentYear}) — measured over the full calendar years. ${stand.firstYear === years[0].year ? '' : `${years[0].year} starts on ${base.from}, `}${years[years.length - 1].year} is not over yet; the days column shows which years are partial.`}
          </p>

          <p class="mt-5 max-w-xl font-mono text-[11px] leading-relaxed text-fg-faint">
            {de
              ? `Und die Schicht, die die Nachbarn nicht führen: nicht DASS Redaktionen denselben Satz drucken, sondern WARUM. Über die ${base.days.toLocaleString('de-DE')} Tage der Baseline war der breiteste Satz des Tages in ${pct(base.chainShare)} % der Fälle eine Konzernkette — verstreute Aufnahme über mehrere Märkte ist der Normalfall, Ketten-Syndizierung die Ausnahme. `
              : `And the layer the neighbors do not keep: not THAT outlets print the same sentence, but WHY. Across the baseline's ${base.days.toLocaleString('en-GB')} days the widest sentence of the day was a corporate chain in ${pct(base.chainShare)}% of cases — scattered pickup across markets is the norm, chain syndication the exception. `}
            <a href={getRelativeLocaleUrl(locale, '/consensus/archive')} class="underline decoration-line underline-offset-2 hover:text-fg">{de ? 'Archiv' : 'archive'}</a>{current && (de
              ? `. Der laufende nächtliche Datensatz (${current.methodVersion}) trägt bisher ${current.classified} klassifizierte ${current.classified === 1 ? 'Tag' : 'Tage'}, davon ${pct(current.chainShare)} % Kette.`
              : `. The running nightly record (${current.methodVersion}) carries ${current.classified} classified ${current.classified === 1 ? 'day' : 'days'} so far, ${pct(current.chainShare)}% of them chain.`)}
          </p>

          <p class="mt-3 max-w-xl border-l-2 border-line pl-3 font-mono text-[11px] leading-relaxed text-fg-faint">
            {de
              ? `Korrektur vom 2026-08-09: Hier stand „${pooledChainPct} % der ${structure.classified} klassifizierten Tage waren Ketten-Syndizierung" — als Aussage über das ganze Archiv. Die Zahl mischte zwei Messpools: ${supersededDays} der Tage stammen aus der alten API-Methode mit unter tausend Artikeln je Tag, in der der breiteste Satz des Tages regelmäßig ein enger Wire-Push ist. Über ${base.days.toLocaleString('de-DE')} Tage einer Methode sagt die Messung das Gegenteil. Die alten Tage bleiben im Archiv und werden getrennt geführt.`
              : `Correction, 2026-08-09: this section used to read "${pooledChainPct}% of ${structure.classified} classified days were chain syndication" — as a statement about the whole archive. That figure pooled two measurement pools: ${supersededDays} of those days come from the old API method with under a thousand articles a day, where the day's widest sentence is routinely a tight wire push. Across ${base.days.toLocaleString('en-GB')} days of one method the measurement says the opposite. The old days stay in the archive and are kept apart.`}
          </p>

          <p class="mt-3 max-w-xl font-mono text-[11px] leading-relaxed text-fg-faint">
            {de
              ? `Herkunft: ${baseline.source.citation} · GKG 2.1 über BigQuery, ${baseline.provenance.jobs.length} Jobs, Query und Job-Trace committet (${baseline.provenance.query}); ${baseline.gaps.missing_days} Tage fehlen in GDELTs Archiv und werden nicht interpoliert. Die nächtliche Lesung ist ein rollendes 24-Stunden-Fenster, die Baseline-Tage sind UTC-Kalendertage — vergleichbar, nicht identisch.`
              : `Provenance: ${baseline.source.citation} · GKG 2.1 via BigQuery, ${baseline.provenance.jobs.length} jobs, query and job trace committed (${baseline.provenance.query}); ${baseline.gaps.missing_days} days are absent from GDELT's own archive and are not interpolated. The nightly reading is a rolling 24-hour window, the baseline days are UTC calendar days — comparable, not identical.`}
          </p>
        </section>
      )}

      {r && (
        <section class="mb-12 border-t border-line pt-6">
          <p class="kicker">{de ? 'Auch heute im Chor' : 'Also in chorus today'}</p>
          <p class="mt-2 leading-snug">„{cleanTitle(r.sample_title)}"</p>
          <p class="mt-1 font-mono text-xs text-fg-faint">
            {de ? `${r.domain_count} Medien, wortgleich` : `${r.domain_count} outlets, word-for-word`}
          </p>
        </section>
      )}
    </>
  ) : d.stats.articles_scanned === 0 ? (
    <p class="max-w-xl text-fg-muted">
      {de
        ? 'Quelle nicht erreichbar — Feststellung entfällt. GDELT hat die nächtlichen Abrufe nicht beantwortet; es wurden 0 Artikel gescannt. Ein Ausfall der Messung, kein ruhiger Nachrichtentag.'
        : 'Source unreachable — finding omitted. GDELT did not answer the nightly fetches; 0 articles were scanned. A failure of the measurement, not a quiet news day.'}
    </p>
  ) : (
    <p class="text-fg-muted">{de ? 'Heute kein Echo-Cluster über der Schwelle.' : 'No echo cluster above threshold today.'}</p>
  )}

  <section class="mb-12 border-t border-line pt-6">
    <p class="kicker">
      {de ? 'Nächste Nachbarn' : 'Nearest neighbors'}
    </p>
    <ul class="mt-3 space-y-2 text-sm text-fg-muted">
      <li>
        <a href="https://arstechnica.com/information-technology/2013/04/churnalism-tracker-catches-journalists-copying-press-releases-wikipedia" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">Churnalism</a>
        {de ? ' — prüft eingefügten Artikeltext gegen einen Hash-Korpus aus Pressemitteilungen auf wortgleiche Übernahme.' : ' — checks pasted article text against a hashed corpus of press releases for verbatim reuse.'}
      </li>
      <li>
        <a href="https://www.media.mit.edu/projects/media-cloud/overview" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">Media Cloud</a>
        {de ? ' (MIT/Harvard) — dedupliziert wiederholte Sätze über mehr als eine Milliarde Artikel hinweg, mit offener API.' : ' (MIT/Harvard) — deduplicates repeated sentences across 1B+ articles, with an open API.'}
      </li>
      <li>
        <a href="https://ijoc.org/index.php/ijoc/article/download/9904/2777" target="_blank" rel="noopener nofollow" class="underline decoration-line underline-offset-2 hover:text-fg">{de ? '„Detecting Textual Reuse in News Stories, At Scale"' : '"Detecting Textual Reuse in News Stories, At Scale"'}</a>
        {de ? ', International Journal of Communication — begutachtete Churnalism-Methodik im großen Maßstab.' : ', International Journal of Communication — peer-reviewed churnalism-at-scale methodology.'}
      </li>
    </ul>
    <p class="mt-3 max-w-xl text-sm leading-relaxed text-fg-muted">
      {de
        ? 'Die Messtechnik ist über ein Jahrzehnt alt und institutionalisiert; was fehlt, ist das Format — ein tägliches, öffentliches Ritual mit laufendem Echo-Wert. Was hier neu dazukommt: die Klassifikation, WARUM Medien konvergieren (Ketten-Syndizierung vs. verstreute Platzierung, TLD-Anteil), nicht nur DASS sie es tun — das leistet keiner der Nachbarn.'
        : "The measurement technique is over a decade old and institutionalized; what's missing elsewhere is the format — a daily public ritual with a running echo score. What's new here: a classification of WHY outlets converge (chain syndication vs. scattered placement, TLD share), not just THAT they did — none of the neighbors do that."}
    </p>
  </section>

  <SheetFoot>
    <p class="font-mono text-xs text-fg-faint">
      {d.stats.beats
        ? de
          ? `Gescannt: ${d.stats.articles_scanned} Artikel über ${d.stats.domains_scanned} Domains (GDELT, ${d.stats.beats.length} Beats).`
          : `Scanned: ${d.stats.articles_scanned} articles across ${d.stats.domains_scanned} domains (GDELT, ${d.stats.beats.length} beats).`
        : de
          ? `Gescannt: ${d.stats.articles_scanned.toLocaleString('de-DE')} Artikel über ${d.stats.domains_scanned.toLocaleString('de-DE')} Domains (GDELT-Rohdateien, ${d.stats.slots_fetched}/${d.stats.slots_expected} 15-Minuten-Dateien).`
          : `Scanned: ${d.stats.articles_scanned.toLocaleString('en-US')} articles across ${d.stats.domains_scanned.toLocaleString('en-US')} domains (GDELT raw files, ${d.stats.slots_fetched}/${d.stats.slots_expected} 15-minute files).`}
    </p>
    <nav class="mt-2 flex gap-4">
      <a href={methodUrl} class="sheet-link">{t(locale, 'prot.method')} →</a>
      <a href="/consensus/archive" class="sheet-link">
        {de ? 'Archiv — jeder committete Tag' : 'Archive — every committed day'} →
      </a>
    </nav>
  </SheetFoot>
</article>
</main>

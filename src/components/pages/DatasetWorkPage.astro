---
// /datasets/work/[id] — eine Seite je Werk mit MEHREREN Fassungen.
//
// Warum es diese Seite gibt: Ein Datensatz, der in vier Versionen registriert wurde,
// hatte bis zum 27.07. vier fast identische Unterseiten — gleicher Titel, gleicher
// Herausgeber, gleiches Jahr, oft dieselbe Beschreibung. Gemessen waren das 14.073
// von 16.494 Seiten, allein 10.254 davon aus Werken mit genau zwei Fassungen. Diese
// Seite fasst sie zusammen und zeigt stattdessen die Fassungsgeschichte — eine
// Aussage, die keine einzelne Quellseite trifft, weil jede von ihnen genau einen
// Datensatz kennt.
//
// Die Fassungsseiten bleiben abrufbar; sie verweisen per canonical hierher.
import details from '@/data/datasets/details.json'
import { SITE } from '@/lib/site'
import {
  accessLabel,
  licenceLabel,
  suggestedCitation,
  type DatasetWork,
} from '@/lib/datasets'

interface Props {
  workId: string
  work: DatasetWork
}
const { workId, work } = Astro.props
const canonical = `${SITE.url}/datasets/work/${workId}`

interface EntryDetail {
  zugang_url?: string
  quell_id?: string
  beschreibung?: string
  urheber?: { name: string; orcid?: string }[]
}
const detailOf = (id: string) =>
  ((details as Record<string, EntryDetail>)[id] ?? {}) as EntryDetail

const representative = work.f.find((v) => v.i === work.v) ?? work.f[0]
const repDetail = detailOf(representative.i)
const creators = repDetail.urheber ?? []
const confirmed = work.f.filter((v) => v.pv === 'landing' || v.pv === 'download').length
const years = work.f.map((v) => v.j).filter((j): j is number => typeof j === 'number')
const span = years.length
  ? Math.min(...years) === Math.max(...years)
    ? String(Math.min(...years))
    : `${Math.min(...years)}–${Math.max(...years)}`
  : 'not stated'

// JSON-LD: das Werk als Dataset, die Fassungen als hasPart. "url" zeigt auf den
// Zugriffsweg des Vertreters — wörtlich aus der Quelle, nie konstruiert.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  mainEntityOfPage: canonical,
  name: work.t,
  url: repDetail.zugang_url ?? '',
  version: `${work.n} versions recorded`,
  hasPart: work.f.map((v) => ({
    '@type': 'Dataset',
    name: v.t,
    identifier: detailOf(v.i).quell_id ?? '',
    datePublished: v.j ? String(v.j) : undefined,
  })),
}
if (work.h) jsonLd.publisher = { '@type': 'Organization', name: work.h }
if (repDetail.beschreibung) jsonLd.description = repDetail.beschreibung
if (creators.length) {
  jsonLd.creator = creators.map((c) => ({
    '@type': 'Person',
    name: c.name,
    ...(c.orcid ? { identifier: c.orcid } : {}),
  }))
}
---

<main id="main" class="mx-auto w-full max-w-3xl px-4 py-10 sm:py-14">
  <p class="mb-2 font-mono text-xs uppercase tracking-widest text-fg-faint">
    Dataset Register · work
  </p>
  <h1 class="text-2xl font-semibold leading-snug tracking-tight sm:text-3xl">{work.t}</h1>

  <p class="mt-4 text-fg-muted">
    Recorded in <strong class="font-normal text-fg">{work.n} versions</strong> ({span}).
    {work.vg === 'quelle' ? (
      <>The version shown first is the one the other records point to themselves.</>
    ) : (
      /* Ehrlichkeitsregel: Welche Fassung die aktuelle ist, behauptet das Register
         nicht von sich aus. Wenn keine Fassung von den anderen als Ziel benannt wird,
         entscheidet das Jahr — und dann heißt es genau das. */
      <>No record names another as its successor, so the most recent year leads —
      that is this register's ordering, not a statement by the source.</>
    )}
  </p>

  {work.abw.length > 0 && (
    /* Widersprüche werden benannt, nicht geglättet: verschiedene Lizenzen über die
       Fassungen hinweg sind ein Befund über die Quelle, kein Darstellungsproblem. */
    <p class="mt-3 rounded-lg border border-line bg-panel px-3 py-2 text-sm text-fg-muted">
      The versions disagree on {work.abw.map((f) => (f === 'lizenz_id' ? 'licence' : 'publisher')).join(' and ')}.
      Shown per version below, not merged into one value.
    </p>
  )}

  {repDetail.beschreibung && (
    <p class="mt-6 whitespace-pre-line text-[15px] leading-relaxed text-fg-muted">
      {repDetail.beschreibung}
    </p>
  )}

  <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2.5 text-sm">
    <dt class="text-fg-faint">Creators</dt>
    <dd class="text-fg">{creators.length ? creators.map((c) => c.name).join(' · ') : 'not stated'}</dd>

    <dt class="text-fg-faint">Publisher</dt>
    <dd class="text-fg">{work.h || 'not stated'}</dd>

    <dt class="text-fg-faint">Versions</dt>
    <dd class="text-fg">{work.n}</dd>

    <dt class="text-fg-faint">Access checked</dt>
    <dd class="text-fg">
      {confirmed > 0
        ? `${confirmed} of ${work.n} versions confirmed by an actual request`
        : 'no version confirmed yet'}
    </dd>
  </dl>

  <section class="mt-10 border-t border-line pt-6">
    <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-fg-faint">Version history</h2>
    <p class="mt-2 text-xs text-fg-faint">
      Grouped by this register from the relations the sources state — not presented as
      a group by any single catalogue.
    </p>
    <ul class="mt-4 space-y-3">
      {work.f.map((v) => (
        <li class="rounded-lg border border-line bg-panel p-3">
          <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <span class="font-mono text-xs tabular-nums text-fg-faint">{v.j ?? '—'}</span>
            <a href={`/datasets/${v.i}`} class="text-sm text-fg underline decoration-line underline-offset-2 hover:decoration-fg">
              {v.t}
            </a>
            {v.i === work.v && (
              <span class="rounded border border-line px-1.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-fg-faint">
                pointed to by the others
              </span>
            )}
          </div>
          <p class="mt-1.5 font-mono text-xs text-fg-faint">
            {detailOf(v.i).quell_id} · licence: {licenceLabel(v.l)} · {accessLabel(v.pv, v.s)}
          </p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-10 border-t border-line pt-6">
    <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-fg-faint">Suggested citation</h2>
    <p class="mt-2 text-sm leading-relaxed text-fg-muted">
      {suggestedCitation(
        { t: work.t, h: work.h, j: representative.j },
        repDetail.zugang_url ?? '',
      )}
    </p>
    <p class="mt-1.5 text-xs text-fg-faint">
      Assembled from this work's own fields — not a publisher-issued citation string.
      Cite the specific version if your use depends on it.
    </p>
  </section>

  <p class="mt-10 text-xs text-fg-faint"><a href="/datasets" class="hover:text-fg">← back to the Dataset Register</a></p>
</main>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

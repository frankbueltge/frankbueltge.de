---
import { t } from '@/i18n/ui'
import { aboutContent } from '@/data/about'
import { SITE, type Locale } from '@/lib/site'

const locale = (Astro.currentLocale ?? 'en') as Locale
const a = aboutContent[locale]
const links = [
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'GitHub', href: SITE.social.github },
  { label: 'datavism.org', href: SITE.projects.datavism },
  { label: 'data-snack.com', href: SITE.projects.dataSnack },
]
---

<main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-16 sm:py-24">
  {/* Gradient-Headline der Vor-Ökologie-Ära entfernt (16.07.): About folgt jetzt der
      zurückhaltenden Typo des Hubs — der einzige Eigenname im System, unlackiert. */}
  <p class="font-mono text-xs uppercase tracking-[0.28em] text-fg-muted">{t(locale, 'about.title')}</p>
  {/* Person entity anchor (SEO): real portrait + name + role, so this page reads
      unambiguously as the authoritative page about Frank Bültge the person — the signal
      that wins the name query and disambiguates from the namesake. Portrait shown in a
      fixed square via object-cover/object-top so the face stays framed without a hard crop. */}
  <div class="mt-6 flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-8">
    <img
      src="/frank-bueltge.webp"
      alt="Frank Bültge — Data Engineering & Analytics"
      width="176"
      height="176"
      class="h-40 w-40 shrink-0 rounded-2xl border border-line object-cover object-top sm:h-44 sm:w-44"
      loading="eager"
    />
    <div>
      <h1 class="text-[clamp(34px,5vw,56px)] font-bold tracking-[-0.03em]">Frank Bültge</h1>
      <p class="mt-2 font-mono text-sm uppercase tracking-[0.2em] text-fg-muted">{SITE.role[locale]}</p>
    </div>
  </div>
  <p class="mt-8 max-w-2xl text-xl text-fg sm:text-2xl">{a.lede}</p>

  <div class="mt-12 space-y-10">
    {a.sections.map((s) => (
      <section>
        <h2 class="text-xl font-semibold">{s.heading}</h2>
        <div class="mt-3 space-y-3">
          {s.paragraphs.map((p) => <p class="leading-relaxed text-fg-muted">{p}</p>)}
        </div>
      </section>
    ))}
  </div>

  <h2 class="mt-12 font-mono text-xs uppercase tracking-widest text-fg-faint">Contact</h2>
  <p class="mt-3 max-w-lg text-fg-muted">
    Reachable directly by <a href={`mailto:${SITE.email}`} class="underline hover:text-fg">{SITE.email}</a>
    or on LinkedIn. For projects, conversations, or just a good question about data — see
    also <a href="/contact" class="underline hover:text-fg">/contact</a>.
  </p>

  <h2 class="mt-10 font-mono text-xs uppercase tracking-widest text-fg-faint">{t(locale, 'about.elsewhere')}</h2>
  <ul class="mt-4 flex flex-wrap gap-2">
    {links.map((l) => (
      <li><a href={l.href} target="_blank" rel="noreferrer" class="rounded-full border border-line px-3 py-1.5 text-sm text-fg-muted transition-colors hover:border-fg-muted hover:text-fg">{l.label} ↗</a></li>
    ))}
    <li><a href={`mailto:${SITE.email}`} class="rounded-full border border-line px-3 py-1.5 text-sm text-fg-muted transition-colors hover:border-fg-muted hover:text-fg">{SITE.email}</a></li>
  </ul>

  {/* ProfilePage schema: marks /about as the canonical profile page for the site-wide
      Person node (#person, enriched with the portrait + locality in Base.astro). Google
      uses ProfilePage/Person for people — this is the entity anchor for the name query. */}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'ProfilePage',
    '@id': `${SITE.url}/about/#profilepage`,
    url: `${SITE.url}/about/`,
    name: 'About Frank Bültge',
    mainEntity: { '@id': `${SITE.url}/#person` },
  })} />
</main>

---
// /contact — a real form since 2026-08-01 (spec 2026-08-01-rueckweg-email-design.md D5).
// The form posts into the SAME private letter queue as the post office's letterbox
// (functions/api/post.js, to: "frank") — one intake, one review surface, one privacy
// statement. The mailto link stays for people who prefer their own mail client.
//
// Order flipped same day (Frank): the form led a double life as a footnote under the mailto
// buttons, headed "Or right here · no mail client needed" — the right framing while the
// buttons were the page and the form an afterthought. Now the page sits in the top nav as
// the site's contact door, so the form comes first and the buttons follow as alternatives.
//
// Re-skin 2d (2026-09-02): the page wears the frame's recipe — kicker as .kicker, the head on
// the display step, the form as a panel with the fields cut from src/lib/ui/field.ts (the same
// recipe the shadcn Input/Textarea primitives wear), the send button on the primary recipe, the
// other channels as outline buttons. The form's names, the honeypot, the Turnstile widget and
// the script below are untouched: the wire to functions/api/post.js is exactly what it was.
import { t } from '@/i18n/ui'
import { SITE, type Locale } from '@/lib/site'
import { buttonVariants } from '@/components/ui/button'
import { fieldLabel, fieldVariants } from '@/lib/ui/field'
import { cn } from '@/lib/ui/cn'
const locale = (Astro.currentLocale ?? 'en') as Locale
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined

const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const input = cn(fieldVariants({ kind: 'input' }), 'mt-1.5')
const textarea = cn(fieldVariants({ kind: 'textarea' }), 'mt-1.5')
const primary = cn(buttonVariants({ variant: 'default' }))
const channel = cn(buttonVariants({ variant: 'outline' }), 'text-fg')
---

<main id="main" class="mx-auto w-full max-w-2xl flex-1 px-6 py-20 sm:py-28">
  <p class={kicker}>{t(locale, 'contact.title')}</p>
  <h1 class="mt-5 text-display font-bold">{t(locale, 'contact.title')}</h1>
  <p class="mt-5 max-w-lg text-h3 font-normal text-fg-muted">{t(locale, 'contact.body')}</p>

  <section class={cn(panel, 'mt-10 p-5 sm:p-6')} aria-label="Contact form">
    <p class="max-w-[60ch] text-small leading-relaxed text-fg-muted">
      Write right here — it lands in a private queue read by me. Nothing is published, nothing
      is fed to a model. Leave an email if you want an answer; without one your message is
      read all the same, it just can't be replied to.
    </p>
    <form id="contact-form" class="mt-6 space-y-4" novalidate>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class={fieldLabel}>
          <span>from</span>
          <input name="fromMark" required maxlength="80" placeholder="your name" class={input} />
        </label>
        <label class={fieldLabel}>
          <span>email <span class="normal-case text-fg-faint">(optional, for a reply)</span></span>
          <input name="contact" maxlength="200" type="email" placeholder="you@example.org" class={input} />
        </label>
      </div>
      <label class={fieldLabel}>
        <span>message</span>
        <textarea name="text" required minlength="10" maxlength="4000" rows="6" class={textarea}></textarea>
      </label>
      {/* honeypot — invisible to people, filled by bots */}
      <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="hidden" />
      {turnstileSiteKey && <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="auto"></div>}
      <div class="flex items-center gap-4">
        <button type="submit" class={primary}>send</button>
        <p id="contact-status" class="font-mono text-mono-sm text-fg-muted" aria-live="polite"></p>
      </div>
    </form>
  </section>

  <section class="mt-14 border-t border-line/60 pt-8" aria-label="Other channels">
    <p class={kicker}><b class="text-fg">Prefer your own client?</b> · or another channel</p>
    <div class="mt-5 flex flex-wrap gap-3">
      <a href={`mailto:${SITE.email}`} class={channel}>{SITE.email} →</a>
      <a href={SITE.social.linkedin} target="_blank" rel="noreferrer" class={channel}>LinkedIn ↗</a>
      <a href={SITE.social.github} target="_blank" rel="noreferrer" class={channel}>GitHub ↗</a>
    </div>
  </section>
</main>

{turnstileSiteKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Same wire as the post office letterbox (functions/api/post.js), addressed to "frank" —
  // a personal message, never forwarded to a practice.
  const form = document.getElementById('contact-form') as HTMLFormElement | null
  const status = document.getElementById('contact-status')
  const SAY: Record<string, string> = {
    'rate-limit': 'Too many messages from here just now — please try again in a few minutes.',
    'daily-cap': 'Today’s queue is full — please come back tomorrow, or use the email link above.',
    'open-cap': 'The queue is full — please use the email link above.',
    turnstile: 'The bot check failed. Please reload the page and try again.',
    standby: 'The form is not fully wired up yet — please use the email link above.',
    'from-mark': 'Please leave a name (2–80 characters).',
    text: 'The message needs between 10 and 4000 characters.',
    contact: 'The email line does not fit (3–200 characters).',
  }
  if (form && status) {
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      status.textContent = 'sending…'
      const data = new FormData(form)
      const turnstileToken = data.get('cf-turnstile-response') ?? ''
      try {
        const res = await fetch('/api/post', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            to: 'frank',
            fromMark: data.get('fromMark'),
            contact: data.get('contact') || '',
            regarding: 'contact form',
            text: data.get('text'),
            website: data.get('website') || '',
            turnstileToken,
          }),
        })
        const out = await res.json().catch(() => ({}))
        if (res.ok && out.ok) {
          form.reset()
          status.textContent = 'Sent — it lands directly with me. Thanks.'
        } else {
          status.textContent = SAY[out.reason] ?? 'That did not go through — please try the email link above.'
        }
      } catch {
        status.textContent = 'Network hiccup — please try again.'
      }
    })
  }
</script>

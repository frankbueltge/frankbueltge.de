---
// /datasets — Dataset Register.
//
// Since 2026-07-28 not empty: the holdings come from the data sources the house's own works
// fetch nightly (src/lib/register.ts explains why that is the route and which five search
// routes were measured and dropped before it).
//
// 2026-11-09 (Frank's choice on the catalogue review, wording private): the register shares its
// toolbar with /papers and /atlas (search, sort, folded filters, paging, state in the address),
// shows each source once (src/lib/register.ts, SOURCES), separates the APIs works fetch from the
// datasets practices cite, and groups its users into practices, instruments and plumbing.
//
// Information before poetry: first "what is this?", then the figures, then the holdings.
// Numbers only from the data — no value is typed into the prose.
import { SOURCES, usedBy, userKind, werkLabel, zugangLabel } from '@/lib/register'
import { titleSortKey } from '@/lib/catalogue/query'
import CatalogueStats from '@/components/catalogue/CatalogueStats.astro'
import CatalogueToolbar from '@/components/catalogue/CatalogueToolbar.astro'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'

const PAGE_SIZE = 50
const total = SOURCES.length
const confirmed = SOURCES.filter((e) => e.geprueft).length
const gated = SOURCES.filter((e) => e.zugang_gesperrt).length
const byMore = SOURCES.filter((e) => usedBy(e).length > 1).length

const count = <T,>(values: T[]) => {
  const m = new Map<T, number>()
  for (const v of values) m.set(v, (m.get(v) ?? 0) + 1)
  return m
}

// Two kinds of entry that used to stand in one alphabet: an API or file a work calls (its
// title is often just the host, because that is what it is), and a dataset a practice cites by
// DOI. The filter and the card say which is which.
const kindOf = (e: (typeof SOURCES)[number]) => (e.aufnahmegrund === 'zitiert' ? 'cited' : 'fetched')
const kindCounts = count(SOURCES.map(kindOf))

const KIND_ORDER = ['practice', 'instrument', 'infrastructure'] as const
const KIND_TITLE = { practice: 'practices', instrument: 'instruments', infrastructure: 'shared plumbing' }
const userCounts = [...count(SOURCES.flatMap(usedBy)).entries()]
const userOptions = KIND_ORDER.flatMap((k) =>
  userCounts
    .filter(([w]) => userKind(w) === k)
    .sort((a, b) => b[1] - a[1])
    .map(([w, n], i) => ({ value: w, label: werkLabel(w), n, section: i === 0 ? KIND_TITLE[k] : undefined })),
)

// The four access states are the register's real subject and are deliberately not flattened
// into "checked / unchecked".
const state = (e: (typeof SOURCES)[number]) =>
  e.geprueft ? 'confirmed' : e.zugang_gesperrt ? 'gated' : e.nur_vorlage ? 'template' : 'silent'
const accessFacet = [
  { value: 'confirmed', label: 'access confirmed', n: confirmed },
  { value: 'gated', label: 'gated', n: gated },
  { value: 'template', label: 'template only', n: SOURCES.filter((e) => e.nur_vorlage).length },
  { value: 'silent', label: 'no answer', n: SOURCES.filter((e) => state(e) === 'silent').length },
].filter((z) => z.n > 0)

const groups = [
  { key: 'kind', title: 'kind', options: [
    { value: 'fetched', label: 'fetched by a work', n: kindCounts.get('fetched') ?? 0 },
    { value: 'cited', label: 'cited as a dataset', n: kindCounts.get('cited') ?? 0 },
  ].filter((o) => o.n > 0) },
  { key: 'used', title: 'used by', options: userOptions },
  { key: 'access', title: 'access', options: accessFacet },
]
const sorts = [
  { value: 'access', label: 'access confirmed first' },
  { value: 'used', label: 'most used' },
  { value: 'title', label: 'name A–Z' },
]
// Confirmed first, then alphabetical: what demonstrably answers stands on top.
const sorted = [...SOURCES].sort((a, b) => {
  if (a.geprueft !== b.geprueft) return a.geprueft ? -1 : 1
  return a.titel.localeCompare(b.titel)
})
const ACCESS_RANK = { confirmed: 0, gated: 1, template: 2, silent: 3 }
/** A title that is one word with a dot in it is a host name, and is set as one. */
const isHost = (t: string) => !/\s/.test(t.trim()) && t.includes('.')

const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const fold = 'fold-chevron inline-block'
const more = cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'font-mono text-mono-sm font-normal')
---

<main id="main" class="mx-auto w-full max-w-4xl px-4 py-10 sm:py-14">
  <header class="mb-8 max-w-3xl">
    <p class={cn(kicker, 'mb-2')}>Catalogues · Datasets</p>
    <h1 class="text-h1 font-semibold">Dataset Register</h1>
    <p class="mt-4 text-body text-fg-muted">
      The public data this lab's own pipelines and the practices' works actually retrieve,
      and the datasets the practices cite by DOI. Every entry names who uses it and the
      file the call or citation is written in — and states how far the access route was
      confirmed when it was last asked.
    </p>
    <p class="mt-3 text-body text-fg-muted">
      The register does not collect what exists. It reads what runs. A call in the source
      of a nightly pipeline is a stronger warrant than a citation: a citation says someone
      read this once, a scheduled fetch says it is load-bearing tonight.
    </p>
  </header>


  <CatalogueStats items={[
    { value: total, label: 'sources in use' },
    { value: confirmed, label: 'access confirmed' },
    { value: gated, label: 'exist but gated' },
    { value: byMore, label: 'used by more than one' },
  ]} />

  <section
    data-catalogue
    data-groups="kind used access"
    data-multi="used"
    data-sorts="access used title"
    data-sort-desc="used"
    data-default-sort="access"
    data-page-size={PAGE_SIZE}
  >
    <CatalogueToolbar
      groups={groups}
      sorts={sorts}
      total={total}
      noun="sources"
      placeholder="Search name, host, user, file…"
    />

    <ol data-list class="space-y-4">
      {sorted.map((e) => (
        <li
          class={cn(panel, 'ds-card break-words p-5')}
          data-card
          data-f-kind={kindOf(e)}
          data-f-used={usedBy(e).join(' ')}
          data-f-access={state(e)}
          data-s-access={`${ACCESS_RANK[state(e)]}${titleSortKey(e.titel)}`}
          data-s-used={String(usedBy(e).length)}
          data-s-title={titleSortKey(e.titel)}
          data-text={[e.titel, e.host, e.relevanz, ...usedBy(e).map(werkLabel), ...e.fundstellen].join(' ')}
        >
          <p class="mb-1 font-mono text-mono-xs uppercase tracking-wider text-fg-faint">
            {kindOf(e) === 'cited' ? 'dataset · cited' : 'source · fetched'}
            {e.verify_status === 'toVerify' && (
              <span title="the use is documented; nobody has read the entry over yet"> · not yet reviewed</span>
            )}
          </p>
          <h2 class={cn('font-semibold leading-snug text-fg', isHost(e.titel) ? 'font-mono text-body' : 'text-h3')}>
            <a href={e.zugriff_url} rel="noopener"
               class="decoration-line underline-offset-4 hover:underline">{e.titel}</a>
          </h2>

          <p class="mt-2 text-small leading-relaxed text-fg-muted">{e.relevanz}</p>

          <div class="ds-ids mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-mono-sm text-fg-faint">
            {!isHost(e.titel) && <span>{e.host}</span>}
            <span>{zugangLabel(e)}</span>
            <span>used by {usedBy(e).map(werkLabel).join(', ')}</span>
          </div>

          <details class="mt-3 border-t border-line pt-2">
            <summary class="cursor-pointer font-mono text-mono-sm text-fg-faint hover:text-fg">
              <span class={fold}>▾</span> {e.aufnahmegrund === 'zitiert'
                ? 'admitted because a practice cites it as a dataset'
                : 'admitted because a work of this ecology retrieves it'}
            </summary>
            <ul class="mt-2 space-y-1 font-mono text-mono-sm text-fg-faint">
              {e.fundstellen.map((f) => <li>{e.aufnahmegrund === 'zitiert' ? 'cited in' : 'call written in'} {f}</li>)}
              {e.adressen.map((a) => <li class="break-all">{e.aufnahmegrund === 'zitiert' ? 'resolves at' : 'fetches'} {a}</li>)}
              {e.pruef_vermerk && <li>note: {e.pruef_vermerk}</li>}
            </ul>
          </details>
        </li>
      ))}
    </ol>

    <p data-empty hidden class="py-10 text-center text-small text-fg-muted">
      Nothing matches. Clear the search or a filter.
    </p>
    <div class="mt-6 flex justify-center">
      <button type="button" data-more hidden class={more}>show <span data-more-n>{PAGE_SIZE}</span> more</button>
    </div>
  </section>

  {total === 0 && (
    <p class="text-small leading-relaxed text-fg-muted">
      Empty, and that is the accurate state — not a source outage, not a failed build.
    </p>
  )}
  <!-- The roll-back stays visible and dated instead of vanishing under the new holdings
       (currency rule); since 2026-11-09 below the list rather than above it. -->
  <details class={cn(panel, 'mt-12 p-5')}>
    <summary class={cn(kicker, 'cursor-pointer hover:text-fg')}>
      <span class={fold}>▾</span> How this register got here · reset 2026-07-27
    </summary>
    <p class="mt-3 text-small leading-relaxed text-fg-muted">
      Until 27 July 2026 the register held 16,516 entries, harvested by running a keyword
      sieve over 56,620,404 DataCite records, and published 8,590 pages. It was rolled
      back to nothing — not trimmed, not re-filtered. What settled it was a count: of the
      16,507 DOIs in the register and the 89 the practices had ever cited, the overlap was
      <strong class="font-semibold text-fg">zero</strong>. A keyword in a title names a
      role, not a subject; a sieve counts word occurrences and reports it as relevance.
    </p>
    <p class="mt-3 text-small leading-relaxed text-fg-muted">
      Five ways of <em>searching</em> for suitable datasets were then measured and found
      empty: DataCite back-references (1 hit across 20 papers), OpenAlex dataset
      neighbourhood (0), and three topic searches (0, 0, and 38 with unusable top hits).
      The experiments had been retrieving sixty public sources all along.
    </p>
    <p class="mt-3 text-small leading-relaxed text-fg-muted">
      Nothing measured was destroyed: the earlier harvest, its rejection log and its
      failure notes remain in the
      <a href="https://github.com/frankbueltge/dataset-hub" rel="noopener"
         class="underline decoration-line underline-offset-4 transition-colors hover:text-fg">dataset-hub</a>
      repository as a quarry, not as a record on display.
    </p>
  </details>
</main>

<style>
  /* The entry card answers the pointer with the frame's gesture at the frame's speed. It is a
     card that is READ in place (its links sit inside it), so it brightens its hairline and
     casts a little deeper rather than rising: .lift is for cards that ARE the destination.
     The rule stands here because global.css's interactive rule cannot reach a <li>.
     (re-skin 2d, 2026-09-02) */
  .ds-card {
    transition:
      border-color 0.2s var(--ease-frame),
      box-shadow 0.2s var(--ease-frame);
  }
  .ds-card:hover,
  .ds-card:focus-within {
    border-color: var(--color-line-lift);
    box-shadow: var(--elev-lift);
  }
  .ds-ids > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { initCatalogue } from '@/lib/catalogue/controller'
  const root = document.querySelector<HTMLElement>('[data-catalogue]')
  if (root) initCatalogue(root)
</script>

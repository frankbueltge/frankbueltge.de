---
// Steuerzentrale v3 — the ops room (2026-08-21, Frank's ask, wording private: one glance over
// everything, interactive, a professional operator surface — v2's plain text sections read as
// a printout). The room wears the entrance's instrument-panel language: ops-room.css supplies
// ground, grid and tokens (scoped to .ops-room on <main>), hub-triptych.css the three practice
// identity colours, zentrale-ops.css this page's own furniture. No new identity hexes — see
// that file's header for the colour provenance.
//
// The data model and every action flow are v2's, unchanged: content comes exclusively from the
// script below against GET/POST /api/zentrale/* (contract: X-Zentrale-Auth header, token from
// localStorage). Nothing renders server-side except the static frame and the knob register —
// there is no committed JSON behind this page (the one sanctioned exception to "Git ist das
// Archiv", docs/design/2026-07-17-steuerzentrale.md). Hence no no-JS fallback, only <noscript>.
//
// Script pattern follows CockpitPage.astro: no is:inline (Astro bundles and hashes it, allowed
// by script-src 'self'), a generic el() builder that inserts strings exclusively as DOM text
// nodes (never innerHTML — commit messages, issue excerpts and seeds are foreign text), and
// German error-code→text maps.
//
// Fixed on the way (2026-08-21): the access section and the gate lane both carried
// data-zx="gate" since v2 — querySelector resolved both constants to the FIRST match, so every
// publication-candidate card was appended into the hidden access section and the visible "Am
// Gate" lane stayed empty forever. The lane hook is now data-zx="gatelane".
import '@/styles/ops-room.css'
import '@/styles/hub-triptych.css'
import '@/styles/zentrale-ops.css'

// The knob register (static by design): the levers Frank actually has, one row per unit, each
// chip linking the exact file that IS the lever. Rendered server-side because the register is
// knowledge about the house, not live state — it changes by decision, with this file.
const GH = 'https://github.com/frankbueltge'
const KNOBS: { name: string; voice: string | null; links: [string, string][] }[] = [
  {
    name: 'Atelier · Assay',
    voice: 'ulysses',
    links: [
      ['Verfassung', `${GH}/ulysses/blob/main/PROTOCOL.md`],
      ['Delegation §4', `${GH}/ulysses/blob/main/governance/STANDING-DELEGATION.md`],
      ['Kanal', `${GH}/ulysses/blob/main/REQUESTS.md`],
      ['Gate', `${GH}/ulysses/blob/main/.github/workflows/research-auto-land.yml`],
      ['Validator', `${GH}/ulysses/blob/main/tools/validate_v4_projects.py`],
    ],
  },
  {
    name: 'Field · Meridian',
    voice: 'meridian',
    links: [
      ['Verfassung', `${GH}/field-research/blob/main/PROTOCOL.md`],
      ['Kanal', `${GH}/field-research/blob/main/REQUESTS.md`],
      ['Feldkarte', `${GH}/field-research/blob/main/FIELD.md`],
      ['Gate', `${GH}/field-research/blob/main/.github/workflows/auto-land.yml`],
    ],
  },
  {
    name: 'Studio · Ensemble',
    voice: 'ensemble',
    links: [
      ['Verfassung', `${GH}/studio/blob/main/PROTOCOL.md`],
      ['Workboard', `${GH}/studio/blob/main/WORKBOARD.md`],
      ['Kanal', `${GH}/studio/blob/main/REQUESTS.md`],
      ['Gate', `${GH}/studio/blob/main/.github/workflows/auto-land.yml`],
    ],
  },
  {
    name: 'Nightly line',
    voice: null,
    links: [
      ['Verfassung', `${GH}/error-as-method/blob/main/PROTOCOL.md`],
      ['Kanal', `${GH}/error-as-method/blob/main/REQUESTS.md`],
      ['Workflows', `${GH}/error-as-method/tree/main/.github/workflows`],
    ],
  },
  {
    name: 'n-1 · Remainder',
    voice: null,
    links: [
      ['Mitgift (der Boden)', `${GH}/n-1/blob/main/DOWRY.md`],
      ['Foundation', `${GH}/n-1/tree/main/foundation`],
      ['Kanal', `${GH}/n-1/blob/main/REQUESTS.md`],
      ['Register', `${GH}/n-1/blob/main/REGISTER.md`],
    ],
  },
  {
    name: 'Machine Attention',
    voice: null,
    links: [
      ['README (Verfassungsort)', `${GH}/machine-attention/blob/main/README.md`],
      ['Kanal', `${GH}/machine-attention/blob/main/REQUESTS.md`],
      ['Sensor-Vorschläge', `${GH}/machine-attention/tree/main/foreknown/proposals`],
      ['Autonomie-Log', `${GH}/machine-attention/blob/main/autonomy/log.jsonl`],
    ],
  },
  {
    name: 'Das Haus (Site)',
    voice: null,
    links: [
      ['Decision-Log', `${GH}/frankbueltge.de/blob/main/docs/decision-log.md`],
      ['Drift-Wächter', `${GH}/frankbueltge.de/blob/main/scripts/drift-check.mjs`],
      ['Workflows', `${GH}/frankbueltge.de/tree/main/.github/workflows`],
      ['Wording-Kanon', `${GH}/frankbueltge.de/blob/main/docs/wording-kanon.md`],
    ],
  },
]
---

<main id="main" class="zx-ops ops-room hub-voices">
  {/* ── access ─────────────────────────────────────────────────────────── */}
  <section data-zx="gate" class="zx-narrow">
    <p class="zx-eyebrow">Steuerzentrale</p>
    <h1 class="zx-title">Zugang</h1>
    <p class="zx-card-body">Privates Operator-Werkzeug — nur mit Zugangstoken.</p>
    <form data-zx="gate-form" class="zx-field">
      <label for="zx-token" class="zx-label">Zugangstoken</label>
      <input id="zx-token" name="token" type="password" autocomplete="off" required class="zx-input" />
      <div class="zx-actions">
        <button type="submit" class="zx-btn zx-btn--primary">Öffnen</button>
      </div>
      <p data-zx="gate-error" class="zx-status zx-status--warn" role="status"></p>
    </form>
  </section>

  {/* ── waiting states ─────────────────────────────────────────────────── */}
  <p data-zx="loading" class="zx-narrow zx-empty" hidden>Lädt …</p>
  <p data-zx="notconnected" class="zx-narrow zx-empty" hidden></p>

  {/* ── the room ───────────────────────────────────────────────────────── */}
  <div data-zx="dashboard" class="zx-shell" hidden>
    <header class="zx-topbar">
      <div>
        <p class="zx-eyebrow">Steuerzentrale</p>
        <h1 class="zx-title">Opsroom</h1>
      </div>
      <div class="zx-topbar-right">
        <span class="zx-chip"><span data-zx="liveled" class="zx-led"></span><span data-zx="stamp">—</span></span>
        <button type="button" data-zx="refresh" class="zx-btn">Aktualisieren</button>
      </div>
    </header>

    {/* The dates that govern the house right now. The day counts are filled by the
        script; the dates themselves stand in markup, so nothing here can drift silently.
        2026-09-01: the ecology-reading countdown is gone — the reading of 2026-09-05 was
        held early on 2026-08-30 and decided v3 (docs/design/2026-08-30-research-ecology-v3.md). */}
    <div class="zx-counts">
      <div class="zx-count" data-zx-date="2026-10-14">
        <span class="zx-count-n" data-zx="countn">–</span>
        <span class="zx-count-what">
          <span class="zx-count-label">Founder’s Reading n-1 · Freeze-Ende</span>
          <span class="zx-count-sub">14.10.</span>
        </span>
      </div>
    </div>

    <p data-zx="errors" class="zx-partial" hidden></p>

    <section aria-labelledby="zx-night-h">
      <h2 id="zx-night-h" class="zx-h">Praxis-Board — die Nacht</h2>
      <div data-zx="night" class="zx-board"></div>
    </section>

    <div class="zx-cols">
      {/* ── left column: what asks for a decision ────────────────────── */}
      <div class="zx-col">
        {/* Triage (v2 P1, claims-only since 2026-08-12): only dated deadlines in reach and
            forwardings arrive here at all — the standing rule at the head of every
            REQUESTS.md makes everything else the practice's own call. */}
        <section aria-labelledby="zx-needed-h">
          <h2 id="zx-needed-h" class="zx-h">Heute nötig</h2>
          <div data-zx="needed" class="zx-lane"></div>
        </section>

        {/* Gate lane (v2 P2, Governance §1): publication candidates with the honest 72h
            clock and GO/HALTEN — the decision commits as a dated section into the
            practice's REQUESTS.md; its next session performs the publication. */}
        <section aria-labelledby="zx-gatelane-h">
          <h2 id="zx-gatelane-h" class="zx-h">Am Gate</h2>
          <div data-zx="gatelane" class="zx-lane"></div>
        </section>

        <section aria-labelledby="zx-siteprs-h">
          <h2 id="zx-siteprs-h" class="zx-h">Site-PRs</h2>
          <div data-zx="siteprs" class="zx-lane"></div>
        </section>

        <section aria-labelledby="zx-pubseed-h">
          <h2 id="zx-pubseed-h" class="zx-h">Öffentliche Saat — Freigabe</h2>
          <div data-zx="pending-seeds" class="zx-lane"></div>
        </section>

        {/* Letters from outside (post office /post) — private queue, read here, forwarded
            by Frank's hand; dismissing deletes from KV (letters were never public). */}
        <section aria-labelledby="zx-letters-h">
          <h2 id="zx-letters-h" class="zx-h">Briefkasten — Post von außen</h2>
          <div data-zx="letters" class="zx-lane"></div>
        </section>
      </div>

      {/* ── right column: outgoing, levers, machinery ────────────────── */}
      <div class="zx-col">
        {/* Post lane (poste restante, Frank's concept): the outgoing tray is part of the
            work, not a task pile. Days lying open are a fact, never a deadline. */}
        <section aria-labelledby="zx-post-h">
          <h2 id="zx-post-h" class="zx-h">Post — offener Ausgang</h2>
          <div data-zx="post" class="zx-lane"></div>
        </section>

        <section aria-labelledby="zx-seed-h">
          <h2 id="zx-seed-h" class="zx-h">Saat legen</h2>
          <form data-zx="seed-form" class="zx-card">
            <div class="zx-field">
              <label for="zx-seed-repo" class="zx-label">Kollektiv</label>
              <select id="zx-seed-repo" name="repo" class="zx-select">
                <option value="field-research">Field · Meridian</option>
                <option value="studio">Studio · Ensemble</option>
                <option value="ulysses">Atelier · Assay</option>
                <option value="data-snack-plenum">Plenum</option>
              </select>
            </div>
            <div class="zx-field">
              <label for="zx-seed-title" class="zx-label">Titel</label>
              <input id="zx-seed-title" name="title" type="text" required maxlength="140" class="zx-input" />
            </div>
            <div class="zx-field">
              <label for="zx-seed-body" class="zx-label">Text</label>
              <textarea id="zx-seed-body" name="body" rows="4" required class="zx-textarea"></textarea>
            </div>
            <div class="zx-actions">
              <button type="submit" data-zx="seed-submit" class="zx-btn zx-btn--primary">In REQUESTS.md legen</button>
            </div>
            <p data-zx="seed-msg" class="zx-status" role="status"></p>
            <p class="zx-card-note">Ein Seed ist ein Angebot, kein Auftrag — die Praxis antwortet im Journal.</p>
          </form>
        </section>

        <section aria-labelledby="zx-knobs-h">
          <h2 id="zx-knobs-h" class="zx-h">Maschinenraum — die Stellschrauben</h2>
          <div class="zx-knobs">
            {
              KNOBS.map((k) => (
                <div class={`zx-knob-row${k.voice ? ` zx-knob-row--${k.voice}` : ''}`}>
                  <p class="zx-knob-name">{k.name}</p>
                  <div class="zx-knob-links">
                    {k.links.map(([label, href]) => (
                      <a href={href} target="_blank" rel="noreferrer">
                        {label} ↗
                      </a>
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
          <p class="zx-knob-foot">
            Verfassungs-Floors und alles, was das Haus verlässt, bleiben bewusst ohne Schalter: sie werden als
            datierte Entscheidung geschrieben, nicht als Setting geklickt. Die Routine-Prompts der Nacht-Sessions
            liegen in der Trigger-API, nicht in Git — der eine Hebel ohne Link.
          </p>
        </section>

        <section aria-labelledby="zx-runs-h" class="zx-runs">
          <details data-zx="runs-details">
            <summary id="zx-runs-h">Alle Läufe</summary>
            <div data-zx="runs" class="zx-field"></div>
          </details>
        </section>
      </div>
    </div>
  </div>

  <noscript>
    <p class="zx-narrow zx-empty">Die Steuerzentrale braucht JavaScript.</p>
  </noscript>
</main>

<script>
  // State machine: gate → loading → dashboard | notconnected. Pure DOM, no framework
  // (CockpitPage pattern). Every API-supplied string enters the DOM exclusively through
  // el()/text children (never innerHTML) — commit messages and issue excerpts are the
  // collectives' text, not trusted markup.
  const TOKEN_KEY = 'zentraleToken'
  // Timestamp of the last writing action (answer, ack, PR merge/close). The status endpoint
  // caches for three minutes; without this mark a reload right after finishing something
  // would show it as open again. localStorage, not sessionStorage — the mark must hold in a
  // freshly opened tab too. See cacheIsUsable().
  const MUTATED_KEY = 'zentraleMutatedAt'

  interface ZxCollective {
    repo: string
    label: string
    voice: 'ulysses' | 'meridian' | 'ensemble' | null
    commitsLast24h: number | null
    lastCommit: { sha: string; message: string; date: string } | null
    protocol: { heading: string; version: string | null } | null
    integrate: {
      workflow: string | null
      conclusion: 'success' | 'failure' | null
      at: string | null
      runUrl: string | null
      redIssue: { number: number; title: string; url: string } | null
    } | null
    chronicle: { date: string; summary: string; verdict: string | null; session: number | null } | null
    vitalSigns: { date: string | null; closure: number | null; session: number | null } | null
    journal: { date: string; title: string; url: string | null } | null
    strandedIssues: { number: number; title: string; url: string }[]
  }

  interface ZxRun {
    workflow: string
    conclusion: 'success' | 'failure' | null
    status: string
    at: string
    url: string
  }

  interface ZxInboxEntry {
    repo: string
    heading: string
    issueNumber: number
    issueUrl: string
    openedAt: string
    ageDays: number
    excerpt: string
    structured: boolean
    summary: string
    braucht: string | null
    brauchtOptionen: string[]
    frist: string | null
    fristDate: string | null
    kontext: string | null
    /** Fach, in dem der Eintrag landet — siehe status.ts trayFor. */
    tray: 'today' | 'postoffice' | 'running' | 'fyi'
    needsAction: boolean
    fristInDays: number | null
  }

  interface ZxGateCandidate {
    repo: string
    project: string
    title: string | null
    scoreChangedAt: string | null
    hoursSinceChange: number | null
    projectUrl: string
  }

  interface ZxPostItem {
    id: string
    practice: string
    piece: string
    receiver: string
    receiverChannel: string
    email: string | null
    status: string
    asOf: string
    daysOpen: number | null
    recordUrl: string
    note: string
  }

  interface ZxSitePr {
    number: number
    ns: string
    persona: string
    label: string
    slug: string
    title: string
    url: string
    branch: string
    createdAt: string
    excerpt: string
  }

  interface ZxPendingSeed {
    id: string
    kind: string
    text: string
    author_mark: string
    addressed_to: string
    ts: string
    gate: { model: string; verdict: string } | null
  }

  interface ZxSeedReviewResult {
    ok: boolean
    code?: string
    approved?: boolean
    rejected?: boolean
    forwarded_to?: string[]
  }

  interface ZxStatus {
    ok: true
    generatedAt: string
    cached: boolean
    errors: string[]
    collectives: ZxCollective[]
    runs: ZxRun[]
    inbox: ZxInboxEntry[]
    gate: ZxGateCandidate[]
    post: ZxPostItem[]
    sitePrs: ZxSitePr[] | null
  }

  interface ZxSitePrResult {
    ok: boolean
    code?: string
    merged?: boolean
    closed?: boolean
    warning?: string
  }

  interface ZxAntwortResult {
    ok: boolean
    code?: string
    commit?: Record<string, unknown>
    issue?: Record<string, unknown>
    warning?: string
    /** Nur bei code 'not-found': ob das Issue trotzdem geschlossen werden konnte. */
    issueClosed?: boolean
  }

  const REPO_LABELS: Record<string, string> = {
    'field-research': 'Field · Meridian',
    studio: 'Studio · Ensemble',
    ulysses: 'Atelier · Assay',
    'irrtum-als-methode': 'Atelier · Assay', // historischer Repo-Name (bis 2026-07-23)
    'error-as-method': 'Nightly line',
    'n-1': 'n-1 · Remainder',
    'machine-attention': 'Machine Attention',
    'data-snack-plenum': 'Plenum',
  }

  const KIND_LABELS: Record<string, string> = { frage: 'Frage', quelle: 'Quelle', wort: 'Wort', richtung: 'Richtung' }

  const SEEDREVIEW_ERR: Record<string, string> = {
    'not-found': 'Nicht mehr in der Warteschlange — vermutlich schon bearbeitet. Bitte neu laden.',
    'bad-id': 'Ungültige Seed-Kennung.',
    'bad-decision': 'Ungültige Aktion.',
    corrupt: 'Der Pending-Eintrag ist beschädigt.',
    'not-connected': 'Nicht verbunden — SAAT_GITHUB_TOKEN oder das KV-Binding fehlt.',
    conflict: 'Schreibkonflikt — bitte erneut versuchen.',
    upstream: 'GitHub/KV antwortet gerade nicht — bitte später erneut versuchen.',
  }

  const ANTWORT_ERR: Record<string, string> = {
    'bad-json': 'Fehlerhafte Anfrage — bitte neu laden.',
    validation: 'Eingabe unvollständig oder ungültig.',
    upstream: 'GitHub antwortet gerade nicht — bitte später erneut versuchen.',
  }

  const SITEPR_ERR: Record<string, string> = {
    'not-found': 'PR nicht gefunden — vermutlich schon geschlossen. Bitte neu laden.',
    'not-open': 'PR ist nicht mehr offen — bitte neu laden.',
    'not-engine-pr': 'Kein Schleusen-PR — die Zentrale rührt nur Engine-Vorschläge an.',
    'not-mergeable': 'Nicht mergebar (Konflikt oder rote Checks) — auf GitHub ansehen.',
    'head-changed': 'Der Branch hat sich gerade geändert — bitte neu laden.',
    forbidden: 'Dem Token fehlt das Merge-Recht auf dem Site-Repo (Pull requests + Contents: write).',
    validation: 'Eingabe ungültig.',
    upstream: 'GitHub antwortet gerade nicht — bitte später erneut versuchen.',
  }

  /** Minimal DOM builder: children enter only via Element.append() — the native string→text
   * node path, never innerHTML. Foreign text therefore always stays plain text. */
  function el<K extends keyof HTMLElementTagNameMap>(
    tag: K,
    attrs: Record<string, string> = {},
    ...children: Array<string | Node>
  ): HTMLElementTagNameMap[K] {
    const node = document.createElement(tag)
    for (const [k, v] of Object.entries(attrs)) {
      if (k === 'class') node.className = v
      else node.setAttribute(k, v)
    }
    if (children.length) node.append(...children)
    return node
  }

  function fmtStamp(iso: string): string {
    const d = new Date(iso)
    if (Number.isNaN(d.getTime())) return '—'
    return new Intl.DateTimeFormat('de-DE', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' }).format(d)
  }

  /** Relative time from an ISO stamp — commits, integrate runs, workflow runs. */
  function fmtRel(iso: string | null): string {
    if (!iso) return '—'
    const then = new Date(iso).getTime()
    if (Number.isNaN(then)) return '—'
    const min = Math.floor((Date.now() - then) / 60_000)
    if (min < 1) return 'gerade eben'
    if (min < 60) return `vor ${min} Min.`
    const h = Math.floor(min / 60)
    if (h < 24) return `vor ${h} h`
    const d = Math.floor(h / 24)
    return `vor ${d} ${d === 1 ? 'Tag' : 'Tagen'}`
  }

  /** Die Inbox liefert ageDays fertig (ganze Tage, server-seitig gerundet). */
  function fmtAgeDays(n: number): string {
    if (n <= 0) return 'heute'
    if (n === 1) return 'vor 1 Tag'
    return `vor ${n} Tagen`
  }

  function fmtClosure(n: number): string {
    return n.toFixed(2).replace('.', ',')
  }

  // 'YYYY-MM-DD' → '26.07.'. Deliberately not fmtRel: a day-date carries no clock time, and
  // "vor 5 h" would fake a precision the source does not hold.
  function fmtDay(date: string | null): string {
    if (!date) return '—'
    const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(date)
    return m ? `${m[3]}.${m[2]}.` : date
  }

  function daysSince(date: string | null): number | null {
    if (!date) return null
    const then = new Date(`${date}T00:00:00Z`).getTime()
    if (Number.isNaN(then)) return null
    return Math.floor((Date.now() - then) / 86_400_000)
  }

  // ── DOM references ──────────────────────────────────────────────────────
  const gateSection = document.querySelector<HTMLElement>('[data-zx="gate"]')
  const gateForm = document.querySelector<HTMLFormElement>('[data-zx="gate-form"]')
  const gateError = document.querySelector<HTMLElement>('[data-zx="gate-error"]')
  const loadingEl = document.querySelector<HTMLElement>('[data-zx="loading"]')
  const notConnected = document.querySelector<HTMLElement>('[data-zx="notconnected"]')
  const dashboard = document.querySelector<HTMLElement>('[data-zx="dashboard"]')
  const stampEl = document.querySelector<HTMLElement>('[data-zx="stamp"]')
  const liveLed = document.querySelector<HTMLElement>('[data-zx="liveled"]')
  const refreshBtn = document.querySelector<HTMLButtonElement>('[data-zx="refresh"]')
  const errorsEl = document.querySelector<HTMLElement>('[data-zx="errors"]')
  const nightEl = document.querySelector<HTMLElement>('[data-zx="night"]')
  const neededEl = document.querySelector<HTMLElement>('[data-zx="needed"]')
  const gateLaneEl = document.querySelector<HTMLElement>('[data-zx="gatelane"]')
  const postEl = document.querySelector<HTMLElement>('[data-zx="post"]')
  const sitePrsEl = document.querySelector<HTMLElement>('[data-zx="siteprs"]')
  const pendingSeedsEl = document.querySelector<HTMLElement>('[data-zx="pending-seeds"]')
  const seedForm = document.querySelector<HTMLFormElement>('[data-zx="seed-form"]')
  const seedSubmit = document.querySelector<HTMLButtonElement>('[data-zx="seed-submit"]')
  const seedMsg = document.querySelector<HTMLElement>('[data-zx="seed-msg"]')
  const runsEl = document.querySelector<HTMLElement>('[data-zx="runs"]')

  // ── countdown tiles: days remaining, from the dates printed in markup ──
  for (const tile of document.querySelectorAll<HTMLElement>('[data-zx-date]')) {
    const date = tile.getAttribute('data-zx-date')
    const n = tile.querySelector<HTMLElement>('[data-zx="countn"]')
    if (!date || !n) continue
    const days = Math.ceil((new Date(`${date}T00:00:00+02:00`).getTime() - Date.now()) / 86_400_000)
    n.textContent = days >= 0 ? String(days) : `+${-days}`
    if (days >= 0 && days <= 7) tile.classList.add('zx-count--near')
  }

  let token: string | null = null
  try {
    token = localStorage.getItem(TOKEN_KEY)
  } catch {
    token = null
  }

  function clearToken(): void {
    token = null
    try {
      localStorage.removeItem(TOKEN_KEY)
    } catch {
      /* private mode etc. — token is already null in memory */
    }
  }

  /** To call after every successful writing action. */
  function markMutation(): void {
    try {
      localStorage.setItem(MUTATED_KEY, String(Date.now()))
    } catch {
      /* private mode — cache behaviour stays; "Aktualisieren" still helps */
    }
  }

  function lastMutation(): string | null {
    try {
      return localStorage.getItem(MUTATED_KEY)
    } catch {
      return null
    }
  }

  function showGate(message?: string): void {
    if (loadingEl) loadingEl.hidden = true
    if (notConnected) notConnected.hidden = true
    if (dashboard) dashboard.hidden = true
    if (gateSection) gateSection.hidden = false
    if (gateError) gateError.textContent = message ?? ''
  }

  function showLoading(): void {
    if (gateSection) gateSection.hidden = true
    if (notConnected) notConnected.hidden = true
    if (dashboard) dashboard.hidden = true
    if (loadingEl) loadingEl.hidden = false
  }

  function showNotConnected(message?: string): void {
    if (gateSection) gateSection.hidden = true
    if (loadingEl) loadingEl.hidden = true
    if (dashboard) dashboard.hidden = true
    if (notConnected) {
      notConnected.hidden = false
      notConnected.textContent = message ?? 'Nicht verbunden — Secrets fehlen auf dem Server.'
    }
  }

  /** POST wrapper for answers/seeds — 401 clears the token globally and shows the gate, so
   * no card improvises its own idea of an expired token. */
  async function postAntwort(payload: Record<string, unknown>): Promise<ZxAntwortResult> {
    const res = await fetch('/api/zentrale/antwort', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'X-Zentrale-Auth': token ?? '' },
      body: JSON.stringify(payload),
    })
    if (res.status === 401) {
      clearToken()
      showGate('Token ungültig.')
      throw new Error('unauthorized')
    }
    return (await res.json()) as ZxAntwortResult
  }

  function commitUrlOf(commit: Record<string, unknown> | undefined): string | null {
    if (!commit) return null
    const url = commit.html_url ?? commit.url
    return typeof url === 'string' ? url : null
  }

  /** POST wrapper for site-PR decisions (merge/close). */
  async function postSitePr(payload: Record<string, unknown>): Promise<ZxSitePrResult> {
    const res = await fetch('/api/zentrale/site-pr', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'X-Zentrale-Auth': token ?? '' },
      body: JSON.stringify(payload),
    })
    if (res.status === 401) {
      clearToken()
      showGate('Token ungültig.')
      throw new Error('unauthorized')
    }
    return (await res.json()) as ZxSitePrResult
  }

  /** POST wrapper for public-seed review decisions (approve/reject). */
  async function postSeedReview(payload: Record<string, unknown>): Promise<ZxSeedReviewResult> {
    const res = await fetch('/api/zentrale/seed-review', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'X-Zentrale-Auth': token ?? '' },
      body: JSON.stringify(payload),
    })
    if (res.status === 401) {
      clearToken()
      showGate('Token ungültig.')
      throw new Error('unauthorized')
    }
    return (await res.json()) as ZxSeedReviewResult
  }

  // ── rendering: the board ────────────────────────────────────────────────
  function renderCollective(c: ZxCollective): HTMLElement {
    const card = el('article', { class: `zx-unit${c.voice ? ` zx-unit--${c.voice}` : ''}` })

    // Head row: LED (integrate state) + name + protocol version chip.
    const head = el('div', { class: 'zx-unit-head' })
    const conclusion = c.integrate?.conclusion ?? null
    const ledCls = conclusion === 'success' ? 'zx-led zx-led--ok' : conclusion === 'failure' ? 'zx-led zx-led--red' : 'zx-led'
    const ledWord = conclusion === 'success' ? 'grün' : conclusion === 'failure' ? 'rot' : 'kein Lauf'
    head.append(el('span', { class: ledCls, role: 'img', 'aria-label': `Integrate ${ledWord}` }))
    head.append(el('h3', { class: 'zx-unit-name' }, c.label))
    if (c.protocol?.version) {
      const chip = el('span', { class: 'zx-chip zx-chip--accent', title: c.protocol.heading }, c.protocol.version)
      head.append(chip)
    }
    card.append(head)

    // The needle: commits in the last 24h.
    const stat = el('div', { class: 'zx-unit-stat' })
    stat.append(el('span', { class: 'zx-unit-stat-n' }, c.commitsLast24h === null ? '–' : String(c.commitsLast24h)))
    stat.append(el('span', { class: 'zx-unit-stat-label' }, 'Commits · 24 h'))
    card.append(stat)

    // The practice's own last sentence: chronicle (field/studio) or journal (atelier, nightly).
    if (c.chronicle) {
      const quote = c.chronicle.verdict ? `„${c.chronicle.summary}“ — ${c.chronicle.verdict}` : `„${c.chronicle.summary}“`
      card.append(el('p', { class: 'zx-unit-quote', title: quote }, quote))
    }
    if (c.journal) {
      const line = el('p', { class: 'zx-unit-quote' }, `„${c.journal.title}“`)
      card.append(line)
      const meta = el('p', { class: 'zx-unit-line' }, `Journal ${fmtDay(c.journal.date)}`)
      if (c.journal.url) {
        meta.append(' · ')
        meta.append(el('a', { href: c.journal.url, target: '_blank', rel: 'noreferrer' }, 'lesen ↗'))
      }
      card.append(meta)
    }

    if (c.lastCommit) {
      card.append(el('p', { class: 'zx-unit-line' }, `„${c.lastCommit.message}“ · ${fmtRel(c.lastCommit.date)}`))
    }

    // Integrate line with run link — the LED above carries the state, this line the receipt.
    if (c.integrate && (c.integrate.runUrl || c.integrate.redIssue)) {
      const line = el('p', { class: 'zx-unit-line' })
      if (c.integrate.runUrl) {
        line.append(el('a', { href: c.integrate.runUrl, target: '_blank', rel: 'noreferrer' }, `Integrate ${ledWord} · ${fmtRel(c.integrate.at)} ↗`))
      }
      if (c.integrate.redIssue) {
        if (c.integrate.runUrl) line.append(' · ')
        line.append(el('a', { href: c.integrate.redIssue.url, target: '_blank', rel: 'noreferrer' }, `Issue #${c.integrate.redIssue.number}`))
      }
      card.append(line)
    }

    // Vital signs stay visible but DATED — a frozen v4 metric must never read as current.
    if (c.vitalSigns && typeof c.vitalSigns.closure === 'number') {
      const age = daysSince(c.vitalSigns.date)
      const line = el('p', { class: 'zx-unit-line' }, `closure ${fmtClosure(c.vitalSigns.closure)} · Stand ${fmtDay(c.vitalSigns.date)}`)
      if (age !== null && age > 2) line.append(` — seit ${age} Tagen unverändert (v4-Kennzahl)`)
      card.append(line)
    }

    if (c.strandedIssues.length > 0) {
      const warn = el('p', { class: 'zx-unit-alert' }, 'Offen geblieben: ')
      c.strandedIssues.forEach((issue, i) => {
        if (i > 0) warn.append(', ')
        warn.append(el('a', { href: issue.url, target: '_blank', rel: 'noreferrer' }, `#${issue.number} ${issue.title}`))
      })
      card.append(warn)
    }

    return card
  }

  // ── rendering: inbox ────────────────────────────────────────────────────
  /** Deadline display with countdown — carried by the sender's own four-line head. */
  function fmtFrist(entry: ZxInboxEntry): { label: string; urgent: boolean } | null {
    if (entry.fristDate) {
      const days = Math.floor((Date.parse(entry.fristDate) - Date.now()) / 86_400_000)
      const rel = days < 0 ? `überfällig (${-days} Tg.)` : days === 0 ? 'heute' : `in ${days} Tg.`
      return { label: `Frist ${entry.fristDate} · ${rel}`, urgent: days <= 2 }
    }
    if (entry.frist) {
      const t = entry.frist.length > 42 ? `${entry.frist.slice(0, 41)}…` : entry.frist
      return { label: `Frist: ${t}`, urgent: false }
    }
    return null
  }

  /** Gate card (v2 P2): candidate + honestly labelled SLA clock + GO/HALTEN. GO takes a
   * second confirming click (publication is the most consequential one-click action here);
   * HALTEN takes a reason — "decide, or write a dated 'held, because …'". */
  function renderGateCard(c: ZxGateCandidate): HTMLElement {
    const card = el('article', { class: 'zx-card' })
    const meta = el('p', { class: 'zx-card-meta' }, `${REPO_LABELS[c.repo] ?? c.repo} · PUBLICATION_CANDIDATE`)
    if (c.hoursSinceChange !== null) {
      const over = c.hoursSinceChange >= 72
      if (over) card.classList.add('zx-card--urgent')
      meta.append(el('span', { class: over ? 'zx-chip zx-chip--urgent' : 'zx-chip' }, over ? `SLA überschritten · ${c.hoursSinceChange} h seit letzter Änderung` : `${c.hoursSinceChange} h von 72 h (ab letzter SCORE-Änderung)`))
    } else {
      meta.append(el('span', { class: 'zx-chip' }, 'Wartezeit nicht ableitbar'))
    }
    card.append(meta)
    card.append(el('p', { class: 'zx-card-title' }, c.title ?? c.project))
    const src = el('p', { class: 'zx-card-sub' })
    src.append(el('a', { href: c.projectUrl, target: '_blank', rel: 'noreferrer' }, `${c.project} ↗`))
    if (c.scoreChangedAt) src.append(` · SCORE zuletzt ${c.scoreChangedAt.slice(0, 10)}`)
    card.append(src)

    const reasonField = el('textarea', { rows: '2', class: 'zx-textarea zx-field', placeholder: 'Halten, weil …' }) as HTMLTextAreaElement
    reasonField.hidden = true
    card.append(reasonField)
    const hint = el('p', { class: 'zx-status', role: 'status' })
    card.append(hint)

    const actions = el('div', { class: 'zx-actions' })
    const btnGo = el('button', { type: 'button', class: 'zx-btn zx-btn--go' }, 'GO — publizieren') as HTMLButtonElement
    const btnHold = el('button', { type: 'button', class: 'zx-btn' }, 'HALTEN (mit Begründung)') as HTMLButtonElement
    actions.append(btnGo, btnHold)
    card.append(actions)

    let goArmed = false
    async function send(decision: 'GO' | 'HOLD'): Promise<void> {
      btnGo.disabled = btnHold.disabled = true
      hint.textContent = ''
      try {
        const result = await postAntwort({ action: 'gate', repo: c.repo, project: c.project, decision, reason: reasonField.value.trim() })
        if (result.ok) {
          markMutation()
          const p = el('p', { class: 'zx-done' }, decision === 'GO' ? '✓ GO committet — die nächste Session der Praxis vollzieht die Publikation.' : '✓ HALTEN committet — datiert, mit Begründung.')
          const url = commitUrlOf(result.commit)
          if (url) { p.append(' · '); p.append(el('a', { href: url, target: '_blank', rel: 'noreferrer' }, 'Commit ansehen ↗')) }
          card.replaceChildren(p)
          return
        }
        hint.textContent = result.code === 'conflict' ? 'Konflikt — neu laden und erneut versuchen' : 'Das hat nicht geklappt — bitte später erneut versuchen.'
      } catch (err) {
        if (String(err) !== 'Error: unauthorized') hint.textContent = 'Netzwerkfehler — bitte erneut versuchen.'
      } finally {
        btnGo.disabled = btnHold.disabled = false
      }
    }
    btnGo.addEventListener('click', () => {
      if (!goArmed) { goArmed = true; btnGo.textContent = 'GO bestätigen — wirklich publizieren'; return }
      void send('GO')
    })
    btnHold.addEventListener('click', () => {
      if (reasonField.hidden) { reasonField.hidden = false; reasonField.focus(); return }
      if (reasonField.value.trim() === '') { hint.textContent = 'HALTEN braucht eine Begründung.'; reasonField.focus(); return }
      void send('HOLD')
    })
    return card
  }

  /** Post card (poste restante): read-only — receiver, channel, days lying open as a fact.
   * No countdown, no warning amber: a long-lying letter is part of the gesture. */
  function renderPostCard(item: ZxPostItem): HTMLElement {
    const card = el('article', { class: 'zx-card' })
    const meta = el('p', { class: 'zx-card-meta' }, `${item.practice} · ${item.status}`)
    if (item.daysOpen !== null) {
      meta.append(el('span', { class: 'zx-chip' }, item.daysOpen === 0 ? 'heute offen gelegt' : `liegt offen zur Abholung · ${item.daysOpen} Tg.`))
    } else {
      meta.append(el('span', { class: 'zx-chip' }, 'liegt noch bei der Praxis'))
    }
    card.append(meta)
    card.append(el('p', { class: 'zx-card-title' }, item.piece))
    card.append(el('p', { class: 'zx-card-body' }, `an: ${item.receiver} · Kanal: ${item.receiverChannel}`))
    if (item.note) card.append(el('p', { class: 'zx-card-note' }, item.note))
    const links = el('p', { class: 'zx-card-sub' })
    if (item.email) {
      links.append(el('a', { href: `mailto:${item.email}` }, `direkt zustellen (optional): ${item.email}`))
      links.append(' · ')
    }
    links.append(el('a', { href: item.recordUrl, target: '_blank', rel: 'noreferrer' }, 'das Paket ↗'))
    card.append(links)
    return card
  }

  function renderInboxCard(entry: ZxInboxEntry): HTMLElement {
    const card = el('article', { class: 'zx-card' })
    const repoLabel = REPO_LABELS[entry.repo] ?? entry.repo

    // Triage head (v2 P1): the sender's self-declaration as chips. Headless legacy
    // requests carry the honest marker instead of an invented classification.
    const meta = el('p', { class: 'zx-card-meta' }, `${repoLabel} · ${fmtAgeDays(entry.ageDays)}`)
    if (entry.structured && entry.braucht) meta.append(el('span', { class: 'zx-chip' }, `braucht: ${entry.braucht}`))
    if (!entry.structured) meta.append(el('span', { class: 'zx-chip' }, 'unstrukturiert (alt)'))
    const frist = fmtFrist(entry)
    if (frist) {
      if (frist.urgent) card.classList.add('zx-card--urgent')
      meta.append(el('span', { class: frist.urgent ? 'zx-chip zx-chip--urgent' : 'zx-chip' }, frist.label))
    }
    card.append(meta)

    // The one line first: the sender's tl;dr (or the sentence fallback); the REQUESTS
    // heading stays as a subline, the full text one expander away.
    card.append(el('p', { class: 'zx-card-title' }, entry.summary || entry.heading))
    card.append(el('p', { class: 'zx-card-sub' }, entry.heading))
    if (entry.kontext) card.append(el('p', { class: 'zx-card-note' }, `Kontext: ${entry.kontext}`))

    const excerptWrap = el('div', { class: 'zx-excerpt' }, el('span', {}, entry.excerpt))
    card.append(excerptWrap)
    // The button appears only when there really is more — measured by CHARACTER COUNT, not
    // layout: a scrollHeight probe would silently hide a broken clamp style instead of
    // showing it.
    if (entry.excerpt.length > 280) {
      const expandBtn = el('button', { type: 'button', class: 'zx-more' }, 'mehr')
      expandBtn.addEventListener('click', () => {
        const expanded = excerptWrap.classList.toggle('is-expanded')
        expandBtn.textContent = expanded ? 'weniger' : 'mehr'
      })
      card.append(expandBtn)
    }

    const hinweis = el('p', { class: 'zx-card-note' }, 'Ohne Antwort entscheidet die Praxis in ihrer nächsten Sitzung selbst. ')
    hinweis.append(el('a', { href: entry.issueUrl, target: '_blank', rel: 'noreferrer' }, 'ganz lesen ↗'))
    card.append(hinweis)

    const msgField = el('textarea', { rows: '2', class: 'zx-textarea zx-field', placeholder: 'Nachricht …' }) as HTMLTextAreaElement
    msgField.hidden = true
    card.append(msgField)

    const hint = el('p', { class: 'zx-status', role: 'status' })
    card.append(hint)

    let revealed = false
    const reveal = (): void => {
      revealed = true
      msgField.hidden = false
      msgField.focus()
    }

    const actions = el('div', { class: 'zx-actions' })
    const btn = (label: string): HTMLButtonElement => el('button', { type: 'button', class: 'zx-btn' }, label) as HTMLButtonElement

    const btnEnabled = btn('enabled')
    const btnDeclined = btn('declined')
    const btnNote = btn('Antwort')
    const btnAck = btn('gelesen — entscheidet selbst')
    actions.append(btnEnabled, btnDeclined, btnNote, btnAck)
    card.append(actions)

    // v2 P3: "braucht: entscheidung (a | b)" turns the sender's own options into one-click
    // answers — written like 'Antwort', as a dated response line in the practice's
    // REQUESTS.md. Prepended: likeliest action first.
    if (entry.braucht === 'entscheidung' && entry.brauchtOptionen.length > 0) {
      for (const opt of entry.brauchtOptionen.slice(0, 4).reverse()) {
        const label = opt.length > 30 ? `${opt.slice(0, 29)}…` : opt
        const optBtn = btn(`→ ${label}`)
        optBtn.title = opt
        optBtn.addEventListener('click', () => {
          void submit({ action: 'answer', repo: entry.repo, heading: entry.heading, issueNumber: entry.issueNumber, decision: 'note', message: `Entscheidung: ${opt}` }, 'note')
        })
        actions.prepend(optBtn)
      }
    }

    const setBusy = (busy: boolean): void => {
      for (const b of [btnEnabled, btnDeclined, btnNote, btnAck]) b.disabled = busy
    }

    async function submit(payload: Record<string, unknown>, decision?: string): Promise<void> {
      setBusy(true)
      hint.textContent = ''
      try {
        const result = await postAntwort(payload)
        if (result.ok) {
          markMutation()
          if (decision === 'enabled') {
            const p = el('p', { class: 'zx-done' }, '✓ enabled — committet')
            const url = commitUrlOf(result.commit)
            if (url) {
              p.append(' · ')
              p.append(el('a', { href: url, target: '_blank', rel: 'noreferrer' }, 'Commit ansehen ↗'))
            }
            if (result.warning) p.append(el('span', { class: 'zx-status zx-status--warn' }, result.warning))
            card.replaceChildren(p)
          } else {
            const p = el('p', { class: 'zx-done' }, '✓ geschlossen')
            if (result.warning) p.append(el('span', { class: 'zx-status zx-status--warn' }, result.warning))
            card.replaceChildren(p)
          }
          return
        }
        // The request is gone from REQUESTS.md: the practice cleared it itself, Frank's
        // answer was NOT written. The text says both — the half-truth would leave open
        // whether the answer is in there or not.
        if (result.code === 'not-found') {
          if (result.issueClosed) markMutation()
          const p = el('p', { class: 'zx-empty' }, 'Nicht mehr in REQUESTS.md — die Praxis hat die Stelle selbst abgeräumt. Deine Antwort wurde nicht geschrieben.')
          p.append(el('span', { class: 'zx-status' }, result.issueClosed ? '✓ Issue geschlossen' : 'Issue konnte nicht geschlossen werden — auf GitHub erledigen.'))
          card.replaceChildren(p)
          return
        }
        if (result.code === 'conflict') {
          hint.textContent = 'Konflikt — neu laden und erneut versuchen'
        } else {
          hint.textContent = ANTWORT_ERR[result.code ?? ''] ?? 'Das hat nicht geklappt — bitte später erneut versuchen.'
        }
      } catch (err) {
        if (String(err) !== 'Error: unauthorized') {
          hint.textContent = 'Netzwerkfehler — bitte erneut versuchen.'
        }
      } finally {
        setBusy(false)
      }
    }

    // enabled/declined/Antwort share the message field: the first click on any of the three
    // only opens it (a chance to write before anything is sent); every further click
    // validates and sends. For declined/Antwort an empty message is a valid "open" action
    // and is answered with a hint instead of being sent silently.
    const attemptAnswer = (decision: 'enabled' | 'declined' | 'note'): void => {
      if (!revealed) {
        reveal()
        return
      }
      const message = msgField.value.trim()
      if ((decision === 'declined' || decision === 'note') && message === '') {
        hint.textContent = 'Bitte eine Nachricht ergänzen.'
        msgField.focus()
        return
      }
      void submit({ action: 'answer', repo: entry.repo, heading: entry.heading, issueNumber: entry.issueNumber, decision, message }, decision)
    }

    btnEnabled.addEventListener('click', () => attemptAnswer('enabled'))
    btnDeclined.addEventListener('click', () => attemptAnswer('declined'))
    btnNote.addEventListener('click', () => attemptAnswer('note'))
    btnAck.addEventListener('click', () => {
      void submit({ action: 'acknowledge', repo: entry.repo, heading: entry.heading, issueNumber: entry.issueNumber })
    })

    return card
  }

  // ── rendering: site PRs ─────────────────────────────────────────────────
  // Proposals of the PR sluice at the site itself. Two decisions: merge (goes live —
  // deploy-cf rebuilds) or decline (close, final). Merging is a live action and therefore
  // takes a second confirming click; declining first opens an optional reason field (the
  // engine reads the comment), the second click closes.
  function renderSitePrCard(pr: ZxSitePr): HTMLElement {
    const card = el('article', { class: 'zx-card' })

    const head = el('p', { class: 'zx-card-meta' })
    head.append(`${pr.label} · #${pr.number} · ${fmtRel(pr.createdAt)}`)
    card.append(head)

    card.append(el('p', { class: 'zx-card-title' }, pr.title))
    card.append(el('p', { class: 'zx-card-sub' }, `site-prs/${pr.slug}`))

    if (pr.excerpt) {
      const excerptWrap = el('div', { class: 'zx-excerpt' }, el('span', {}, pr.excerpt))
      card.append(excerptWrap)
      const expandBtn = el('button', { type: 'button', class: 'zx-more' }, 'mehr')
      expandBtn.addEventListener('click', () => {
        const expanded = excerptWrap.classList.toggle('is-expanded')
        expandBtn.textContent = expanded ? 'weniger' : 'mehr'
      })
      card.append(expandBtn)
    }

    const links = el('p', { class: 'zx-card-sub' })
    links.append(el('a', { href: pr.url, target: '_blank', rel: 'noreferrer' }, 'PR ansehen ↗'))
    card.append(links)

    const msgField = el('textarea', { rows: '2', class: 'zx-textarea zx-field', placeholder: 'Begründung an die Engine (optional) …' }) as HTMLTextAreaElement
    msgField.hidden = true
    card.append(msgField)

    const hint = el('p', { class: 'zx-status', role: 'status' })
    card.append(hint)

    const actions = el('div', { class: 'zx-actions' })
    const btnMerge = el('button', { type: 'button', class: 'zx-btn zx-btn--go' }, 'mergen (geht live)') as HTMLButtonElement
    const btnClose = el('button', { type: 'button', class: 'zx-btn' }, 'ablehnen') as HTMLButtonElement
    actions.append(btnMerge, btnClose)
    card.append(actions)

    const setBusy = (busy: boolean): void => {
      btnMerge.disabled = busy
      btnClose.disabled = busy
    }

    async function submit(payload: Record<string, unknown>, kind: 'merge' | 'close'): Promise<void> {
      setBusy(true)
      hint.textContent = ''
      try {
        const result = await postSitePr(payload)
        if (result.ok) {
          markMutation()
          const text = kind === 'merge' ? '✓ gemergt — Deploy läuft' : '✓ abgelehnt (geschlossen)'
          const p = el('p', { class: 'zx-done' }, text)
          if (result.warning) p.append(el('span', { class: 'zx-status zx-status--warn' }, result.warning))
          card.replaceChildren(p)
          return
        }
        hint.textContent = SITEPR_ERR[result.code ?? ''] ?? 'Das hat nicht geklappt — bitte später erneut versuchen.'
      } catch (err) {
        if (String(err) !== 'Error: unauthorized') hint.textContent = 'Netzwerkfehler — bitte erneut versuchen.'
      } finally {
        setBusy(false)
      }
    }

    // Merge: first click confirms (live action), second executes.
    let mergeArmed = false
    btnMerge.addEventListener('click', () => {
      if (!mergeArmed) {
        mergeArmed = true
        btnMerge.textContent = 'wirklich mergen?'
        hint.textContent = 'Merge baut die Live-Site neu. Nochmal klicken zum Bestätigen.'
        return
      }
      void submit({ number: pr.number, action: 'merge' }, 'merge')
    })

    // Decline: first click opens the reason field, second closes.
    let closeArmed = false
    btnClose.addEventListener('click', () => {
      if (!closeArmed) {
        closeArmed = true
        msgField.hidden = false
        msgField.focus()
        btnClose.textContent = 'ablehnen bestätigen'
        hint.textContent = 'Endgültig — die Schleuse belebt einen geschlossenen PR nie wieder.'
        return
      }
      const comment = msgField.value.trim()
      void submit({ number: pr.number, action: 'close', ...(comment ? { comment } : {}) }, 'close')
    })

    return card
  }

  // ── rendering: public seeds awaiting review ─────────────────────────────
  function addresseeLabel(a: string): string {
    if (a === 'open') return 'offen (alle drei)'
    return REPO_LABELS[a] ?? a
  }

  function renderPendingSeedCard(seed: ZxPendingSeed): HTMLElement {
    const card = el('article', { class: 'zx-card' })

    const head = el('p', { class: 'zx-card-meta' })
    head.append(`${KIND_LABELS[seed.kind] ?? seed.kind} · an ${addresseeLabel(seed.addressed_to)} · ${fmtRel(seed.ts)}`)
    card.append(head)

    // Seed text: raw visitor input — enters the DOM EXCLUSIVELY as a text node.
    card.append(el('p', { class: 'zx-card-body zx-pre' }, seed.text))
    card.append(el('p', { class: 'zx-card-sub' }, `— „${seed.author_mark}“`))

    if (seed.gate) {
      card.append(el('p', { class: 'zx-card-sub' }, `Gate: ${seed.gate.verdict} (${seed.gate.model})`))
    }

    const hint = el('p', { class: 'zx-status', role: 'status' })
    card.append(hint)

    const actions = el('div', { class: 'zx-actions' })
    const btnApprove = el('button', { type: 'button', class: 'zx-btn zx-btn--go' }, 'freigeben (geht live)') as HTMLButtonElement
    const btnReject = el('button', { type: 'button', class: 'zx-btn' }, 'ablehnen') as HTMLButtonElement
    actions.append(btnApprove, btnReject)
    card.append(actions)

    const setBusy = (busy: boolean): void => {
      btnApprove.disabled = busy
      btnReject.disabled = busy
    }

    async function submit(decision: 'approve' | 'reject'): Promise<void> {
      setBusy(true)
      hint.textContent = ''
      try {
        const result = await postSeedReview({ id: seed.id, decision })
        if (result.ok) {
          const text = decision === 'approve' ? '✓ freigegeben — öffentlich im Register' : '✓ abgelehnt (verworfen)'
          card.replaceChildren(el('p', { class: 'zx-done' }, text))
          return
        }
        hint.textContent = SEEDREVIEW_ERR[result.code ?? ''] ?? 'Das hat nicht geklappt — bitte später erneut versuchen.'
      } catch (err) {
        if (String(err) !== 'Error: unauthorized') hint.textContent = 'Netzwerkfehler — bitte erneut versuchen.'
      } finally {
        setBusy(false)
      }
    }

    let approveArmed = false
    btnApprove.addEventListener('click', () => {
      if (!approveArmed) {
        approveArmed = true
        btnApprove.textContent = 'wirklich freigeben?'
        hint.textContent = 'Freigabe veröffentlicht den Seed im öffentlichen Register. Nochmal klicken zum Bestätigen.'
        return
      }
      void submit('approve')
    })

    let rejectArmed = false
    btnReject.addEventListener('click', () => {
      if (!rejectArmed) {
        rejectArmed = true
        btnReject.textContent = 'ablehnen bestätigen'
        hint.textContent = 'Verwirft die Einreichung endgültig — sie war nie öffentlich.'
        return
      }
      void submit('reject')
    })

    return card
  }

  // ── letters from the post office queue (GET/DELETE /api/post) ───────────
  const lettersEl = document.querySelector<HTMLElement>('[data-zx="letters"]')
  interface ZxLetter {
    id: string
    to: string
    fromMark: string
    contact: string
    regarding: string
    text: string
    received_at: string
    status?: string
    answered_at?: string
  }
  // Conservative mirror of the server-side check (src/lib/post/brevo.ts isEmail) — the
  // contact field is free-form, and the mail button must not offer itself for a handle.
  const looksLikeEmail = (s: string): boolean =>
    s.trim().length >= 6 && s.trim().length <= 320 && /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s.trim())
  function renderLetterCard(l: ZxLetter): HTMLElement {
    const card = el('article', { class: 'zx-card' })
    const head = el('p', { class: 'zx-card-meta' })
    head.textContent = `an ${l.to} · von ${l.fromMark}${l.regarding ? ` · betr. ${l.regarding}` : ''}`
    const meta = el('p', { class: 'zx-card-sub' })
    meta.textContent = `${l.id} · ${fmtRel(l.received_at)}${l.contact ? ` · Kontakt: ${l.contact}` : ' · kein Kontakt hinterlassen'}${l.status === 'answered' ? ' · BEANTWORTET' : ''}`
    const body = el('p', { class: 'zx-card-body zx-pre' })
    body.textContent = l.text
    const row = el('div', { class: 'zx-actions' })
    const btn = el('button', { type: 'button', class: 'zx-btn' }, 'erledigt')
    const hint = el('span', { class: 'zx-status' }, '')
    let armed = false
    btn.addEventListener('click', () => {
      if (!armed) {
        armed = true
        btn.textContent = 'löschen bestätigen'
        hint.textContent = 'Entfernt den Brief endgültig aus der Warteschlange.'
        return
      }
      void (async () => {
        try {
          const res = await fetch(`/api/post?id=${encodeURIComponent(l.id)}`, {
            method: 'DELETE',
            headers: { 'X-Zentrale-Auth': token ?? '' },
          })
          if (res.ok) card.remove()
          else hint.textContent = 'Löschen fehlgeschlagen.'
        } catch {
          hint.textContent = 'Netzwerkfehler beim Löschen.'
        }
      })()
    })
    row.append(btn, hint)

    // Reply by email — only offered when the writer left an address (spec 2026-08-01 §2.3).
    // The text is written here, in the moment; /api/zentrale/reply sends it via Brevo from
    // the verified sender and marks the letter answered. Nothing sends itself.
    if (looksLikeEmail(l.contact) && l.status !== 'answered') {
      const replyBtn = el('button', { type: 'button', class: 'zx-btn' }, 'per E-Mail antworten')
      const replyWrap = el('div', { class: 'zx-field' })
      replyWrap.hidden = true
      const subjField = el('input', {
        type: 'text',
        maxlength: '160',
        value: l.regarding ? `Re: ${l.regarding}` : 'Re: dein Brief an frankbueltge.de',
        class: 'zx-input',
      }) as HTMLInputElement
      const textField = el('textarea', { rows: '5', placeholder: 'Antwort …', class: 'zx-textarea zx-field' }) as HTMLTextAreaElement
      const sendRow = el('div', { class: 'zx-actions' })
      const sendBtn = el('button', { type: 'button', class: 'zx-btn zx-btn--primary' }, 'senden')
      const sendHint = el('span', { class: 'zx-status', role: 'status' }, '')
      sendRow.append(sendBtn, sendHint)
      replyWrap.append(subjField, textField, sendRow)
      replyBtn.addEventListener('click', () => {
        replyWrap.hidden = !replyWrap.hidden
        if (!replyWrap.hidden) textField.focus()
      })
      sendBtn.addEventListener('click', () => {
        const text = textField.value.trim()
        const subject = subjField.value.trim()
        if (text.length < 10) {
          sendHint.textContent = 'Die Antwort braucht mindestens 10 Zeichen.'
          return
        }
        sendBtn.setAttribute('disabled', 'true')
        sendHint.textContent = 'sendet …'
        void (async () => {
          try {
            const res = await fetch('/api/zentrale/reply', {
              method: 'POST',
              headers: { 'content-type': 'application/json', 'X-Zentrale-Auth': token ?? '' },
              body: JSON.stringify({ letterId: l.id, subject, text }),
            })
            const out = (await res.json().catch(() => ({}))) as { ok?: boolean; code?: string }
            if (res.ok && out.ok) {
              sendHint.textContent = 'Gesendet. Der Brief ist als beantwortet markiert.'
              replyBtn.remove()
              textField.setAttribute('disabled', 'true')
              subjField.setAttribute('disabled', 'true')
              sendBtn.remove()
              meta.textContent += ' · BEANTWORTET'
            } else {
              sendBtn.removeAttribute('disabled')
              const sayReply: Record<string, string> = {
                standby: 'Mail-Versand ist noch nicht eingerichtet (Brevo-Secrets fehlen).',
                'no-email': 'Der Kontakt ist keine E-Mail-Adresse.',
                'not-found': 'Brief nicht mehr in der Warteschlange — bitte neu laden.',
                'send-failed': 'Der Versand ist beim Anbieter fehlgeschlagen.',
                upstream: 'Der Anbieter hat nicht geantwortet — bitte gleich noch einmal.',
              }
              sendHint.textContent = sayReply[out.code ?? ''] ?? 'Senden fehlgeschlagen.'
            }
          } catch {
            sendBtn.removeAttribute('disabled')
            sendHint.textContent = 'Netzwerkfehler beim Senden.'
          }
        })()
      })
      row.append(replyBtn)
      card.append(head, meta, body, row, replyWrap)
      return card
    }

    card.append(head, meta, body, row)
    return card
  }
  async function fetchLetters(): Promise<void> {
    if (!lettersEl || !token) return
    try {
      const res = await fetch('/api/post', { headers: { 'X-Zentrale-Auth': token } })
      lettersEl.replaceChildren()
      if (!res.ok) {
        lettersEl.append(el('p', { class: 'zx-status zx-status--warn' }, 'Konnte den Briefkasten nicht laden.'))
        return
      }
      const body = (await res.json()) as { ok?: boolean; letters?: ZxLetter[] }
      const list = body.ok && Array.isArray(body.letters) ? body.letters : []
      if (list.length === 0) {
        lettersEl.append(el('p', { class: 'zx-empty' }, 'Keine Briefe in der Warteschlange.'))
      } else {
        for (const l of [...list].sort((a, b) => b.received_at.localeCompare(a.received_at))) {
          lettersEl.append(renderLetterCard(l))
        }
      }
    } catch {
      lettersEl.replaceChildren(el('p', { class: 'zx-status zx-status--warn' }, 'Netzwerkfehler beim Laden des Briefkastens.'))
    }
  }

  async function fetchPendingSeeds(): Promise<void> {
    if (!pendingSeedsEl || !token) return
    try {
      const res = await fetch('/api/zentrale/seed-review', { headers: { 'X-Zentrale-Auth': token } })
      if (res.status === 401) {
        clearToken()
        showGate('Token ungültig.')
        return
      }
      pendingSeedsEl.replaceChildren()
      if (!res.ok) {
        pendingSeedsEl.append(el('p', { class: 'zx-status zx-status--warn' }, 'Konnte die Warteschlange nicht laden.'))
        return
      }
      const body = (await res.json()) as { ok: boolean; pending?: ZxPendingSeed[] }
      const list = body.ok && Array.isArray(body.pending) ? body.pending : []
      if (list.length === 0) {
        pendingSeedsEl.append(el('p', { class: 'zx-empty' }, 'Keine wartenden Besucher-Seeds.'))
      } else {
        for (const s of list) pendingSeedsEl.append(renderPendingSeedCard(s))
      }
    } catch {
      pendingSeedsEl.replaceChildren(el('p', { class: 'zx-status zx-status--warn' }, 'Netzwerkfehler beim Laden der Warteschlange.'))
    }
  }

  // ── rendering: all runs ─────────────────────────────────────────────────
  function renderRuns(runs: ZxRun[]): void {
    if (!runsEl) return
    runsEl.replaceChildren()
    const sorted = [...runs].sort((a, b) => {
      const rank = (c: ZxRun['conclusion']) => (c === 'failure' ? 0 : 1)
      const byRank = rank(a.conclusion) - rank(b.conclusion)
      return byRank !== 0 ? byRank : a.workflow.localeCompare(b.workflow)
    })
    for (const r of sorted) {
      const ledCls = r.conclusion === 'success' ? 'zx-led zx-led--ok' : r.conclusion === 'failure' ? 'zx-led zx-led--red' : 'zx-led'
      const row = el('div', { class: 'zx-run-row' })
      row.append(el('span', { class: ledCls, 'aria-hidden': 'true' }))
      row.append(el('span', { class: 'zx-run-name' }, r.workflow))
      row.append(el('span', { class: 'zx-mono' }, fmtRel(r.at)))
      row.append(el('a', { href: r.url, target: '_blank', rel: 'noreferrer', class: 'zx-mono' }, '↗'))
      runsEl.append(row)
    }
  }

  // ── rendering: the dashboard ────────────────────────────────────────────
  function renderDashboard(body: ZxStatus): void {
    if (gateSection) gateSection.hidden = true
    if (loadingEl) loadingEl.hidden = true
    if (notConnected) notConnected.hidden = true
    if (dashboard) dashboard.hidden = false

    if (stampEl) stampEl.textContent = `Stand ${fmtStamp(body.generatedAt)}${body.cached ? ' (Cache)' : ''}`
    // The top LED judges the whole board at once: red anywhere → red; else green.
    if (liveLed) {
      const anyRed = body.collectives.some((c) => c.integrate?.conclusion === 'failure')
      liveLed.className = anyRed ? 'zx-led zx-led--red' : 'zx-led zx-led--ok'
      liveLed.setAttribute('aria-label', anyRed ? 'mindestens ein Integrate rot' : 'alle Integrates grün')
    }

    if (errorsEl) {
      if (body.errors.length > 0) {
        errorsEl.textContent = `Teilausfall: ${body.errors.join(', ')}`
        errorsEl.hidden = false
      } else {
        errorsEl.textContent = ''
        errorsEl.hidden = true
      }
    }

    if (nightEl) {
      nightEl.replaceChildren()
      for (const c of body.collectives) nightEl.append(renderCollective(c))
    }

    // Triage split (v2 P1; claims-only since 2026-08-12): the server only sends claims —
    // dated deadlines in reach ('today') and forwardings ('postoffice'). What runs without
    // Frank never arrives (status.ts buildInbox).
    const byFrist = (a: (typeof body.inbox)[number], b: (typeof body.inbox)[number]) => {
      const fa = a.fristDate ?? '9999-12-31'
      const fb = b.fristDate ?? '9999-12-31'
      return fa < fb ? -1 : fa > fb ? 1 : b.ageDays - a.ageDays
    }
    const needed = body.inbox.filter((e) => e.tray === 'today').sort(byFrist)
    const forwarding = body.inbox.filter((e) => e.tray === 'postoffice').sort(byFrist)
    if (neededEl) {
      neededEl.replaceChildren()
      if (needed.length === 0) {
        neededEl.append(el('p', { class: 'zx-empty' }, 'Nichts braucht dich heute.'))
      } else {
        for (const entry of needed) neededEl.append(renderInboxCard(entry))
      }
    }

    if (gateLaneEl) {
      gateLaneEl.replaceChildren()
      if (!body.gate || body.gate.length === 0) {
        gateLaneEl.append(el('p', { class: 'zx-empty' }, 'Kein Kandidat am Gate.'))
      } else {
        for (const c of body.gate) gateLaneEl.append(renderGateCard(c))
      }
    }

    if (postEl) {
      postEl.replaceChildren()
      const letters = body.post ?? []
      if (letters.length === 0 && forwarding.length === 0) {
        postEl.append(el('p', { class: 'zx-empty' }, 'Nichts liegt im Postausgang.'))
      } else {
        for (const item of letters) postEl.append(renderPostCard(item))
        // Requests with "braucht: weiterleitung" belong here, not under "Heute nötig"
        // (Frank, 2026-08-02) — same lane as the letters: days lying open as a fact.
        for (const entry of forwarding) postEl.append(renderInboxCard(entry))
      }
    }

    if (sitePrsEl) {
      sitePrsEl.replaceChildren()
      if (body.sitePrs === null) {
        // Partial fetch failed (named in errors) — say so, never disguise as "empty".
        sitePrsEl.append(el('p', { class: 'zx-status zx-status--warn' }, 'Konnte die offenen Vorschläge nicht laden.'))
      } else if (body.sitePrs.length === 0) {
        sitePrsEl.append(el('p', { class: 'zx-empty' }, 'Keine offenen Vorschläge.'))
      } else {
        for (const pr of body.sitePrs) sitePrsEl.append(renderSitePrCard(pr))
      }
    }

    renderRuns(body.runs)
  }

  // ── loading ─────────────────────────────────────────────────────────────
  async function fetchStatus(refresh: boolean): Promise<void> {
    if (!token) {
      showGate()
      return
    }
    const dashboardVisible = dashboard ? !dashboard.hidden : false
    if (!dashboardVisible) showLoading()
    if (refresh && refreshBtn) {
      refreshBtn.disabled = true
      refreshBtn.textContent = 'Aktualisiert …'
    }
    try {
      // Without a forced fetch, the timestamp of the last writing action travels along:
      // the server discards a cache entry older than it.
      const params = new URLSearchParams()
      if (refresh) params.set('refresh', '1')
      else {
        const since = lastMutation()
        if (since) params.set('since', since)
      }
      const query = params.toString()
      const res = await fetch(`/api/zentrale/status${query ? `?${query}` : ''}`, {
        headers: { 'X-Zentrale-Auth': token },
      })
      if (res.status === 401) {
        clearToken()
        showGate('Token ungültig.')
        return
      }
      if (res.status === 503) {
        showNotConnected()
        return
      }
      if (!res.ok) {
        showNotConnected('Unerwarteter Fehler beim Laden — bitte später erneut versuchen.')
        return
      }
      const body = (await res.json()) as ZxStatus | { ok: false; code?: string }
      if (!body.ok) {
        showNotConnected()
        return
      }
      renderDashboard(body)
      void fetchPendingSeeds() // own endpoint (KV), loads in parallel after the status
      void fetchLetters() // post office KV queue, likewise parallel
    } catch {
      showNotConnected('Netzwerkfehler — bitte später erneut versuchen.')
    } finally {
      if (refresh && refreshBtn) {
        refreshBtn.disabled = false
        refreshBtn.textContent = 'Aktualisieren'
      }
    }
  }

  gateForm?.addEventListener('submit', (ev) => {
    ev.preventDefault()
    const fd = new FormData(gateForm)
    const value = String(fd.get('token') ?? '').trim()
    if (!value) return
    try {
      localStorage.setItem(TOKEN_KEY, value)
    } catch {
      /* private mode etc. — token holds for this page load only */
    }
    token = value
    void fetchStatus(false)
  })

  refreshBtn?.addEventListener('click', () => {
    void fetchStatus(true)
  })

  seedForm?.addEventListener('submit', (ev) => {
    ev.preventDefault()
    if (!seedSubmit || seedSubmit.disabled) return
    const fd = new FormData(seedForm)
    const repo = String(fd.get('repo') ?? '')
    const title = String(fd.get('title') ?? '').trim()
    const bodyText = String(fd.get('body') ?? '').trim()
    if (!seedMsg) return
    if (!title || !bodyText) {
      seedMsg.textContent = 'Titel und Text sind Pflicht.'
      seedMsg.className = 'zx-status zx-status--warn'
      return
    }
    seedSubmit.disabled = true
    seedMsg.textContent = ''
    seedMsg.className = 'zx-status'
    void (async () => {
      try {
        const result = await postAntwort({ action: 'seed', repo, title, body: bodyText })
        if (result.ok) {
          seedMsg.textContent = '✓ gelegt'
          const url = commitUrlOf(result.commit)
          if (url) {
            seedMsg.append(' ')
            seedMsg.append(el('a', { href: url, target: '_blank', rel: 'noreferrer' }, 'Commit ansehen ↗'))
          }
          if (result.warning) seedMsg.append(el('span', { class: 'zx-status zx-status--warn' }, result.warning))
          seedForm.reset()
        } else {
          seedMsg.textContent = ANTWORT_ERR[result.code ?? ''] ?? 'Das hat nicht geklappt — bitte später erneut versuchen.'
          seedMsg.className = 'zx-status zx-status--warn'
        }
      } catch (err) {
        if (String(err) !== 'Error: unauthorized') {
          seedMsg.textContent = 'Netzwerkfehler — bitte erneut versuchen.'
          seedMsg.className = 'zx-status zx-status--warn'
        }
      } finally {
        seedSubmit.disabled = false
      }
    })()
  })

  if (token) void fetchStatus(false)
  else showGate()
</script>

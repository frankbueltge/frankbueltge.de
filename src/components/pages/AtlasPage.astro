---
import type { Locale } from '@/lib/site'
import worksData from '@/data/atlas/werke.json'
import {
  FAMILIE,
  FAMILIE_LABEL_DE,
  FAMILIE_LABEL_EN,
  THEMEN_LABELS_DE,
  THEMEN_LABELS_EN,
} from '@/config/themen'
import { cn } from '@/lib/ui/cn'

interface Props {
  locale: Locale
}
const { locale } = Astro.props

type Work = {
  title: string
  artist: string
  year: string
  venue_prize: string
  clusters: number[]
  axis_pole: 'investigation' | 'spectacle' | 'mixed'
  form: string
  medium_class: 'digital' | 'hybrid' | 'physical'
  lab_renderable?: boolean
  decisive_move?: string
  source_url?: string
  verify_status?: 'verified' | 'toVerify'
  curator_note?: string
}
const works = worksData as Work[]

const de = locale === 'de'

// Felder 1–7 kartieren Daten, KI und Macht — der Stand der ersten Fassung (2026).
// Felder 8–13 sind die Erweiterung vom 2026-07-25: Datenkunst, die nicht von Macht
// handelt. Sie erscheinen in der Filterleiste erst, sobald sie belegt sind (clusterKeys
// wird aus den Daten abgeleitet), damit die Seite keine leeren Felder behauptet.
//
// Die Labels standen bis 2026-07-27 hier inline. Seit der Paper-Katalog dieselben Felder
// benennt, liegen sie in src/config/themen.ts — eine Kopie wäre die erste, die still
// veraltet, und genau daran scheiterte das alte Relevanzkriterium des Registers.
const CLUSTER: Record<number, string> = de ? THEMEN_LABELS_DE : THEMEN_LABELS_EN
const FAMILIE_LABEL: Record<string, string> = de ? FAMILIE_LABEL_DE : FAMILIE_LABEL_EN
// Der Atlas begann als Gegenwartskarte — vor 2015 lag nichts darin. Die Netzkunst der
// Nullerjahre ist aber nicht Vorgeschichte, sondern die Ebene, auf der die heutigen
// Arbeiten stehen (Asendorf, Levin, Polli, ted davis). Sie wird deshalb als eigene
// Schicht geführt und nicht untergemischt.
const SCHICHT_GRENZE = 2013

// Zwei Einträge tragen Prosa im Jahresfeld, weil das Projekt läuft („toolkit ongoing
// since ~2014", „developed ~2019–2023"). Die erste Jahreszahl im String ist dafür die
// vertretbare Lesung — die ersten vier Zeichen sind es nicht.
const jahrZahl = (jahr: string): number | null => {
  const treffer = String(jahr).match(/\d{4}/)
  return treffer ? Number.parseInt(treffer[0], 10) : null
}
const epocheVon = (jahr: string): 'archiv' | 'gegenwart' => {
  const n = jahrZahl(jahr)
  return n !== null && n < SCHICHT_GRENZE ? 'archiv' : 'gegenwart'
}
const EPOCHE: Record<string, string> = de
  ? { archiv: `Archiv (vor ${SCHICHT_GRENZE})`, gegenwart: 'Gegenwart' }
  : { archiv: `archive (pre-${SCHICHT_GRENZE})`, gegenwart: 'present' }

const MEDIUM: Record<string, string> = de
  ? { digital: 'digital', hybrid: 'hybrid', physical: 'physisch' }
  : { digital: 'digital', hybrid: 'hybrid', physical: 'physical' }
const AXIS: Record<string, string> = de
  ? { investigation: 'Untersuchung', spectacle: 'Spektakel', mixed: 'gemischt' }
  : { investigation: 'investigation', spectacle: 'spectacle', mixed: 'mixed' }

const copy = de
  ? {
      kicker: 'Ein lebendiges Verzeichnis',
      intro:
        'Eine quellenbelegte Landkarte zeitgenössischer Datenkunst — Werke, die Daten und KI als Material und als Gegenstand nehmen: was sie kosten, was sie verbergen, was sie wahrnehmbar machen, was sie sagen lassen. Global, nach thematischen Feldern geordnet, jede Angabe mit abrufbarer Quelle.',
      fuelPre: 'Futter für das Kollektiv im ',
      fuelMid: ' und fürs ',
      lWorks: 'Werke',
      lVerified: 'verifiziert',
      lClusters: 'Felder',
      lPhysical: 'physisch/öffentlich',
      fField: 'Feld',
      fMedium: 'Medium',
      fJahr: 'Jahr',
      fEpoche: 'Schicht',
      fAxis: 'Standpunkt',
      all: 'Alle',
      showing: 'sichtbar',
      reset: 'Filter zurücksetzen',
      unverified: 'ungeprüft',
      source: 'Quelle',
      method:
        'Zusammengetragen in 16 parallelen Recherche-Durchgängen; jede Angabe gegen eine abrufbare Quelle geprüft — nichts erfunden. Unsichere Einordnungen sind als „ungeprüft" markiert. Ein Werk kann in mehreren Feldern liegen. Standpunkt: Untersuchung (KI als Gegenstand) ↔ Spektakel (KI als Medium). Die Karte begann als Kartierung von Daten, KI und Macht (Felder 1–7); am 25.07.2026 wurde sie um Felder erweitert, die nicht von Macht handeln (8–13) — Erkenntnis und Ausdruck.',
      field: 'Feld',
      atelier: 'Atelier',
    }
  : {
      kicker: 'A living index',
      intro:
        'A source-cited map of contemporary data art — works that take data and AI as material and as subject: what they cost, what they hide, what they let us perceive, what they let us say. Global, ordered by thematic fields, every entry with a retrievable source.',
      fuelPre: 'Fuel for the collective in the ',
      fuelMid: ' and for the ',
      lWorks: 'works',
      lVerified: 'verified',
      lClusters: 'clusters',
      lPhysical: 'physical/public',
      fField: 'Cluster',
      fMedium: 'Medium',
      fJahr: 'Year',
      fEpoche: 'Layer',
      fAxis: 'Stance',
      all: 'All',
      showing: 'showing',
      reset: 'reset filters',
      unverified: 'unverified',
      source: 'source',
      method:
        'Compiled across 16 parallel research passes; every entry checked against a retrievable source — nothing invented. Uncertain classifications are flagged “unverified”. A work can sit in several clusters. Stance: investigation (AI as subject) ↔ spectacle (AI as medium). The map began as a survey of data, AI and power (fields 1–7); on 2026-07-25 it was widened with fields that are not about power (8–13) — knowing and expression.',
      field: 'Field',
      atelier: 'Atelier',
    }

// stats
const total = works.length
const verified = works.filter((w) => w.verify_status === 'verified').length
const physical = works.filter((w) => w.medium_class === 'physical').length
const clusterCounts: Record<number, number> = {}
for (const w of works) for (const c of w.clusters) clusterCounts[c] = (clusterCounts[c] ?? 0) + 1

// Aus den Daten abgeleitet, nicht fest verdrahtet: ein neu angelegtes Feld erscheint in
// der Filterleiste erst, sobald ein Werk darin liegt. Die Seite behauptet damit keine
// Felder, die noch leer sind — und wächst ohne weitere Codeänderung mit dem Atlas.
const clusterKeys = Object.keys(CLUSTER)
  .map(Number)
  .filter((c) => (clusterCounts[c] ?? 0) > 0)
  .sort((a, b) => a - b)
// Familien nur zeigen, solange mehr als eine belegt ist — bei ausschließlich Feldern 1–7
// wäre ein einzelnes „Macht"-Etikett über allen Chips nur Rauschen.
const familienKeys = ['macht', 'erkenntnis', 'ausdruck'].filter((f) =>
  clusterKeys.some((c) => FAMILIE[c] === f),
)
// Wie bei den Feldern: aus den Daten abgeleitet. Solange der Atlas rein gegenwärtig
// ist, erscheint die Zeile gar nicht — erst wenn Archivwerke aufgenommen sind.
const epochenKeys = (['archiv', 'gegenwart'] as const).filter((e) =>
  works.some((w) => epocheVon(w.year) === e),
)

// Jahrzehnte statt Schieberegler: dieselbe Chip-Sprache wie die übrigen Filter, ohne
// zusätzliche Bedienlogik. Aus den Daten abgeleitet, deshalb wächst die Reihe mit.
const dekadeVon = (jahr: string): number | null => {
  const n = jahrZahl(jahr)
  return n !== null ? Math.floor(n / 10) * 10 : null
}
const dekadenCounts: Record<number, number> = {}
for (const w of works) {
  const d = dekadeVon(w.year)
  if (d !== null) dekadenCounts[d] = (dekadenCounts[d] ?? 0) + 1
}
const dekadenKeys = Object.keys(dekadenCounts).map(Number).sort((a, b) => a - b)
const mediumKeys = ['digital', 'hybrid', 'physical']
const axisKeys = ['investigation', 'mixed', 'spectacle']

// Re-skin 2d (2026-09-02): the atlas on the frame's recipe — the kicker as the one .kicker
// class, the head and the cards on the type scale, panels on the frame's radius and resting
// depth, and a card that answers the pointer at the frame's speed. The .chip below keeps its
// own rule (there are a hundred of them on this page and they are the page's instrument), but
// it now takes its radius and its easing from the frame's tokens instead of its own numbers.
// The filter script, the data and every word are untouched.
const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
---

<main id="main" class="mx-auto w-full max-w-6xl px-4 py-10 sm:py-14">
  <header class="mb-8 max-w-3xl">
    <p class={cn(kicker, 'mb-2')}>{copy.kicker}</p>
    <h1 class="text-h1 font-semibold">
      {de ? 'Atlas der Datenkunst' : 'Atlas of Data Art'}
    </h1>
    <p class="mt-4 text-body text-fg-muted">{copy.intro}</p>
  </header>

  <!-- stats -->
  <dl class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {[
      { n: total, l: copy.lWorks },
      { n: verified, l: copy.lVerified },
      { n: clusterKeys.length, l: copy.lClusters },
      { n: physical, l: copy.lPhysical },
    ].map((s) => (
      <div class={cn(panel, 'p-4')}>
        <dd class="font-mono text-h2 font-semibold text-fg">{s.n}</dd>
        <dt class="mt-0.5 text-small text-fg-muted">{s.l}</dt>
      </div>
    ))}
  </dl>

  <section data-atlas>
    <!-- filters -->
    <div class="mb-6 space-y-5">
      <!-- Thema: je Familie eine Zeile, damit dreizehn Felder lesbar bleiben -->
      <div class="space-y-1.5">
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="mr-1 w-20 shrink-0 font-mono text-mono uppercase tracking-wider text-fg-faint">{copy.fField}</span>
          <button type="button" data-filter="cluster" data-value="all" aria-pressed="true" class="chip">{copy.all}</button>
        </div>
        {familienKeys.map((f) => (
          <div class="flex flex-wrap items-center gap-1.5">
            {/* Familienname als eigene Zeile, damit die Chips linksbündig stehen und
                nicht hinter einer Beschriftungsspalte eingerückt beginnen. */}
            <span class="w-full font-mono text-mono-xs uppercase tracking-wider text-fg-faint">{FAMILIE_LABEL[f]}</span>
            {clusterKeys.filter((c) => FAMILIE[c] === f).map((c) => (
              <button type="button" data-filter="cluster" data-value={String(c)} aria-pressed="false" class="chip" title={CLUSTER[c]}>
                <span class="font-mono text-fg-faint">{c}</span> {CLUSTER[c]} <span class="text-fg-faint">{clusterCounts[c] ?? 0}</span>
              </button>
            ))}
          </div>
        ))}
      </div>

      <!-- Zeit, Form, Standpunkt -->
      <div class="space-y-1.5 border-t border-line pt-4">
        {dekadenKeys.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="mr-1 w-20 shrink-0 font-mono text-mono uppercase tracking-wider text-fg-faint">{copy.fJahr}</span>
            <button type="button" data-filter="dekade" data-value="all" aria-pressed="true" class="chip">{copy.all}</button>
            {dekadenKeys.map((d) => (
              <button type="button" data-filter="dekade" data-value={String(d)} aria-pressed="false" class="chip">
                <span class="font-mono">{d}er</span> <span class="text-fg-faint">{dekadenCounts[d]}</span>
              </button>
            ))}
          </div>
        )}
        {epochenKeys.length > 1 && (
          <div class="flex flex-wrap items-center gap-1.5">
            <span class="mr-1 w-20 shrink-0 font-mono text-mono uppercase tracking-wider text-fg-faint">{copy.fEpoche}</span>
            <button type="button" data-filter="epoche" data-value="all" aria-pressed="true" class="chip">{copy.all}</button>
            {epochenKeys.map((e) => (
              <button type="button" data-filter="epoche" data-value={e} aria-pressed="false" class="chip">
                {EPOCHE[e]} <span class="text-fg-faint">{works.filter((w) => epocheVon(w.year) === e).length}</span>
              </button>
            ))}
          </div>
        )}
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="mr-1 w-20 shrink-0 font-mono text-mono uppercase tracking-wider text-fg-faint">{copy.fMedium}</span>
          <button type="button" data-filter="medium" data-value="all" aria-pressed="true" class="chip">{copy.all}</button>
          {mediumKeys.map((m) => (
            <button type="button" data-filter="medium" data-value={m} aria-pressed="false" class="chip">{MEDIUM[m]}</button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-1.5">
          <span class="mr-1 w-20 shrink-0 font-mono text-mono uppercase tracking-wider text-fg-faint">{copy.fAxis}</span>
          <button type="button" data-filter="axis" data-value="all" aria-pressed="true" class="chip">{copy.all}</button>
          {axisKeys.map((a) => (
            <button type="button" data-filter="axis" data-value={a} aria-pressed="false" class="chip">{AXIS[a]}</button>
          ))}
        </div>
      </div>

      <div class="flex items-center gap-3 border-t border-line pt-3">
        <p class="font-mono text-mono text-fg-faint"><span data-count>{total}</span> / {total} {copy.showing}</p>
        <button type="button" data-reset class="chip hidden">{copy.reset}</button>
      </div>
    </div>

    <!-- grid -->
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {works.map((w) => (
        <li
          data-card
          data-clusters={w.clusters.join(' ')}
          data-medium={w.medium_class}
          data-epoche={epocheVon(w.year)}
          data-dekade={String(dekadeVon(w.year) ?? '')}
          data-axis={w.axis_pole}
          class={cn(panel, 'atlas-card flex flex-col break-words p-4')}
        >
          <div class="mb-2 flex flex-wrap items-center gap-1.5">
            {w.clusters.map((c) => (
              <span class="rounded-xs bg-panel-2 px-1.5 py-0.5 font-mono text-mono-xs text-fg-muted" title={CLUSTER[c]}>{c}</span>
            ))}
            <span class="ml-auto font-mono text-mono-xs uppercase tracking-wider text-fg-faint">{MEDIUM[w.medium_class]}</span>
            {w.verify_status !== 'verified' && (
              <span class="rounded-xs bg-panel-2 px-1.5 py-0.5 font-mono text-mono-xs text-fg-muted" title={copy.unverified}>?</span>
            )}
          </div>
          <h2 class="text-h3 font-semibold leading-snug text-fg">{w.title}</h2>
          <p class="mt-0.5 text-small text-fg-muted">{w.artist} · {w.year}</p>
          <p class="mt-0.5 text-small text-fg-faint">{w.venue_prize}</p>
          {w.decisive_move && <p class="mt-2 text-small leading-relaxed text-fg-muted">{w.decisive_move}</p>}
          {w.curator_note && <p class="mt-2 text-small italic leading-relaxed text-fg-faint">{w.curator_note}</p>}
          <div class="mt-3 flex items-center justify-between gap-2 border-t border-line pt-2 text-small">
            <span class="font-mono text-fg-faint">{AXIS[w.axis_pole]} · {w.form}</span>
            {w.source_url && (
              <a href={w.source_url} target="_blank" rel="noopener noreferrer" class="shrink-0 text-fg-muted underline decoration-line underline-offset-2 hover:text-fg">{copy.source} ↗</a>
            )}
          </div>
        </li>
      ))}
    </ul>

    <p class="mt-10 max-w-3xl text-small leading-relaxed text-fg-faint">{copy.method}</p>
  </section>
</main>

<style>
  /* The atlas's own chip. It is not the shadcn Button recipe on purpose: a hundred of these
     stand on one page as the instrument the atlas is read with, and they need to be smaller and
     denser than a button of the frame. What changed on 2026-09-02 is where its numbers come
     from — the frame's radius step and the frame's easing, instead of a 0.5rem corner and three
     hand-typed 150 ms transitions. */
  .chip {
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    padding: 0.25rem 0.6rem;
    font-size: var(--text-small);
    color: var(--color-fg-muted);
    transition:
      color 0.2s var(--ease-frame),
      border-color 0.2s var(--ease-frame),
      background-color 0.2s var(--ease-frame);
  }
  .chip:hover {
    color: var(--color-fg);
    border-color: var(--color-line-lift);
  }

  /* The work card answers the pointer with the frame's gesture: it is read in place, so it
     brightens its hairline and casts deeper rather than rising. The rule stands here because
     the interactive rule in global.css cannot reach a <li>. */
  .atlas-card {
    transition:
      border-color 0.2s var(--ease-frame),
      box-shadow 0.2s var(--ease-frame);
  }
  .atlas-card:hover,
  .atlas-card:focus-within {
    border-color: var(--color-line-lift);
    box-shadow: var(--elev-lift);
  }
  .chip[aria-pressed='true'] {
    background: var(--color-fg);
    color: var(--color-bg);
    border-color: var(--color-fg);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-atlas]')
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'))
    const countEl = root.querySelector<HTMLElement>('[data-count]')
    const resetEl = root.querySelector<HTMLButtonElement>('[data-reset]')
    const state: Record<string, string> = { cluster: 'all', medium: 'all', axis: 'all', epoche: 'all', dekade: 'all' }

    const apply = () => {
      let n = 0
      for (const card of cards) {
        const clusters = (card.dataset.clusters ?? '').split(' ')
        const okC = state.cluster === 'all' || clusters.includes(state.cluster)
        const okM = state.medium === 'all' || card.dataset.medium === state.medium
        const okA = state.axis === 'all' || card.dataset.axis === state.axis
        const okE = state.epoche === 'all' || card.dataset.epoche === state.epoche
        const okD = state.dekade === 'all' || card.dataset.dekade === state.dekade
        const show = okC && okM && okA && okE && okD
        card.hidden = !show
        if (show) n++
      }
      if (countEl) countEl.textContent = String(n)
      // Der Zurücksetzen-Knopf erscheint erst, wenn es etwas zurückzusetzen gibt.
      const aktiv = Object.values(state).some((v) => v !== 'all')
      resetEl?.classList.toggle('hidden', !aktiv)
    }

    resetEl?.addEventListener('click', () => {
      for (const group of Object.keys(state)) state[group] = 'all'
      root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.value === 'all'))
      })
      apply()
    })

    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const group = btn.dataset.filter ?? ''
        const value = btn.dataset.value ?? 'all'
        state[group] = value
        root
          .querySelectorAll<HTMLButtonElement>(`[data-filter="${group}"]`)
          .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
        apply()
      })
    })

    apply()
  }
</script>

---
// /papers — the paper catalogue (wording-kanon.md "Catalogues": since 2026-07-27 the third
// reference work next to the Atlas and the Dataset Register).
//
// Frank's decision of 2026-07-27, wording private: datasets go to the register, and papers get
// a catalogue of their own. Built from what the practices actually cite — see src/lib/papers.ts
// for provenance and for the line drawn against Assay's theory atlas.
//
// 2026-11-09 (Frank's choice on the catalogue review, wording private): the page lists what the
// practices READ (src/lib/papers.ts, READING) and summarises the identifiers works tested as
// their material instead of printing thousands of them; it shares its toolbar with /atlas and
// /datasets (search, sort, folded filters, paging, state in the address). Every card is still
// rendered on the server, so the whole catalogue stands without JavaScript.
//
// Numbers only from the data (canon rule) — no value is typed into the prose.
import {
  ABGELEHNT,
  READING,
  TESTED_IN_WORK,
  ablehnungsGrundLabel,
  authorLine,
  citedBy,
  grundLabel,
  praxisLabel,
  pruefLabel,
  testedInWorkSummary,
  urteilLabel,
} from '@/lib/papers'
import { titleSortKey } from '@/lib/catalogue/query'
import { THEMEN_LABELS } from '@/config/themen'
import CatalogueStats from '@/components/catalogue/CatalogueStats.astro'
import CatalogueToolbar from '@/components/catalogue/CatalogueToolbar.astro'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'

const PAGE_SIZE = 50
const total = READING.length
const withReason = READING.filter((p) => p.relevanz_herkunft === 'praxis').length
const byMore = READING.filter((p) => citedBy(p).length > 1).length
const byModel = READING.filter((p) => p.relevanz_herkunft === 'urteil').length

// Most recently used first: what is in use now stands on top. Entries without a date go last
// instead of being given an invented one.
const sorted = [...READING].sort((a, b) => {
  const av = a.zuletzt_gebraucht ?? ''
  const bv = b.zuletzt_gebraucht ?? ''
  if (av !== bv) return bv.localeCompare(av)
  return (b.jahr ?? 0) - (a.jahr ?? 0)
})

// ── Facets ────────────────────────────────────────────────────────────────────────────────
// All derived from the data, never from a fixed list: an option appears only when it is held
// (the atlas pattern). A catalogue whose point is checkability does not offer empty filters.
const count = <T,>(values: T[]) => {
  const m = new Map<T, number>()
  for (const v of values) m.set(v, (m.get(v) ?? 0) + 1)
  return m
}

const practiceFacet = [...count(READING.flatMap(citedBy)).entries()].sort((a, b) => b[1] - a[1])

// Fields in their binding order 1–13, not by frequency: the numbers are the shared map.
const fieldCounts = count(READING.flatMap((p) => p.felder))
const fieldFacet = [...fieldCounts.entries()].sort((a, b) => a[0] - b[0])
const unplaced = READING.filter((p) => p.felder.length === 0).length

const reasonCounts = count(READING.map((p) => p.relevanz_herkunft))

// Decades, with everything before 1990 in one bucket: nineteen decade chips back to the 1840s
// made the bar longer than a phone screen for a handful of entries (2026-11-09).
const EARLY = 1990
const period = (y: number | null): string =>
  y === null ? '' : y < EARLY ? 'early' : String(Math.floor(y / 10) * 10)
const periodCounts = count(READING.map((p) => period(p.jahr)).filter(Boolean))
const periodFacet = [...periodCounts.entries()]
  .sort((a, b) => (a[0] === 'early' ? 1 : b[0] === 'early' ? -1 : Number(b[0]) - Number(a[0])))
  .map(([v, n]) => ({ value: v, label: v === 'early' ? `before ${EARLY}` : `${v}s`, n }))

const accessFacet = [
  { value: 'open', label: 'openly accessible', n: READING.filter((p) => p.frei_zugaenglich).length },
  { value: 'checked', label: 'access confirmed', n: READING.filter((p) => p.geprueft).length },
].filter((z) => z.n > 0)

const groups = [
  { key: 'cited', title: 'cited by',
    options: practiceFacet.map(([p, n]) => ({ value: p, label: praxisLabel(p), n })) },
  { key: 'field', title: 'field',
    options: [
      ...fieldFacet.map(([f, n]) => ({ value: String(f), label: THEMEN_LABELS[f] ?? `field ${f}`, n })),
      ...(unplaced > 0 ? [{ value: 'none', label: 'not yet placed', n: unplaced }] : []),
    ] },
  { key: 'period', title: 'published', options: periodFacet },
  // Two yes/no questions a reader actually asks, instead of the register's provenance states
  // (practice / model / none) and two overlapping access states (2026-11-09).
  { key: 'reason', title: 'reason',
    options: [{ value: 'praxis', label: 'written by a practice', n: reasonCounts.get('praxis') ?? 0 }] },
  { key: 'access', title: 'access', options: accessFacet.filter((o) => o.value === 'open') },
]
const sorts = [
  { value: 'recent', label: 'recently used' },
  { value: 'year', label: 'newest' },
  { value: 'added', label: 'recently added' },
  { value: 'title', label: 'title A–Z' },
]

// The works whose data folders held identifiers they tested. Named by their folder, linked to
// it in the practice's public repository, largest first.
const tested = testedInWorkSummary().map(({ work, n }) => {
  const [repo, ...rest] = work.split('/')
  const slug = rest[rest.length - 1] ?? work
  const name = slug.replace(/^\d{4}-\d{2}-\d{2}-/, '').replace(/-/g, ' ')
  return {
    n,
    name: name.charAt(0).toUpperCase() + name.slice(1),
    repo,
    href: `https://github.com/frankbueltge/${repo}/tree/main/${rest.join('/')}`,
  }
})

const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const fold = 'fold-chevron inline-block'
const more = cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'font-mono text-mono-sm font-normal')
---

<main id="main" class="mx-auto w-full max-w-4xl px-4 py-10 sm:py-14">
  <header class="mb-8 max-w-3xl">
    <p class={cn(kicker, 'mb-2')}>Catalogues · Papers</p>
    <h1 class="text-h1 font-semibold">Paper Catalogue</h1>
    <p class="mt-4 text-body text-fg-muted">
      What this ecology's research practices and the lab's other houses actually read.
      Every entry is here because one of them reached for it in its own writing — the
      catalogue starts from use, not from a search of everything that exists.
    </p>
    <p class="mt-3 text-body text-fg-muted">
      Each entry says who cites it, when it was last picked up, and where its reason came
      from: a sentence written by a practice is reproduced verbatim; a sentence written by a
      model names the model, the date and what it read. Unfold an entry to see the file it
      was found in and whether its access route answered.
    </p>
  </header>

  <CatalogueStats items={[
    { value: total, label: 'papers read' },
    { value: withReason, label: 'with a written reason' },
    { value: byMore, label: 'cited by more than one' },
    { value: TESTED_IN_WORK.length, label: 'tested inside works' },
  ]} />

  <section
    data-catalogue
    data-groups="cited field period reason access"
    data-multi="cited field access"
    data-sorts="recent year added title"
    data-sort-desc="recent year added"
    data-default-sort="recent"
    data-page-size={PAGE_SIZE}
  >
    <CatalogueToolbar
      groups={groups}
      sorts={sorts}
      total={total}
      noun="papers"
      placeholder="Search title, author, journal, DOI…"
    />

    <ol data-list class="space-y-4">
    {sorted.map((p) => (
      <li
        class={cn(panel, 'pp-card break-words p-5')}
        data-card
        data-f-cited={citedBy(p).join(' ')}
        data-f-reason={p.relevanz_herkunft}
        data-f-field={p.felder.length ? p.felder.join(' ') : 'none'}
        data-f-period={period(p.jahr)}
        data-f-access={[p.frei_zugaenglich ? 'open' : '', p.geprueft ? 'checked' : ''].filter(Boolean).join(' ')}
        data-s-recent={p.zuletzt_gebraucht ?? ''}
        data-s-year={p.jahr ? String(p.jahr) : ''}
        data-s-added={p.first_seen_on ?? ''}
        data-s-title={titleSortKey(p.titel)}
        data-text={[p.titel, p.urheber.join(' '), p.ort, p.kennung, ...(p.weitere_kennungen ?? []), p.relevanz].join(' ')}
      >
        <h2 class="text-h3 font-semibold leading-snug text-fg">
          <a href={p.url} rel="noopener" class="decoration-line underline-offset-4 hover:underline">
            {p.titel}
          </a>
        </h2>

        <p class="mt-1 font-mono text-mono text-fg-faint">
          {authorLine(p.urheber)}{p.jahr ? ` · ${p.jahr}` : ''}{p.ort ? ` · ${p.ort}` : ''}
        </p>

        <p class={cn('mt-3 text-small leading-relaxed', p.relevanz_herkunft === 'gebrauch' ? 'text-fg-faint' : 'text-fg-muted')}>
          {p.relevanz_herkunft === 'urteil' && <span class="font-mono text-mono-xs uppercase tracking-wider text-fg-faint">model's proposal · </span>}
          {p.relevanz}
        </p>

        <div class="pp-ids mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-mono-sm text-fg-faint">
          <a href={p.url} rel="noopener" class="hover:text-fg">{p.kennung}</a>
          {p.weitere_kennungen?.map((k) => <span>also {k}</span>)}
          {p.frei_zugaenglich && <span>open access</span>}
          {p.zitiert_von.length > 0 && <span>cited by {citedBy(p).map(praxisLabel).join(', ')}</span>}
          {p.zuletzt_gebraucht && <span>last used {p.zuletzt_gebraucht}</span>}
        </div>
        {p.felder.length > 0 && (
          <p class="mt-2 font-mono text-mono-xs text-fg-faint">
            {p.felder.map((f) => THEMEN_LABELS[f] ?? `field ${f}`).join(' · ')}
          </p>
        )}

        {/* The warrant: why the entry stands here, where to read it, whether the address was
            checked. Frank's instruction of 2026-07-28 (wording private): everything checked and
            annotated — where it comes from and why it was admitted. */}
        <details class="mt-3 border-t border-line pt-2">
          <summary class="cursor-pointer font-mono text-mono-sm text-fg-faint hover:text-fg">
            <span class={fold}>▾</span> admitted because {grundLabel(p.aufnahmegrund)} · {pruefLabel(p)}
          </summary>
          <ul class="mt-2 space-y-1 font-mono text-mono-sm text-fg-faint">
            {p.fundstellen?.map((f) => <li>found in {f}</li>)}
            {p.pruef_vermerk && <li>note: {p.pruef_vermerk}</li>}
            <li>
              route: {p.weg === 'scout' ? 'scout enrichment' : 'from the practices'} ·
              reason for the sentence above: {
                p.relevanz_herkunft === 'praxis'
                  ? 'written by the practice, reproduced verbatim'
                  : p.relevanz_herkunft === 'urteil'
                    ? `${urteilLabel(p.urteil)} — a proposal to the practice, not a substitute for its reading`
                    : 'record of use — nobody has written the reason yet'
              }
            </li>
          </ul>
        </details>
      </li>
    ))}
    </ol>

    <p data-empty hidden class="py-10 text-center text-small text-fg-muted">
      Nothing matches. Clear the search or a filter.
    </p>
    <div class="mt-6 flex justify-center">
      <button type="button" data-more hidden class={more}>show <span data-more-n>{PAGE_SIZE}</span> more</button>
    </div>
  </section>

  {total === 0 && (
    <p class="text-small leading-relaxed text-fg-muted">
      Empty — the catalogue is built from the practices' own citations and has not been
      run yet. Not a source outage.
    </p>
  )}

  <!-- What used to be three quarters of this page: identifiers a work tested as its material.
       Summarised by work, not printed one by one; every entry stays in the feeds. -->
  {tested.length > 0 && (
    <section class={cn(panel, 'mt-12 p-5')}>
      <details>
        <summary class={cn(kicker, 'cursor-pointer hover:text-fg')}>
          <span class={fold}>▾</span> tested inside works, not read: {TESTED_IN_WORK.length.toLocaleString('en-GB')} identifiers
        </summary>
        <p class="mt-3 text-small leading-relaxed text-fg-muted">
          Some works use identifiers as their material — they resolve, retrieve or count
          thousands of them to measure something about the record itself. Those identifiers are
          the work's sample, not the practice's reading, so they are not listed above. They
          are kept, entry by entry, in the
          <a href="/papers/register.json" class="underline decoration-line underline-offset-4 hover:text-fg">machine-readable register</a>,
          and each work's data folder holds them in full:
        </p>
        <ul class="mt-4 space-y-1.5 font-mono text-mono-sm text-fg-faint">
          {tested.map((t) => (
            <li class="flex items-baseline justify-between gap-3">
              <a href={t.href} rel="noopener" class="hover:text-fg">{t.name} <span class="opacity-60">({t.repo})</span></a>
              <span class="shrink-0 tabular-nums">{t.n.toLocaleString('en-GB')}</span>
            </li>
          ))}
        </ul>
      </details>
    </section>
  )}

  {ABGELEHNT.length > 0 && (
    <!-- The withdrawals. A catalogue that can REMOVE silently is no more checkable than one
         that admits silently — and a list nobody sees is no list. -->
    <section class={cn(panel, 'mt-4 p-5')}>
      <details>
        <summary class={cn(kicker, 'cursor-pointer hover:text-fg')}>
          <span class={fold}>▾</span> withdrawn from this catalogue: {ABGELEHNT.length}
        </summary>
        <p class="mt-3 text-small leading-relaxed text-fg-muted">
          An entry can be taken back — but only by name, with a stated ground and
          evidence of what is actually at the cited place. An entry whose reason was
          written by a practice can never be withdrawn: someone read that text.
        </p>
        <ul class="mt-4 space-y-4">
          {ABGELEHNT.map((a) => (
            <li class="border-l-2 border-line pl-3">
              <div class="text-small text-fg">{a.titel}</div>
              <div class="mt-1 font-mono text-mono-xs uppercase tracking-wider text-fg-faint">
                {a.grund} — {ablehnungsGrundLabel(a.grund)}
              </div>
              <p class="mt-2 text-small leading-relaxed text-fg-muted">{a.beleg}</p>
              <div class="mt-1 font-mono text-mono-xs text-fg-faint">
                withdrawn by {a.wer} on {a.am}
              </div>
            </li>
          ))}
        </ul>
      </details>
    </section>
  )}
  {byModel > 0 && (
    <p class="mt-6 font-mono text-mono-xs text-fg-faint">
      {byModel} {byModel === 1 ? 'reason was' : 'reasons were'} proposed by a model and {byModel === 1 ? 'is' : 'are'} marked as such on the entry.
    </p>
  )}
</main>

<style>
  /* The entry answers the pointer the way every card of this frame does, at the frame's own
     speed. It is READ in place, so it brightens its hairline and casts a little deeper rather
     than rising; .lift belongs to cards that ARE the destination. (re-skin 2d, 2026-09-02) */
  .pp-card {
    transition:
      border-color 0.2s var(--ease-frame),
      box-shadow 0.2s var(--ease-frame);
  }
  .pp-card:hover,
  .pp-card:focus-within {
    border-color: var(--color-line-lift);
    box-shadow: var(--elev-lift);
  }

  /* A DOI or an arXiv id is one unbreakable word; letting the items shrink and the ids break
     anywhere keeps a phone's viewport from being pushed sideways (measured 2026-09-02). */
  .pp-ids > * {
    min-width: 0;
    overflow-wrap: anywhere;
  }
</style>

<script>
  import { initCatalogue } from '@/lib/catalogue/controller'
  const root = document.querySelector<HTMLElement>('[data-catalogue]')
  if (root) initCatalogue(root)
</script>

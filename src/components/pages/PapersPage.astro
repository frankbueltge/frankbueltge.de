---
// /papers — Paper-Katalog (wording-kanon.md "Catalogues": ab 2026-07-27 der dritte
// Nachschlagewerk-Eintrag neben Atlas und Dataset Register).
//
// Frank, 2026-07-27: „datasets für das register und einen weiteren katalog für die
// sammlung von papers". Gebaut aus dem, was die Praxen tatsächlich zitieren — siehe
// src/lib/papers.ts für Herkunft und Abgrenzung zu Ulysses' Theorie-Atlas.
//
// Rendering: vollständig serverseitig. 134 Einträge sind ein paar hundert KB Markup —
// der Vorgänger brauchte eine Client-Suche, weil er 16.516 führte. Das ist kein
// technischer Fortschritt, sondern die Folge davon, dass jeder Eintrag begründet ist.
//
// Zahlen NUR aus den Daten (Kanon-Regel) — kein Wert steht im Fließtext.
import { ABGELEHNT, PAPERS, ablehnungsGrundLabel, authorLine, grundLabel, praxisLabel, pruefLabel, urteilLabel } from '@/lib/papers'
import { THEMEN_LABELS } from '@/config/themen'

const total = PAPERS.length
const mitEigenerBegruendung = PAPERS.filter((p) => p.relevanz_herkunft === 'praxis').length
const vonMehreren = PAPERS.filter((p) => p.zitiert_von.length > 1).length
const ausScout = PAPERS.filter((p) => p.weg === 'scout').length
const ausUrteil = PAPERS.filter((p) => p.relevanz_herkunft === 'urteil').length

// Jüngstes zuerst: was gerade gebraucht wird, steht oben. Einträge ohne Datum ans Ende,
// statt sie mit einem erfundenen Datum einzureihen.
const sortiert = [...PAPERS].sort((a, b) => {
  const av = a.zuletzt_gebraucht ?? ''
  const bv = b.zuletzt_gebraucht ?? ''
  if (av !== bv) return bv.localeCompare(av)
  return (b.jahr ?? 0) - (a.jahr ?? 0)
})

// ── Facetten ──────────────────────────────────────────────────────────────────────
// Alle aus den Daten abgeleitet, nie aus einer festen Liste: Eine Option erscheint nur,
// wenn sie belegt ist (Atlas-Muster). Die Seite behauptet damit keine Zustände, die im
// Bestand nicht vorkommen — bei einem Katalog, dessen ganzer Sinn Nachprüfbarkeit ist,
// wäre ein leerer Filter eine kleine Lüge.
const zaehle = <T,>(werte: T[]) => {
  const m = new Map<T, number>()
  for (const w of werte) m.set(w, (m.get(w) ?? 0) + 1)
  return m
}

const praxisFacette = [...zaehle(PAPERS.flatMap((p) => p.zitiert_von)).entries()]
  .sort((a, b) => b[1] - a[1])

// Felder in der bindenden Reihenfolge 1–13, nicht nach Häufigkeit: Die Nummern sind die
// gemeinsame Karte, und ihre Ordnung ist Teil der Aussage (drei Familien).
const feldZaehler = zaehle(PAPERS.flatMap((p) => p.felder))
const feldFacette = [...feldZaehler.entries()].sort((a, b) => a[0] - b[0])
const ohneFeld = PAPERS.filter((p) => p.felder.length === 0).length

// Herkunft der Begründung — die wichtigste Facette dieses Katalogs: Sie trennt, was eine
// Praxis geschrieben hat, von dem, was eine Maschine vorschlug, und von dem, wo noch
// niemand etwas gesagt hat.
const herkunftOrder = [
  { key: 'praxis', label: 'written by a practice' },
  { key: 'urteil', label: 'written by a model' },
  { key: 'gebrauch', label: 'no reason written yet' },
] as const
const herkunftZaehler = zaehle(PAPERS.map((p) => p.relevanz_herkunft))
const herkunftFacette = herkunftOrder.filter((h) => (herkunftZaehler.get(h.key) ?? 0) > 0)

// Jahrzehnte statt Jahre: 208 Einträge über gut fünf Jahrzehnte ergäben sonst eine
// Filterleiste, die länger ist als die Ergebnisliste.
const jahrzehnt = (j: number | null) => (j ? Math.floor(j / 10) * 10 : null)
const jahrzehntZaehler = zaehle(
  PAPERS.map((p) => jahrzehnt(p.jahr)).filter((d): d is number => d !== null),
)
const jahrzehntFacette = [...jahrzehntZaehler.entries()].sort((a, b) => b[0] - a[0])

const zugangFacette = [
  { key: 'open', label: 'openly accessible', n: PAPERS.filter((p) => p.frei_zugaenglich).length },
  { key: 'geprueft', label: 'access confirmed', n: PAPERS.filter((p) => p.geprueft).length },
].filter((z) => z.n > 0)
---

<main id="main" class="mx-auto w-full max-w-4xl px-4 py-10 sm:py-14">
  <header class="mb-8 max-w-3xl">
    <p class="mb-2 font-mono text-xs uppercase tracking-widest text-fg-faint">Papers</p>
    <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">Paper Catalogue</h1>
    <p class="mt-4 text-fg-muted">
      What this ecology's three research practices actually read. Every entry is here
      because a practice reached for it in its own work — the catalogue starts from use,
      not from a search of everything that exists.
    </p>
    <p class="mt-3 text-fg-muted">
      Each entry says who cites it and when it was last picked up, and each one shows
      where its reason came from. A sentence written by a practice is reproduced verbatim.
      A sentence written by a model names the model, the date and what it was reading —
      it is a proposal to the practice, never a substitute for its own reading. Where
      nobody has written one at all, the entry carries the plain record of its use.
    </p>
    <p class="mt-3 text-fg-muted">
      Nothing here is marked as read over until a person or a practice says so. Every
      entry can be unfolded to show the file it was found in, the rule under which it was
      admitted, and whether its access route answered when asked.
    </p>
  </header>

  <!-- Kennzahlen: gezählt, nie behauptet. -->
  <section class="mb-10 grid grid-cols-2 gap-3 sm:grid-cols-4">
    {[
      { wert: total, label: 'entries' },
      { wert: mitEigenerBegruendung, label: 'with a written reason' },
      { wert: vonMehreren, label: 'cited by more than one' },
      { wert: ausUrteil, label: 'reason written by a model' },
    ].map((k) => (
      <div class="rounded-lg border border-line bg-panel p-4">
        <div class="font-mono text-2xl font-semibold tabular-nums text-fg">{k.wert}</div>
        <div class="mt-1 font-mono text-[10px] uppercase leading-tight tracking-wider text-fg-faint">
          {k.label}
        </div>
      </div>
    ))}
  </section>

  {ABGELEHNT.length > 0 && (
    <!-- Das Ablehnungsverzeichnis. Steht hier, weil ein Katalog, der still ENTFERNEN
         kann, nicht prüfbarer ist als einer, der still aufnimmt — und weil ein
         Verzeichnis, das niemand sieht, keines ist. -->
    <section class="mb-10 rounded-lg border border-line bg-panel p-4">
      <details>
        <summary class="cursor-pointer font-mono text-[11px] uppercase tracking-wider text-fg-faint">
          withdrawn from this catalogue: {ABGELEHNT.length}
        </summary>
        <p class="mt-3 text-sm leading-relaxed text-fg-muted">
          An entry can be taken back — but only by name, with a stated ground and
          evidence of what is actually at the cited place. An entry whose reason was
          written by a practice can never be withdrawn: someone read that text.
        </p>
        <ul class="mt-4 space-y-4">
          {ABGELEHNT.map((a) => (
            <li class="border-l-2 border-line pl-3">
              <div class="text-sm text-fg">{a.titel}</div>
              <div class="mt-1 font-mono text-[10px] uppercase tracking-wider text-fg-faint">
                {a.grund} — {ablehnungsGrundLabel(a.grund)}
              </div>
              <p class="mt-2 text-xs leading-relaxed text-fg-muted">{a.beleg}</p>
              <div class="mt-1 font-mono text-[10px] text-fg-faint">
                withdrawn by {a.wer} on {a.am}
              </div>
            </li>
          ))}
        </ul>
      </details>
    </section>
  )}

  <section data-papers>
    <!-- Filter. Rein clientseitig über data-Attribute; ohne JavaScript bleibt die
         vollständige Liste stehen (kein leerer Bildschirm als Ausfallzustand). -->
    <div class="mb-6 space-y-3 border-y border-line py-4">
      {[
        { gruppe: 'praxis', titel: 'cited by',
          optionen: praxisFacette.map(([p, n]) => ({ wert: p, label: praxisLabel(p), n })) },
        { gruppe: 'herkunft', titel: 'reason',
          optionen: herkunftFacette.map((h) => ({
            wert: h.key, label: h.label, n: herkunftZaehler.get(h.key) ?? 0 })) },
        { gruppe: 'feld', titel: 'field',
          optionen: [
            ...feldFacette.map(([f, n]) => ({
              wert: String(f), label: THEMEN_LABELS[f] ?? `field ${f}`, n })),
            ...(ohneFeld > 0
              ? [{ wert: 'keins', label: 'not yet placed', n: ohneFeld }]
              : []),
          ] },
        { gruppe: 'jahrzehnt', titel: 'decade',
          optionen: jahrzehntFacette.map(([d, n]) => ({ wert: String(d), label: `${d}s`, n })) },
        { gruppe: 'zugang', titel: 'access',
          optionen: zugangFacette.map((z) => ({ wert: z.key, label: z.label, n: z.n })) },
      ].filter((g) => g.optionen.length > 1).map((g) => (
        <div class="flex flex-wrap items-baseline gap-x-2 gap-y-1">
          <span class="w-16 shrink-0 font-mono text-[10px] uppercase tracking-wider text-fg-faint">
            {g.titel}
          </span>
          <button
            type="button" data-filter={g.gruppe} data-value="all" aria-pressed="true"
            class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-fg-faint aria-pressed:border-fg-faint aria-pressed:text-fg hover:text-fg"
          >all</button>
          {g.optionen.map((o) => (
            <button
              type="button" data-filter={g.gruppe} data-value={o.wert} aria-pressed="false"
              class="rounded border border-line px-2 py-0.5 font-mono text-[11px] text-fg-faint aria-pressed:border-fg-faint aria-pressed:text-fg hover:text-fg"
            >{o.label} <span class="tabular-nums opacity-60">{o.n}</span></button>
          ))}
        </div>
      ))}

      <div class="flex items-center gap-3 pt-1">
        <p class="font-mono text-xs text-fg-faint">
          <span data-count>{total}</span> / {total} shown
        </p>
        <button
          type="button" data-reset
          class="hidden rounded border border-line px-2 py-0.5 font-mono text-[11px] text-fg-faint hover:text-fg"
        >reset</button>
      </div>
    </div>

    <ol class="space-y-5">
    {sortiert.map((p) => (
      <li
        class="rounded-xl border border-line bg-panel p-5"
        data-card
        data-praxis={p.zitiert_von.join(' ')}
        data-herkunft={p.relevanz_herkunft}
        data-feld={p.felder.length ? p.felder.join(' ') : 'keins'}
        data-jahrzehnt={p.jahr ? String(Math.floor(p.jahr / 10) * 10) : ''}
        data-zugang={[p.frei_zugaenglich ? 'open' : '', p.geprueft ? 'geprueft' : ''].filter(Boolean).join(' ')}
      >
        <div class="flex items-start justify-between gap-3">
          <h2 class="text-base font-semibold leading-snug text-fg">
            <a href={p.url} rel="noopener" class="hover:underline decoration-line underline-offset-4">
              {p.titel}
            </a>
          </h2>
          {p.verify_status === 'toVerify' && (
            <span
              class="shrink-0 font-mono text-xs text-fg-faint"
              title="the use is documented; nobody has written down why it matters yet">?</span>
          )}
        </div>

        <p class="mt-1 font-mono text-xs text-fg-faint">
          {authorLine(p.urheber)}{p.jahr ? ` · ${p.jahr}` : ''}{p.ort ? ` · ${p.ort}` : ''}
        </p>

        <p class="mt-3 text-sm leading-relaxed text-fg-muted">{p.relevanz}</p>

        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[11px] text-fg-faint">
          <a href={p.url} rel="noopener" class="hover:text-fg">{p.kennung}</a>
          {/* Preprint neben Veröffentlichung: beide Kennungen bleiben auffindbar. */}
          {p.weitere_kennungen?.map((k) => <span>also {k}</span>)}
          {p.frei_zugaenglich && <span>open access</span>}
          {p.zitiert_von.length > 0 && (
            <span>cited by {p.zitiert_von.map(praxisLabel).join(', ')}</span>
          )}
          {p.zuletzt_gebraucht && <span>last used {p.zuletzt_gebraucht}</span>}
          {p.felder.map((f) => (
            <span class="rounded border border-line px-1.5 py-0.5">
              {THEMEN_LABELS[f] ?? `field ${f}`}
            </span>
          ))}
        </div>

        {/* Der Beleg: warum der Eintrag hier steht, wo das nachzulesen ist, und ob die
            Adresse geprüft wurde. Franks Vorgabe, 2026-07-28 (Wortlaut privat): alles muss geprüft
            und annotiert sein — woher es kommt und warum es aufgenommen wurde. Das gehört sichtbar
            an den Eintrag, nicht nur ins JSON — sonst ist es keine Rechenschaft. */}
        <details class="mt-3 border-t border-line pt-2">
          <summary class="cursor-pointer font-mono text-[11px] text-fg-faint hover:text-fg">
            admitted because {grundLabel(p.aufnahmegrund)} · {pruefLabel(p)}
          </summary>
          <ul class="mt-2 space-y-1 font-mono text-[11px] text-fg-faint">
            {p.fundstellen?.map((f) => <li>found in {f}</li>)}
            {p.pruef_vermerk && <li>note: {p.pruef_vermerk}</li>}
            <li>
              route: {p.weg === 'scout' ? 'scout enrichment' : 'from the practices'} ·
              reason for the sentence above: {
                p.relevanz_herkunft === 'praxis'
                  ? 'written by the practice, reproduced verbatim'
                  : p.relevanz_herkunft === 'urteil'
                    ? `${urteilLabel(p.urteil)} — a proposal to the practice, not a substitute for its reading`
                    : 'record of use — nobody has written the reason yet'
              }
            </li>
          </ul>
        </details>
      </li>
    ))}
    </ol>
  </section>

  {total === 0 && (
    <p class="text-sm leading-relaxed text-fg-muted">
      Empty — the catalogue is built from the practices' own citations and has not been
      run yet. Not a source outage.
    </p>
  )}
</main>

<script>
  // Dasselbe Muster wie AtlasPage — ein zweites zu erfinden hieße, zwei Filterleisten
  // getrennt zu pflegen. Mehrwertige Merkmale (Praxis, Feld, Zugang) prüfen auf
  // Enthaltensein, einwertige auf Gleichheit.
  const root = document.querySelector<HTMLElement>('[data-papers]')
  if (root) {
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-card]'))
    const countEl = root.querySelector<HTMLElement>('[data-count]')
    const resetEl = root.querySelector<HTMLButtonElement>('[data-reset]')
    const MEHRWERTIG = new Set(['praxis', 'feld', 'zugang'])
    const state: Record<string, string> = {
      praxis: 'all', herkunft: 'all', feld: 'all', jahrzehnt: 'all', zugang: 'all',
    }

    const apply = () => {
      let n = 0
      for (const card of cards) {
        const show = Object.entries(state).every(([gruppe, wert]) => {
          if (wert === 'all') return true
          const feld = card.dataset[gruppe] ?? ''
          return MEHRWERTIG.has(gruppe) ? feld.split(' ').includes(wert) : feld === wert
        })
        card.hidden = !show
        if (show) n++
      }
      if (countEl) countEl.textContent = String(n)
      resetEl?.classList.toggle('hidden', !Object.values(state).some((v) => v !== 'all'))
    }

    resetEl?.addEventListener('click', () => {
      for (const gruppe of Object.keys(state)) state[gruppe] = 'all'
      root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
        b.setAttribute('aria-pressed', String(b.dataset.value === 'all'))
      })
      apply()
    })

    root.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const gruppe = btn.dataset.filter ?? ''
        state[gruppe] = btn.dataset.value ?? 'all'
        root.querySelectorAll<HTMLButtonElement>(`[data-filter="${gruppe}"]`)
          .forEach((b) => b.setAttribute('aria-pressed', String(b === btn)))
        apply()
      })
    })

    apply()
  }
</script>

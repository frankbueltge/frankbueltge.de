---
// SaatPage — die „Öffentliche Saat" (Design-Spec 2026-07-20-oeffentliche-saat-design.md).
// English-only per Frank's decision (2026-07-20, wording private — English everywhere): the site went
// English-only on 2026-07-16 ("de-abbau", decision-log). The route is /seed — English slug,
// no German URLs (Frank 2026-07-20; the earlier German slug /saat was dropped, Addendum D10).
// The former German text set (a `locale` prop with dual dictionaries) has been removed from the
// code; it remains recoverable through this branch's git history, not as a live code path.
//
// Contract with functions/api/seed.js (built in parallel; read directly to confirm the shape
// below — this file's error/response mapping is the single place to adjust if it ever changes):
//   GET  /api/seed  → { ready, missing, daily_used, daily_cap, pending, cap }
//   POST /api/seed  body { kind, text, authorMark, addressedTo, consent, website, turnstileToken }
//                    → success { ok: true, id, claim_token }
//                    → failure { ok: false, reason, code? }
//   `reason` is the primary discriminator: one of the RejectReason values from saat.ts
//   ('kind' | 'too-short' | 'too-long' | 'pii' | 'url-not-allowed' | 'too-many-urls' |
//   'author-mark' | 'addressee'), or 'gate' | 'daily-cap' | 'open-cap' | 'turnstile' |
//   'gate-unavailable' | 'standby' | 'rate-limit' | 'bad-json' | 'content-type' | 'too-large' |
//   'conflict' | 'upstream'. Only for reason === 'gate' does a second field, `code`, carry the
//   GateReason (spam/abuse/nonsense/injection/pii/other) — mirrors validateSeed()'s own
//   RejectReason naming, not functions/api/impulse.js's flatter `{ code: v.reason }` shape.
//
// Status lookup runs entirely client-side: hashToken() (WebCrypto SHA-256, imported straight
// from src/lib/saat/saat.ts — Web-API-only, safe in a browser <script>) hashes the entered
// token locally; the token itself never leaves the browser. It is matched against a freshly
// fetched copy of the committed register.json from raw.githubusercontent.com (no server needed,
// "Git is the archive"). Turnstile + that raw fetch are the two documented exceptions to the
// site's connect-src/script-src CSP (astro.config.mjs), both named in the spec's own risk list.
import registerJson from '@/data/saat/register.json'
import {
  SAAT_KINDS,
  SAAT_ADDRESSEES,
  SAAT_MIN_LEN,
  SAAT_MAX_LEN,
  AUTHOR_MARK_MAX_LEN,
  SAAT_DAILY_CAP,
  SAAT_OPEN_CAP,
  type SaatRegister,
  type SaatKind,
  type SaatAddressee,
  type GateReason,
} from '@/lib/saat/saat'
import { GATE_MODEL, GATE_PROMPT } from '@/lib/saat/gate'
import { buttonVariants } from '@/components/ui/button'
import { fieldLabel, fieldVariants } from '@/lib/ui/field'
import { cn } from '@/lib/ui/cn'

const register = registerJson as SaatRegister
const seeds = [...register.seeds].sort((a, b) => b.ts.localeCompare(a.ts))
const gateStatsTotal = register.gate_stats.blocked_total
const gateStatsByReason = Object.entries(register.gate_stats.by_reason) as [GateReason, number][]

// Nur zur Buildzeit gesetzt ⇒ nur dann rendern wir Widget + Script (Task-Vorgabe: ohne Key
// bleibt das Formular im Standby, kein totes Formular, kein ungenutztes externes Script).
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined
const hasTurnstile = Boolean(turnstileSiteKey)

const kindLabel: Record<SaatKind, string> = { frage: 'question', quelle: 'source', wort: 'word', richtung: 'direction' }

const kindOption: Record<SaatKind, string> = {
  frage: 'Question — something you want to know but cannot answer yourself',
  quelle: 'Source — a find, a URL, a pointer to material',
  wort: 'Word — a single term that hits something',
  richtung: 'Direction — a suggestion for where the practice could look next',
}

const addresseeLabel: Record<SaatAddressee, string> = {
  'field-research': 'Field / Meridian',
  studio: 'Studio / Ensemble',
  'ulysses': 'Atelier / Ulysses',
  open: 'open to all three',
}

const statusLabel: Record<string, string> = { offered: 'offered', taken: 'taken', adapted: 'adapted', declined: 'declined' }

/** Kurzname je Praxis für die Antwortmarken. Die Schlüssel sind Repo-Namen — die stehen
 *  so im Register, weil der Rückfluss sie aus dem Repo-Pfad nimmt, nicht aus der Persona. */
const practiceShort: Record<string, string> = {
  'field-research': 'Field',
  studio: 'Studio',
  ulysses: 'Atelier',
}

const gateReasonLabel: Record<GateReason, string> = {
  spam: 'spam/advertising',
  abuse: 'abuse/harassment',
  nonsense: 'nonsense noise with no discernible impulse',
  injection: 'an attempt to instruct an AI system',
  pii: "a third party's personal data",
  other: 'another reason',
}

const errors: Record<string, string> = {
  kind: 'Please pick a kind: question, source, word or direction.',
  'too-short': 'Too short — at least 3 characters.',
  'too-long': 'Too long — 500 characters at most.',
  pii: 'No email addresses or phone numbers, please — seeds are public and pseudonymous.',
  'url-not-allowed': 'Links only for kind "source".',
  'too-many-urls': 'One URL at most.',
  'author-mark': 'The pseudonym is too long or contains contact details/links.',
  addressee: 'Please pick an addressee.',
  consent: 'Please confirm publication under CC BY-NC-SA 4.0.',
  gate: 'The gate declined this seed.',
  'daily-cap': "Today's cap is reached — the register takes no more seeds today. Try again tomorrow.",
  'open-cap': 'Too many open seeds are still waiting on a reply from the practices — once a few are answered, room opens up again.',
  turnstile: 'The bot check failed. Please reload the page and try again.',
  'gate-unavailable': 'The gate was not reachable just now — out of caution, nothing is waved through unchecked. Please try again shortly.',
  standby: 'The inlet is not connected yet — the seed is waiting on its secrets.',
  'not-connected': 'The inlet is not connected yet.',
  'rate-limit': "Slow down — please don't send that many seeds in a row.",
  'bad-json': 'Something went wrong technically. Please reload the page.',
  'content-type': 'Something went wrong technically. Please reload the page.',
  'too-large': 'The text is too long to submit — please shorten it.',
  conflict: 'A brief conflict writing to the register — please try again in a moment.',
  upstream: 'The register was not reachable just now. Please try again later.',
  generic: "That didn't work — please try again later.",
}

const txt = {
  eyebrow: 'Ecology · visitor participation',
  title: 'Public seed',
  lede:
    'You can offer this research a seed — a question, a source, a word, a direction. The practices decide ' +
    'for themselves what to do with it; acceptance and refusal are both public.',
  lede2: 'A seed is material, never an instruction — the practice decides for itself whether to take it, adapt it, or decline it with a reason.',
  lede3: `At most ${SAAT_DAILY_CAP} new seeds per day, at most ${SAAT_OPEN_CAP} open at once — after that the register waits until the practices catch up.`,
  formHeading: 'Offer a seed',
  standby: 'The inlet is not connected yet — the seed is waiting on its secrets.',
  kindLabel: 'Kind of seed',
  textLabel: 'Your text',
  textPlaceholder: '3–500 characters',
  textNote: 'For "source" exactly one URL is allowed, otherwise none — and no personal data (email, phone, third-party names).',
  markLabel: 'Pseudonym (optional, 24 characters max)',
  markNote: 'Leave it empty and "anonymous" appears. No contact details, no links.',
  addresseeLabel: 'Addressed to',
  consentLabel: 'I agree that this seed, if accepted for publication, will be published pseudonymously under CC BY-NC-SA 4.0.',
  submit: 'Submit seed',
  submitting: 'submitting …',
  readyToday: '{remaining} of {cap} slots left today',
  readyOpen: '{pending}/{cap} open seeds in total',
  doneHeading: 'Your seed is in the queue for review.',
  doneBody:
    'A person reviews every seed before it goes public — if accepted, it appears in the register below; ' +
    'if not, it is discarded and never published. Your claim token appears here only this once and is ' +
    'stored nowhere — it is the only key to your seed’s status. Keep it if you want to check back later.',
  copyLabel: 'Copy',
  copiedLabel: 'Copied ✓',
  statusHeading: 'Look up a seed’s status',
  statusIntro: 'Enter your claim token — it is hashed locally in the browser only, never sent to a server.',
  statusInputLabel: 'Claim token',
  statusButton: 'Look up',
  statusChecking: 'looking …',
  statusNotFound:
    'No entry found for this token — the seed may still be awaiting review (or was not accepted ' +
    'for publication), or the token is wrong.',
  statusFetchError: 'The register could not be loaded just now. Please try again later.',
  responseNoteLabel: 'The practice’s reply:',
  oneReply: 'read the reply',
  manyReplies: 'read all {n} replies',
  stillOpen: 'no reply yet',
  stillOpenHint:
    'This practice was asked and has not answered. A seed stays material until it is used or declined — silence here is not a refusal.',
  registerHeading: 'The register — every seed, open or answered',
  registerIntro: 'Newest first. Declines stand here just as visibly as acceptances — that is by design, not a flaw.',
  registerEmpty: 'No seed in the register yet.',
  gateHeading: 'The gate',
  gateIntro:
    `Every submitted seed first passes an AI gate (model ${GATE_MODEL}) that checks only for hard exclusion ` +
    'grounds — spam, abuse, nonsense noise, attempts to instruct an AI system, or a third party’s personal ' +
    'data. Everything else passes; unusual, poetic or fragmentary seeds are explicitly welcome. The actual ' +
    'decision — take, adapt, decline — always belongs to the addressed practice, never to this gate.',
  gatePromptLabel: 'The prompt, verbatim:',
  turnstileNote:
    'Before the gate, Turnstile (Cloudflare) checks whether a human is submitting — the one deliberate ' +
    'exception to this lab’s otherwise zero-third-party stance, made because this is the same provider as the hosting.',
  chainNote: 'The chain, in order: mechanical prefilter → Turnstile → daily and open caps → AI gate → the practice decides.',
  gateStatsEmpty: 'The gate has not blocked a seed yet.',
  gateStatsLabel: (n: number) => `Blocked by the gate so far: ${n} in total.`,
}

// Client-Payload — nur serialisierbare Daten (keine Funktionen); Templates mit {platzhalter}
// werden im Script per String-Replace gefüllt (siehe dort).
const payload = JSON.stringify({
  hasTurnstile,
  addressees: SAAT_ADDRESSEES,
  errors,
  gateReasons: gateReasonLabel,
  kindLabels: kindLabel,
  addresseeLabels: addresseeLabel,
  statusLabels: statusLabel,
  sending: txt.submitting,
  readyToday: txt.readyToday,
  readyOpen: txt.readyOpen,
  statusChecking: txt.statusChecking,
  statusNotFound: txt.statusNotFound,
  statusFetchError: txt.statusFetchError,
  responseNoteLabel: txt.responseNoteLabel,
  registerEmpty: txt.registerEmpty,
  copyLabel: txt.copyLabel,
  copiedLabel: txt.copiedLabel,
}).replace(/</g, '\\u003c')

// Re-skin 2d (2026-09-02): the seed page on the frame's recipe — the eyebrow as the one .kicker
// class, the head on the type scale, the form and the register as panels with the frame's radius
// and resting depth, the fields on the shared field recipe (src/lib/ui/field.ts) and the two
// buttons on the shadcn Button. The Turnstile widget, the honeypot, the claim-token lookup and
// the whole client script are untouched — including the register markup the script re-renders,
// which is kept byte-for-byte in step with the server's below.
const kicker = 'kicker'
const panel = 'rounded-md border border-line bg-panel panel-raised'
const inset = 'rounded-sm border border-line bg-bg/40'
const select = cn(fieldVariants({ kind: 'select' }), 'mt-2')
const input = cn(fieldVariants({ kind: 'input' }), 'mt-2')
const textarea = cn(fieldVariants({ kind: 'textarea' }), 'mt-2 min-h-24')
const primary = cn(buttonVariants({ variant: 'default' }))
const outline = cn(buttonVariants({ variant: 'outline' }))
const outlineSm = cn(buttonVariants({ variant: 'outline', size: 'sm' }))
/* the register list, as both the server and the script below render it */
const registerList = 'mt-6 divide-y divide-line/60 overflow-hidden rounded-md border border-line bg-panel panel-raised'
const seedMark = 'rounded-sm border border-line px-2 py-0.5 font-mono text-mono-sm'
---

<main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 pb-24 pt-16 sm:pt-24">
  <section>
    <p class={kicker}>{txt.eyebrow}</p>
    <h1 class="mt-4 text-display font-bold">{txt.title}</h1>
    <p class="mt-5 max-w-[62ch] text-h3 font-normal text-fg-muted">{txt.lede}</p>
    <p class="mt-3 max-w-[62ch] text-body text-fg-muted">{txt.lede2}</p>
    <p class="mt-3 max-w-[62ch] font-mono text-mono text-fg-faint">{txt.lede3}</p>
  </section>

  {/* ── Formular — Standby bis /api/seed ready:true meldet UND Turnstile zur Buildzeit da ist ── */}
  <section class={cn(panel, 'mt-12 p-6 sm:p-8')} aria-labelledby="saat-form-h">
    <h2 id="saat-form-h" class={kicker}>{txt.formHeading}</h2>

    <div class={cn(inset, 'mt-5 flex items-start gap-3 p-4')} data-saat="standby">
      <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-fg-faint" aria-hidden="true"></span>
      <p class="text-small text-fg-muted">{txt.standby}</p>
    </div>

    <form class="mt-5 space-y-5" data-saat="form" hidden>
      <div>
        <label for="saat-kind" class={fieldLabel}>{txt.kindLabel}</label>
        <select id="saat-kind" name="kind" required class={select}>
          {SAAT_KINDS.map((k) => <option value={k}>{kindOption[k]}</option>)}
        </select>
      </div>

      <div>
        <label for="saat-text" class={fieldLabel}>{txt.textLabel}</label>
        <textarea
          id="saat-text"
          name="text"
          required
          minlength={SAAT_MIN_LEN}
          maxlength={SAAT_MAX_LEN}
          rows="4"
          placeholder={txt.textPlaceholder}
          data-saat="text"
          class={textarea}
        ></textarea>
        <div class="mt-1 flex items-center justify-between">
          <p class="max-w-[48ch] text-small text-fg-muted">{txt.textNote}</p>
          <span class="shrink-0 pl-3 font-mono text-mono text-fg-faint" data-saat="counter">0/{SAAT_MAX_LEN}</span>
        </div>
      </div>

      <div>
        <label for="saat-mark" class={fieldLabel}>{txt.markLabel}</label>
        <input
          id="saat-mark"
          name="authorMark"
          type="text"
          maxlength={AUTHOR_MARK_MAX_LEN}
          placeholder="anonymous"
          autocomplete="off"
          class={input}
        />
        <p class="mt-1 text-small text-fg-muted">{txt.markNote}</p>
      </div>

      <div>
        <label for="saat-addressee" class={fieldLabel}>{txt.addresseeLabel}</label>
        <select id="saat-addressee" name="addressedTo" required data-saat="addressee" class={select}>
          {/* "open" is the default — a seed belongs to the research, not to one practice; the
              ?to=/?an= prefills below still override it for contextual links from a practice page. */}
          {SAAT_ADDRESSEES.map((a) => <option value={a} selected={a === 'open'}>{addresseeLabel[a]}</option>)}
        </select>
      </div>

      <label class="flex items-start gap-2.5 text-small text-fg-muted">
        <input type="checkbox" name="consent" required class="mt-1 shrink-0" />
        <span>{txt.consentLabel}</span>
      </label>

      {/* Honeypot — für Menschen unsichtbar, Bots füllen es aus (Cockpit-Ventil-Konvention) */}
      <input type="text" name="website" class="saat-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

      {hasTurnstile && <div class="cf-turnstile" data-sitekey={turnstileSiteKey}></div>}

      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" data-saat="submit" class={primary}>
          {txt.submit}
        </button>
        <span class="font-mono text-mono text-fg-faint" data-saat="ready-info"></span>
      </div>
      <p class="text-small text-fg-muted" role="status" data-saat="msg"></p>
    </form>

    <div class={cn(inset, 'mt-5 p-4')} data-saat="done" hidden>
      <p class="text-h3 font-semibold text-fg">{txt.doneHeading}</p>
      <p class="mt-2 text-small text-fg-muted">{txt.doneBody}</p>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <code class="break-all rounded-sm border border-line bg-panel-2 px-3 py-2 font-mono text-small" data-saat="token"></code>
        <button type="button" class={outlineSm} data-saat="copy">
          {txt.copyLabel}
        </button>
      </div>
    </div>
  </section>

  {/* ── Status-Abfrage ─────────────────────────────────────────────────── */}
  <section class="mt-14" aria-labelledby="saat-status-h">
    <h2 id="saat-status-h" class={kicker}>{txt.statusHeading}</h2>
    <p class="mt-3 max-w-[60ch] text-body text-fg-muted">{txt.statusIntro}</p>
    <form class="mt-4 flex flex-wrap gap-2" data-saat="status-form">
      <label class="sr-only" for="saat-token-input">{txt.statusInputLabel}</label>
      <input
        id="saat-token-input"
        name="token"
        type="text"
        autocomplete="off"
        placeholder={txt.statusInputLabel}
        class={cn(fieldVariants({ kind: 'input' }), 'min-w-[16rem] flex-1 font-mono')}
      />
      <button type="submit" class={outline}>{txt.statusButton}</button>
    </form>
    <p class="mt-3 min-h-[1.5em] text-small text-fg-muted" role="status" data-saat="status-result"></p>
  </section>

  {/* ── Register ───────────────────────────────────────────────────────── */}
  <section class="mt-14" aria-labelledby="saat-register-h">
    <h2 id="saat-register-h" class={kicker}>{txt.registerHeading}</h2>
    <p class="mt-3 max-w-[64ch] text-body text-fg-muted">{txt.registerIntro}</p>

    <div data-saat="register-body">
    {seeds.length === 0 ? (
      <p class="mt-6 text-small text-fg-faint">{txt.registerEmpty}</p>
    ) : (
      <ul class={registerList}>
        {seeds.map((seed) => (
          <li class="p-4 sm:p-5">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-mono-sm uppercase tracking-[0.12em] text-fg-faint">
              <span>{seed.ts.slice(0, 10)}</span>
              <span aria-hidden="true">·</span>
              <span>{kindLabel[seed.kind]}</span>
              <span aria-hidden="true">·</span>
              <span>{addresseeLabel[seed.addressed_to]}</span>
              <span aria-hidden="true">·</span>
              <span class={cn(seedMark, 'normal-case tracking-normal text-fg-muted')}>{statusLabel[seed.status]}</span>
            </div>
            <p class="mt-2 whitespace-pre-line text-body leading-relaxed text-fg">{seed.text}</p>
            <p class="mt-2 font-mono text-mono text-fg-faint">— {seed.author_mark}</p>
            {/* ALLE Antworten, eine je Praxis. Ein Seed an „open" geht an drei Praxen, und
                sie antworten verschieden — beim Seed …-e322 nahm Ensemble ihn als Material
                auf, während Meridian ihn begründet ablehnte. Bis 2026-07-28 zeigte diese
                Stelle nur ein einziges `response`, und der Widerspruch — das Interessanteste
                daran — war unsichtbar.

                Die Zeile darunter beantwortet Franks Frage (28.07.), „ob die Praxen sofort
                blocken oder sich eventuell weiter damit beschäftigen" — und zwar AUS DEN
                DATEN: Wer gefragt wurde, steht in `forwarded_to`; wer geantwortet hat, in
                `responses`. Die Differenz ist offen, und offen heißt: kann noch kommen.
                Nichts davon wird aus dem Wortlaut einer Antwort erschlossen. */}
            {(() => {
              const antworten = seed.responses?.length
                ? seed.responses
                : seed.response
                  ? [seed.response]
                  : []
              const beantwortet = new Set(antworten.map((a) => a.practice))
              const offen = seed.forwarded_to.filter((p) => !beantwortet.has(p))
              if (antworten.length === 0 && offen.length === 0) return null
              return (
                <div class="mt-3 border-t border-line/60 pt-3">
                  {/* Übersicht: eine Marke je gefragter Praxis, immer sichtbar. */}
                  <ul class="flex flex-wrap gap-x-2 gap-y-1">
                    {antworten.map((a) => (
                      <li class={cn(seedMark, 'text-fg-muted')}>
                        {practiceShort[a.practice] ?? a.practice}{' '}
                        <span class="text-fg">{statusLabel[a.decision] ?? a.decision}</span>
                      </li>
                    ))}
                    {offen.map((p) => (
                      <li
                        class={cn(seedMark, 'border-dashed text-fg-faint')}
                        title={txt.stillOpenHint}
                      >
                        {practiceShort[p] ?? p} <span>{txt.stillOpen}</span>
                      </li>
                    ))}
                  </ul>

                  {/* Der Wortlaut erst auf Klick — die Antworten sind teils lang, und die
                      Liste soll überfliegbar bleiben. */}
                  {antworten.length > 0 && (
                    <details class="group mt-2">
                      <summary class="cursor-pointer font-mono text-mono-sm uppercase tracking-[0.12em] text-fg-faint hover:text-fg">
                        <span class="fold-chevron inline-block">▾</span>{' '}
                        {antworten.length === 1 ? txt.oneReply : txt.manyReplies.replace('{n}', String(antworten.length))}
                      </summary>
                      <div class="mt-2 space-y-3">
                        {antworten.map((a) => (
                          <p class="text-small leading-relaxed text-fg-muted">
                            <span class="font-mono text-mono uppercase tracking-[0.12em] text-fg-faint">
                              {practiceShort[a.practice] ?? a.practice} · {statusLabel[a.decision] ?? a.decision}
                            </span>{' '}
                            {a.note}
                            <span class="ml-1 text-fg-faint">({a.date})</span>
                          </p>
                        ))}
                      </div>
                    </details>
                  )}
                </div>
              )
            })()}
          </li>
        ))}
      </ul>
    )}
    </div>
  </section>

  {/* ── Gate-Transparenz (Spec §4, §7) ─────────────────────────────────── */}
  <section class="mb-4 mt-14" aria-labelledby="saat-gate-h">
    <h2 id="saat-gate-h" class={kicker}>{txt.gateHeading}</h2>
    <p class="mt-3 max-w-[68ch] text-body text-fg-muted">{txt.gateIntro}</p>
    <p class="mt-4 font-mono text-mono uppercase tracking-[0.14em] text-fg-faint">{txt.gatePromptLabel}</p>
    <pre class={cn(panel, 'mt-2 overflow-x-auto whitespace-pre-wrap p-4 text-small leading-relaxed text-fg-muted')}>{GATE_PROMPT}</pre>
    <p class="mt-4 text-body text-fg-muted">{txt.turnstileNote}</p>
    <p class="mt-2 text-body text-fg-muted">{txt.chainNote}</p>
    <p class="mt-4 font-mono text-mono text-fg-faint">
      {gateStatsTotal === 0 ? txt.gateStatsEmpty : txt.gateStatsLabel(gateStatsTotal)}
      {gateStatsTotal > 0 && gateStatsByReason.length > 0 && (
        <span> {gateStatsByReason.map(([reason, n]) => `${gateReasonLabel[reason] ?? reason}: ${n}`).join(' · ')}</span>
      )}
    </p>
  </section>
</main>

<script type="application/json" id="saat-data" set:html={payload} />

{hasTurnstile && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  // Öffentliche Saat — Formular-Logik: Standby → Probe → Formular → Einreichen, plus die
  // clientseitige Status-Abfrage per Claim-Token. Läuft nur mit dem, was der Server (functions/
  // api/saat.js) tatsächlich zurückgibt; ohne JS bleibt der Standby stehen (progressive
  // enhancement, wie das Cockpit-Ventil).
  import { hashToken } from '@/lib/saat/saat'

  // Prefill the addressee from ?to=<collective> — contextual links from the practice pages
  // (/field → field-research, /studio → studio, /atelier → ulysses). Runtime-only, hence client-side.
  {
    const to = new URLSearchParams(location.search).get('to')
    if (to) {
      const sel = document.getElementById('saat-addressee')
      if (sel instanceof HTMLSelectElement && Array.from(sel.options).some((o) => o.value === to)) {
        sel.value = to
      }
    }
  }

  interface SaatPayload {
    hasTurnstile: boolean
    addressees: string[]
    errors: Record<string, string>
    gateReasons: Record<string, string>
    kindLabels: Record<string, string>
    addresseeLabels: Record<string, string>
    statusLabels: Record<string, string>
    sending: string
    readyToday: string
    readyOpen: string
    statusChecking: string
    statusNotFound: string
    statusFetchError: string
    responseNoteLabel: string
    /** Kurznamen der Praxen für die Antwortmarken. */
    practiceShort: Record<string, string>
    oneReply: string
    manyReplies: string
    stillOpen: string
    registerEmpty: string
    copyLabel: string
    copiedLabel: string
  }

  const dataEl = document.getElementById('saat-data')
  const DATA: SaatPayload = dataEl?.textContent
    ? JSON.parse(dataEl.textContent)
    : {
        hasTurnstile: false,
        addressees: [],
        errors: {},
        gateReasons: {},
        kindLabels: {},
        addresseeLabels: {},
        statusLabels: {},
        sending: '…',
        readyToday: '',
        readyOpen: '',
        statusChecking: '…',
        statusNotFound: '',
        statusFetchError: '',
        responseNoteLabel: '',
        registerEmpty: '',
        copyLabel: 'copy',
        copiedLabel: 'copied',
      }

  // ── Adressat aus ?an=<addressee> vorwählen (CTAs von /field, /studio, /atelier, dem Hub) ──
  const addresseeSelect = document.querySelector<HTMLSelectElement>('[data-saat="addressee"]')
  const an = new URLSearchParams(location.search).get('an')
  if (addresseeSelect && an && DATA.addressees.includes(an)) addresseeSelect.value = an

  // ── Live-Zeichenzähler ────────────────────────────────────────────────
  const textArea = document.querySelector<HTMLTextAreaElement>('[data-saat="text"]')
  const counter = document.querySelector<HTMLElement>('[data-saat="counter"]')
  const maxLen = textArea?.maxLength && textArea.maxLength > 0 ? textArea.maxLength : 500
  const updateCounter = (): void => {
    if (textArea && counter) counter.textContent = `${textArea.value.length}/${maxLen}`
  }
  textArea?.addEventListener('input', updateCounter)
  updateCounter()

  // ── Standby → Probe → Formular ────────────────────────────────────────
  const standby = document.querySelector<HTMLElement>('[data-saat="standby"]')
  const form = document.querySelector<HTMLFormElement>('[data-saat="form"]')
  const doneEl = document.querySelector<HTMLElement>('[data-saat="done"]')
  const msgEl = document.querySelector<HTMLElement>('[data-saat="msg"]')
  const readyInfo = document.querySelector<HTMLElement>('[data-saat="ready-info"]')
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-saat="submit"]')

  if (form && standby && DATA.hasTurnstile) {
    fetch('/api/seed', { headers: { accept: 'application/json' } })
      .then((r) => (r.ok ? r.json() : { ready: false }))
      .then((probe: { ready?: boolean; daily_used?: number; daily_cap?: number; pending?: number; cap?: number }) => {
        if (!probe.ready) return // Standby bleibt stehen — ehrlich, kein totes Formular
        standby.hidden = true
        form.hidden = false
        if (readyInfo) {
          const parts: string[] = []
          if (typeof probe.daily_used === 'number' && typeof probe.daily_cap === 'number') {
            parts.push(
              DATA.readyToday
                .replace('{remaining}', String(Math.max(0, probe.daily_cap - probe.daily_used)))
                .replace('{cap}', String(probe.daily_cap)),
            )
          }
          if (typeof probe.pending === 'number' && typeof probe.cap === 'number') {
            parts.push(DATA.readyOpen.replace('{pending}', String(probe.pending)).replace('{cap}', String(probe.cap)))
          }
          readyInfo.textContent = parts.join(' · ')
        }
      })
      .catch(() => {}) // kein Netz/keine Function (lokale Preview, oder noch nicht deployed) → Standby

    form.addEventListener('submit', async (ev) => {
      ev.preventDefault()
      if (!submitBtn || submitBtn.disabled) return
      const fd = new FormData(form)
      submitBtn.disabled = true
      const label = submitBtn.textContent
      submitBtn.textContent = DATA.sending
      if (msgEl) msgEl.textContent = ''
      try {
        const res = await fetch('/api/seed', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            kind: fd.get('kind'),
            text: fd.get('text'),
            authorMark: fd.get('authorMark'),
            addressedTo: fd.get('addressedTo'),
            consent: fd.get('consent') === 'on',
            website: fd.get('website'),
            // Turnstile injiziert dieses Feld selbst ins Formular, sobald der Widget-Token da ist.
            turnstileToken: fd.get('cf-turnstile-response'),
          }),
        })
        const body = (await res.json()) as { ok?: boolean; reason?: string; code?: string; id?: string; claim_token?: string }
        if (body.ok) {
          // Honeypot-Treffer antworten { ok:true } ohne claim_token (functions/api/seed.js) —
          // dann bleibt die Token-Zeile leer; das betrifft nie einen echten Absender.
          const token = body.claim_token ?? ''
          form.hidden = true
          if (doneEl) {
            doneEl.hidden = false
            const tokenEl = doneEl.querySelector<HTMLElement>('[data-saat="token"]')
            if (tokenEl) tokenEl.textContent = token
          }
        } else if (msgEl) {
          // `reason` ist der primäre Diskriminator; nur bei reason === 'gate' trägt `code` den
          // GateReason (spam/abuse/… — s. Kopf-Kommentar, Vertrag mit functions/api/seed.js).
          const reason = body.reason ?? 'generic'
          if (reason === 'gate') {
            const reasonLabel = DATA.gateReasons[body.code ?? 'other']
            msgEl.textContent = reasonLabel ? `${DATA.errors.gate} (${reasonLabel})` : DATA.errors.gate
          } else {
            msgEl.textContent = DATA.errors[reason] ?? DATA.errors.generic
          }
        }
      } catch {
        if (msgEl) msgEl.textContent = DATA.errors.generic
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = label
      }
    })
  }

  // ── Copy-Button für den Claim-Token ────────────────────────────────────
  const copyBtn = document.querySelector<HTMLButtonElement>('[data-saat="copy"]')
  copyBtn?.addEventListener('click', async () => {
    const tokenEl = document.querySelector<HTMLElement>('[data-saat="token"]')
    const value = tokenEl?.textContent ?? ''
    if (!value) return
    try {
      await navigator.clipboard.writeText(value)
      const original = copyBtn.textContent
      copyBtn.textContent = DATA.copiedLabel
      setTimeout(() => {
        copyBtn.textContent = original
      }, 2000)
    } catch {
      // Clipboard-API kann in unsicheren Kontexten fehlen — der Token bleibt sichtbar zum Abschreiben.
    }
  })

  // ── Status-Abfrage: Token lokal hashen, gegen frisches Register matchen ──
  interface RegisterSeed {
    claim_token_hash: string
    status: string
    kind: string
    addressed_to: string
    response: { practice: string; decision: string; note: string; date: string } | null
    responses?: { practice: string; decision: string; note: string; date: string }[]
    forwarded_to?: string[]
  }
  const REGISTER_URL = 'https://raw.githubusercontent.com/frankbueltge/frankbueltge.de/main/src/data/saat/register.json'
  const statusForm = document.querySelector<HTMLFormElement>('[data-saat="status-form"]')
  const statusResult = document.querySelector<HTMLElement>('[data-saat="status-result"]')

  statusForm?.addEventListener('submit', async (ev) => {
    ev.preventDefault()
    const input = statusForm.querySelector<HTMLInputElement>('input[name="token"]')
    const token = input?.value.trim()
    if (!token || !statusResult) return
    statusResult.textContent = DATA.statusChecking
    try {
      const hash = await hashToken(token)
      const res = await fetch(REGISTER_URL, { cache: 'no-store' })
      if (!res.ok) throw new Error('fetch failed')
      const reg = (await res.json()) as { seeds: RegisterSeed[] }
      const seed = reg.seeds.find((s) => s.claim_token_hash === hash)
      if (!seed) {
        statusResult.textContent = DATA.statusNotFound
        return
      }
      const label = DATA.statusLabels[seed.status] ?? seed.status
      let text = `${DATA.kindLabels[seed.kind] ?? seed.kind} → ${DATA.addresseeLabels[seed.addressed_to] ?? seed.addressed_to} · ${label}`
      if (seed.response) {
        text += ` — ${DATA.responseNoteLabel} ${seed.response.note} (${seed.response.practice}, ${seed.response.date})`
      }
      statusResult.textContent = text
    } catch {
      statusResult.textContent = DATA.statusFetchError
    }
  })

  // Register-Liste stets aktuell: aus dem Live-register.json (dieselbe Quelle wie die
  // Token-Abfrage) neu rendern, sobald JS lädt — ein frisch freigegebener Seed erscheint so
  // sofort, ohne Rebuild und unabhängig vom HTML-Cache. Die SSR-Liste bleibt Fallback.
  const registerBody = document.querySelector<HTMLElement>('[data-saat="register-body"]')
  if (registerBody) {
    const esc = (s: unknown) =>
      String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] ?? c))
    fetch(REGISTER_URL, { cache: 'no-store' })
      .then((r) => (r.ok ? r.json() : null))
      .then(
        (reg: {
          seeds?: Array<{
            ts: string
            text: string
            author_mark: string
            kind: string
            addressed_to: string
            status: string
            response: { practice: string; decision: string; note: string; date: string } | null
    responses?: { practice: string; decision: string; note: string; date: string }[]
    forwarded_to?: string[]
          }>
        } | null) => {
          if (!reg || !Array.isArray(reg.seeds)) return
          const seeds = [...reg.seeds].sort((a, b) => String(b.ts).localeCompare(String(a.ts)))
          if (seeds.length === 0) {
            registerBody.innerHTML = `<p class="mt-6 text-small text-fg-faint">${esc(DATA.registerEmpty)}</p>`
            return
          }
          const items = seeds
            .map((s) => {
              // Spiegelt den serverseitigen Block oben: Marken je Praxis, Wortlaut im
              // Akkordeon, und die noch nicht Beantwortenden gestrichelt daneben. Zwei
              // Renderpfade für dieselbe Sache sind eine Dublette — sie stehen hier
              // trotzdem getrennt, weil dieser Pfad frisch von raw.githubusercontent.com
              // liest (Claim-Token-Abfrage) und keinen Astro-Build kennt. Wer den einen
              // ändert, muss den anderen mitziehen.
              const antworten = s.responses?.length ? s.responses : s.response ? [s.response] : []
              const beantwortet = new Set(antworten.map((a) => a.practice))
              const offen = (s.forwarded_to ?? []).filter((p) => !beantwortet.has(p))
              const marke = (inhalt: string, gestrichelt: boolean) =>
                `<li class="rounded-sm border ${gestrichelt ? 'border-dashed border-line text-fg-faint' : 'border-line text-fg-muted'} px-2 py-0.5 font-mono text-mono-sm">${inhalt}</li>`
              const marken = antworten.length || offen.length
                ? `<ul class="flex flex-wrap gap-x-2 gap-y-1">${
                    antworten.map((a) => marke(`${esc(DATA.practiceShort[a.practice] ?? a.practice)} <span class="text-fg">${esc(DATA.statusLabels[a.decision] ?? a.decision)}</span>`, false)).join('')
                  }${
                    offen.map((p) => marke(`${esc(DATA.practiceShort[p] ?? p)} <span>${esc(DATA.stillOpen)}</span>`, true)).join('')
                  }</ul>`
                : ''
              const wortlaut = antworten.length
                ? `<details class="mt-2"><summary class="cursor-pointer font-mono text-mono-sm uppercase tracking-[0.12em] text-fg-faint hover:text-fg"><span class="fold-chevron inline-block">\u25BE</span> ${
                    esc(antworten.length === 1 ? DATA.oneReply : DATA.manyReplies.replace('{n}', String(antworten.length)))
                  }</summary><div class="mt-2 space-y-3">${
                    antworten.map((a) => `<p class="text-small leading-relaxed text-fg-muted"><span class="font-mono text-mono uppercase tracking-[0.12em] text-fg-faint">${esc(DATA.practiceShort[a.practice] ?? a.practice)} · ${esc(DATA.statusLabels[a.decision] ?? a.decision)}</span> ${esc(a.note)} <span class="ml-1 text-fg-faint">(${esc(a.date)})</span></p>`).join('')
                  }</div></details>`
                : ''
              const resp = marken || wortlaut
                ? `<div class="mt-3 border-t border-line/60 pt-3">${marken}${wortlaut}</div>`
                : ''
              return `<li class="p-4 sm:p-5"><div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-mono-sm uppercase tracking-[0.12em] text-fg-faint"><span>${esc(String(s.ts).slice(0, 10))}</span><span aria-hidden="true">·</span><span>${esc(DATA.kindLabels[s.kind] ?? s.kind)}</span><span aria-hidden="true">·</span><span>${esc(DATA.addresseeLabels[s.addressed_to] ?? s.addressed_to)}</span><span aria-hidden="true">·</span><span class="rounded-sm border border-line px-2 py-0.5 font-mono text-mono-sm normal-case tracking-normal text-fg-muted">${esc(DATA.statusLabels[s.status] ?? s.status)}</span></div><p class="mt-2 whitespace-pre-line text-body leading-relaxed text-fg">${esc(s.text)}</p><p class="mt-2 font-mono text-mono text-fg-faint">— ${esc(s.author_mark)}</p>${resp}</li>`
            })
            .join('')
          registerBody.innerHTML = `<ul class="mt-6 divide-y divide-line/60 overflow-hidden rounded-md border border-line bg-panel panel-raised">${items}</ul>`
        },
      )
      .catch(() => {})
  }
</script>

<style>
  .saat-hp {
    position: absolute !important;
    left: -9999px !important;
    height: 1px;
    width: 1px;
    opacity: 0;
  }
</style>

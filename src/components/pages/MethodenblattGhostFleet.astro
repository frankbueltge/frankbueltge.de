---
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/lib/site'
import MethodSheet from '@/components/experiments/MethodSheet.astro'
import RetiredNotice from '@/components/experiments/RetiredNotice.astro'

interface Props { locale: Locale }
const { locale } = Astro.props
const de = locale === 'de'
const workUrl = getRelativeLocaleUrl(locale, '/ghost-fleet')

const txt = {
  h1: de ? 'Methodenblatt — Ghost Fleet' : 'Method sheet — Ghost Fleet',
  revealHead: de ? 'Worum es geht' : 'What this is',
  reveal: de
    ? 'Das AIS-Bild der Meere wirkt lückenlos. Es ist es nicht — Schiffe schalten ihren Transponder bewusst ab, um zu verschwinden. Dieses Instrument zählt die absichtliche Funkstille und hebt den markantesten Fall des Tages hervor: eine benannte AIS-Kennung — meist ein Schiff, mitunter eine Fischereigerät-Kennung ohne Flaggenstaat —, die tage- bis wochenlang in einer fremden Wirtschaftszone (EEZ) oder auf hoher See dunkel wurde und andernorts wieder auftauchte.'
    : 'The AIS picture of the seas looks complete. It is not — ships switch off their transponder on purpose to vanish. This instrument counts the deliberate radio silence and surfaces the day\'s most striking case: a named AIS identity — usually a vessel, sometimes an unflagged fishing-gear tag — that went dark for days or weeks inside a foreign EEZ (or on the high seas) and resurfaced elsewhere.',
  s1: de ? '1. Quellen & Lizenzen' : '1. Sources & licences',
  s1body: de
    ? 'Global Fishing Watch, Events-API (AIS-„gap"-/Disabling-Events), Bearer-Token, nicht-kommerziell mit Attributionspflicht. GFW liefert nur hoch-konfidente, als absichtlich eingestufte Abschaltungen: ≥ 12 h, ≥ 50 sm vor der Küste, gute Satellitenabdeckung. Jeder Fall verlinkt das GFW-Vessel.'
    : 'Global Fishing Watch, Events API (AIS „gap"/disabling events), Bearer token, non-commercial with attribution. GFW returns only high-confidence, intentional-classified disabling: ≥ 12 h, ≥ 50 nm offshore, good satellite coverage. Every case links the GFW vessel.',
  s2: de ? '2. Kadenz' : '2. Cadence',
  s2body: de
    ? 'Täglich, bis zur Stilllegung am 2026-10-17. Fenster: Abschaltungen, die in den letzten 7 Tagen endeten (vollständige Verschwinde-und-Rückkehr-Geschichten). Kanonisches Artefakt: versionierte JSON in src/data/ghost-fleet/ — Git ist das Archiv.'
    : 'Daily, until it was retired on 2026-10-17. Window: disabling events that ended in the last 7 days (complete vanish-and-return stories). Canonical artefact: versioned JSON in src/data/ghost-fleet/ — git is the archive.',
  s3: de ? '3. Verarbeitung' : '3. Processing',
  s3body: de
    ? 'GFW-Events abrufen (paginiert, gekappt) → normalisieren → filtern (Ende im Fenster, plausible Dauer) → Index (wie viele, wie viele in nationalen EEZ / auf hoher See / in Schutzgebieten, Summe Dunkel-Stunden) → Fall des Tages nach Region-Brisanz, dann Dauer. Index zählt alle geprüften Abschaltungen, nicht Schiffe; der Fall und die Liste zeigen benannte AIS-Kennungen — Schiffe wie Fischereigerät-Kennungen.'
    : 'Fetch GFW events (paginated, capped) → normalise → filter (ended in window, plausible duration) → index (how many, how many in national EEZs / on the high seas / in protected areas, total dark-hours) → case of the day by region brisance, then duration. The index counts all examined shutdowns, not vessels; the case and list show named AIS identities — vessels and fishing-gear tags alike.',
  aiHead: de ? 'KI/ML — offengelegt' : 'AI/ML — disclosed',
  aiBody: de
    ? 'Die Einstufung „absichtlich" stammt aus GFWs Machine-Learning-Modell und ist eine Wahrscheinlichkeit, kein Beweis (GFW sagt „likely"). Wir geben das offen weiter und erheben keinen Vorwurf. Unsere eigene Verarbeitung ist rein symbolisch (Filter, Region-Gewicht, Aggregate), kein LLM.'
    : 'The „intentional" label comes from GFW\'s machine-learning model and is a probability, not proof (GFW says „likely"). We pass that on openly and make no accusation. Our own processing is purely symbolic (filters, region weight, aggregates), no LLM.',
  s4: de ? '4. Grenzen der Methode' : '4. Limits of the method',
  s4items: de
    ? [
        '„Absichtlich" ist ML-geschätzt, nicht bewiesen; Abschalten kann legitime Gründe haben (z. B. Piraterie-Zonen). Kein Illegalitäts-Vorwurf gegen Schiff oder Staat.',
        'Nur offshore (≥ 50 sm) und gut beobachtet: küstennahe Abschaltungen fehlen; gemessen wird das offene Meer. Meeresschutzgebiete und hohe See erscheinen nie — nicht, weil dort niemand abschaltet, sondern weil die Quelle diese Felder für Abschalt-Ereignisse leer lässt (geprüft an einer echten Antwort am 2026-10-17).',
        'Nur AIS: Schiffe, die nie senden („dark by default"), erscheinen gar nicht.',
        'Die Region-Zuordnung ist nicht die der Verschwinde-Position, wie diese Zeile bis 2026-10-17 behauptete, sondern die des Mittelpunkts auf dem Großkreis zwischen Verschwinde- und Wiederauftauch-Position — ein Punkt, den das Schiff nicht passiert haben muss. Eine EEZ ist eine ausschließliche Wirtschaftszone, keine Hoheitsgewässer. GFWs EEZ-Kennziffern sind Marine-Regions-MRGIDs und werden seit 2026-06-26 über eine committete Nachschlagetabelle zu Namen aufgelöst; eine Kennziffer ohne Tabelleneintrag bliebe namenlos.',
        'Cluster spiegeln auch die Satellitenabdeckung, nicht nur das Verhalten.',
      ]
    : [
        '„Intentional" is ML-estimated, not proof; disabling can have legitimate reasons (e.g. piracy zones). No claim of illegality against vessel or state.',
        'Only offshore (≥ 50 nm) and well-observed: nearshore disabling is missing; what is measured is the open sea. Marine protected areas and the high seas never appear — not because nobody goes dark there, but because the source leaves those fields empty for gap events (checked against a live response on 2026-10-17).',
        'AIS only: vessels that never transmit („dark by default") do not appear at all.',
        'Region attribution is not that of the vanishing position, as this line said until 2026-10-17, but that of the great-circle midpoint between where the transponder went off and where it came back on — a point the vessel need not have passed. An EEZ is an exclusive economic zone, not territorial waters. GFW\'s EEZ ids are Marine Regions MRGIDs and have been resolved to names since 2026-06-26 via a committed lookup; an id absent from that lookup would stay unnamed.',
        'Clusters reflect satellite coverage too, not only behaviour.',
      ],
  s5: de ? '5. Compute-Fußabdruck' : '5. Compute footprint',
  s5body: de
    ? 'Wenige paginierte API-Abrufe pro Tag mit Token, kein LLM. Die Site ist statisch.'
    : 'A few paginated API fetches per day with a token, no LLM. The site is static.',
  s6: de ? '6. Änderungsprotokoll' : '6. Change log',
  s6items: de
    ? [
        'v1 (2026-06) — Erstfassung: GFW-gap-Events, Fenster 7 Tage, Index + Fall des Tages, EEZ/Hohe-See-Fokus, Schutzgebiet als Sonderfall-Marker.',
        'v1.1 (2026-06-26) — EEZ-Kennziffern werden über eine committete Marine-Regions-Tabelle zu Namen aufgelöst; die Grenze „nur Kennziffern" ist damit erledigt.',
        'Stillgelegt (2026-10-17) — die Quelle füllt hohe See und Schutzgebiete für Abschalt-Ereignisse nie, die Zone gilt dem Mittelpunkt der Lücke; der nächtliche Workflow ist entfernt, das Archiv bleibt.',
      ]
    : [
        'v1 (2026-06) — first edition: GFW gap events, 7-day window, index + case of the day, EEZ/high-seas focus, protected area as a special-case marker.',
        'v1.1 (2026-06-26) — EEZ ids resolved to names via a committed Marine Regions lookup; the „numeric ids only" limit is retired.',
        'Retired (2026-10-17) — the source never fills the high-seas and protected-area fields for gap events, and the zone it names belongs to the gap\'s midpoint; the nightly workflow is removed, the archive stays.',
      ],
  toWork: de ? 'Zum Experiment' : 'To the experiment',
}
---

<MethodSheet title={txt.h1} workHref={workUrl} workLabel={txt.toWork}>

  <RetiredNotice id="ghost-fleet" lastReading={false} />

  <section class="sheet-reveal mb-10">
    <h2 class="kicker mb-2">{txt.revealHead}</h2>
    <p class="leading-relaxed">{txt.reveal}</p>
  </section>

  <section class="mb-8"><h2 class="mb-2 font-semibold">{txt.s1}</h2><p class="leading-relaxed text-fg-muted">{txt.s1body}</p></section>
  <section class="mb-8"><h2 class="mb-2 font-semibold">{txt.s2}</h2><p class="leading-relaxed text-fg-muted">{txt.s2body}</p></section>

  <section class="mb-8">
    <h2 class="mb-2 font-semibold">{txt.s3}</h2>
    <p class="leading-relaxed text-fg-muted">{txt.s3body}</p>
    <p class="mt-2">
      <a href="https://github.com/frankbueltge/frankbueltge.de/tree/main/pipelines/ghost-fleet"
        class="sheet-link" rel="noopener">→ pipelines/ghost-fleet</a>
    </p>
  </section>

  <section class="mb-8 border-l-2 border-line pl-4">
    <h2 class="mb-2 font-semibold">{txt.aiHead}</h2>
    <p class="leading-relaxed text-fg-muted">{txt.aiBody}</p>
  </section>

  <section class="mb-8">
    <h2 class="mb-2 font-semibold">{txt.s4}</h2>
    <ul class="list-disc space-y-1 pl-5 text-fg-muted">{txt.s4items.map((i) => <li>{i}</li>)}</ul>
  </section>

  <section class="mb-8"><h2 class="mb-2 font-semibold">{txt.s5}</h2><p class="leading-relaxed text-fg-muted">{txt.s5body}</p></section>

  <section class="mb-8">
    <h2 class="mb-2 font-semibold">{txt.s6}</h2>
    <ul class="list-disc space-y-1 pl-5 text-fg-muted">{txt.s6items.map((i) => <li>{i}</li>)}</ul>
  </section>

</MethodSheet>

---
// /datasets/[id] — eine Register-Einzelseite. Zeigt genau die Felder, die der Snapshot
// für diesen Eintrag führt; kein Feld wird geraten oder ergänzt (Kanon-Regel).
//
// Zwei Datenquellen mit verschiedenem Zweck: eintraege.json ist der schlanke Index, der
// auch im Browser landet (Suche/Filter); details.json trägt Beschreibung, Urheber, Lizenz-
// Wortlaut und Räumlichkeit und wird NUR hier beim Bauen gelesen — es erreicht den Browser
// nie und darf deshalb groß sein. schema.org/Dataset wertet genau diese Felder aus.
import details from '@/data/datasets/details.json'
import { SITE } from '@/lib/site'
import {
  accessLabel,
  licenceLabel,
  isAccessibleForFree,
  suggestedCitation,
  type DatasetEntry,
} from '@/lib/datasets'

interface Props {
  entry: DatasetEntry
}
const { entry } = Astro.props
const canonical = `${SITE.url}/datasets/${entry.i}`

interface EntryDetail {
  zugang_url?: string
  quell_id?: string
  beschreibung?: string
  urheber?: { name: string; orcid?: string }[]
  lizenz_roh?: Record<string, unknown>[]
  raeumlichkeit?: unknown[]
}
const detail = ((details as Record<string, EntryDetail>)[entry.i] ?? {}) as EntryDetail
const creators = detail.urheber ?? []
// Zugriffsweg und Quell-ID stehen in details.json statt im Suchindex — sie werden nur
// hier gebraucht und würden den Browser-Download sonst unnötig vergrößern.
const zugangUrl = detail.zugang_url ?? ''
const quellId = detail.quell_id ?? ''

// JSON-LD: nur Felder, die der Eintrag tatsächlich führt. "url" zeigt auf die wörtliche
// Zugriffs-URL der Quelle (das Dataset selbst), nicht auf diese Seite — die Seite ist
// über @id/mainEntityOfPage referenziert.
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  '@id': `${canonical}#dataset`,
  mainEntityOfPage: canonical,
  name: entry.t,
  url: zugangUrl,
  identifier: { '@type': 'PropertyValue', propertyID: entry.q, value: quellId },
}
if (entry.l) jsonLd.license = entry.l
if (entry.h) jsonLd.publisher = { '@type': 'Organization', name: entry.h }
const free = isAccessibleForFree(entry.v)
if (free !== undefined) jsonLd.isAccessibleForFree = free
// Beschreibung und Urheber stammen wörtlich aus der Quelle. Fehlen sie dort, fehlen sie
// auch hier — nichts wird aus dem Titel abgeleitet oder generiert.
if (detail.beschreibung) jsonLd.description = detail.beschreibung
if (creators.length) {
  jsonLd.creator = creators.map((c) =>
    c.orcid
      ? { '@type': 'Person', name: c.name, identifier: c.orcid }
      : { '@type': 'Person', name: c.name },
  )
}
if (entry.j) jsonLd.datePublished = String(entry.j)
---

<main id="main" class="mx-auto w-full max-w-2xl flex-1 px-6 py-16 sm:py-24">
  <p class="font-mono text-xs uppercase tracking-[0.18em] text-fg-faint">
    <a href="/datasets" class="hover:text-fg">Dataset Register</a> / entry
  </p>
  <h1 class="mt-4 text-[clamp(24px,4vw,38px)] font-bold leading-tight tracking-[-0.02em]">{entry.t}</h1>

  {entry.z === 'ungeprueft' && (
    <p class="mt-4 inline-block rounded-lg border border-line bg-panel px-3 py-1.5 text-xs text-fg-muted">
      entry unverified — automatically admitted from its source, not yet human-reviewed
    </p>
  )}

  {detail.beschreibung && (
    <p class="mt-6 whitespace-pre-line text-[15px] leading-relaxed text-fg-muted">
      {detail.beschreibung}
    </p>
  )}

  <dl class="mt-8 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2.5 text-sm">
    <dt class="text-fg-faint">Creators</dt>
    <dd class="text-fg">
      {creators.length ? creators.map((c) => c.name).join(' · ') : 'not stated'}
    </dd>

    <dt class="text-fg-faint">Publisher</dt>
    <dd class="text-fg">{entry.h || 'not stated'}</dd>

    <dt class="text-fg-faint">Year</dt>
    <dd class="text-fg">{entry.j ?? 'not stated'}</dd>

    <dt class="text-fg-faint">Granularity</dt>
    <dd class="text-fg">{entry.g}</dd>

    <dt class="text-fg-faint">Licence</dt>
    <dd class="text-fg">{licenceLabel(entry.l)}</dd>

    <dt class="text-fg-faint">Access</dt>
    <dd class="text-fg">{accessLabel(entry.v, entry.s)}</dd>

    <dt class="text-fg-faint">Source</dt>
    <dd class="text-fg">{entry.q}</dd>

    <dt class="text-fg-faint">Source ID</dt>
    <dd class="break-all font-mono text-xs text-fg">{quellId}</dd>
  </dl>

  <p class="mt-8">
    <a
      href={zugangUrl}
      rel="noopener noreferrer"
      target="_blank"
      class="break-all text-fg underline decoration-line underline-offset-4 hover:decoration-fg"
    >
      {zugangUrl} ↗
    </a>
  </p>
  <p class="mt-1.5 text-xs text-fg-faint">
    The access route above is copied verbatim from the source — never constructed or guessed.
  </p>

  <section class="mt-10 border-t border-line pt-6">
    <h2 class="font-mono text-xs uppercase tracking-[0.18em] text-fg-faint">Suggested citation</h2>
    <p class="mt-2 text-sm leading-relaxed text-fg-muted">{suggestedCitation(entry, zugangUrl)}</p>
    <p class="mt-1.5 text-xs text-fg-faint">
      Assembled from this entry's own fields — not a publisher-issued citation string.
    </p>
  </section>

  <p class="mt-10 text-xs text-fg-faint"><a href="/datasets" class="hover:text-fg">← back to the Dataset Register</a></p>
</main>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

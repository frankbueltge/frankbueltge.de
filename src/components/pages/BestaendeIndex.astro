---
// Ökologie-Neustrukturierung (Phase 3e, Branch ecology-restructure): "/experiments" widmet die
// bisherigen Experimente (src/data/werke.ts, ohne die drei Engines) zu "Bestände des Labors —
// Material, der Ökologie angeboten" um (docs/design/site-restructure-concept.md §2). Jede
// bestehende Route bleibt unverändert erreichbar; hier ändert sich nur die Rahmung, keine
// Experiment-Seite wird verändert oder gelöscht.
//
// 2026-08-22 — the shelf gets categories, and two neighbours (Frank):
//   · the sixteen entries are grouped by RESEARCH LINE (src/data/werke.ts: EXPERIMENT_LINES,
//     WERKE_BY_LINE). Chosen over a by-subject and a by-rank cut because this one is the works'
//     own claim: nine of them already said "from the counter-measurement line" in their own
//     description while the page showed no line at all. Recency order (2026-08-14) survives
//     inside each group because the grouping is derived from WERKE_HOLDINGS.
//   · below them, the two machine practices that are NOT part of the research ecology and were
//     reachable only through ecology surfaces until now: the Atelier's nightly line and n-1.
//     They are listed APART and never among the experiments — neither is a piece of the lab,
//     and the USP gate (graph.test.ts) rightly demands an audit verdict from every experiment
//     on this shelf, which a practice does not have.
//
// 2026-08-22, second pass — a page a visitor can survey (Frank: a menu or a filter, and less
// endless scrolling): every row collapses to one line, and a sticky filter bar over three axes —
// line, kind, data — in the /papers idiom. Without JavaScript the complete list simply stands.
//
// 2026-09-02 — THE SHELF BECOMES A GALLERY (visual layer, Phase 3c; Frank's decision, wording
// private). What was a list of lines is a grid of cards, and every card carries a MINIATURE OF
// ITS OWN INSTRUMENT: the same committed file the experiment's page draws from, through the same
// pure builder, in a 240×72 box (src/lib/experiments/thumbnails.ts). Three things did NOT change
// and were kept deliberately:
//   · the three axes, their counts, their words and their failure state (with no JavaScript the
//     whole shelf stands and the buttons are inert) — the filter simply moved INTO the island,
//     because the count line, the section counts, the empty state and the animated reflow are
//     one piece of state, and a script outside would fight React for the same `hidden`;
//   · every card's link, its stamps and its full description in a native <details>;
//   · the sections, their kickers and their blurbs, read from the register as before.
// What the practices beside the lab get is NOT a decorative stand-in but the shape of their own
// record: one tick per dated entry their mirror holds.
import { getRelativeLocaleUrl } from 'astro:i18n'
import type { Locale } from '@/lib/site'
import { WERKE_BY_LINE, werkTitle } from '@/data/werke'
import { BESIDE_GROUP, KIND_LABEL, kindOf, shelfFacets, type ShelfCard, type ShelfKind } from '@/lib/experiments/shelf'
import { datedEntries, recordThumbnail, THUMBNAILS, THUMB_BOX } from '@/lib/experiments/thumbnails'
import { GALLERY } from '@/config/gallery-wording'
import { NAMING } from '@/config/naming'
import { readN1Facts } from '@/lib/ecology/n1-line'
import { readArchFacts } from '@/lib/arch/facts'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'
import SheetHead from '@/components/experiments/SheetHead.astro'
import ExperimentGallery, { type GalleryCard, type GallerySection } from '@/components/experiments/ExperimentGallery'
import Readout from '@/components/dataviz/Readout.astro'
import '@/styles/experiment-sheet.css'
import '@/styles/experiment-gallery.css'

const locale = (Astro.currentLocale ?? 'en') as Locale
// Back to "Experiments" (Frank, 2026-07-31): the 2026-07 redesignation to "Holdings" traded a
// word everyone understands for house vocabulary. The route /experiments is unchanged — links,
// redirects and OG paths keep working; only the visible name goes back to the plain one.
// "earlier work" dropped from the sub (Frank, 2026-08-08): this shelf now also lists the
// RUNNING second experiment (The State Before the Interface) on Frank's explicit call —
// "offered to the ecology as material" would be wrong for a piece built deliberately
// outside the ecology, so the sentence names only what holds for every entry.
const copy = {
  de: {
    title: 'Experimente',
    sub: 'Die Experimente des Labors — laufende Instrumente, jedes mit offenen Quellen und offengelegtem Verfahren. Nach Forschungslinie geordnet, innerhalb jeder das Neueste zuerst.',
  },
  en: {
    title: 'Experiments',
    sub: "The lab's experiments — ongoing instruments, each with open sources and a disclosed method. Grouped by research line, newest first inside each.",
  },
}[locale]

// The nightly line reads its title, sentence and route from the homepage's own card
// (NAMING.overview.items) rather than restating them — the read-never-restate arrangement the
// ops-room board uses, so a reworded card moves this section with it.
const nightly = NAMING.overview.items.find((i) => i.id === 'nightly-line')
if (!nightly?.href) throw new Error('/experiments: NAMING.overview.items has no "nightly-line" card to read')

// n-1 states its own facts in its own mirrored record: the working title it declares, the day
// its Dowry says it was founded, and — since 2026-08-21 — the name the practice took for
// itself. Read, never typed: the day the practice renames itself, this row follows.
const n1 = readN1Facts()

// Arch (2026-08-23) reads the same way: its sentence from its own homepage card, its founding
// date and its window from its mirrored dowry and pre-registration — never typed here.
const archCard = NAMING.overview.items.find((i) => i.id === 'arch')
if (!archCard?.href || !archCard.line) throw new Error('/experiments: NAMING.overview.items has no "arch" card to read')
const arch = readArchFacts()

const url = (href: string) => getRelativeLocaleUrl(locale, href)

const sections: GallerySection[] = [
  ...WERKE_BY_LINE.map((group) => ({
    id: group.line.id,
    label: group.line.label,
    blurb: group.line.blurb[locale],
    cards: group.werke.map((werk): GalleryCard => {
      const kind = kindOf(werk)
      return {
        id: werk.id,
        group: group.line.id,
        kind,
        // the default kind stays unsaid: a badge reading "experiment" on a shelf of experiments
        kindLabel: kind === 'experiment' ? null : KIND_LABEL[kind],
        live: Boolean(werk.live),
        title: werkTitle(werk, locale),
        subtitle: werk.subtitle[locale],
        description: werk.description[locale],
        href: url(werk.href),
        methodHref: werk.methodHref ? url(werk.methodHref) : null,
        stamp: werk.since,
        thumb: THUMBNAILS.get(werk.id) ?? null,
      }
    }),
  })),
  {
    id: BESIDE_GROUP,
    label: 'BESIDE THE LAB',
    // States what holds, not what changed: the "until now they were only reachable through the
    // ecology" clause that first stood here was a sentence about this site's own history, and it
    // starts ageing the day it ships. That belongs in docs/decision-log.md, which has it.
    blurb:
      'Machine-run practices with their own record, their own law and their own surface. None of them belongs to the research ecology — n-1’s founding document says so in as many words — and none is a piece of the lab. They are listed here because this is where a visitor looks for them, not because the lab holds them.',
    cards: [
      {
        id: 'nightly-line',
        group: BESIDE_GROUP,
        kind: 'practice',
        kindLabel: KIND_LABEL.practice,
        live: false,
        title: nightly.title ?? 'Error as Method',
        description: nightly.line ?? '',
        href: url(nightly.href),
        meta: nightly.meta,
        thumb: recordThumbnail(
          'nightly-line',
          datedEntries('src/data/nightly/journal'),
          GALLERY.beside.nightly,
          'src/data/nightly/journal',
        ),
      },
      {
        id: 'n-1',
        group: BESIDE_GROUP,
        kind: 'practice',
        kindLabel: KIND_LABEL.practice,
        live: false,
        title: n1.title,
        description: `A practice founded on the Atelier’s own working paper and given no protocol document by design; it holds itself to that paper’s trial discipline and rewrites it where it proves too small. Its repository is mirrored whole and served as the practice’s own surface — the house keeps no window on it.${
          n1.name ? ` It has since named itself ${n1.name} (2026-08-21); the working title stands until the founder acts on the renaming request.` : ''
        }`,
        href: url('/n-1'),
        meta: `founded ${n1.founded} · ${n1.law} instead of a protocol`,
        thumb: recordThumbnail('n-1', datedEntries('public/n-1/nights'), GALLERY.beside.n1, 'public/n-1/nights'),
      },
      {
        id: 'arch',
        group: BESIDE_GROUP,
        kind: 'practice',
        kindLabel: KIND_LABEL.practice,
        live: false,
        title: archCard.title ?? 'Arch',
        description: archCard.line,
        href: url(archCard.href),
        meta: arch.window
          ? `founded ${arch.founded} · window ${arch.window.opens} → ${arch.window.closes} · balance by ${arch.window.balanceBy}`
          : `founded ${arch.founded} · no window open`,
        thumb: recordThumbnail(
          'arch',
          datedEntries('public/arch/ledger'),
          GALLERY.beside.arch,
          'public/arch/ledger',
        ),
      },
    ],
  },
]

// The facet counts stay ONE arithmetic with the cards on the page: they are derived from the
// very array the gallery renders, never counted a second time by hand (src/lib/experiments/
// shelf.ts states why).
const cards: ShelfCard[] = sections.flatMap((s) =>
  s.cards.map((c) => ({ id: c.id, group: c.group, kind: c.kind as ShelfKind, live: c.live })),
)
const facets = shelfFacets(
  cards,
  new Map(sections.map((s) => [s.id, s.label])),
  sections.map((s) => s.id),
)

const wording = {
  all: GALLERY.filter.all,
  reset: GALLERY.filter.reset,
  shown: GALLERY.filter.shown,
  empty: GALLERY.filter.empty,
  live: GALLERY.stamp.live,
  opened: GALLERY.stamp.opened,
  open: GALLERY.link.open,
  method: GALLERY.link.method,
  from: GALLERY.thumb.from,
}

const READOUT_ID = 'gallery-readout'
const quietLink = cn(
  buttonVariants({ variant: 'ghost', size: 'sm' }),
  'h-7 px-2 font-mono text-mono-sm font-normal text-fg-muted hover:text-fg',
)
---

<main id="main" class="mx-auto w-full max-w-4xl flex-1 px-6 py-12 sm:py-16">
  <SheetHead title={copy.title} sub={copy.sub} class="mb-8">
    <p class="mt-4 -ml-2">
      <a
        href={url('/experiments/neighbors')}
        class={cn(quietLink, 'h-auto whitespace-normal py-1 text-left uppercase tracking-[0.14em] text-fg-faint')}
      >
        {GALLERY.link.field}
      </a>
    </p>
  </SheetHead>

  {/* The stage is the box the readout is clamped to (dataviz/readout.ts, house rule 1): the
      gallery's own element, never the viewport and never a scroll container. */}
  <div class="gal-stage">
    <ExperimentGallery
      client:visible
      sections={sections}
      facets={facets}
      wording={wording}
      box={{ width: THUMB_BOX.width, height: THUMB_BOX.height }}
      readoutId={READOUT_ID}
    />
    <Readout id={READOUT_ID} maxWidth="34ch" />
  </div>
</main>

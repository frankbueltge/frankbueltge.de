---
// COMMON TIME — Common Ground, played back once a week (2026-11-08; docs/design/2026-11-08-common-time.md).
//
// The sound comes first, then the guide to what plays when, then the rules. Every number on the page
// is read at build time from the pressing's own score (src/data/common-time/<week>.json), which the
// renderer wrote beside the audio; the guard test (src/lib/common-time/score.test.ts) holds each score
// to the ledger it claims to play.
import SheetHead from '@/components/experiments/SheetHead.astro'
import SheetFoot from '@/components/experiments/SheetFoot.astro'
import TableFallback from '@/components/dataviz/TableFallback.astro'
import { FAMILIES, INSTRUMENT, motifNames } from '@/lib/common-time/arrangement'
import { buildGuide, GUIDE_FRAME } from '@/lib/common-time/guide'
import { audioHref, clock, dayShort, readPressings, weekName, weekSpan } from '@/lib/common-time/score'
import '@/styles/experiment-sheet.css'
import '@/styles/common-time.css'

const REPO = 'https://github.com/frankbueltge/frankbueltge.de'
const link = 'underline decoration-line underline-offset-4 hover:decoration-fg'

const pressings = readPressings()
const latest = pressings.at(-1)!
const earlier = pressings.slice(0, -1).reverse()
const guide = buildGuide(latest)
const theme = latest.theme
const scoreHref = (week: string): string => `${REPO}/blob/main/src/data/common-time/${week}.json`
const inWords = (families: readonly string[]): string => families.map((f) => INSTRUMENT[f as keyof typeof INSTRUMENT]).join(', ')

const rows = latest.sections.map((s) => ({
  day: dayShort(s.day),
  topics: s.converging,
  theme: s.theme.present ? 'on the charts' : 'silent',
  melody: s.melody ? s.melody.label : '—',
  unison: s.melody ? inWords(s.melody.families) : '—',
  ornaments: s.ornaments.length,
}))
const melodyDays = latest.sections.filter((s) => s.melody)
const fullest = Math.max(...melodyDays.map((s) => s.melody!.families.length))
---

<main id="main" class="sheet mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:py-14">
  <SheetHead
    kicker="From the nightly-ledger line"
    title="Common Time"
    sub="What the web agreed on, played back once a week. A topic’s name becomes its melody, and the more platforms carried it, the fuller the unison."
    badges={[weekName(latest.week)]}
    stamp={weekSpan(latest.days)}
  />

  <section class="mb-10" aria-label="This week’s pressing">
    <audio class="ct-player" controls preload="metadata" src={audioHref(latest)}></audio>
    <p class="mt-3 font-mono text-mono-sm text-fg-muted">
      {weekName(latest.week)} · {weekSpan(latest.days)} · {clock(latest.audio.seconds)} ·
      <a class={link} href={audioHref(latest)} download>download</a> · CC BY 4.0
    </p>
    {theme && (
      <p class="mt-5 max-w-3xl leading-relaxed">
        This week’s theme is <strong>{theme.label}</strong>, on Common Ground’s charts on {theme.days} of the {latest.days.length} days, and
        its name sings {motifNames(theme.motif)}. Each day’s melody is the topic the most platform families agreed on that day; the
        fullest this week was played by {fullest} instruments at once.
      </p>
    )}
  </section>

  <figure class="ct-guide mb-3" aria-labelledby="ct-guide-cap">
    <svg viewBox={`0 0 ${guide.width} ${guide.height}`} role="img" aria-labelledby="ct-guide-title">
      <title id="ct-guide-title">What plays when in {weekName(latest.week)}: the theme, each day’s melody, the ornaments and the crowd</title>
      {guide.rows.map((r) => (
        <text class="ct-row" x="8" y={r.y + 4}>{r.label}</text>
      ))}
      {guide.days.map((d) => (
        <g>
          <line class="ct-day" x1={d.x} x2={d.x} y1={GUIDE_FRAME.top} y2={GUIDE_FRAME.bottom} />
          <text class="ct-day-label" x={d.x + 4} y={GUIDE_FRAME.dayLabelY}>{d.label}</text>
        </g>
      ))}
      <line class="ct-day" x1={guide.span.outro} x2={guide.span.outro} y1={GUIDE_FRAME.top} y2={GUIDE_FRAME.bottom} />
      <text class="ct-day-label" x={guide.span.outro + 4} y={GUIDE_FRAME.dayLabelY}>end</text>
      {guide.crowd.map((m) => (
        <rect class="ct-crowd" x={m.x} y={m.y} width={m.w} height={m.h}><title>{m.title}</title></rect>
      ))}
      {guide.theme.map((m) => (
        <rect class="ct-theme" x={m.x} y={m.y} width={m.w} height={m.h}><title>{m.title}</title></rect>
      ))}
      {guide.melody.map((m) => (
        <rect class="ct-melody" x={m.x} y={m.y} width={m.w} height={m.h}><title>{m.title}</title></rect>
      ))}
      {guide.ornaments.map((m) => (
        <line class="ct-orn" x1={m.x} x2={m.x} y1={m.y1} y2={m.y2}><title>{m.title}</title></line>
      ))}
    </svg>
    <figcaption id="ct-guide-cap" class="mt-2 font-mono text-mono-sm text-fg-muted">
      Drawn from the pressing’s own score. A melody is as tall as the number of instruments in its unison; hover a mark for its topic.
    </figcaption>
  </figure>
  <div class="mb-12">
    <TableFallback
      summary="The week as a table"
      caption={`${weekName(latest.week)}, day by day`}
      columns={[
        { key: 'day', label: 'Day', nowrap: true },
        { key: 'topics', label: 'Converging topics', align: 'right' },
        { key: 'theme', label: 'Theme' },
        { key: 'melody', label: 'Melody' },
        { key: 'unison', label: 'Played by' },
        { key: 'ornaments', label: 'Ornaments', align: 'right' },
      ]}
      rows={rows}
      provenance={`From src/data/common-time/${latest.week}.json, which hashes every day file of src/data/trending it read.`}
    />
  </div>

  <section class="mb-12 max-w-3xl">
    <p class="kicker mb-3">What you are hearing</p>
    <p class="leading-relaxed text-fg-muted">
      <a class={link} href="/trending">Common Ground</a> reads every morning what the web is searching, reading and posting about, and
      keeps the topics that surface on several independent platforms at once. Common Time plays a week of that ledger, Monday to
      Sunday, eight bars a day. A topic that converged has a melody, and the melody is its name: the vowels of its label, in the
      order they are written, on the five notes F, G, A, C and D (u, e, i, o and a), the last vowel of each word held twice as long.
      It is an old device, the soggetto cavato with which Josquin des Prez set a duke’s name to music, with one note taken out so
      that no two notes in the piece are ever a semitone apart. A topic that comes back on another day comes back as the same
      melody.
    </p>
    <p class="mt-4 leading-relaxed text-fg-muted">
      The theme is the week’s most persistent topic: it repeats once a bar on every day it was on the charts and falls silent on a
      day it was not. Each day’s melody is that day’s most converged other topic, played slowly, twice, by the instrument of every
      platform family that carried it, in unison, so that agreement is heard as fullness. The day’s other converging topics are
      single quiet notes, and everything else the sources held that day is a dark tick in time with the beat.
    </p>
    <p class="mt-4 leading-relaxed text-fg-muted">
      Composed, and the same every week: the tempo, the chords (F, Dm7, Gsus4 and Csus2, made of the same five notes), the bed and
      the bass, a soft kick from the second day and hats from the third, the instruments, and the ending, where the theme is played
      slowly by every family that carried it. The levels are set on an ordinary day of the ledger, never on the week itself, so a
      week in which more converged than usual is heard as one. No music model made any of it: nothing here was
      generated by a system trained on other people’s music; every note is computed from the day files by the rules above,
      which are published, and synthesised from numbers. The music proves nothing. What it claims is only that every note it
      plays comes from a named day file.
    </p>
  </section>

  <section class="mb-12 max-w-3xl">
    <p class="kicker mb-3">Who plays</p>
    <ul class="space-y-2 leading-relaxed text-fg-muted">
      {FAMILIES.map((f) => (
        <li>
          <span class="text-fg">{INSTRUMENT[f]}</span>: {latest.patch.platforms[f].join(', ')}{f === latest.patch.fallback_family && ', and every news outlet behind Google News'}
        </li>
      ))}
    </ul>
  </section>

  {earlier.length > 0 && (
    <section class="mb-12" aria-label="Earlier weeks">
      <p class="kicker mb-3">Earlier weeks</p>
      <ul class="ct-weeks">
        {earlier.map((p) => (
          <li>
            <p class="font-mono text-mono-sm text-fg-muted">
              {weekName(p.week)} · {weekSpan(p.days)} · theme: <span class="text-fg">{p.theme ? p.theme.label : 'none'}</span> ·
              <a class={link} href={scoreHref(p.week)}>score</a>
            </p>
            <audio class="ct-player mt-2" controls preload="none" src={audioHref(p)}></audio>
          </li>
        ))}
      </ul>
    </section>
  )}

  <SheetFoot links={[
    { href: '/werke/common-time', label: 'method sheet' },
    { href: `${REPO}/tree/main/src/data/common-time`, label: 'the scores', external: true },
    { href: `${REPO}/tree/main/src/data/trending`, label: 'the ledger', external: true },
    { href: '/trending', label: 'Common Ground' },
  ]} />
</main>

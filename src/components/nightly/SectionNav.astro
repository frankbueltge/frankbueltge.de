---
// The nightly line's rooms (2026-08-11). Until then the line had one page and a link to its
// repository, while the material that makes it legible as research — a genealogy that grew for
// thirty sessions, two position papers with a documented turn between them, a typed error
// register of thirty-eight entries — rendered as an accordion of raw markdown at the foot of
// the Atelier's works room, where nobody read it.
//
// 2026-10-17, the publication rule (src/lib/engines/publication.mjs): the site publishes the
// practices' finished works and cycle presentations, and the four rooms that read the line's
// apparatus (the genealogy, the position, the error register, the reading) were retired with it.
// Their texts are read in the line's own repository, where their addresses now lead (301), so the
// menu keeps the line's page and one door into the repository that says it leaves the site.
//
// 2026-10-18: the door names what the line keeps there now. The four rooms were the earlier phase;
// since 2026-10-04 the working material is the research project's (its document, the position
// papers, the register and the research days).
import { LINE_REPO } from '@/lib/engines/nightly-line'

interface Props {
  /** the room the visitor is in, so it is marked rather than linked */
  active?: 'line'
}

const { active } = Astro.props

const ROOMS = [
  { id: 'line', href: '/error-as-method', label: 'the line' },
  { id: 'repository', href: LINE_REPO, label: 'the project document, the papers, the register and the research days ↗ in the repository' },
] as const
---

<nav class="mt-8 flex flex-wrap gap-x-5 gap-y-2 border-y border-line/60 py-3 font-mono text-[11px] uppercase tracking-[0.12em]" aria-label="The nightly line's rooms">
  {
    ROOMS.map((room) =>
      room.id === active ? (
        <span class="text-fg" aria-current="page">{room.label}</span>
      ) : (
        <a href={room.href} class="text-fg-faint underline decoration-line underline-offset-4 transition-colors hover:text-fg">
          {room.label}
        </a>
      ),
    )
  }
</nav>

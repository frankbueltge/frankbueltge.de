    background: var(--c);
  }
  .pt-scroll {
    padding: 8px 4px 0;
  }
  /* table rendition (TableFallback.astro's shared shell, skinned here): the wrapping <details>
     carries the border/padding the old hand-rolled block had; the header rides along and the
     line column stays three lines tall — unclamped, a single landing could be 940px tall. */
  :global(.pt-stage .dv-table-fallback) {
    border-top: 1px solid var(--pt-hairc);
    padding: 16px 20px;
  }
  @media (min-width: 640px) {
    :global(.pt-stage .dv-table-fallback) {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
  :global(.pt-stage .dv-table-fallback summary) {
    cursor: pointer;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--pt-muted);
  }
  .pt-scroll,
  :global(.pt-stage .dv-table-wrap) {
    /* main is a flex item (min-width:auto) — without inline-size containment the
       canvas min-width would propagate as min-content up to the page and widen
       the whole page on mobile instead of scrolling here. TableFallback's own .dv-table-wrap
       already carries overflow-x:auto (its structural CSS); this adds only the containment. */
    contain: inline-size;
  }
  :global(.pt-stage .dv-table-wrap) {
    margin-top: 12px;
    max-height: 60vh;
    overflow-y: auto;
  }
  :global(.pt-stage .dv-table) {
    width: 100%;
    text-align: left;
    font-size: 12px;
  }
  :global(.pt-stage .dv-table th) {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: 6px 16px 6px 0;
    font-weight: 400;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--pt-faint);
    /* the stage is a gradient, so a flat header strip reads as intended rather than
       as a patch that almost matches */
    background: var(--pt-panel2);
  }
  :global(.pt-stage .dv-table td) {
    padding: 6px 16px 6px 0;
    border-top: 1px solid var(--pt-hairc);
    vertical-align: top;
    color: var(--pt-muted);
  }
  /* date, mark: no wrap (TableFallback's own nowrap prop) — voice/move·verdict share the
     mono treatment the date column has; mark and line stay the body font. */
  :global(.pt-stage .dv-table td:nth-child(1)),
  :global(.pt-stage .dv-table td:nth-child(2)),
  :global(.pt-stage .dv-table td:nth-child(4)) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
  }
  :global(.pt-stage .dv-table td:nth-child(1)) {
    font-variant-numeric: tabular-nums;
  }
  :global(.pt-stage .dv-table td:last-child) {
    padding-right: 0;
    color: var(--pt-ink);
    /* see the caption above this block: the old title="" full-text hover has no equivalent
       here, but the row stays readable and the clamp keeps the table navigable. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pt-canvas {
    position: relative;
    /* no-JS floor; the client layer sets the exact width from data-min-width */
    min-width: 760px;
  }
  #pt-cross {
    display: none;
  }
  /* the voice ribbons: real per-day density, worn quietly under the marks */
  .pt-band {
    opacity: 0.16;
    transition: opacity 0.25s ease;
  }
  .pt-glowlayer {
    opacity: 0.5;
    transition: opacity 0.25s ease;
  }
  /* the time lens: while it is engaged the static layers step back so the
     shifted marks read cleanly; fans replace a dense day's face mark */
  .pt-lens .pt-band {
    opacity: 0.055;
  }
  .pt-lens .pt-glowlayer {
    opacity: 0.22;
  }
  .pt-lens .pt-grid-w {
    opacity: 0.4;
  }
  .pt-fan {
    display: none;
  }
  .pt-hit.pt-expanded .pt-fan {
    display: inline;
  }
  .pt-hit.pt-expanded .pt-face {
    display: none;
  }
  /* the playhead: exists only during the JS-gated entrance */
  .pt-sweep {
    display: none;
    stroke: var(--pt-ink);
    stroke-width: 1.5;
    opacity: 0;
  }
  .pt-anim .pt-sweep {
    display: inline;
    animation: pt-sweep 1.15s cubic-bezier(0.3, 0, 0.4, 1) 0.05s forwards;
  }
  @keyframes pt-sweep {
    0% {
      transform: translateX(0);
      opacity: 0.55;
    }
    92% {
      opacity: 0.35;
    }
    100% {
      transform: translateX(932px);
      opacity: 0;
    }
  }
  .pt-anim .pt-glowlayer {
    opacity: 0;
    animation: pt-glowin 1.6s ease-out 0.25s forwards;
  }
  @keyframes pt-glowin {
    to {
      opacity: 0.5;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt-anim .pt-sweep {
      display: none;
      animation: none;
    }
    .pt-anim .pt-glowlayer {
      animation: none;
      opacity: 0.5;
    }
  }
  svg text.pt-t-voice {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    fill: var(--pt-ink);
  }
  /* the lane label as a link: quiet until asked, and never a second colour on the stage */
  .pt-voice-link {
    cursor: pointer;
    outline: none;
  }
  .pt-voice-link:hover text.pt-t-voice,
  .pt-voice-link:focus-visible text.pt-t-voice {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pt-voice-link:focus-visible text.pt-t-voice {
    outline: 2px solid var(--pt-muted);
    outline-offset: 3px;
  }
  svg text.pt-t-meta {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    fill: var(--pt-faint);
  }
  svg text.pt-t-label {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    letter-spacing: 0.06em;
    fill: var(--pt-muted);
  }
  .pt-hit {
    cursor: pointer;
    outline: none;
    /* tiny easing so the lens feels fluid rather than snapping per event */
    transition: transform 0.09s linear;
  }
  .pt-ring {
    stroke: var(--pt-ink);
    stroke-width: 1;
    opacity: 0;
  }
  .pt-hit:focus-visible .pt-ring {
    opacity: 0.85;
  }
  /* the landing currently read in the panel — the score's tonearm */
  .pt-hit.pt-active .pt-ring {
    opacity: 0.85;
  }
  .pt-hit:hover .pt-cluster {
    filter: brightness(1.2);
  }
  /* Entrance as a JS enhancement only (.pt-anim is added by the client layer, the
     delay set via CSSOM) — without JS the score is fully visible immediately. */
  .pt-anim .pt-cluster {
    opacity: 0;
    transform: translateY(5px);
    animation: pt-in 0.45s ease-out forwards;
    animation-delay: var(--d, 0ms);
  }
  @keyframes pt-in {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pt-anim .pt-cluster {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
  /* WP4-style port: #pt-tip is now dataviz/Readout.astro's shared .dv-readout shell —
     structure (position/clamping/pointer-events/z-index/max-width) lives there, only the
     score's own skin (background/border/type/shadow) stays here, scoped by id so the same
     .dv-readout class used by other practices' figures never picks these colors up. */
  :global(#pt-tip) {
    background: var(--pt-panel2);
    border: 1px solid var(--pt-hair);
    border-radius: 8px;
    padding: 8px 10px;
    font-size: 11px;
    line-height: 1.45;
    color: var(--pt-ink);
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
  }
  /* Readout/panel internals are created at runtime (createElement) and therefore
     carry no Astro scope attributes — hence :global() under the server-rendered root. */
  :global(#pt-tip .tip-date) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9.5px;
    letter-spacing: 0.1em;
    color: var(--pt-faint);
  }
  :global(#pt-tip .tip-row) {
    display: grid;
    grid-template-columns: 14px 52px 1fr;
    gap: 6px;
    align-items: baseline;
    margin-top: 5px;
  }
  :global(#pt-tip .tip-key) {
    width: 12px;
    height: 2px;
    background: var(--c);
    align-self: center;
  }
  :global(#pt-tip .tip-voice) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pt-muted);
  }
  /* #pt-panel is now dataviz/DetailPanel.astro's shared shell (id passed through as a prop) —
     its own CSS only supplies the nav's flex row; the score's skin plus the layout that puts
     the prev/next/pos/close cluster back beside the heading (not below the list, DetailPanel's
     plain top-to-bottom DOM order) live here: head+nav share row 1 (nav pushed right via
     margin-left:auto), body and foot each force their own row via flex-basis:100%. */
  :global(#pt-panel) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    margin: 4px 20px 0;
    border-top: 1px solid var(--pt-hairc);
    padding: 14px 4px 6px;
  }
  :global(#pt-panel .dv-panel-head) {
    order: 1;
  }
  :global(#pt-panel .dv-panel-nav) {
    order: 2;
    margin-left: auto;
    gap: 16px;
  }
  :global(#pt-panel .dv-panel-body) {
    order: 3;
    flex-basis: 100%;
    margin-top: 8px;
  }
  :global(#pt-panel .dv-panel-foot) {
    order: 4;
    flex-basis: 100%;
    margin-top: 12px;
  }
  #pt-panel-list {
    list-style: none;
    padding: 0;
  }
  :global(#pt-panel .ev-meta) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pt-faint);
  }
  :global(#pt-panel .ev-text) {
    margin-top: 3px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--pt-ink);
    max-width: 72ch;
  }
  /* the shell's own prev/next/close buttons (DetailPanel.astro's [data-dv-prev] etc.) — same
     skin the old hand-rolled .pt-close class gave them. */
  :global(#pt-panel .dv-panel-nav button) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pt-faint);
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
  }
  :global(#pt-panel .dv-panel-nav button:hover) {
    color: var(--pt-ink);
  }
  :global(#pt-panel .dv-panel-nav button:disabled) {
    opacity: 0.35;
    cursor: default;
  }
  :global(#pt-panel .dv-panel-nav button:disabled:hover) {
    color: var(--pt-faint);
  }
  /* the position readout ("2/3 this day · 14/27 in field") — inserted at runtime between the
     shell's own prev/next buttons (no shell slot exists between them); created via
     createElement, so :global() as above. */
  :global(#pt-panel .pt-pos) {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 10px;
    color: var(--pt-faint);
    font-variant-numeric: tabular-nums;
  }
  .pt-link {
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 11px;
    color: var(--pt-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .pt-link:hover {
    color: var(--pt-ink);
  }
</style>

<script>
  // The score's interaction layer: crosshair + tooltips, click/Enter → detail panel
  // with the full wording, Esc closes. Everything below is an enhancement — the
  // static rendition (SVG + table) stands on its own.
  //
  // Ported onto the shared dataviz primitives: the tooltip onto dataviz/Readout.astro +
  // createReadout/placeReadout, the detail panel onto dataviz/DetailPanel.astro + src/lib/
  // dataviz/stepper.ts's buildSegments/step/positionLabel (this file's own former flat/seg/
  // step, extracted from here in WP3), and the mark-offset table + nearest-mark resolution onto
  // src/lib/partitur.ts's shared MARK_OFFSETS/fanOffsets/nearestMarkOffset (previously
  // duplicated server- and client-side by hand — see that module for the fix's own history:
  // "nobody hits a 9px dot reliably").
  import { createReadout } from '@/lib/dataviz/readout'
  import { readJsonScript } from '@/lib/dataviz/runtime'
  import { buildSegments, positionLabel, step as stepperStep } from '@/lib/dataviz/stepper'
  import { fanOffsets, nearestMarkOffset } from '@/lib/partitur'

  interface TipEvent {
    glyph: string
    session: number | null
    move: string | null
    verdict: string | null
    text: string
  }
  interface Payload {
    layout: { vbw: number; x0: number; dayW: number; top: number; laneH: number; days: string[] }
    /** src/lib/partitur.ts's MARK_OFFSETS, handed through instead of a second hand-kept-in-sync
     *  literal (fanOffsets, a formula rather than data, is imported directly above instead). */
    offsets: Record<number, number[]>
    voices: Record<string, { label: string; href: string }>
    order: string[]
    clusters: Record<string, TipEvent[]>
  }

  const stage = document.getElementById('partitur')
  const dataEl = document.getElementById('partitur-data')
  const svg = document.getElementById('partitur-svg') as unknown as SVGSVGElement | null
  const canvas = document.querySelector<HTMLElement>('#partitur .pt-canvas')
  const tip = document.getElementById('pt-tip')
  const cross = document.getElementById('pt-cross')
  // The panel exists only in the full view; in compact mode a click leads to the full page.
  const panel = document.getElementById('pt-panel')
  const panelHead = document.getElementById('pt-panel-head')
  const panelList = document.getElementById('pt-panel-list')
  const panelLink = document.getElementById('pt-panel-link') as HTMLAnchorElement | null

  if (stage && dataEl?.textContent && svg && canvas && tip && cross) {
    const compact = stage.dataset.compact === 'true'
    const data = readJsonScript<Payload>('partitur-data')
    const { vbw, x0, dayW, days } = data.layout
    const glyphWord: Record<string, string> = { session: 'session', work: 'work', fail: 'fail' }

    // ── The time lens (full view only): a cartesian fisheye on the x axis. Under
    //    the pointer the month stretches locally (≈3.6× at focus); dense days fan
    //    out into their individual landings and become hoverable one by one.
    //    fisheye(focus) === focus, so using the pointer as focus is stable. ─────
    const LENS_R = 170
    const LENS_D = 2.6
    const lensOn = () => !compact && stage.classList.contains('pt-lens')
    const fish = (x: number, focus: number): number => {
      const dx = x - focus
      const a = Math.abs(dx)
      if (a >= LENS_R || a === 0) return x
      const k = ((LENS_D + 1) * LENS_R * a) / (LENS_D * a + LENS_R)
      return focus + Math.sign(dx) * k
    }
    const unfish = (xd: number, focus: number): number => {
      const dk = xd - focus
      const k = Math.abs(dk)
      if (k >= LENS_R || k === 0) return xd
      const a = (k * LENS_R) / ((LENS_D + 1) * LENS_R - LENS_D * k)
      return focus + Math.sign(dk) * a
    }
    let lensFocus = 0

    // The site CSP drops style ATTRIBUTES — CSSOM assignments like these are allowed.
    // The exact min-width (depends on the day count) and the entrance delays are
    // therefore applied only here; without JS the score is complete right away.
    const minW = canvas.getAttribute('data-min-width')
    if (minW) canvas.style.minWidth = `${minW}px`
    for (const hit of svg.querySelectorAll<SVGGElement>('.pt-hit')) {
      hit.style.setProperty('--d', `${hit.dataset.delay ?? 0}ms`)
    }
    stage.classList.add('pt-anim')

    const scale = () => svg.getBoundingClientRect().width / vbw

    // ── Tooltips — the readout is placed relative to the STAGE (not the canvas) so
    //    the scroll container never clips it (dataviz/readout.ts's house rule 1);
    //    near an edge it flips rather than clipping (house rule 2). Three tiers
    //    (Frank's finding 2026-07-31, mouseover was day-wise only): a single mark →
    //    EXACTLY that landing; a ×n cluster → that voice's landings; open lane →
    //    the whole day column. ──────────────────────────────────────────────────
    const readout = createReadout(tip, stage)
    const tipHeader = (container: DocumentFragment, label: string) => {
      const d = document.createElement('p')
      d.className = 'tip-date'
      d.textContent = label
      container.appendChild(d)
    }
    const tipRow = (container: DocumentFragment, v: string, e: TipEvent, max: number) => {
      const row = document.createElement('div')
      row.className = 'tip-row'
      row.style.setProperty('--c', `var(--pt-${v})`)
      const key = document.createElement('span')
      key.className = 'tip-key'
      const voice = document.createElement('span')
      voice.className = 'tip-voice'
      voice.textContent = v
      const text = document.createElement('span')
      text.textContent =
        (e.glyph === 'fail' ? '✕ ' : e.glyph === 'work' ? '◆ ' : '') +
        (e.text.length > max ? `${e.text.slice(0, max - 1)}…` : e.text)
      row.append(key, voice, text)
      container.appendChild(row)
    }
    const tipNote = (container: DocumentFragment, text: string) => {
      const more = document.createElement('p')
      more.className = 'tip-voice'
      more.style.marginTop = '3px'
      more.textContent = text
      container.appendChild(more)
    }
    /** anchor point for the readout, in the STAGE's own local coordinate space — never
     *  viewport/scroll-container coordinates (dataviz/readout.ts's house rule 1). */
    const anchorFor = (dayIdx: number, clientY: number) => {
      const stageRect = stage.getBoundingClientRect()
      const svgRect = svg.getBoundingClientRect()
      const ax = x0 + dayW * (dayIdx + 0.5)
      return {
        anchorX: svgRect.left - stageRect.left + (lensOn() ? fish(ax, lensFocus) : ax) * scale(),
        anchorY: clientY - stageRect.top,
      }
    }

    /** open lane: the whole day column, all voices (capped per voice) */
    const showDayTip = (dayIdx: number, clientY: number) => {
      const date = days[dayIdx]
      const rows = data.order
        .map((v) => ({ v, evs: data.clusters[`${v}|${date}`] }))
        .filter((r): r is { v: string; evs: TipEvent[] } => Boolean(r.evs?.length))
      if (rows.length === 0) {
        readout.hide()
        return
      }
      const frag = document.createDocumentFragment()
      tipHeader(frag, date)
      for (const { v, evs } of rows) {
        for (const e of evs.slice(0, 3)) tipRow(frag, v, e, 96)
        if (evs.length > 3) tipNote(frag, `… ${evs.length - 3} more ${v} landings — hover the mark`)
      }
      readout.show(frag, anchorFor(dayIdx, clientY))
    }

    /** mark/cluster: mi ≥ 0 → exactly THAT landing; mi < 0 → all of the voice's landings that day */
    const showVoiceTip = (key: string, mi: number, clientY: number) => {
      const [v, date] = key.split('|')
      const evs = data.clusters[key]
      const dayIdx = days.indexOf(date)
      if (!evs?.length || dayIdx < 0) {
        readout.hide()
        return
      }
      const frag = document.createDocumentFragment()
      const single = mi >= 0 && mi < evs.length
      tipHeader(frag, single ? `${date} · ${v} · landing ${mi + 1} of ${evs.length}` : `${date} · ${v} · ${evs.length} landings`)
      if (single) {
        const e = evs[mi]
        tipRow(frag, v, e, 220)
        const meta = [e.session === null ? null : `S${e.session}`, e.move, e.verdict].filter(Boolean).join(' · ')
        if (meta) tipNote(frag, meta)
      } else {
        for (const e of evs.slice(0, 5)) tipRow(frag, v, e, 110)
        if (evs.length > 5) tipNote(frag, `… ${evs.length - 5} more — click, then step with next →`)
      }
      readout.show(frag, anchorFor(dayIdx, clientY))
    }

    const allHits = Array.from(svg.querySelectorAll<SVGGElement>('.pt-hit'))
    const applyLens = (focus: number) => {
      stage.classList.add('pt-lens')
      lensFocus = focus
      for (const h of allHits) {
        const bx = Number(h.dataset.x ?? 0)
        const t = fish(bx, focus) - bx
        h.style.transform = t === 0 ? '' : `translateX(${t.toFixed(2)}px)`
        h.dataset.t = t.toFixed(2)
        const n = data.clusters[h.dataset.key ?? '']?.length ?? 0
        if (n > 3) h.classList.toggle('pt-expanded', Math.abs(bx - focus) < 70)
      }
    }
    const releaseLens = () => {
      stage.classList.remove('pt-lens')
      for (const h of allHits) {
        h.style.transform = ''
        h.dataset.t = '0'
        h.classList.remove('pt-expanded')
      }
    }

    svg.addEventListener('pointermove', (ev) => {
      const rect = svg.getBoundingClientRect()
      const xVb = (ev.clientX - rect.left) / scale()
      const idx = Math.round((xVb - x0 - dayW / 2) / dayW)
      if (idx < 0 || idx >= days.length) {
        cross.style.display = 'none'
        readout.hide()
        if (!compact) releaseLens()
        return
      }
      // the pointer is the lens focus — fisheye(focus) === focus, so the day
      // under the cursor stays put while its neighborhood stretches
      if (!compact) applyLens(xVb)
      const snapped = x0 + dayW * (idx + 0.5)
      const snappedR = lensOn() ? fish(snapped, lensFocus) : snapped
      cross.setAttribute('x1', String(snappedR))
      cross.setAttribute('x2', String(snappedR))
      cross.style.display = 'inline'
      // Anywhere inside a cluster's hit band → session-precise via NEAREST mark
      // (in the cluster's own, possibly lens-shifted frame). A lens-expanded
      // dense day resolves per fanned mark; unexpanded ones keep the voice list.
      const target = ev.target instanceof Element ? ev.target : null
      const hitEl = target?.closest('.pt-hit') as SVGGElement | null
      const key = hitEl?.dataset.key
      if (key && hitEl) {
        const evs = data.clusters[key]
        if (evs?.length) {
          let mi = -1
          const offsets =
            evs.length <= 3
              ? (data.offsets[evs.length] ?? [0])
              : hitEl.classList.contains('pt-expanded')
                ? fanOffsets(evs.length)
                : null
          if (offsets) {
            const cx = Number(hitEl.dataset.x ?? 0)
            const localX = xVb - Number(hitEl.dataset.t ?? 0)
            mi = nearestMarkOffset(offsets, localX - cx)
          }
          showVoiceTip(key, mi, ev.clientY)
          return
        }
      }
      showDayTip(idx, ev.clientY)
    })
    svg.addEventListener('pointerleave', () => {
      cross.style.display = 'none'
      readout.hide()
      if (!compact) releaseLens()
    })

    // ── Detail panel (full view): session-wise reading. The navigation axis is the
    //    flat, chronological landing list PER VOICE — prev/next (and ←/→) step
    //    through every single landing, including within dense days (Frank's finding
    //    2026-07-31). In compact mode a click leads to the full page.
    //
    //    Ported onto dataviz/DetailPanel.astro's shared shell + src/lib/dataviz/stepper.ts's
    //    buildSegments/step/positionLabel: the shell owns the prev/next/close buttons and the
    //    Escape/←/→ keyboard arbitration through its own module-level registry (so several
    //    DetailPanel instances on one page — this one today, tour panels soon — never fight
    //    over the same keypress; see stepper.ts's own header for the bug this replaces, where
    //    this component bound its own document-level keydown listener per instance). This
    //    component only fills the shell's slots and reacts to the dv:step/dv:close events its
    //    buttons (and, via the registry, the keyboard) already dispatch.
    const prevBtn = panel?.querySelector<HTMLButtonElement>('[data-dv-prev]') ?? null
    const nextBtn = panel?.querySelector<HTMLButtonElement>('[data-dv-next]') ?? null
    const closeBtn = panel?.querySelector<HTMLButtonElement>('[data-dv-close]') ?? null
    const hasPanel = Boolean(panel && panelHead && panelList && panelLink && prevBtn && nextBtn && closeBtn)

    // The position readout ("2/3 this day · 14/27 in field") has no shell slot between the
    // prev/next buttons — inserted there once, at init, exactly where it always sat.
    let posEl: HTMLSpanElement | null = null
    if (hasPanel) {
      prevBtn!.textContent = '← prev'
      prevBtn!.setAttribute('aria-label', 'Previous landing in this voice')
      nextBtn!.textContent = 'next →'
      nextBtn!.setAttribute('aria-label', 'Next landing in this voice')
      closeBtn!.textContent = 'close ✕'
      posEl = document.createElement('span')
      posEl.className = 'pt-pos'
      posEl.setAttribute('aria-live', 'polite')
      nextBtn!.before(posEl)
    }

    interface FlatEntry {
      key: string
      voice: string
      date: string
      dayIdx: number
      ev: TipEvent
    }
    const flat: FlatEntry[] = []
    for (const v of data.order) {
      for (const d of days) {
        const evs = data.clusters[`${v}|${d}`]
        if (evs) evs.forEach((ev, dayIdx) => flat.push({ key: `${v}|${d}`, voice: v, date: d, dayIdx, ev }))
      }
    }
    // one contiguous run per voice (flat is built voice-by-voice above) — buildSegments's
    // documented precondition, replacing this component's own former hand-rolled seg map.
    const segmented = buildSegments(flat, (f) => f.voice)

    const hitByKey = new Map<string, SVGGElement>()
    let pos = -1

    const renderPanel = () => {
      if (!hasPanel || pos < 0) return
      const entry = segmented.items[pos]
      const meta = data.voices[entry.voice]
      const dayCount = data.clusters[entry.key]?.length ?? 1
      const seg = segmented.segments[entry.voice]
      panelHead!.textContent = `${entry.date} · ${meta?.label ?? entry.voice}`
      posEl!.textContent = positionLabel(segmented, pos, `${entry.dayIdx + 1}/${dayCount} this day`)
      panelList!.textContent = ''
      const li = document.createElement('li')
      const m = document.createElement('p')
      m.className = 'ev-meta'
      m.textContent = [
        glyphWord[entry.ev.glyph] ?? entry.ev.glyph,
        entry.ev.session === null ? null : `S${entry.ev.session}`,
        entry.ev.move,
        entry.ev.verdict,
      ]
        .filter(Boolean)
        .join(' · ')
      const t = document.createElement('p')
      t.className = 'ev-text'
      t.textContent = entry.ev.text
      li.append(m, t)
      panelList!.appendChild(li)
      if (meta) {
        panelLink!.href = meta.href
        panelLink!.textContent = `open the ${entry.voice} log →`
      }
      prevBtn!.disabled = pos <= seg.start
      nextBtn!.disabled = pos >= seg.end - 1
      // tonearm: highlight the active mark, bring it into view, park the crosshair on its day
      for (const g of hitByKey.values()) g.classList.remove('pt-active')
      const g = hitByKey.get(entry.key)
      if (g) {
        g.classList.add('pt-active')
        g.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' })
      }
      const di = days.indexOf(entry.date)
      if (di >= 0) {
        const snapped = x0 + dayW * (di + 0.5)
        cross.setAttribute('x1', String(snapped))
        cross.setAttribute('x2', String(snapped))
        cross.style.display = 'inline'
      }
      // keep the shell's own data-dv-pos in sync — its prev/next buttons read it to compute the
      // requested position for the next dv:step event (see DetailPanel.astro's own script).
      panel!.dataset.dvPos = String(pos)
      panel!.hidden = false
    }
    const activate = (key: string) => {
      if (compact || !hasPanel) {
        window.location.assign('/maschinenraum')
        return
      }
      pos = segmented.items.findIndex((f) => f.key === key)
      renderPanel()
    }
    if (hasPanel) {
      const closePanel = () => {
        panel!.hidden = true
        for (const g of hitByKey.values()) g.classList.remove('pt-active')
      }
      // DetailPanel.astro's own script dispatches these on click (prev/next/close) and on
      // Escape/←/→ once this panel is the keyboard registry's active one (see above) — one
      // pair of listeners covers both input paths, instead of a second, parallel keydown
      // handler here.
      panel!.addEventListener('dv:close', closePanel)
      panel!.addEventListener('dv:step', ((ev: CustomEvent<{ pos: number }>) => {
        if (pos < 0) return
        const next = stepperStep(segmented, pos, ev.detail.pos - pos)
        if (next === pos) return
        pos = next
        renderPanel()
      }) as EventListener)
    }

    for (const hit of svg.querySelectorAll<SVGGElement>('.pt-hit')) {
      const key = hit.dataset.key
      if (!key) continue
      hitByKey.set(key, hit)
      hit.addEventListener('click', () => activate(key))
      hit.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault()
          activate(key)
        }
      })
      // keyboard gets the same readout as the pointer — voice-scoped at the focus point
      hit.addEventListener('focus', () => {
        showVoiceTip(key, -1, hit.getBoundingClientRect().bottom)
      })
      hit.addEventListener('blur', () => {
        readout.hide()
      })
    }
  }
</script>

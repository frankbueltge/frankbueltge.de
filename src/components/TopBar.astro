---
// The bar carries four points (Frank, 2026-08-09, late; wording private — the bar must not
// put one project in focus):
//   Projects ▾   Research projects (front doors: /ecology, /machine-attention, /atlas)
//                and Other projects (card pages from src/data/projects.ts)
//   Lab          the site's earlier experiments (route /experiments keeps its URL)
//   About · Contact
// Removed the same evening: the "Works" group (the registers are reachable from the homes
// they belong to) and "Talk back" (the post office and the seed intake belong to the research
// ecology and live on its own pages — the top bar is the whole site's, not one project's).
// The ecology's /work card page went with its menu entry: it was an interstitial between the
// menu and the project's real page at /ecology (301 covers the old address).
// "Experiments" → "Lab" as the menu word — the route and page keep their names.
// Practice names and project entries are DERIVED, not retyped — a rename in naming.ts or
// projects.ts moves the nav with it.
// Dropdowns are native <details>: they work without JS; the script below only closes them on
// outside-click/Escape and keeps at most one open.
// History: "Atlas" → "Catalogues" (Frank, 2026-07-26); DE/EN toggle removed with the
// single-locale switch (site-v2 §1.5); the 2026-07-31 arrangement (Research Ecology ▾ /
// Works ▾ / Talk back ▾) lives in git history.
//
// Re-skin 2a (2026-09-02): the four points and their wording are untouched — only the
// clothing changed. Every control is now cut from the same shadcn recipe (buttonVariants
// from src/components/ui/button.tsx, composed with cn()), so the bar, the menu items and
// the theme toggle share one hover surface, one radius and one focus ring with every
// primitive the rest of the re-skin will use. The bar itself is persisted across page
// transitions (transition:persist), which is why the current-page mark is also re-derived
// in the script below: a persisted bar keeps its old DOM, and a stale mark is worse than none.
import { t } from '@/i18n/ui'
import type { Locale } from '@/lib/site'
import { getProjects } from '@/data/projects'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'

const locale = (Astro.currentLocale ?? 'en') as Locale

type NavLink = { href: string; label: string }
type NavSection = { label: string; items: NavLink[] }
type NavGroup = { label: string; sections: NavSection[]; foot?: NavLink }
type NavItem = NavLink | NavGroup

// Every project gets its card page; the external site is one click further, on that page.
// Atlas is excluded here because it sits under Research projects with its direct door — one
// menu, one address per thing.
const projects: NavLink[] = getProjects()
  .filter((p) => p.slug !== 'atlas')
  .map((p) => ({ href: `/work/${p.slug}`, label: p.name }))

const nav: NavItem[] = [
  {
    // One axis: kind of thing (Frank, 2026-08-09 evening — "da wird ja unter 'Research' alles
    // zusammengeworfen"). No project gets a mega-menu of its own any more; the ecology's own
    // rooms — practices, apparatus, Maschinenraum — live on its project page, where they belong.
    label: 'Projects',
    sections: [
      {
        label: 'Research projects',
        items: [
          { href: '/ecology', label: 'The research ecology' },
          { href: '/machine-attention', label: 'Machine Attention' },
          { href: '/atlas', label: 'Atlas' },
        ],
      },
      { label: 'Other projects', items: projects },
    ],
    foot: { href: '/work', label: 'all projects →' },
  },
  { href: '/experiments', label: 'Lab' },
  { href: '/about', label: 'About' },
  // Contact after About (Frank, 2026-08-01) — since the page carries a real form that lands
  // in the letter queue, it earns its own door instead of hiding behind the footer.
  { href: '/contact', label: 'Contact' },
]

const isGroup = (i: NavItem): i is NavGroup => 'sections' in i
// A group with several sections gets two columns so the panel stays a readable shape; the
// width is clamped so it can never push past a narrow viewport.
const panelClass = (g: NavGroup) =>
  g.sections.length > 1
    ? 'w-[27rem] max-w-[calc(100vw-2rem)] grid-cols-2'
    : 'w-56 max-w-[calc(100vw-2rem)] grid-cols-1'

// Which point of the bar is the page the reader is on. Rendered server-side so it is right
// without JavaScript, and re-derived after every client-side navigation (see the script).
const here = Astro.url.pathname.replace(/\/+$/, '') || '/'
const onPath = (href: string) => here === href || here.startsWith(`${href}/`)
const isHere = (i: NavItem) => (isGroup(i) ? i.sections.some((s) => s.items.some((l) => onPath(l.href))) : onPath(i.href))

// One recipe per role, so the bar cannot drift from the primitives.
const point = cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'nav-point px-2.5 text-fg-muted hover:text-fg')
const entry = cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'h-auto w-full justify-start px-2 py-1.5 text-fg-muted hover:text-fg')
const iconBtn = cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'size-8 text-fg-faint hover:text-fg')
---

<header
  transition:persist="site-topbar"
  class="keep-dark sticky top-0 z-30 border-b border-line bg-bg/75 backdrop-blur-xl"
>
  <div class="flex h-14 items-center justify-between px-3 sm:h-12 sm:px-4">
    <a
      href="/"
      data-nav-point="/"
      class={cn(buttonVariants({ variant: 'ghost', size: 'sm' }), 'gap-2.5 px-2 text-fg')}
      aria-label={t(locale, 'nav.overview')}
    >
      <span class="h-[7px] w-[7px] rounded-full bg-cyan"></span>
      <span class="text-[14px] font-semibold tracking-tight">Frank Bültge</span>
    </a>

    <div class="flex items-center gap-1">
      <!-- desktop nav: flat links + native-details dropdowns with named sections -->
      <nav class="hidden items-center gap-0.5 text-sm sm:flex">
        {nav.map((item) =>
          isGroup(item) ? (
            <details data-nav-drop class="relative">
              <summary class={cn(point, 'cursor-pointer select-none')} data-current={isHere(item) ? 'on' : undefined}>
                {item.label}
                <svg class="drop-chevron mt-px" width="9" height="9" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
              </summary>
              <div class={`drop-panel absolute left-1/2 top-[calc(100%+10px)] grid -translate-x-1/2 gap-x-2 gap-y-3 rounded-lg border border-line bg-panel p-2.5 panel-float backdrop-blur-xl ${panelClass(item)}`}>
                {item.sections.map((s) => (
                  <section>
                    <p class="kicker px-2 pb-1.5">{s.label}</p>
                    <div class="flex flex-col gap-px">
                      {s.items.map((l) => (
                        <a href={l.href} data-nav-point={l.href} data-current={onPath(l.href) ? 'on' : undefined} class={entry}>{l.label}</a>
                      ))}
                    </div>
                  </section>
                ))}
                {item.foot && (
                  <a
                    href={item.foot.href}
                    data-nav-point={item.foot.href}
                    data-current={onPath(item.foot.href) ? 'on' : undefined}
                    class={cn(entry, 'col-span-full mt-1 border-t border-line/70 pt-2.5 font-mono text-mono-sm text-fg-faint')}
                  >{item.foot.label}</a>
                )}
              </div>
            </details>
          ) : (
            <a href={item.href} data-nav-point={item.href} data-current={isHere(item) ? 'on' : undefined} class={point}>{item.label}</a>
          ),
        )}
      </nav>

      <span class="mx-1 hidden h-4 w-px bg-line sm:block" aria-hidden="true"></span>

      <!-- theme toggle: cycles auto → light → dark → auto. Auto (default) follows the OS.
           The icon shows the current MODE (monitor = auto, sun = light, moon = dark); it is
           driven by [data-theme-mode] on <html>, set by the controller in Base.astro. -->
      <button
        type="button"
        data-theme-toggle
        aria-label={t(locale, 'theme.toggle')}
        title={t(locale, 'theme.toggle')}
        class={iconBtn}
      >
        <svg class="i-auto" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" /></svg>
        <svg class="i-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4" /></svg>
        <svg class="i-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
      </button>

      <!-- mobile menu: native <details> disclosure (works without JS), same groups and sections.
           The panel scrolls on its own so a long ecology list can never run off a short screen. -->
      <details data-menu class="relative sm:hidden">
        <summary class={cn(iconBtn, 'i-summary cursor-pointer text-fg-muted')} aria-label={t(locale, 'nav.menu')}>
          <svg class="i-menu" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <svg class="i-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </summary>
        <nav class="drop-panel absolute right-0 top-[calc(100%+10px)] flex max-h-[calc(100dvh-6rem)] w-64 flex-col gap-px overflow-y-auto rounded-lg border border-line bg-panel p-2 panel-float backdrop-blur-xl">
          {nav.map((item) =>
            isGroup(item) ? (
              <>
                <p class="px-2 pb-1.5 pt-1 text-sm font-semibold text-fg">{item.label}</p>
                {item.sections.map((s) => (
                  <>
                    <p class="kicker px-2 pb-1 pt-2">{s.label}</p>
                    {s.items.map((l) => (
                      <a href={l.href} data-nav-point={l.href} data-current={onPath(l.href) ? 'on' : undefined} class={cn(entry, 'py-2')}>{l.label}</a>
                    ))}
                  </>
                ))}
                {item.foot && (
                  <a href={item.foot.href} data-nav-point={item.foot.href} data-current={onPath(item.foot.href) ? 'on' : undefined} class={cn(entry, 'py-2 font-mono text-mono-sm text-fg-faint')}>{item.foot.label}</a>
                )}
              </>
            ) : (
              <a href={item.href} data-nav-point={item.href} data-current={isHere(item) ? 'on' : undefined} class={cn(entry, 'mt-1 py-2 text-sm font-semibold text-fg')}>{item.label}</a>
            ),
          )}
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  /* hamburger ⇄ close icon swap driven purely by the open state */
  .i-close { display: none; }
  details[open] .i-menu { display: none; }
  details[open] .i-close { display: block; }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }

  /* An open dropdown reads as active, and its chevron turns over. */
  details[data-nav-drop][open] > summary {
    color: var(--color-fg);
    background-color: var(--color-panel-2);
  }
  .drop-chevron { transition: transform 0.2s var(--ease-frame); }
  details[open] > summary .drop-chevron { transform: rotate(180deg); }

  /* The page the reader is on: the bar's own ink, underlined by a hairline that sits on the
     bar's bottom border. A mono frame marks position with weight and a rule, never a hue. */
  .nav-point[data-current] { color: var(--color-fg); }
  .nav-point[data-current]::after {
    content: '';
    position: absolute;
    left: 0.625rem;
    right: 0.625rem;
    bottom: -0.5rem;
    height: 1.5px;
    background-color: var(--color-fg);
  }
  .nav-point { position: relative; }
  /* Inside a panel the mark cannot be an underline on the bar's edge — it is a left rule. */
  .drop-panel a[data-current] {
    color: var(--color-fg);
    background-color: var(--color-panel-2);
  }

  /* The panels arrive rather than appear. `transform` is used on purpose and `translate` is
     left alone: Tailwind v4 centres the desktop panel with the `translate` property, so an
     animation touching that would fight the centring for 180 ms. Nothing moves under
     reduced motion. */
  @media (prefers-reduced-motion: no-preference) {
    details[open] > .drop-panel {
      animation: drop-in 0.18s var(--ease-frame) both;
    }
  }
  @keyframes drop-in {
    from { opacity: 0; transform: translateY(-4px); }
  }
</style>

<script>
  // Close any open nav disclosure (mobile menu or desktop dropdown) on outside-click or
  // Escape, and keep at most one open at a time. Bound once on the document (which survives
  // every page transition) and re-applied per disclosure, because a bar that was NOT
  // persisted comes back as fresh DOM after a swap.
  const all = () => [...document.querySelectorAll<HTMLDetailsElement>('[data-menu], [data-nav-drop]')]

  let documentBound = false
  const wireNav = (): void => {
    for (const d of all()) {
      if (d.dataset.navBound) continue
      d.dataset.navBound = 'on'
      d.addEventListener('toggle', () => {
        if (d.open) for (const other of all()) if (other !== d) other.open = false
      })
    }

    // The bar is persisted across page transitions, so its server-rendered current-page mark
    // belongs to the page the reader arrived on, not the one they are reading. Re-derive it.
    const here = location.pathname.replace(/\/+$/, '') || '/'
    for (const link of document.querySelectorAll<HTMLElement>('[data-nav-point]')) {
      const href = link.dataset.navPoint || ''
      const current = href === '/' ? here === '/' : here === href || here.startsWith(`${href}/`)
      if (current) link.dataset.current = 'on'
      else delete link.dataset.current
    }
    // A group's summary is current when any of its entries is.
    for (const drop of document.querySelectorAll<HTMLDetailsElement>('[data-nav-drop]')) {
      const summary = drop.querySelector('summary')
      if (!summary) continue
      if (drop.querySelector('.drop-panel a[data-current]')) summary.dataset.current = 'on'
      else delete summary.dataset.current
    }

    if (documentBound) return
    documentBound = true
    document.addEventListener('click', (e) => {
      for (const d of all()) {
        if (d.open && !d.contains(e.target as Node)) d.open = false
      }
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') for (const d of all()) d.open = false
    })
  }

  wireNav()
  document.addEventListener('astro:page-load', wireNav)
  // The theme toggle is wired centrally in Base.astro (single source of truth).
</script>

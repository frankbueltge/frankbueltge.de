---
// The bar carries four points (Frank, 2026-08-09, late; wording private — the bar must not
// put one project in focus):
//   Projects ▾   Research projects (front doors: /ecology, /machine-attention, /atlas, /n-1,
//                /error-as-method) and Other projects (card pages from src/data/projects.ts)
//   Lab          the site's earlier experiments (route /experiments keeps its URL)
//   About · Contact
// Removed that evening: the "Works" group (the registers are reachable from the homes they
// belong to) and "Talk back" (the post office and the seed intake belong to the research
// ecology and live on its own pages — the top bar is the whole site's, not one project's).
//
// 2026-10-11 — the bar of the design handoff (docs/design_handoff_homepage_ecology/README.md
// §1; approval trail: docs/decision-log.md). The four points and their order are untouched.
// What changed:
//   · The left end is the name line — NAMING.eyebrow, the person and the role — instead of a
//     dot and the bare name. It is the line the entrance used to carry as its eyebrow, and the
//     reason is the same one (src/pages/index.astro): on the query that is a person's name
//     this site cannot afford to leave its own name out. It now stands on every page.
//   · A research project says in a few words what it is, and n-1 and the nightly line — under
//     its name, Ulysses — joined the list. Arch left it: its trial has ended (see /arch).
//   · The clothing: a 40 px bar on the page's own ground with a hairline under it, labels in
//     tracked capitals, the panel a framed sheet. Below 860 px the bar is 56 px, stays at the
//     top of the screen, and one MENU button opens the whole menu inline.
//   · The bar reads the frame's tokens (--color-bg, --color-fg, --color-line), so it stands on
//     paper where the page is paper (src/styles/paper.css) and on the mono skin elsewhere,
//     without knowing which. Its two typefaces are its own on every page.
//
// Practice names and project entries are DERIVED, not retyped — a rename in naming.ts or
// projects.ts moves the bar with it. Both disclosures are native <details>: they work without
// JavaScript. The script adds what the handoff asks for on top — the Projects panel opens
// under a resting pointer and closes when it leaves — closes a disclosure on outside-click and
// Escape, and keeps at most one open. The bar is persisted across page transitions
// (transition:persist), which is why the current-page mark is re-derived in the script: a
// persisted bar keeps its old DOM, and a stale mark is worse than none.
// History: "Atlas" → "Catalogues" (Frank, 2026-07-26); DE/EN toggle removed with the
// single-locale switch (site-v2 §1.5); the 2026-07-31 arrangement (Research Ecology ▾ /
// Works ▾ / Talk back ▾) and the shadcn-recipe bar of 2026-09-02 live in git history.
import '@fontsource-variable/schibsted-grotesk/wght.css'
import '@fontsource-variable/literata/opsz.css'
import { t } from '@/i18n/ui'
import type { Locale } from '@/lib/site'
import { getProjects } from '@/data/projects'
import { NAMING } from '@/config/naming'

const locale = (Astro.currentLocale ?? 'en') as Locale
const NAV = NAMING.nav

interface Entry {
  href: string
  name: string
  line?: string
}

// A research entry reads its name and address from its overview card where it has one; the
// catalogue among them reads its line from the catalogue's own short description.
const cards = new Map(NAMING.overview.items.map((c) => [c.id, c]))
const research: Entry[] = NAV.research.items.map((item) => {
  if ('card' in item) {
    const card = cards.get(item.card)
    if (!card?.title || !card.href) throw new Error(`TopBar: NAMING.overview.items has no "${item.card}" card to read`)
    return { href: card.href, name: card.title, line: item.line }
  }
  const catalogue = NAMING.catalogues.items.find((c) => c.href === item.href)
  return { href: item.href, name: item.name, line: catalogue?.short }
})

// Every project gets its card page; the external site is one click further, on that page.
// Atlas is excluded here because it sits under Research projects with its direct door — one
// menu, one address per thing.
const other: Entry[] = getProjects()
  .filter((p) => p.slug !== 'atlas')
  .map((p) => ({ href: `/work/${p.slug}`, name: p.name }))

// The name line, as one line on a desk and as two on a phone: the person, then the role.
const [person, ...roleParts] = NAMING.eyebrow.split(' · ')
const role = roleParts.join(' · ')

// Which point of the bar is the page the reader is on. Rendered server-side so it is right
// without JavaScript, and re-derived after every client-side navigation (see the script).
const here = Astro.url.pathname.replace(/\/+$/, '') || '/'
const onPath = (href: string) => here === href || here.startsWith(`${href}/`)
const mark = (href: string) => (onPath(href) ? 'on' : undefined)
const inProjects = [...research, ...other, NAV.other.foot].some((l) => onPath(l.href))
---

<header transition:persist="site-topbar" class="site-bar">
  <div class="site-bar-row">
    <a href="/" data-nav-point="/" class="site-bar-name">
      <span>{person}</span><span class="site-bar-sep" aria-hidden="true"> · </span><span class="site-bar-role">{role}</span>
    </a>

    {/* —— a desk: the four points in a row, Projects as a framed sheet under its word —— */}
    <nav class="site-nav" aria-label={NAV.aria.site}>
      <details data-nav-drop class="site-drop">
        <summary class="site-point" data-current={inProjects ? 'on' : undefined}>
          {NAV.projects}
          <span class="site-caret" aria-hidden="true"></span>
        </summary>
        {/* The six pixels between the word and the sheet are padding INSIDE the hover area, so
            the sheet does not close on the pointer's way down to it. */}
        <div class="site-drop-hold">
          <div class="site-sheet">
            <section>
              <p class="site-sheet-label">{NAV.research.label}</p>
              {research.map((l) => (
                <a href={l.href} data-nav-point={l.href} data-current={mark(l.href)} class="site-sheet-entry">
                  <span class="site-sheet-name">{l.name}</span>
                  {l.line && <span class="site-sheet-line">{l.line}</span>}
                </a>
              ))}
            </section>
            <section>
              <p class="site-sheet-label">{NAV.other.label}</p>
              {other.map((l) => (
                <a href={l.href} data-nav-point={l.href} data-current={mark(l.href)} class="site-sheet-entry">
                  <span class="site-sheet-name">{l.name}</span>
                </a>
              ))}
              <a href={NAV.other.foot.href} data-nav-point={NAV.other.foot.href} data-current={mark(NAV.other.foot.href)} class="site-sheet-foot">{NAV.other.foot.label}</a>
            </section>
          </div>
        </div>
      </details>
      {NAV.points.map((p) => (
        <a href={p.href} data-nav-point={p.href} data-current={mark(p.href)} class="site-point">{p.label}</a>
      ))}
    </nav>

    {/* The theme toggle: cycles auto → light → dark → auto. Auto (default) follows the OS. The
        icon shows the current MODE (monitor = auto, sun = light, moon = dark); it is driven by
        [data-theme-mode] on <html>, set by the controller in Base.astro. A paper page has one
        ground under both themes, so the stylesheet below takes the control off the bar there. */}
    <button type="button" data-theme-toggle class="site-theme" aria-label={t(locale, 'theme.toggle')} title={t(locale, 'theme.toggle')}>
      <svg class="i-auto" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="12" rx="1.5" /><path d="M8 20h8M12 16v4" /></svg>
      <svg class="i-sun" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><circle cx="12" cy="12" r="4.2" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6l1.4 1.4M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4l1.4-1.4M18 6l1.4-1.4" /></svg>
      <svg class="i-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" /></svg>
    </button>
  </div>

  {/* —— a phone: one button, and the whole menu opens inline under the bar ——
      A native <details> laid over the row: its summary is the row's right end, its body the
      menu. The summary spans the bar so the body can be the bar's full width, but only the
      button inside it takes the pointer — the name on the left stays a link. */}
  <details data-menu class="site-menu">
    <summary aria-label={t(locale, 'nav.menu')}>
      <span class="site-menu-btn">
        <span class="when-closed">{NAV.menu.open}</span>
        <span class="when-open">{NAV.menu.close}</span>
      </span>
    </summary>
    <nav class="site-menu-panel" aria-label={NAV.aria.site}>
      <section>
        <p class="site-sheet-label">{NAV.research.label}</p>
        {research.map((l) => (
          <a href={l.href} data-nav-point={l.href} data-current={mark(l.href)} class="site-sheet-entry">
            <span class="site-sheet-name">{l.name}</span>
            {l.line && <span class="site-sheet-line">{l.line}</span>}
          </a>
        ))}
      </section>
      <section>
        <p class="site-sheet-label">{NAV.other.label}</p>
        {other.map((l) => (
          <a href={l.href} data-nav-point={l.href} data-current={mark(l.href)} class="site-sheet-entry">
            <span class="site-sheet-name">{l.name}</span>
          </a>
        ))}
        <a href={NAV.other.foot.href} data-nav-point={NAV.other.foot.href} data-current={mark(NAV.other.foot.href)} class="site-sheet-foot">{NAV.other.foot.label}</a>
      </section>
      <div class="site-menu-points">
        {NAV.points.map((p) => (
          <a href={p.href} data-nav-point={p.href} data-current={mark(p.href)}>{p.label}</a>
        ))}
      </div>
    </nav>
  </details>
</header>

<style>
  /* The bar's two faces are its own on every page: the grotesque for its labels, the serif
     for the names in its sheet. Its COLOURS are the page's — the frame's tokens — so it is
     paper on a paper page and mono elsewhere. */
  .site-bar {
    --bar-sans: 'Schibsted Grotesk Variable', ui-sans-serif, system-ui, sans-serif;
    --bar-serif: 'Literata Variable', 'Iowan Old Style', Georgia, serif;
    --bar-gutter: clamp(16px, 4.45vw, 64px);
    --bar-soft: var(--line-soft, var(--color-line));
    position: relative;
    z-index: 30;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-fg);
    font-family: var(--bar-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.25;
  }
  .site-bar a {
    color: inherit;
    text-decoration: none;
  }
  .site-bar-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 40px;
    max-width: 1440px;
    margin-inline: auto;
    padding-inline: var(--bar-gutter);
  }
  .site-bar-name {
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* —— the four points —— */
  .site-nav {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 100%;
    margin-left: auto;
  }
  .site-point {
    position: relative;
    display: flex;
    align-items: center;
    gap: 6px;
    height: 100%;
    text-transform: uppercase;
    cursor: pointer;
    user-select: none;
  }
  .site-point:hover,
  .site-drop[open] > .site-point {
    color: var(--color-fg-muted);
  }
  /* The page the reader is on: a hairline of ink sitting on the bar's own bottom rule. A bar
     of capitals marks position with a rule, never with a hue. */
  .site-point[data-current]::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-fg);
  }
  summary {
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .site-caret {
    width: 0;
    height: 0;
    border-inline: 3.5px solid transparent;
    border-top: 5px solid currentColor;
  }
  .site-drop[open] .site-caret {
    transform: rotate(180deg);
  }

  /* —— the sheet under Projects —— */
  .site-drop {
    position: relative;
    display: flex;
    align-items: center;
    height: 100%;
  }
  .site-drop-hold {
    position: absolute;
    right: -12px;
    top: 100%;
    z-index: 40;
    padding-top: 6px;
  }
  .site-sheet {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: 28px;
    width: min(600px, calc(100vw - 2 * var(--bar-gutter)));
    padding: 18px 22px 16px;
    background: var(--color-bg);
    border: 1px solid var(--color-fg);
    box-shadow: 0 18px 40px -18px rgb(22 20 18 / 0.45);
    letter-spacing: 0;
    font-weight: 400;
  }
  .site-sheet section,
  .site-menu-panel section {
    display: flex;
    flex-direction: column;
  }
  .site-sheet-label {
    margin: 0;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-fg);
    color: var(--color-fg-muted);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .site-sheet-entry {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 8px 0;
    border-bottom: 1px solid var(--bar-soft);
  }
  .site-sheet-name {
    font-family: var(--bar-serif);
    font-size: 17px;
    line-height: 1.25;
  }
  .site-sheet-line {
    color: var(--color-fg-muted);
    font-size: 12px;
    line-height: 1.35;
  }
  .site-sheet-entry:hover .site-sheet-name,
  .site-sheet-foot:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }
  /* Inside the sheet the mark cannot be a rule on the bar's edge — it is a rule beside the name. */
  .site-sheet-entry[data-current] {
    box-shadow: inset 2px 0 0 var(--color-fg);
    padding-left: 10px;
  }
  .site-sheet-foot {
    padding: 10px 0 0;
    font-size: 13px;
    font-weight: 600;
  }
  .site-sheet-foot[data-current] {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* —— the theme toggle —— */
  .site-theme {
    display: grid;
    place-items: center;
    flex: none;
    width: 28px;
    height: 28px;
    margin-left: -8px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-fg-muted);
    cursor: pointer;
  }
  .site-theme:hover {
    color: var(--color-fg);
  }
  /* A paper page has one ground under both themes, so the control comes off the bar there —
     unless the page holds a guest in the mono skin (.pp-guest), which still follows it. */
  :global(:root[data-surface='paper']:not(:has(.pp-guest))) .site-theme {
    display: none;
  }

  /* —— a phone —— */
  .site-menu {
    display: none;
  }
  @media (max-width: 859.98px) {
    .site-bar {
      position: sticky;
      top: 0;
    }
    .site-bar-row {
      gap: 8px;
      height: 56px;
      /* room for the menu button the <details> lays over this row's right end */
      padding-right: calc(var(--bar-gutter) + 72px + 8px);
    }
    .site-nav {
      display: none;
    }
    .site-bar-name {
      display: flex;
      flex-direction: column;
      gap: 1px;
      min-width: 0;
      font-size: 11px;
      letter-spacing: 0.1em;
    }
    /* On the narrowest phones the role line is a few pixels longer than its room; it is cut
       with an ellipsis rather than pushed under the button. */
    .site-bar-name span {
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .site-bar-sep {
      display: none;
    }
    .site-bar-role {
      font-weight: 500;
      color: var(--color-fg-muted);
    }
    .site-theme {
      margin-left: auto;
      width: 36px;
      height: 44px;
    }

    .site-menu {
      display: block;
      margin-top: -56px;
      pointer-events: none;
    }
    .site-menu > summary {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      height: 56px;
      padding-inline: var(--bar-gutter);
      outline: none;
    }
    .site-menu-btn {
      display: grid;
      place-items: center;
      min-width: 72px;
      height: 44px;
      padding: 0 12px;
      border: 1px solid var(--color-fg);
      font-size: 12px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      cursor: pointer;
      pointer-events: auto;
    }
    .site-menu > summary:focus-visible .site-menu-btn {
      outline: 2px solid var(--color-ring);
      outline-offset: 2px;
    }
    .when-open {
      display: none;
    }
    .site-menu[open] .when-open {
      display: inline;
    }
    .site-menu[open] .when-closed {
      display: none;
    }
    .site-menu[open] .site-menu-btn {
      background: var(--color-fg);
      color: var(--color-bg);
    }
    .site-menu-panel {
      display: flex;
      flex-direction: column;
      gap: 16px;
      /* a long menu on a short screen scrolls inside the bar rather than off the screen */
      max-height: calc(100dvh - 56px);
      overflow-y: auto;
      padding: 6px var(--bar-gutter) 18px;
      border-top: 1px solid var(--color-fg);
      background: var(--color-bg);
      letter-spacing: 0;
      font-weight: 400;
      pointer-events: auto;
    }
    .site-menu-panel .site-sheet-label {
      padding: 8px 0 6px;
    }
    .site-menu-panel .site-sheet-entry {
      justify-content: center;
      min-height: 44px;
      padding: 10px 0;
    }
    .site-menu-panel .site-sheet-name {
      font-size: 19px;
    }
    .site-menu-panel .site-sheet-line {
      font-size: 12.5px;
    }
    .site-menu-panel .site-sheet-foot {
      display: flex;
      align-items: center;
      min-height: 44px;
      padding: 0;
      font-size: 14px;
    }
    .site-menu-points {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .site-menu-points a {
      display: grid;
      place-items: center;
      height: 44px;
      border: 1px solid var(--color-fg);
      font-size: 12px;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .site-menu-points a[data-current] {
      background: var(--color-fg);
      color: var(--color-bg);
    }
  }
</style>

<script>
  // The bar's three behaviours, bound once on the document (which survives every page
  // transition) and re-applied per disclosure, because a bar that was NOT persisted comes back
  // as fresh DOM after a swap:
  //   · close any open disclosure on outside-click or Escape, and keep at most one open;
  //   · open the Projects sheet under a resting pointer and close it when the pointer leaves —
  //     only where there IS a resting pointer ((hover: hover)); on a touch screen the native
  //     <details> toggle is the whole behaviour;
  //   · re-derive the current-page mark after a navigation.
  const all = () => [...document.querySelectorAll<HTMLDetailsElement>('[data-menu], [data-nav-drop]')]
  const hovers = window.matchMedia('(hover: hover) and (pointer: fine)')

  let documentBound = false
  const wireNav = (): void => {
    for (const d of all()) {
      if (d.dataset.navBound) continue
      d.dataset.navBound = 'on'
      d.addEventListener('toggle', () => {
        if (d.open) for (const other of all()) if (other !== d) other.open = false
      })
      if (!d.hasAttribute('data-nav-drop')) continue
      d.addEventListener('pointerenter', (e) => {
        if (hovers.matches && e.pointerType === 'mouse') d.open = true
      })
      d.addEventListener('pointerleave', (e) => {
        if (hovers.matches && e.pointerType === 'mouse') d.open = false
      })
      // Under a resting pointer the sheet is already open when the word is clicked, and the
      // native toggle would close it in the reader's face. A mouse click therefore only ever
      // opens; leaving closes. A keyboard "click" (detail 0) keeps the native toggle.
      d.querySelector('summary')?.addEventListener('click', (e) => {
        if (!hovers.matches || e.detail === 0) return
        e.preventDefault()
        d.open = true
      })
    }

    // The bar is persisted across page transitions, so its server-rendered current-page mark
    // belongs to the page the reader arrived on, not the one they are reading. Re-derive it.
    const here = location.pathname.replace(/\/+$/, '') || '/'
    for (const link of document.querySelectorAll<HTMLElement>('[data-nav-point]')) {
      const href = link.dataset.navPoint || ''
      const current = href === '/' ? here === '/' : here === href || here.startsWith(`${href}/`)
      if (current) link.dataset.current = 'on'
      else delete link.dataset.current
    }
    // The Projects word is current when any entry of its sheet is.
    for (const drop of document.querySelectorAll<HTMLDetailsElement>('[data-nav-drop]')) {
      const summary = drop.querySelector('summary')
      if (!summary) continue
      if (drop.querySelector('a[data-current]')) summary.dataset.current = 'on'
      else delete summary.dataset.current
    }

    if (documentBound) return
    documentBound = true
    document.addEventListener('click', (e) => {
      for (const d of all()) {
        if (d.open && !d.contains(e.target as Node)) d.open = false
      }
    })
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') for (const d of all()) d.open = false
    })
  }

  wireNav()
  document.addEventListener('astro:page-load', wireNav)
  // The theme toggle is wired centrally in Base.astro (single source of truth).
</script>

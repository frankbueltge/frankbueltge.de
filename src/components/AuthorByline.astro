---
// The source line under a page. Until 2026-07-16 it pointed every page at lab-pipelines; Frank's
// decision that day (wording private: link the right repository or drop the line) made it
// path-based. Since 2026-11-02 the paths come from the register instead of a list kept here:
// src/lib/source-code.ts names each work's code, its page and its method sheet both link it, and
// a page with no code of its own (the hub, About, the legal pages) renders no line at all.
//
// The line used to open with "An instrument —". The wording canon keeps that word for what runs
// quietly and feeds a project (the Observatory); most pages carrying the line are experiments or
// practices, so the line now says only what holds for all of them.
import { sourceFor } from '@/lib/source-code'

const sourceUrl = sourceFor(Astro.url.pathname)
---

{
  sourceUrl && (
    <aside class="mx-auto max-w-3xl px-4 pb-6 text-xs text-fg-faint">
      <p>
        Method and sources disclosed,{' '}
        <a href={sourceUrl} target="_blank" rel="noreferrer" class="underline transition-colors hover:text-fg">
          source code open
        </a>
        .
      </p>
    </aside>
  )
}

---
// src/components/ops/LabSix.astro — the lab's six strongest experiments, ranked, the band the
// entrance opens with (since 2026-11-13; the order and every card's words in src/lib/ops/lab-six.ts
// and EDITION.lab). Server-rendered whole, no script: the first card large with its still beside
// its words, then two side by side, then three — one ordered list, laid
// out in tiers by the stylesheet. Every card is one link, named by its title, spread
// over the card. No style attribute; the tones and the duotone switch are src/styles/edition.css.
import { ThumbMarkShape } from '@/components/experiments/ThumbMarkShape'
import { EDITION } from '@/config/edition-wording'
import { THUMB_BOX } from '@/lib/experiments/thumbnails'
import { labPlate, labTier, type LabCard } from '@/lib/ops/lab-six'
import { STILL_FRAME } from '@/lib/ops/shelf-stills'
import { fill } from '@/lib/ops/since'

interface Props {
  cards: LabCard[]
  /** the page's own link helper */
  link: (href: string) => string
  headingId: string
}

const { cards, link, headingId } = Astro.props
const L = EDITION.lab
---
<div class="ed-lab">
  <div class="ed-lab-head">
    <h2 id={headingId}>{L.title}</h2>
    <span class="ed-lab-sub">{L.sub}</span>
  </div>

  <ol class="ed-lab-six">
          {cards.map((card) => (
            <li class={`ed-lab-card ed-lab-card--tier-${labTier(card.rank)}`}>
              <div class:list={['ed-lab-frame', !card.still && 'ed-lab-frame--plate']}>
                {card.still ? (
                  <>
                    <img
                      class="ed-duo ed-duo--light"
                      src={card.still.src}
                      alt={card.still.alt}
                      width={STILL_FRAME.width}
                      height={STILL_FRAME.height}
                      loading={card.rank === 1 ? 'eager' : 'lazy'}
                      decoding="async"
                    />
                    {card.still.dark && (
                      <img
                        class="ed-duo ed-duo--dark"
                        src={card.still.dark}
                        alt={card.still.alt}
                        width={STILL_FRAME.width}
                        height={STILL_FRAME.height}
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                  </>
                ) : card.mini ? (
                  <span class="ed-lab-plate">
                    <span class="ed-lab-plate-kind">{L.mini}</span>
                    <svg class="ed-lab-mini" viewBox={`0 0 ${THUMB_BOX.width} ${THUMB_BOX.height}`} role="img" aria-label={`${card.title}: ${card.mini.draws}`}>
                      {card.mini.marks.map((mark) => <ThumbMarkShape mark={mark} />)}
                    </svg>
                    <span class="ed-lab-plate-reading">{card.mini.readout}</span>
                  </span>
                ) : (
                  <span class="ed-lab-plate" aria-hidden="true">
                    <span class="ed-lab-plate-kind">{card.kind}</span>
                    <span class="ed-lab-plate-reading">{labPlate(card)}</span>
                  </span>
                )}
              </div>
              <div class="ed-lab-text">
                <p class="ed-lab-kicker"><span class="ed-lab-rank">{L.rank(card.rank)}</span>{card.line && <> · {card.line}</>}</p>
                <h3 class="ed-lab-title"><a class="ed-lab-link" href={link(card.href)}>{card.title}</a></h3>
                <p class="ed-lab-sentence">{card.sentence}</p>
                <p class="ed-lab-reason">{card.reason}</p>
                <p class="ed-lab-meta">{card.kind} · {card.when}</p>
                {card.rank === 1 && <p class="ed-lab-open" aria-hidden="true">{fill(L.open, { kind: card.kind })}</p>}
              </div>
            </li>
          ))}
  </ol>

  <p class="ed-lab-foot"><a class="ed-link" href={link(L.all.href)}>{L.all.label}</a></p>
</div>

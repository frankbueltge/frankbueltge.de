---
// The selected-works shelf (2026-10-17): the list of cards, without a heading of its own, because
// the edition heads it in its own voice as one of its sections (HomeEdition.astro). The dossier for
// curators and press showed it too, with each pick's reason, until it left the site on 2026-11-02.
//
// What stands here is src/config/selected-works.ts, read through src/lib/ops/selected-works.ts:
// nothing on a card is typed in this file. A card is one link, as the edition's briefs are.
//
// A card without a still gets a plate that says so, never a picture made for it (the rule of the
// score's newest-piece card, src/components/ecology/score/PracticePart.astro). The plate is hidden
// from assistive technology: a missing picture is nothing to announce, and its kind word stands in
// the card's meta line as well.
//
// On the edition (since 2026-10-22) the list holds the whole pool of finished pieces
// (src/lib/ops/shelf-pool.ts) and shows the first `shown`, the hand-chosen picks; the rest stand
// hidden, and the edition's script draws a new eight from all of them on every visit, a pinned
// piece always among them (SELECTED_WORKS.pinned, which leads the pool). A hidden
// card's still is lazy, so it loads only once the draw shows it.
import { SELECTED_WORKS } from '@/config/selected-works'
import type { ShelfCard } from '@/lib/ops/selected-works'
import { STILL_FRAME } from '@/lib/ops/shelf-stills'

interface Props {
  cards: ShelfCard[]
  /** an internal address as the page links it (the edition's locale helper), external ones as they are */
  link?: (href: string) => string
  /** the edition: how many of the cards stand without JavaScript; the rest are the pool's */
  shown?: number
}

const { cards, link = (href: string) => href, shown = cards.length } = Astro.props
const W = SELECTED_WORKS
const to = (href: string) => (href.startsWith('/') ? link(href) : href)
---

<ul class="ed-shelf ed-shelf--edition" data-ed-shelf-shown={shown}>
  {cards.map((card, i) => (
    <li
      class={['ed-shelf-card', card.voice ? `pp-voice-${card.voice}` : 'ed-shelf-card--house'].join(' ')}
      hidden={i >= shown}
      data-ed-shelf-pinned={card.pinned ? '' : undefined}
    >
      <a class="ed-shelf-link" href={to(card.href)}>
        <span class={['ed-shelf-frame', card.still ? '' : 'ed-shelf-frame--plate'].filter(Boolean).join(' ')}>
          {card.still ? (
            <img src={card.still.src} alt={card.still.alt} width={STILL_FRAME.width} height={STILL_FRAME.height} loading="lazy" decoding="async" />
          ) : (
            <span class="ed-shelf-plate" aria-hidden="true">
              <span class="ed-shelf-plate-kind">{card.kind}</span>
              <span class="ed-shelf-plate-note">{W.plate(card.kind)}</span>
            </span>
          )}
        </span>
        <span class="ed-shelf-maker">{card.maker}</span>
        <span class="ed-shelf-title">{card.title}</span>
        {card.sentence && <span class="ed-shelf-line">{card.sentence}</span>}
        <span class="ed-shelf-meta">{card.kind} · {card.when}</span>
      </a>
    </li>
  ))}
</ul>

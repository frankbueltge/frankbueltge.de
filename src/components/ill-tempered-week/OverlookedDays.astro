---
// The days of one edition of Overlooked: which headline each day gave the piece, from which field, on which
// instrument; and which motifs ended with their day because the newest day no longer names their field.
import { FIELD, INSTRUMENT, weekday, type Overlooked } from '@/lib/ill-tempered-week/albums'

interface Props {
  piece: Overlooked
}

const { piece } = Astro.props
---

<ol class="itw-days mt-5">
  {piece.days.map((d) => (
    <li>
      <span class="font-mono text-mono-sm text-fg-muted">{weekday(d.day)} · {FIELD[d.field]} · {INSTRUMENT[d.instrument]}</span>
      <span class="block">“{d.text}”</span>
    </li>
  ))}
</ol>
{piece.silenced_after_their_day.length > 0 && (
  <p class="mt-3 font-mono text-mono-sm text-fg-muted">
    Ended with its day in this edition, because {weekday(piece.newest_day)} no longer names it: {piece.silenced_after_their_day.map((f) => FIELD[f]).join(', ')}.
  </p>
)}

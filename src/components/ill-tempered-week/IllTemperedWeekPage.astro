---
// THE ILL-TEMPERED WEEK — a week of the web's attention, composed (2026-11-09; method:
// docs/design/2026-11-08-common-time-method.md). Since 2026-11-14 the page says first, in plain words, how the data
// becomes sound, and then gives each piece its score: a drawing of what sounds when, from which day and which
// headline, with a playhead that follows the piece's player and a click that jumps it (the islands in this folder,
// their geometry in src/lib/ill-tempered-week/score*.ts). Every number is read at build time from the albums' own
// records (src/data/ill-tempered-week/<week>.json), which the renderer wrote beside the audio; the links come from the
// committed day files the records name (src/lib/ill-tempered-week/sources.ts). The page plays the newest complete
// album and, while a week runs, that week's Overlooked so far; every album also has a page of its own
// (AlbumPage.astro, /ill-tempered-week/<week>/), so its scores stay when it leaves this page.
// Since 2026-11-14 evening (Frank's choice of that day, wording private) the page opens with the album as a track
// list of three equal pieces; a piece's score unfolds under the list when it plays (one at a time, the script at the
// end), the running week is a strip with its player, and every album is listed with its players.
import SheetHead from '@/components/experiments/SheetHead.astro'
import SheetFoot from '@/components/experiments/SheetFoot.astro'
import AlbumPieces from '@/components/ill-tempered-week/AlbumPieces.astro'
import { clock, formedTurn, formedUnison, readAlbums, span, weekday } from '@/lib/ill-tempered-week/albums'
import { formSays } from '@/lib/ill-tempered-week/score-forms'
import { albumPath, frontPage } from '@/lib/ill-tempered-week/pages'
import '@/styles/experiment-sheet.css'
import '@/styles/ill-tempered-week.css'

const REPO = 'https://github.com/frankbueltge/frankbueltge.de'
const link = 'underline decoration-line underline-offset-4 hover:decoration-fg'

const { album, growing, earlier } = frontPage(readAlbums())
const o = album.pieces.overlooked
const u = album.pieces.unison
const t = album.pieces.turn
const g = growing?.pieces.overlooked
const recordHref = (week: string): string => `${REPO}/blob/main/src/data/ill-tempered-week/${week}.json`
const badges = growing && g
  ? [`${album.title}, complete`, `${growing.title}, edition ${g.edition} of 7`]
  : [album.title, album.complete ? 'complete' : `edition ${o.edition} of 7`]
const all = [...(growing ? [growing] : []), album, ...earlier]
const tracks = [
  { id: 'overlooked', no: 'I · chamber ensemble', title: 'Overlooked', p: o, says: 'Each day the headline that drew the least attention is said once, answered and kept as a motif; by the end of the week they all sound together.' },
  ...(u ? [{ id: 'unison', no: 'II · strings, brass, timpani', title: 'Unison', p: u, says: formedUnison(u) ? formSays('unison', u.form) : 'Every war signal a string glissando; each day they glide towards one chord as far as the press agreed on one story.' }] : []),
  ...(t ? [{ id: 'turn', no: 'III · electronics', title: 'Turn', p: t, says: formedTurn(t) ? formSays('turn', t.form) : 'The signals about AI as a rhythmicon of the platforms: the more signals, the fuller the bar; one bar marks where the week turned.' }] : []),
]
---

<main id="main" class="sheet mx-auto w-full max-w-5xl flex-1 px-4 py-10 sm:py-14">
  <SheetHead
    kicker="From the nightly-ledger line"
    title="the ill-tempered week"
    sub="A week of the web’s attention, composed. Each week is an album, a Contrapunctus numbered by the week, pressed day by day from Common Ground: what was overlooked, where the press agreed, when the week turned."
    badges={badges}
    stamp={span(album.days)}
  />

  <section id="itw-album" class="mb-16" aria-label="The newest album">
    <p class="kicker mb-1">The newest album · {span(album.days)} · {album.complete ? 'complete' : `edition ${o.edition} of 7`}</p>
    <h2 class="itw-albumtitle"><a class={link} href={albumPath(album.week)}>{album.title}</a></h2>
    <ol class="itw-tracks">
      {tracks.map((k) => (
        <li class="itw-track">
          <p class="font-mono text-mono-sm text-fg-muted">{k.no} · {clock(k.p.seconds)}</p>
          <h3 class="itw-tracktitle">{k.title}</h3>
          <p class="text-sm leading-relaxed text-fg-muted">{k.says}</p>
          <audio id={`itw-audio-${k.id}`} class="itw-player" controls preload="metadata" src={k.p.audio}></audio>
          <p class="font-mono text-mono-sm text-fg-muted">
            <a class={link} href={`#${k.id}`} data-itw-open={k.id}>score</a> · <a class={link} href={k.p.audio} download>download</a> · CC BY 4.0
          </p>
        </li>
      ))}
    </ol>
    <p class="mt-4 font-mono text-mono-sm text-fg-faint itw-foldhint" hidden>Press play on a piece and its score opens here.</p>
    <div class="mt-8">
      <AlbumPieces album={album} folded />
    </div>
  </section>

  {growing && g && (
    <section id="this-week" class="itw-strip mb-16" aria-label="This week so far">
      <p class="kicker">This week, still pressing</p>
      <div class="itw-stripline">
        <a class={link} href={albumPath(growing.week)}><b>{growing.title}</b></a>
        <span class="font-mono text-mono-sm text-fg-muted">{span(growing.days)} · Overlooked, edition {g.edition} of 7, to {weekday(g.newest_day)} · {clock(g.seconds)}</span>
        <span class="itw-editions" role="img" aria-label={`edition ${g.edition} of 7`}>{Array.from({ length: 7 }, (_, i) => <i class={i < g.edition ? 'is-on' : ''}></i>)}</span>
      </div>
      <audio id="itw-audio-growing" class="itw-player mt-3" controls preload="metadata" src={g.audio}></audio>
      <p class="mt-2 max-w-3xl text-sm leading-relaxed text-fg-muted">
        Pressed again from the start each day the ledger adds one, so each edition hears the week differently. Once Sunday is in,
        <em>Unison</em> and <em>Turn</em> join it and the album moves up. Its score: <a class={link} href={albumPath(growing.week)}>{growing.title}</a>.
      </p>
    </section>
  )}

  <section class="mb-16" aria-label="All albums">
    <p class="kicker mb-3">All albums</p>
    <ul class="itw-albums">
      {all.map((a) => (
        <li>
          <p class="font-mono text-mono-sm text-fg-muted">
            <a class={link} href={albumPath(a.week)}>{a.title}</a> · {span(a.days)} · {a.complete ? 'complete' : `edition ${a.pieces.overlooked.edition} of 7`} · <a class={link} href={albumPath(a.week)}>pieces and scores</a> · <a class={link} href={recordHref(a.week)}>record</a>
          </p>
          <div class="itw-albumplayers">
            {Object.entries(a.pieces).map(([name, p]) => (
              <p><span class="font-mono text-mono-sm">{name}</span> <audio class="itw-player mt-1" controls preload="none" src={p!.audio}></audio></p>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </section>

  <section class="mb-12 max-w-4xl" aria-labelledby="itw-how">
    <h2 id="itw-how" class="kicker mb-3">How the data becomes sound</h2>
    <p class="max-w-3xl leading-relaxed">
      Every day, the ledger of <a class={link} href="/trending">Common Ground</a> records what the web’s big platforms paid attention
      to: news headlines, posts, searches, markets and page views, each with its place in its own platform’s ranking that day. That
      place is a headline’s attention. The house sorts the signals into the thirteen fields of its map, from war and violence to AI and
      its harms. Each piece of the album reads the same week through one written rule and turns what it finds into notes.
    </p>
    <ol class="itw-steps">
      <li><b>A rule picks the data.</b> The least attended headline of each day; every signal about war; every signal about AI, by platform.</li>
      <li><b>Speech gives the pitch.</b> A synthetic voice reads each headline aloud. In <em>Overlooked</em> the rise and fall of that reading becomes the melody; in <em>Unison</em> its pitch is where a string begins.</li>
      <li><b>The ledger gives the time.</b> The day, the hour a story was published and how many signals a day held decide when a note sounds and how fast the music moves.</li>
      <li><b>Field and attention give the sound.</b> A field has its instrument, a platform family its vowel; a more attended signal plays higher, longer and louder.</li>
    </ol>
    <p class="mt-5 max-w-3xl leading-relaxed text-fg-muted">
      The tuning is just intonation on A: scale, chord and rhythm are all taken from the harmonics of A1 = 55 Hz, and no interval is
      tempered. The instruments are real recordings, each note retuned exactly; the voices are synthetic. No music model is involved
      and nothing is played by hand: every note follows from a committed day file, and the album’s record names each file it read. The
      scores are drawn from those records. Press play on a piece and its score opens under the album: time runs from left to right, a
      line follows the music, a click jumps, and a mark names the day and the headline it comes from, with links to the sources.
    </p>
  </section>

  <section class="mb-12 max-w-3xl" aria-label="How it is made">
    <p class="kicker mb-3">How it is made</p>
    <p class="leading-relaxed text-fg-muted">
      The counts are the house’s one count over Common Ground’s day files, the fields those of the map; a headline’s attention is
      its place among the signals of its own platform that day (Hacker News points, Bluesky posts, Trends searches, Polymarket
      dollars, Wikipedia views, Google News editions). Instruments: {album.library}. Voices: {album.voices}. Each album’s record
      hashes every day file it read: <a class={link} href={recordHref(album.week)}>{album.title}</a>{growing && <>, <a class={link} href={recordHref(growing.week)}>{growing.title}</a></>}.
    </p>
    <p class="mt-4 leading-relaxed text-fg-muted">
      The scores are drawn from those records and from the renderer’s fixed form, the same rules the code plays: when each part
      enters, how much softer an older motif sounds, how long a glissando lasts. Where a record does not hold a time, the score works
      it out from the times it does hold: before 14 November 2026 the records did not keep how long a headline was said, so
      <em> Overlooked</em> places the end of each sentence from the bar its motif begins on, to within half a bar, and says so when you
      point at it. From then on, the press records it, with the answering notes, the ensemble’s entries and the double bass’s notes.
    </p>
  </section>

  <SheetFoot links={[
    { href: '/werke/ill-tempered-week', label: 'method sheet' },
    { href: `${REPO}/tree/main/src/data/ill-tempered-week`, label: 'the records', external: true },
    { href: `${REPO}/tree/main/scripts/ill-tempered-week`, label: 'the renderer', external: true },
    { href: '/trending', label: 'Common Ground' },
  ]} />
</main>

<script>
  // One score at a time: the piece that plays opens its section under the track list, the others fold away.
  // Without this script every section stays open (the server render is the floor).
  const album = document.getElementById('itw-album')
  if (album) {
    const pieces = ['overlooked', 'unison', 'turn']
    album.classList.add('itw-folding')
    album.querySelector<HTMLElement>('.itw-foldhint')?.removeAttribute('hidden')
    const open = (id: string, scroll: boolean): void => {
      for (const piece of pieces) document.getElementById(piece)?.classList.toggle('is-open', piece === id)
      album.querySelector<HTMLElement>('.itw-foldhint')?.toggleAttribute('hidden', true)
      if (scroll) document.getElementById(id)?.scrollIntoView({ block: 'start' })
    }
    document.addEventListener(
      'play',
      (e) => {
        const el = e.target
        if (!(el instanceof HTMLAudioElement)) return
        // one player at a time on this page
        for (const other of document.querySelectorAll('audio')) if (other !== el) other.pause()
        const id = el.id.replace('itw-audio-', '')
        if (pieces.includes(id)) open(id, false)
      },
      true,
    )
    album.addEventListener('click', (e) => {
      const a = (e.target as Element).closest<HTMLAnchorElement>('[data-itw-open]')
      if (!a) return
      e.preventDefault()
      open(a.dataset.itwOpen!, true)
    })
    const fromHash = (): void => {
      const id = location.hash.slice(1)
      if (pieces.includes(id)) open(id, true)
    }
    fromHash()
    window.addEventListener('hashchange', fromHash)
  }
</script>

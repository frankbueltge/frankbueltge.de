---
// site-v2 work order §5 (decisions doc 2026-07-16 §1.7): a trimmed footer — Contact, Impressum,
// Datenschutz, the license line, GitHub. The previous four-column footer (Explore/Projects/
// Connect) duplicated what the hub-era TopBar nav + hub's own "where works travel"/"also on
// this site" sections already cover; this keeps only what belongs on every single page.
// Re-skin 2a (2026-09-02): same six links, same two lines, cut from the same recipe as the
// top bar — ghost buttons on the shadcn primitive, so a footer link now has a hover surface
// and a focus ring instead of only a colour change. The forced-dark island stays exactly as
// it was (see the style block): the footer is black under both themes.
import { SITE } from '@/lib/site'
import { NAMING } from '@/config/naming'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/ui/cn'

const year = 2026
const link = cn(buttonVariants({ variant: 'ghost', size: 'sm' }), '-mx-2 px-2 text-fg-muted hover:text-fg')
---

<footer class="mt-24 border-t border-line/60 footer-dark">
  <!-- Asymmetric vertical padding: the row keeps its generous run-in from the border
       above, but sits close to the copyright line below, so mark and fine print read
       as one block instead of two drifting apart. -->
  <div class="mx-auto flex max-w-5xl flex-col gap-8 px-6 pb-6 pt-14 sm:flex-row sm:items-start sm:justify-between">
    <!-- The mark stands alone: the name beside it was redundant with the copyright
         line below, which is also why alt="" is still right — the logo is decorative
         here, and "Frank Bültge" already reaches screen readers from that line. -->
    <img src="/logo.webp" alt="" width="96" height="96" class="h-24 w-24 rounded-full" />

    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
      <a href="/seed" class={link}>Offer a seed</a>
      <a href="/post#digest" class={link}>Digest</a>
      <a href="/contact" class={link}>Contact</a>
      <a href="/impressum" class={link}>Impressum</a>
      <a href="/datenschutz" class={link}>Datenschutz</a>
      <a href={SITE.social.github} target="_blank" rel="noreferrer" class={link}>GitHub</a>
    </nav>
  </div>

  <div class="mx-auto flex max-w-5xl flex-col gap-2 px-6 pb-10 font-mono text-mono text-fg-faint sm:flex-row sm:items-center sm:justify-between">
    <span>© {year} {SITE.name}</span>
    <span>{NAMING.footer.licenseLine}</span>
  </div>
</footer>

<style>
  /* The footer is a permanent dark island: pure-black ground with the dark
     palette's text tokens, so it stays black + legible even under the light theme. */
  .footer-dark {
    background-color: #000;
    /* establish the footer's own text colour from its (forced-dark) tokens, so bare text
       like the "Frank Bültge" name is light-on-black even under the light theme (otherwise
       it inherits the light theme's dark body colour → invisible). */
    color: var(--color-fg);
    --color-fg: #f4f4f5;
    --color-fg-muted: #a3a3a8;
    --color-fg-faint: #8b8b92;
    --color-line: #242427;
    --color-accent: #c2c2c8;
    /* The island's surfaces, added with the ghost-button links of the re-skin (2026-09-02):
       a hover surface reads bg-hover → --color-panel-2, and under the LIGHT theme that token
       is pure white — a white plate flashing on a black footer. The ring is re-declared for
       the same reason: --color-ring is substituted once, at :root, so the value inherited
       down here would be the light theme's near-black ink, invisible on this ground. */
    --color-panel: #141414;
    --color-panel-2: #1c1c1c;
    --color-ring: var(--color-accent);
  }
</style>

---
// src/components/atelier/ProcessFigure.astro — „What the practice is working on":
// Inhalt zuerst, Diagramm als Auswahl darunter.
//
// Die erste Fassung (30.07.) zeigte beim Auswählen einer Linie nur Telemetrie: Tage, Zugzahl,
// Dateinamen. Franks Einwand traf: „Wenn ich ‚negative parallax' auswähle, erfahre ich nichts
// über dieses Projekt und den Fortschritt oder aktuellen Stand und worum es dabei geht. Das
// macht alles nicht übersichtlicher für jemanden, der die Website zum ersten Mal besucht,
// sondern eher noch komplexer."
//
// Daraus die Umkehrung: Nicht das Diagramm ist der Gegenstand, sondern die Arbeit. Oben eine
// Karte mit dem, was die Praxis GERADE tut — voller Titel, worum es geht (wörtlich aus der
// Akte), wo es steht, die letzten Züge mit ihren sprechenden Überschriften. Das Diagramm
// darunter ist die Auswahl dafür: ein Klick tauscht die Karte.
//
// Alle Texte sind Zitat, keine Paraphrase (src/lib/atelier/lineText.ts, unter Test). Die
// Praxis schreibt selbst gut genug; eine zweite Stimme darüber wäre eine Verfälschung.
import { getCollection } from 'astro:content'
import { baueProzessbild, STATIONEN, type Ausgang } from '@/lib/atelier/process'
import { absicht, urteil, zugTitel } from '@/lib/atelier/lineText'
import '@/styles/atelier-process.css'

const all = await getCollection('atelier')

// Rohtexte der Akten — für die Prosa, die die Collection-Daten nicht hergeben.
const scoreRaw = import.meta.glob('/src/content/atelier/projects/*/SCORE.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>
const decisionRaw = import.meta.glob('/src/content/atelier/projects/*/DECISION.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>
const journalRaw = import.meta.glob('/src/content/atelier/journal/*.md', {
  eager: true, query: '?raw', import: 'default',
}) as Record<string, string>

const idAus = (pfad: string) => pfad.replace('/src/content/atelier/projects/', '').split('/')[0]

const proj = new Map<string, { dateien: string[]; data: Record<string, unknown> }>()
for (const e of all) {
  if (!e.id.startsWith('projects/')) continue
  const [, id, stueck] = e.id.split('/')
  if (!id || !stueck) continue
  const eintrag = proj.get(id) ?? { dateien: [], data: {} }
  eintrag.dateien.push(`${stueck.toUpperCase()}.md`)
  if (stueck.toLowerCase() === 'score') eintrag.data = (e.data ?? {}) as Record<string, unknown>
  proj.set(id, eintrag)
}

const journalIds = Object.keys(journalRaw).map((p) => p.replace('/src/content/atelier/', '').replace(/\.md$/, ''))
const heute = new Date().toISOString().slice(0, 10)

/** Loses Collection-Schema ⇒ YAML parst `created:` zu einem Date-OBJEKT. String(date) gäbe
 * „Sat Jul 18 2026 …" und NaN in jeder Datumsrechnung — daran ist der erste Build gescheitert. */
function alsDatum(v: unknown): string {
  if (v instanceof Date && !Number.isNaN(v.getTime())) return v.toISOString().slice(0, 10)
  const s = String(v ?? '').trim()
  if (/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0, 10)
  const p = Date.parse(s)
  return Number.isNaN(p) ? '' : new Date(p).toISOString().slice(0, 10)
}

const bild = baueProzessbild(
  [...proj.entries()].map(([id, v]) => ({
    id,
    title: String(v.data.title ?? id),
    status: String(v.data.status ?? ''),
    disposition: String(v.data.disposition ?? ''),
    created: alsDatum(v.data.created),
    dateien: v.dateien,
  })),
  journalIds,
  heute,
)

// Die Hafen-Namen sagen, was geschah — nicht, wie es zu bewerten ist: „closed unfinished"
// statt „failed", weil das Protokoll Schließen und Weitermachen gleichrangig stellt.
const HAFEN: Record<Ausgang, { label: string; farbe: string; erklaerung: string }> = {
  PUBLISH: { label: 'published', farbe: 'var(--pr-publish)', erklaerung: 'through the gate — a work on the site' },
  PUBLICATION_CANDIDATE: { label: 'at the gate', farbe: 'var(--pr-candidate)', erklaerung: 'proposed as a work; the publication decision is human' },
  ARCHIVE_AS_STUDY: { label: 'kept as study', farbe: 'var(--pr-study)', erklaerung: 'not published, not discarded — it feeds later lines' },
  KILL: { label: 'closed unfinished', farbe: 'var(--pr-kill)', erklaerung: 'ended on purpose; closing costs what continuing costs' },
  OPEN: { label: 'in progress', farbe: 'var(--pr-open)', erklaerung: 'no verdict yet' },
}

// ————————————————————————————————————————— Inhalt je Linie ————————————————
const MONATE = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
const tag = (d: string) => (/^\d{4}-\d{2}-\d{2}$/.test(d) ? `${Number(d.slice(8, 10))} ${MONATE[Number(d.slice(5, 7)) - 1]}` : d)

interface Inhalt {
  id: string
  titel: string
  ausgang: Ausgang
  hafen: string
  farbe: string
  eroeffnet: string
  tage: number
  aktiv: boolean
  worumEsGeht: string | null
  warumSoGeendet: string | null
  zuege: Array<{ datum: string; titel: string }>
  zugZahl: number
}

const inhalte: Inhalt[] = bild.linien.map((l) => {
  const scorePfad = Object.keys(scoreRaw).find((p) => idAus(p) === l.id)
  const decPfad = Object.keys(decisionRaw).find((p) => idAus(p) === l.id)
  const wl = (proj.get(l.id)?.data.work_line ?? {}) as Record<string, unknown>
  // Die Überschriften der Journaleinträge lesen sich wie das Inhaltsverzeichnis der
  // Untersuchung — sie sind der bessere Fortschrittsanzeiger als jede Zahl.
  const zuege = Object.entries(journalRaw)
    .map(([pfad, roh]) => {
      const datei = pfad.split('/').pop() ?? ''
      const m = /^(\d{4}-\d{2}-\d{2})-(.+)\.md$/.exec(datei)
      return m && m[2].startsWith(l.name) ? { datum: m[1], titel: zugTitel(roh, datei) } : null
    })
    .filter((z): z is { datum: string; titel: string } => z !== null)
    .sort((a, b) => b.datum.localeCompare(a.datum))

  return {
    id: l.id,
    titel: l.title,
    ausgang: l.ausgang,
    hafen: HAFEN[l.ausgang].label,
    farbe: HAFEN[l.ausgang].farbe,
    eroeffnet: l.created,
    tage: l.tage,
    aktiv: l.aktiv,
    worumEsGeht: scorePfad ? absicht(scoreRaw[scorePfad], wl.work_intention) : null,
    warumSoGeendet: decPfad ? urteil(decisionRaw[decPfad]) : null,
    zuege: zuege.slice(0, 4),
    zugZahl: l.zuege,
  }
})

/** Die Kopfzeile der Karte. „0 days · 0 moves" wäre wahr und trotzdem irreführend — ein am
 * selben Tag veröffentlichtes Werk hat nicht „nichts" getan, es hat nur keinen eigenen
 * Journaltakt. Also: Nulldauer heißt „same day", und eine Nullzahl an Zügen wird gar nicht
 * erst genannt. Dieselbe Regel steht unten im Skript — beide müssen zusammen geändert werden. */
function kicker(i: { hafen: string; eroeffnet: string; tage: number; zugZahl: number; aktiv: boolean }): string {
  const teile = [i.hafen, `opened ${tag(i.eroeffnet)}`, i.tage === 0 ? 'same day' : `${i.tage} day${i.tage === 1 ? '' : 's'}`]
  if (i.zugZahl > 0) teile.push(`${i.zugZahl} move${i.zugZahl === 1 ? '' : 's'}`)
  if (i.aktiv) teile.push('still running')
  return teile.join(' · ')
}

// Startkarte: die Linie am Tor, sonst die jüngste laufende, sonst die jüngste überhaupt.
const start =
  inhalte.find((i) => i.ausgang === 'PUBLICATION_CANDIDATE') ??
  [...inhalte].reverse().find((i) => i.aktiv) ??
  inhalte[inhalte.length - 1]

// ————————————————————————————————————————— Geometrie ——————————————————————
const linien = bild.linien
const N = Math.max(linien.length, 1)
const ZEILE = 27
const OBEN = 50
const W = 1180
const H = OBEN + N * ZEILE + 30
const LABEL_W = 186
const T_X0 = LABEL_W + 14
const T_X1 = 690
const HAFEN_X = 812
const HAFEN_W = 174

const tms = (d: string) => Date.parse(`${d}T00:00:00Z`)
const T0 = linien.length ? Math.min(...linien.map((l) => tms(l.created))) : tms(heute)
const T1 = Math.max(tms(bild.stand), T0 + 86_400_000)
const xOf = (d: string) => T_X0 + ((tms(d) - T0) / (T1 - T0)) * (T_X1 - T_X0)

const gesamt = linien.length || 1
const HOEHE = N * ZEILE - 6
let lauf = OBEN
const haefen = bild.haefen.map((h) => {
  const hh = Math.max(24, (h.anzahl / gesamt) * HOEHE - 6)
  const y = lauf
  lauf += hh + 6
  return { ...h, y, h: hh, mitte: y + hh / 2, ...HAFEN[h.ausgang] }
})
const hafenVon = new Map(haefen.map((h) => [h.ausgang, h]))

const platz = new Map<string, number>()
for (const h of haefen) {
  const drin = linien.filter((l) => l.ausgang === h.ausgang)
  drin.forEach((l, i) => platz.set(l.id, h.y + (h.h / (drin.length + 1)) * (i + 1)))
}

const bahnen = linien.map((l, i) => {
  const y = OBEN + i * ZEILE + ZEILE / 2
  const x1 = xOf(l.created)
  const x2 = Math.max(xOf(l.letzterZug ?? l.created), x1 + 7)
  const zy = platz.get(l.id) ?? y
  const hafen = hafenVon.get(l.ausgang)
  const farbe = hafen?.farbe ?? 'var(--pr-open)'
  const cx = (x2 + HAFEN_X) / 2
  const tail = `M ${x2.toFixed(1)} ${y} C ${cx.toFixed(1)} ${y}, ${cx.toFixed(1)} ${zy.toFixed(1)}, ${HAFEN_X} ${zy.toFixed(1)}`
  return {
    ...l, y, x1, x2, zy, farbe, tail,
    laenge: Math.round(x2 - x1 + (HAFEN_X - x2) * 1.15),
    hafenLabel: hafen?.label ?? 'in progress',
    striche: l.zugTage.map((d) => xOf(d)),
  }
})

const kuerze = (s: string, n = 19) => (s.length > n ? `${s.slice(0, n - 1)}…` : s)
const marken = [T0, (T0 + T1) / 2, T1]
  .filter((ts) => Number.isFinite(ts))
  .map((ts) => {
    const d = new Date(ts).toISOString().slice(0, 10)
    return { x: xOf(d), label: tag(d) }
  })

const hPub = hafenVon.get('PUBLISH')
const hKand = hafenVon.get('PUBLICATION_CANDIDATE')
const TOR_X = HAFEN_X + HAFEN_W + 16
const torBogen =
  hPub && hKand
    ? {
        d: `M ${TOR_X} ${hKand.mitte} C ${TOR_X + 26} ${hKand.mitte}, ${TOR_X + 26} ${hPub.mitte}, ${TOR_X + 2} ${hPub.mitte + 4}`,
        tx: TOR_X + 8,
        ty: (hPub.mitte + hKand.mitte) / 2 - 2,
      }
    : null

// Die Ausbeute in einem Satz — für alle, die gar kein Diagramm lesen wollen.
const z = (a: Ausgang) => bild.haefen.find((h) => h.ausgang === a)?.anzahl ?? 0
const ausbeute = [
  `${linien.length} questions opened since ${tag(linien[0]?.created ?? heute)}`,
  z('PUBLISH') > 0 ? `${z('PUBLISH')} became a work` : null,
  z('PUBLICATION_CANDIDATE') > 0 ? `${z('PUBLICATION_CANDIDATE')} waits at the gate` : null,
  z('ARCHIVE_AS_STUDY') > 0 ? `${z('ARCHIVE_AS_STUDY')} kept as studies` : null,
  z('KILL') > 0 ? `${z('KILL')} closed on purpose` : null,
].filter(Boolean).join(' · ')

const linienDaten = Object.fromEntries(
  inhalte.map((i) => [i.id, {
    t: i.titel, o: i.hafen, e: tag(i.eroeffnet), d: i.tage, m: i.zugZahl, a: i.aktiv,
    c: i.farbe, ab: i.worumEsGeht, v: i.warumSoGeendet,
    z: i.zuege.map((zg) => [tag(zg.datum), zg.titel]),
  }]),
)
---

<section class="at-proc" aria-labelledby="proc-title" data-proc>
  <div class="at-proc-head">
    <h2 class="at-proc-title" id="proc-title">What the practice is working on</h2>
  </div>
  <p class="at-proc-lead">
    A line begins as a question, is worked in moves, and ends in one of four ways — as a work,
    as a candidate waiting for a human decision, as a study kept for later, or closed on
    purpose. Pick one below to read it.
  </p>

  {/* Die Karte ist der Gegenstand; das Diagramm darunter wählt nur aus. */}
  <article class="at-now" data-card data-color={start?.farbe ?? 'var(--color-line)'}>
    {start && (
      <>
        <p class="n-kicker">
          <span class="n-dot" aria-hidden="true"></span>
          {kicker(start)}
        </p>
        <h3 class="n-title">{start.titel}</h3>
        {start.worumEsGeht && <p class="n-about">{start.worumEsGeht}</p>}
        {start.warumSoGeendet && <p class="n-verdict">{start.warumSoGeendet}</p>}
        {start.zuege.length > 0 && (
          <div class="n-moves">
            <p class="n-moves-h">its last moves</p>
            <ul>
              {start.zuege.map((zg) => (
                <li><span class="m-date">{tag(zg.datum)}</span> {zg.titel}</li>
              ))}
            </ul>
          </div>
        )}
        <p class="n-more"><a href={`/atelier/projects#${start.id}`}>read the full record →</a></p>
      </>
    )}
  </article>

  <p class="at-proc-yield">{ausbeute}</p>

  <ul class="at-proc-legend" data-legend>
    {haefen.map((h) => (
      <li>
        <button class="at-proc-lg" type="button" aria-pressed="false" data-filter={h.ausgang} title={h.erklaerung} data-lg-color={h.farbe}>
          <span class="dot" aria-hidden="true"></span>
          <span>{h.label}</span>
          <span class="n">{h.anzahl}</span>
        </button>
      </li>
    ))}
  </ul>

  <figure class="at-proc-figure">
    <div class="at-proc-scroll" data-plot>
      <svg
        class="at-proc-svg"
        viewBox={`-8 0 ${W + 8} ${H}`}
        role="img"
        aria-label={`Every research line on a time axis: ${linien.length} opened; ${haefen.map((h) => `${h.label} ${h.anzahl}`).join(', ')}. Select a line to read it above.`}
      >
        <defs>
          <marker id="pr-arrow" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
            <path d="M 0 1 L 7 4 L 0 7 z" fill="var(--color-fg-faint)" />
          </marker>
        </defs>
        <g class="pr-axis">
          <line x1={T_X0} y1={OBEN - 22} x2={T_X1} y2={OBEN - 22} />
          {marken.map((m) => <text x={m.x} y={OBEN - 30} text-anchor="middle">{m.label}</text>)}
        </g>

        {torBogen && (
          <g class="pr-gate">
            <path d={torBogen.d} fill="none" marker-end="url(#pr-arrow)" />
            <text x={torBogen.tx} y={torBogen.ty} text-anchor="start">THE GATE</text>
            <text x={torBogen.tx} y={torBogen.ty + 13} text-anchor="start">a human decides</text>
          </g>
        )}

        {haefen.map((h) => (
          <g class="pr-harbour" data-harbour={h.ausgang}>
            <title>{`${h.label} — ${h.erklaerung}`}</title>
            <rect x={HAFEN_X} y={h.y} width={HAFEN_W} height={h.h} rx="9" fill={h.farbe} opacity="0.13" />
            <rect x={HAFEN_X} y={h.y} width="3.5" height={h.h} rx="1.75" fill={h.farbe} />
            <text class="h-count" x={HAFEN_X + 14} y={h.mitte - 2} fill={h.farbe}>{h.anzahl}</text>
            <text class="h-label" x={HAFEN_X + 14} y={h.mitte + 13} fill="var(--color-fg-muted)">{h.label}</text>
          </g>
        ))}

        {bahnen.map((b, i) => (
          <g
            class="pr-line"
            tabindex="0"
            role="button"
            data-line={b.id}
            data-out={b.ausgang}
            data-title={b.title}
            data-color={b.farbe}
            data-harbour={b.hafenLabel}
            aria-label={`${b.title} — ${b.hafenLabel}. Select to read it.`}
            data-len={String(b.laenge)}
            data-delay={`${i * 45}ms`}
          >
            <title>{`${b.title} — ${b.hafenLabel}`}</title>
            <text class="pr-label" x="6" y={b.y + 4}>{kuerze(b.title)}</text>
            <text class="pr-date" x={LABEL_W} y={b.y + 4} text-anchor="end">{b.created.slice(5)}</text>
            <path class="pr-tail" d={b.tail} stroke={b.farbe} />
            <line class:list={['pr-band', { 'is-open': b.ausgang === 'OPEN' }]} x1={b.x1} y1={b.y} x2={b.x2} y2={b.y} stroke={b.farbe} />
            {b.striche.map((x) => <line class="pr-move" x1={x} y1={b.y - 3.2} x2={x} y2={b.y + 3.2} />)}
            {b.aktiv && <circle cx={b.x2} cy={b.y} r="4.4" fill="none" stroke={b.farbe} stroke-width="1.4" opacity="0.9" />}
            <rect class="pr-focus" x={-8} y={b.y - 12} width={W} height={24} rx="6" fill="none" stroke="none" />
            <rect class="pr-rowhit" x={-8} y={b.y - 12} width={HAFEN_X + 8} height={24} fill="transparent" />
          </g>
        ))}
      </svg>
    </div>
    <div class="at-proc-tip" data-tip hidden aria-hidden="true"></div>
  </figure>

  <details class="at-proc-table">
    <summary>every line as a table</summary>
    <table>
      <thead>
        <tr><th>line</th><th>opened</th><th>days</th><th>moves</th><th>records</th><th>outcome</th></tr>
      </thead>
      <tbody>
        {linien.map((l) => (
          <tr>
            <td>{l.title}</td>
            <td>{l.created}</td>
            <td>{l.tage}</td>
            <td>{l.zuege}</td>
            <td>{STATIONEN.filter((s) => l.stationen[s]).join(' · ')}</td>
            <td>{HAFEN[l.ausgang].label}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>

  <p class="at-proc-prov">
    Every sentence above is quoted from the practice's own records, not summarised: what a line
    is about comes from its score, why it ended from its decision, its moves from the journal.
    Derived at build time; {bild.ohneLinie} journal entries in this period belong to no line
    (sessions, protocol changes, encounters) and are not counted as moves.
  </p>

  <script type="application/json" data-lines set:html={JSON.stringify(linienDaten)}></script>
</section>

<script>
  // Zwei Stufen: HOVER zeigt einen Tooltip am Zeiger (nichts zum Hinfahren, `pointer-events:
  // none`), KLICK tauscht die Karte oben. Die erste Fassung hängte die Tafel an `mouseleave`
  // — der Link darin war dadurch unerreichbar (Frank, 30.07.).
  const wurzel = document.querySelector<HTMLElement>('[data-proc]')
  if (wurzel) {
    const karte = wurzel.querySelector<HTMLElement>('[data-card]')!
    const tip = wurzel.querySelector<HTMLElement>('[data-tip]')!
    const rahmen = wurzel.querySelector<HTMLElement>('.at-proc-figure')!
    const daten = JSON.parse(wurzel.querySelector<HTMLElement>('[data-lines]')?.textContent ?? '{}') as Record<string, any>
    const bahnen = [...wurzel.querySelectorAll<SVGGElement>('.pr-line')]
    const knoepfe = [...wurzel.querySelectorAll<HTMLButtonElement>('[data-filter]')]
    let filter: string | null = null
    let gewaehlt: string | null = null

    // Die je Element wechselnden Werte kommen über `data-*` und werden hier gesetzt, NICHT
    // als `style`-Attribut im Markup. Grund ist die CSP: `security.csp` in astro.config.mjs
    // schreibt ein `style-src` mit Hashes, und sobald ein Hash darin steht, ignoriert der
    // Browser das daneben stehende `'unsafe-inline'` — Style-Attribute lassen sich nicht
    // hashen und fallen still weg. Genau das war der Befund vom 25.07. (die
    // e2e-automation-Balken standen deshalb alle auf 100 %). Eine Zuweisung über das CSSOM
    // ist davon nicht betroffen, weil die CSP das Parsen von Markup regelt, nicht
    // Schreibzugriffe zur Laufzeit. `scripts/drift-check.mjs` hält die Regel in CI.
    karte.style.setProperty('--n-color', karte.dataset.color ?? 'var(--color-line)')
    for (const k of knoepfe) {
      if (k.dataset.lgColor) k.style.setProperty('--lg-color', k.dataset.lgColor)
    }
    for (const bahn of bahnen) {
      const { len, delay } = (bahn as unknown as SVGElement & { dataset: DOMStringMap }).dataset
      if (len) bahn.style.setProperty('--len', len)
      if (delay) bahn.style.setProperty('--delay', delay)
    }

    const esc = (s: unknown) =>
      String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string)

    /** Spiegel der serverseitigen Regel: Nulldauer heißt „same day", Nullzüge werden nicht
     * genannt — „0 moves" wäre wahr und trotzdem irreführend. */
    function kicker(d: any): string {
      const teile = [d.o, `opened ${d.e}`, d.d === 0 ? 'same day' : `${d.d} day${d.d === 1 ? '' : 's'}`]
      if (d.m > 0) teile.push(`${d.m} move${d.m === 1 ? '' : 's'}`)
      if (d.a) teile.push('still running')
      return teile.join(' · ')
    }

    function zeigeKarte(id: string) {
      const d = daten[id]
      if (!d) return
      karte.style.setProperty('--n-color', d.c)
      karte.innerHTML =
        `<p class="n-kicker"><span class="n-dot" aria-hidden="true"></span>${esc(kicker(d))}</p>` +
        `<h3 class="n-title">${esc(d.t)}</h3>` +
        (d.ab ? `<p class="n-about">${esc(d.ab)}</p>` : '') +
        (d.v ? `<p class="n-verdict">${esc(d.v)}</p>` : '') +
        (d.z.length
          ? `<div class="n-moves"><p class="n-moves-h">its last moves</p><ul>` +
            d.z.map((zg: [string, string]) => `<li><span class="m-date">${esc(zg[0])}</span> ${esc(zg[1])}</li>`).join('') +
            `</ul></div>`
          : '') +
        `<p class="n-more"><a href="/atelier/projects#${esc(id)}">read the full record →</a></p>`
      karte.animate?.([{ opacity: 0.4 }, { opacity: 1 }], { duration: 220, easing: 'ease-out' })
    }

    function zeigeTip(g: SVGGElement, ev: MouseEvent) {
      const d = g.dataset
      tip.innerHTML = `<b class="t-title">${esc(d.title)}</b><span class="t-meta">${esc(d.harbour)} — click to read it</span>`
      tip.style.setProperty('--t-color', d.color ?? 'var(--color-line)')
      tip.hidden = false
      const r = rahmen.getBoundingClientRect()
      const b = tip.getBoundingClientRect()
      const x = Math.min(Math.max(ev.clientX - r.left + 16, 8), Math.max(8, r.width - b.width - 8))
      const y = Math.max(ev.clientY - r.top - b.height - 14, 6)
      tip.style.transform = `translate(${x}px, ${y}px)`
    }

    function male(vorschau: SVGGElement | null) {
      wurzel!.toggleAttribute('data-dim', Boolean(vorschau) || Boolean(filter))
      for (const g of bahnen) {
        const an = vorschau ? g === vorschau : !filter || g.dataset.out === filter
        g.toggleAttribute('data-on', an)
        g.toggleAttribute('data-chosen', Boolean(gewaehlt) && g.dataset.line === gewaehlt)
      }
    }

    function waehle(id: string) {
      if (!daten[id]) return
      gewaehlt = id
      zeigeKarte(id)
      male(null)
      karte.scrollIntoView({ block: 'nearest', behavior: 'smooth' })
    }

    for (const g of bahnen) {
      g.addEventListener('mouseenter', (ev) => { zeigeTip(g, ev as MouseEvent); male(g) })
      g.addEventListener('mousemove', (ev) => zeigeTip(g, ev as MouseEvent))
      g.addEventListener('mouseleave', () => { tip.hidden = true; male(null) })
      g.addEventListener('focus', () => male(g))
      g.addEventListener('blur', () => male(null))
      g.addEventListener('click', () => waehle(g.dataset.line ?? ''))
      g.addEventListener('keydown', (ev) => {
        const k = (ev as KeyboardEvent).key
        if (k !== 'Enter' && k !== ' ') return
        ev.preventDefault()
        waehle(g.dataset.line ?? '')
      })
    }

    for (const b of knoepfe) {
      b.addEventListener('click', () => {
        const wert = b.dataset.filter ?? null
        filter = filter === wert ? null : wert
        for (const x of knoepfe) x.setAttribute('aria-pressed', String(x.dataset.filter === filter))
        male(null)
      })
    }
  }
</script>

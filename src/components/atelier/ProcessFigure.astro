---
// src/components/atelier/ProcessFigure.astro — "The Passage": what happens to a question in this
// practice, and what closing one costs.
//
// ARCHITECTURE, and why it is this way round (Frank, 2026-07-30, still binding): the CONTENT comes
// first and the drawing below it is the SELECTOR for that content. The first version showed
// telemetry on selection — days, move counts, filenames — and his objection landed: "If I select
// 'negative parallax' I learn nothing about this project, its progress or current state, or what it
// is about. That does not make things clearer for a first-time visitor, it makes them more
// complex." So the card at the top carries the practice's OWN prose — the full title, what the line
// is about (quoted from its score), why it ended (quoted from its decision), its last moves with
// their own headings — and a click on the sheet swaps it. Nothing here is paraphrased; the practice
// writes well enough that a second voice over it would be a falsification.
//
// WHAT WP6a CHANGED, and what it deliberately did not:
//   · PORTED onto the shared WP3 primitives — the hand-rolled tooltip becomes dataviz/Readout
//     (which clamps to the FIGURE's box and flips at its edges instead of only clamping), the
//     hand-rolled legend becomes dataviz/LegendFilter in MULTI mode (two outcomes can now be shown
//     at once; single-select could only ever isolate one), the hand-rolled <details> table becomes
//     dataviz/TableFallback, and the card becomes dataviz/DetailPanel — which is what gives it
//     prev/next: until now a visitor could click ONE line and had to hunt for the next; the stepper
//     walks all of them in the order they were opened, with ← and →.
//   · GAINED the ledger gutter: beside every closed line, what closing it cost, verbatim from that
//     line's own DECISION.md (src/lib/atelier/ledger.ts). Where the record states none, the sheet
//     says so in words. Where a line is still running, it says nothing — a running line has not
//     closed, so it has no closing cost to be missing.
//   · MOVED its geometry into src/lib/atelier/passage.ts, so a guided tour can render a build-time
//     still per scene from the SAME builder the live figure uses (a second generator would drift),
//     and so the drawing is unit-tested rather than eyeballed.
//   · KEPT, unchanged: the content-first order, quotes never paraphrase, the readout is never a hit
//     target (the first draft hung the panel off `mouseleave` and its link ran away when you aimed
//     at it — Frank, 30.07.), every line reachable by keyboard, a native <title> on every mark, the
//     full table below, the provenance line, and the reduced-motion gate on the draw-in.
//   · ONE duplicated rule REMOVED: the "same day / no zero moves" kicker rule used to exist twice,
//     server-side and in the client script, with a comment warning that both had to change
//     together. It is now computed once at build time (ATELIER_NARRATIVE.passage.kickerLine) and
//     the client only re-prints it.
//
// Two house rules this file is built around, both load-bearing:
//   · the figure container is `position: relative` (atelier-process.css `.at-proc-figure`) because
//     the Readout is placed in the FIGURE's own coordinate space — dataviz/readout.ts house rule 1;
//   · no `is:inline` script and no `style=""` anywhere: the site's CSP hashes bundled module
//     scripts and silently drops style attributes, so every dynamic style goes through
//     dataviz/runtime.ts's setVars (scripts/drift-check.mjs guards it).
import DetailPanel from '@/components/dataviz/DetailPanel.astro'
import LegendFilter from '@/components/dataviz/LegendFilter.astro'
import Readout from '@/components/dataviz/Readout.astro'
import TableFallback from '@/components/dataviz/TableFallback.astro'
import { jsonScriptPayload } from '@/lib/dataviz/runtime'
import {
  buildPassageSvg,
  dayLabel,
  PASSAGE_COLUMNS,
  passageRows,
  passageViewBox,
  type PassageModel,
} from '@/lib/atelier/passage'
import type { Ausgang } from '@/lib/atelier/process'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'
import '@/styles/atelier-process.css'

export interface Props {
  /** the sheet, assembled from the committed records by src/lib/atelier/passage-data.ts. Passed in
   *  rather than built here so the guided tour's build-time stills come from the same model this
   *  figure draws — two assemblies would drift. */
  model: PassageModel
  /** DOM id a tour drives this figure by — must match the tour's own focus.figure */
  id?: string
  /** the figure's own heading; omitted renders none (a tour supplies its own title) */
  heading?: string
  /**
   * Whether this instance renders the passage's own table + provenance. `false` when the figure
   * sits inside components/dataviz/Tour.astro's figure slot: that slot is `hidden` until JS reveals
   * it, and the table is the figure's DATA FLOOR — it must never be the thing that disappears when
   * scripts don't run. The tour composition renders the record itself, outside the pinned column.
   * The LEGEND and the CARD stay inside: the card is server-rendered with a real line in it, and
   * identity on this sheet is carried by every line's own label and by that same table, never by
   * colour alone, with or without JS.
   */
  withRecord?: boolean
}

const { model, id = 'atelier-passage', heading, withRecord = true } = Astro.props
const w = ATELIER_NARRATIVE.passage

const svg = buildPassageSvg(model, {
  gapLine: w.gapLine,
  gateLabel: w.gateLabel,
  gutterLabel: w.gutterLabel,
})

// ————————————————————————————————— the card, the legend, the payload ——————
const SWATCH: Record<Ausgang, string> = {
  PUBLISH: 'var(--pr-publish)',
  PUBLICATION_CANDIDATE: 'var(--pr-candidate)',
  ARCHIVE_AS_STUDY: 'var(--pr-study)',
  KILL: 'var(--pr-kill)',
  OPEN: 'var(--pr-open)',
}
const legendItems = model.harbours.map((h) => ({
  key: h.outcome,
  label: h.label,
  hint: h.hint,
  count: h.count,
  swatch: SWATCH[h.outcome],
}))

const payload = model.lines.map((l, i) => ({
  key: l.key,
  outcome: l.outcome,
  title: l.title,
  kicker: w.kickerLine({
    harbour: l.harbour,
    opened: dayLabel(l.opened),
    days: l.days,
    moves: l.moves,
    active: l.active,
  }),
  about: l.about,
  verdict: l.verdict,
  moves: l.moveList.map((m) => [dayLabel(m.date), m.title]),
  ledger: l.ledger ? { text: l.ledger.full, source: l.ledger.source } : null,
  gap: l.outcome !== 'OPEN' && !l.active && !l.ledger,
  href: `/atelier/projects#${l.key}`,
  pos: w.positionLine(i + 1, model.lines.length),
  /** the viewBox a tour scene re-aims the live sheet at — the band around this line. Precomputed
   *  here because the crop maths belongs to the pure builder, not to a client script. */
  band: passageViewBox(model, l.key),
}))

// The opening card: the line at the gate, else the newest running one, else the newest overall.
const startIndex = Math.max(
  0,
  (() => {
    const gate = model.lines.findIndex((l) => l.outcome === 'PUBLICATION_CANDIDATE')
    if (gate !== -1) return gate
    const running = model.lines.map((l) => l.active).lastIndexOf(true)
    return running !== -1 ? running : model.lines.length - 1
  })(),
)
const start = payload[startIndex]

const rows = passageRows(model, w.gapLine, w.openLine)
const provenance = `${w.provenancePrefix} ${w.provenance.join(' · ')} — ${w.scaleNote}. As of ${
  model.asOf
}; ${model.unattachedMoves} journal entries in this period belong to no line (sessions, protocol changes, encounters) and are not counted as moves.`

const titleId = `${id}-title`
const legendLabelId = `${id}-legend-label`
---

<section class="at-proc" data-proc aria-labelledby={heading ? titleId : undefined}>
  {heading && (
    <div class="at-proc-head">
      <h2 class="at-proc-title" id={titleId}>{heading}</h2>
    </div>
  )}
  {heading && <p class="at-proc-lead">{w.lead}</p>}

  <p class="at-proc-key" id={legendLabelId}>{w.legendLabel}</p>
  <LegendFilter items={legendItems} mode="multi" labelledby={legendLabelId} />

  {/* The card IS the object; the sheet below only chooses which line it shows. It is server-
      rendered with a real line in it and opens visible, so a visitor without JS reads a whole
      record here rather than an empty box above a drawing. */}
  <DetailPanel id={`${id}-panel`} open pos={startIndex}>
    <Fragment slot="head">
      <p class="n-kicker">
        <span class="n-dot" aria-hidden="true"></span><span data-p-kicker>{start?.kicker}</span>
      </p>
      <h3 class="n-title" data-p-title>{start?.title}</h3>
    </Fragment>
    <Fragment slot="body">
      <p class="n-about" data-p-about hidden={!start?.about}>{start?.about}</p>
      <p class="n-verdict" data-p-verdict hidden={!start?.verdict}>{start?.verdict}</p>
      <div
        class="n-ledger"
        data-p-ledger-wrap
        data-gap-line={w.gapLine}
        data-gap={start?.gap ? '' : undefined}
        hidden={!start?.ledger && !start?.gap}
      >
        <p class="n-ledger-h">{w.panelLedgerHeading}</p>
        <p class="n-ledger-t" data-p-ledger>{start?.ledger ? start.ledger.text : w.gapLine}</p>
        <p class="n-ledger-src" data-p-ledger-src>{start?.ledger?.source ?? ''}</p>
      </div>
      <div class="n-moves" data-p-moves-wrap hidden={!start?.moves.length}>
        <p class="n-moves-h">{w.cardMovesHeading}</p>
        <ul data-p-moves>
          {start?.moves.map(([date, title]) => (
            <li><span class="m-date">{date}</span> {title}</li>
          ))}
        </ul>
      </div>
    </Fragment>
    <Fragment slot="foot">
      <a class="n-more" data-p-more href={start?.href}>{w.cardMore}</a>
      <span class="n-pos" data-p-pos>{start?.pos}</span>
    </Fragment>
  </DetailPanel>

  <figure class="at-proc-figure" data-proc-figure>
    <div class="at-proc-scroll">
      <div id={id} data-proc-svg set:html={svg} />
    </div>
    <Readout id={`${id}-readout`} maxWidth="34ch" />
  </figure>

  <p class="dv-prov at-proc-hint">{w.hint}</p>

  {withRecord && (
    <TableFallback
      summary={w.tableSummary}
      caption={w.tableCaption}
      columns={PASSAGE_COLUMNS}
      rows={rows}
      provenance={provenance}
    />
  )}

  <script type="application/json" data-proc-payload set:html={jsonScriptPayload(payload)} />
</section>

<script>
  import { isOn } from '@/lib/dataviz/filter'
  import { createReadout } from '@/lib/dataviz/readout'
  import { reducedMotion } from '@/lib/dataviz/runtime'
  import { buildSegments, step } from '@/lib/dataviz/stepper'
  import { ensureFigureReadyListener } from '@/lib/tour/engine'
  import type { FocusState } from '@/lib/tour/types'

  interface Line {
    key: string
    outcome: string
    title: string
    kicker: string
    about: string | null
    verdict: string | null
    moves: [string, string][]
    ledger: { text: string; source: string } | null
    gap: boolean
    href: string
    pos: string
    band: string
  }

  for (const root of document.querySelectorAll<HTMLElement>('[data-proc]')) {
    const figure = root.querySelector<HTMLElement>('[data-proc-figure]')
    const svgHost = root.querySelector<HTMLElement>('[data-proc-svg]')
    const readoutEl = root.querySelector<HTMLElement>('[data-dv-readout]')
    const panel = root.querySelector<HTMLElement>('[data-dv-panel]')
    const payloadEl = root.querySelector<HTMLElement>('[data-proc-payload]')
    const svg = svgHost?.querySelector<SVGSVGElement>('svg')
    if (!figure || !svgHost || !readoutEl || !panel || !payloadEl || !svg) continue

    let lines: Line[]
    try {
      lines = JSON.parse(payloadEl.textContent ?? '[]') as Line[]
    } catch {
      continue // no payload, no enhancement: the SVG's own <title>s and the table still work
    }
    const wholeView = svg.getAttribute('viewBox') ?? ''
    const byKey = new Map(lines.map((l) => [l.key, l]))
    const groups = [...svg.querySelectorAll<SVGGElement>('[data-key]')]
    const harbours = [...svg.querySelectorAll<SVGGElement>('.pr-harbour')]
    const readout = createReadout(readoutEl, figure)

    // one segment, the whole passage in the order the questions were opened — prev/next walks it
    // end to end, which is what a visitor could not do before (one click, one line, then hunt)
    const segmented = buildSegments(lines, () => 'the passage')

    let filter: string[] = []
    let dim: string[] = []
    let chosen: string | null = lines[Number(panel.dataset.dvPos ?? '0')]?.key ?? null

    // ——— the readout: hover and keyboard focus show the same glance ————————————————
    const showReadout = (l: Line, anchorX: number, anchorY: number) => {
      const node = document.createDocumentFragment()
      const head = document.createElement('b')
      head.className = 'r-head'
      head.textContent = l.title
      const meta = document.createElement('span')
      meta.className = 'r-meta'
      // the same first line the card carries — one wording, computed once at build time
      meta.textContent = l.kicker
      node.append(head, meta)
      readoutEl.dataset.out = l.outcome
      readout.show(node, { anchorX, anchorY })
    }

    /** Figure-local coordinates (readout house rule 1): the pointer for a mouse, the mark's own box
     *  for keyboard focus — so a tabbing visitor gets the readout at the line, not wherever the
     *  pointer happens to rest. */
    const anchorOf = (g: SVGGElement, ev?: MouseEvent): [number, number] => {
      const box = figure.getBoundingClientRect()
      if (ev) return [ev.clientX - box.left, ev.clientY - box.top]
      const r = g.getBoundingClientRect()
      return [r.left - box.left + r.width / 2, r.top - box.top + r.height / 2]
    }

    // ——— the card: the practice's own prose, one line at a time ————————————————————
    // The honest-gap sentence is READ OFF the server-rendered card rather than re-typed here, so
    // the wording lives exactly once (src/config/atelier-wording.ts) and no second English string
    // in a client script can drift away from it.
    const ledgerWrap = panel.querySelector<HTMLElement>('[data-p-ledger-wrap]')
    const ledgerGap = ledgerWrap?.dataset.gapLine ?? ''

    const setText = (sel: string, text: string) => {
      const el = panel.querySelector<HTMLElement>(sel)
      if (el) el.textContent = text
    }
    const setBlock = (sel: string, text: string | null) => {
      const el = panel.querySelector<HTMLElement>(sel)
      if (!el) return
      el.textContent = text ?? ''
      el.hidden = !text
    }

    const openAt = (pos: number, opts: { reveal?: boolean } = {}) => {
      const l = lines[pos]
      if (!l) return
      chosen = l.key
      panel.dataset.dvPos = String(pos)
      panel.dataset.out = l.outcome
      setText('[data-p-kicker]', l.kicker)
      setText('[data-p-title]', l.title)
      setBlock('[data-p-about]', l.about)
      setBlock('[data-p-verdict]', l.verdict)
      setText('[data-p-pos]', l.pos)

      if (ledgerWrap) {
        // three states, and the difference matters: the record's own words, the honest gap, or —
        // for a line still being worked — nothing at all, because it has not closed yet
        ledgerWrap.hidden = !l.ledger && !l.gap
        ledgerWrap.toggleAttribute('data-gap', l.gap)
        setText('[data-p-ledger]', l.ledger ? l.ledger.text : ledgerGap)
        setText('[data-p-ledger-src]', l.ledger ? l.ledger.source : '')
      }

      const movesWrap = panel.querySelector<HTMLElement>('[data-p-moves-wrap]')
      const movesList = panel.querySelector<HTMLElement>('[data-p-moves]')
      if (movesWrap && movesList) {
        movesWrap.hidden = l.moves.length === 0
        movesList.textContent = ''
        for (const [date, title] of l.moves) {
          const li = document.createElement('li')
          const d = document.createElement('span')
          d.className = 'm-date'
          d.textContent = date
          li.append(d, document.createTextNode(` ${title}`))
          movesList.append(li)
        }
      }

      const more = panel.querySelector<HTMLAnchorElement>('[data-p-more]')
      if (more) more.href = l.href

      panel.hidden = false
      paint()
      if (opts.reveal) {
        panel.scrollIntoView({ block: 'nearest', behavior: reducedMotion() ? 'auto' : 'smooth' })
      }
    }

    panel.addEventListener('dv:step', (ev) => {
      const at = Number(panel.dataset.dvPos ?? '0')
      const next = step(segmented, at, (ev as CustomEvent).detail.pos - at)
      if (next !== at) openAt(next, { reveal: true })
    })
    panel.addEventListener('dv:close', () => {
      panel.hidden = true
      chosen = null
      paint()
    })

    // ——— paint: filter, dim and selection are ATTRIBUTES; no mark ever moves ————————
    function paint() {
      for (const g of groups) {
        const key = g.dataset.key ?? ''
        const l = byKey.get(key)
        g.toggleAttribute('data-on', isOn(filter, l?.outcome ?? ''))
        g.toggleAttribute('data-dim', dim.includes(key))
        g.toggleAttribute('data-sel', chosen === key)
      }
      // the harbours follow the filter too — a lit harbour above a set of ghosted lines reads as
      // if the filter had not taken, and the count in it would be about lines that are not shown
      for (const h of harbours) h.toggleAttribute('data-on', isOn(filter, h.dataset.out ?? ''))
      // on the SVG, not the section: the build-time stills carry the same attribute and have no
      // section of their own (see buildPassageSvg)
      svg.toggleAttribute('data-filtered', filter.length > 0 || dim.length > 0)
    }

    root.addEventListener('dv:filter', (ev) => {
      filter = (ev as CustomEvent<{ keys: string[] }>).detail.keys
      paint()
    })

    for (const g of groups) {
      const l = byKey.get(g.dataset.key ?? '')
      if (!l) continue
      g.addEventListener('mouseenter', (ev) => showReadout(l, ...anchorOf(g, ev as MouseEvent)))
      g.addEventListener('mousemove', (ev) => showReadout(l, ...anchorOf(g, ev as MouseEvent)))
      g.addEventListener('mouseleave', () => readout.hide())
      g.addEventListener('focus', () => showReadout(l, ...anchorOf(g)))
      g.addEventListener('blur', () => readout.hide())
      g.addEventListener('click', () => openAt(lines.findIndex((x) => x.key === l.key), { reveal: true }))
      g.addEventListener('keydown', (ev) => {
        const k = (ev as KeyboardEvent).key
        if (k !== 'Enter' && k !== ' ') return
        ev.preventDefault()
        openAt(lines.findIndex((x) => x.key === l.key), { reveal: true })
      })
    }

    // ——— the tour handshake: this figure opts in, and knows nothing about any tour ————
    const apply = (focus: FocusState) => {
      // `filter: null` explicitly clears; `undefined` means this scene does not touch the filter
      if (focus.filter !== undefined) filter = focus.filter ?? []
      dim = focus.dim ?? []
      applyNotes(focus.annotate ?? [])
      const selected = focus.select ? byKey.get(focus.select) : undefined
      if (selected) {
        const pos = lines.findIndex((l) => l.key === selected.key)
        // no `reveal`: a tour scrolls the page itself, and a second scroll would fight it
        if (pos >= 0) openAt(pos)
      }
      // Re-aim the sheet the way the build-time stills are cropped, and by the same rule: a scene
      // that lifts the filter (`filter: null`) is about the whole passage, every other one about
      // one band of it. This is what keeps the ledger gutter — running text — at its designed size
      // in a pinned column instead of being scaled down to nothing. A viewBox is an ATTRIBUTE, so
      // the CSP has no quarrel with it.
      const whole = focus.filter === null || !selected
      svg.setAttribute('viewBox', whole ? wholeView : selected.band)
      svg.dataset.view = whole ? 'whole' : 'band'
      paint()
      // the legend buttons must agree with a scene-driven filter, or a visitor sees a filtered
      // sheet beside an unfiltered legend and cannot tell what is going on
      for (const b of root.querySelectorAll<HTMLButtonElement>('[data-dv-legend-key]')) {
        b.setAttribute('aria-pressed', String(filter.includes(b.dataset.dvLegendKey ?? '')))
      }
    }

    // A scene's call-outs are lettered as real SVG text at the line they name — the same place the
    // build-time stills letter them — created through the DOM rather than as markup, so no
    // innerHTML of data and nothing for the CSP to drop.
    const SVG_NS = 'http://www.w3.org/2000/svg'
    let noteLayer: SVGGElement | null = null
    const applyNotes = (notes: { key: string; text: string }[]) => {
      noteLayer?.remove()
      noteLayer = null
      if (!notes.length) return
      const layer = document.createElementNS(SVG_NS, 'g')
      for (const note of notes) {
        const band = svg.querySelector<SVGLineElement>(`[data-key="${CSS.escape(note.key)}"] .pr-band`)
        if (!band) continue
        const text = document.createElementNS(SVG_NS, 'text')
        text.setAttribute('class', 'pr-note')
        text.setAttribute('x', band.getAttribute('x1') ?? '0')
        text.setAttribute('y', String(Number(band.getAttribute('y1') ?? '0') - 10))
        text.textContent = note.text
        layer.append(text)
      }
      svg.append(layer)
      noteLayer = layer
    }

    paint()
    // The handshake, with the one guarantee the bare dispatch does not give. src/lib/tour/engine.ts
    // documents both registration orders as safe, and they are — but ONLY once something is
    // listening: `dv:figure-ready` is an ordinary event, so a figure whose bundle executes before
    // any Tour's does dispatches into an empty room and is never registered at all. Calling
    // ensureFigureReadyListener() here installs the shared (idempotent, one-per-page) listener
    // BEFORE this figure announces itself, so the registry is populated whichever bundle runs
    // first. This figure still knows nothing about any tour — it only makes sure the registry the
    // contract is built on exists. (Observed, not theorised: /atelier's chunk order put this script
    // first and every scene's focus went nowhere.)
    ensureFigureReadyListener()
    window.dispatchEvent(new CustomEvent('dv:figure-ready', { detail: { id: svgHost.id, apply } }))
  }
</script>

---
// src/components/atelier/tours/KilledOnThePivot.astro — the Atelier's guided tour of the
// retraction-signature line, composed: the WP5 tour engine (components/dataviz/Tour.astro) driving
// The Passage (components/atelier/ProcessFigure.astro), with the scene sequence and its verbatim
// quotes coming from src/lib/tour/atelier-pivot.ts.
//
// The progressive-enhancement ladder, in this composition's own terms:
//
//   1. NO JS — the tour's figure column stays `hidden`, and each scene shows its own build-time
//      still: a cropped, filtered render of the SAME builder the live sheet uses, so a still can
//      never drift from the figure it stands in for. Under the scenes, every line as a table with
//      its closing ledger verbatim and the file it came from. Complete, readable straight through.
//   2. WITH JS — the stills hide, ONE passage becomes pinned above the scenes and is driven scene
//      by scene (filter / select / dim / annotate). The last scene lifts the filter, so a visitor
//      who read to the end is left looking at the whole sheet, interactive.
//
// TWO deliberate departures from the studio's tour composition, both forced by what this figure IS:
//
//   · the figure is PINNED ABOVE the scenes, not beside them (single column — see the
//     `.dv-tour-body` override in atelier-process.css). The Passage is a wide sheet whose right-
//     hand column is running text: the ledger gutter. In the engine's default half-width column its
//     ten-pixel record type renders at about five pixels, i.e. the one thing this figure was built
//     to show becomes unreadable. A pinned drawing board with the account running underneath keeps
//     the gutter legible at every width, which is the whole point.
//   · the RECORD (table + provenance) is rendered HERE rather than by ProcessFigure, because the
//     tour's figure column is hidden without JS and the data floor must never be the thing that
//     disappears. Same reason, same shape as studio/tours/ThreeReturns.astro.
//
// One consequence worth stating plainly rather than discovering: The Passage's card is an
// initially-open DetailPanel, and an open panel owns the ←/→ keys (dataviz/stepper.ts's registry;
// Tour.astro yields to it by design). So on this page the arrow keys step the SHEET, line by line,
// and the tour is walked by scrolling — or, under reduced motion and on short touch viewports, by
// the engine's own prev/next buttons. Closing the card hands the arrows back to the tour.
import Tour from '@/components/dataviz/Tour.astro'
import TableFallback from '@/components/dataviz/TableFallback.astro'
import ProcessFigure from '@/components/atelier/ProcessFigure.astro'
import { pivotTour, PASSAGE_FIGURE } from '@/lib/tour/atelier-pivot'
import {
  buildPassageSvg,
  PASSAGE_COLUMNS,
  passageRows,
  type PassageModel,
} from '@/lib/atelier/passage'
import type { Scene } from '@/lib/tour/types'
import { ATELIER_NARRATIVE } from '@/config/atelier-wording'

export interface Props {
  model: PassageModel
}

const { model } = Astro.props
const w = ATELIER_NARRATIVE.passage

/**
 * One scene's build-time still, rendered from the same passage builder with that scene's own focus
 * applied. `focus.filter === null` is the tour's "lift the filter" signal, and it doubles as the
 * signal to render UNCROPPED: the closing scene is about the whole sheet, so its still shows every
 * line, while each earlier one crops to a band around the line it is talking about.
 */
const renderStill = (scene: Scene): string => {
  const liftsFilter = scene.focus.filter === null
  return buildPassageSvg(model, {
    filter: scene.focus.filter ?? undefined,
    dim: scene.focus.dim,
    select: scene.focus.select,
    annotate: scene.focus.annotate,
    cropTo: liftsFilter ? undefined : scene.focus.select,
    still: true,
    label: `${scene.heading} — ${w.tableCaption}`,
    gapLine: w.gapLine,
    gateLabel: w.gateLabel,
    gutterLabel: w.gutterLabel,
  })
}

const provenance = `${w.provenancePrefix} ${w.provenance.join(' · ')} — ${w.scaleNote}. As of ${model.asOf}.`
---

<div id="tour-killed-on-the-pivot" class="at-tour-wrap">
  <Tour tour={pivotTour} renderStill={renderStill}>
    <ProcessFigure slot="figure" model={model} id={PASSAGE_FIGURE} withRecord={false} />
  </Tour>

  <TableFallback
    summary={w.tableSummary}
    caption={w.tableCaption}
    columns={PASSAGE_COLUMNS}
    rows={passageRows(model, w.gapLine, w.openLine)}
    provenance={provenance}
  />
</div>

<style>
  .at-tour-wrap {
    scroll-margin-top: 3rem;
  }
</style>

<script>
  // NARROW SCREENS GET THE STILLS BACK.
  //
  // A phone has no room to pin a sheet this wide above a column of prose: measured at 390px, the
  // board held the key line and the card and clipped the drawing away entirely — the one thing it
  // exists to show. So below 900px the live column is dropped (atelier-process.css) and each
  // scene's own BUILD-TIME still is shown inline instead: the same cropped, filtered, annotated
  // render, from the same builder, which is the presentation the no-JS floor already uses.
  //
  // Why this is a script and not a media query: components/dataviz/Tour.astro hides the stills by
  // setting the `hidden` ATTRIBUTE, and Tailwind v4's preflight ships
  // `[hidden] { display: none !important }` inside a cascade layer — a layered !important
  // declaration outranks an unlayered one regardless of specificity, so no stylesheet rule can
  // re-show them. Removing the attribute is also the right answer for assistive technology: the
  // still becomes visible AND readable, instead of being painted over an element still marked
  // hidden. The tour engine is left untouched; this is one composition's choice about its own
  // figure, not a change to the shared contract.
  const NARROW = '(max-width: 900px)'

  for (const wrap of document.querySelectorAll<HTMLElement>('#tour-killed-on-the-pivot')) {
    const stills = [...wrap.querySelectorAll<HTMLElement>('[data-dv-still]')]
    if (stills.length === 0) continue
    const mql = matchMedia(NARROW)
    // The tour's own script hides the stills when it reveals the live figure; it may run before or
    // after this one, so the sync is re-run on the next frame as well as immediately.
    const sync = () => {
      for (const still of stills) still.hidden = !mql.matches
    }
    sync()
    requestAnimationFrame(sync)
    mql.addEventListener('change', sync)
  }
</script>

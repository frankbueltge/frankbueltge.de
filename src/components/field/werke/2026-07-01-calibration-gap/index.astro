---
import data from './data.json'

const CAP = data.fpr_scale_cap

// Bar geometry in SVG user units. The previous version computed
// min(value/CAP*100, 100) as a CSS percentage of a flex-track's rendered
// width, with null/zero drawn as a hairline at 0.15% of that width. TRACK
// below is the track's length in SVG user units, so the same formula,
// scaled to user units instead of percent, reproduces the same proportions
// -- this time as real rect geometry rather than an inline attribute the
// site's policy would drop.
const TRACK = 300 // bar length in SVG user units; equals BAR_VIEWBOX_W
const HAIRLINE = TRACK * 0.0015

function barLen(val: number | null): number {
  if (val === null || val === 0) return HAIRLINE
  return Math.min((val / CAP) * TRACK, TRACK)
}

function fmt(val: number | null, suffix = '%'): string {
  return val !== null ? `${val}${suffix}` : 'n/d'
}

const tools = data.tools
const cases = data.harm_cases
const sources = data.benchmark_sources
const specs = data.specification_sources

// Identifiers are rendered on the face from 2026-08-01. Until that date this work held eight
// identifiers in data.json and printed none of them: a reader on the published page could not
// follow a single source. Measured first-hand on the served page, 2026-07-31 — zero occurrences
// of doi.org, arxiv.org, aclanthology, or any cited news host. (The count read 'ten' until an
// independent Verifier enumerated the pre-repair file and found eight; corrected 2026-08-01.)
// The parameter admits `undefined` as well as `null`: `source_url_secondary` exists on
// only one harm-register row, so the array's inferred element type makes it optional and
// the narrower signature failed the site's type check (build feedback 2026-08-01,
// index.astro:208 — the first compile error this repair caused, and it was ours).
function shortUrl(url: string | null | undefined): string {
  if (!url) return ''
  return url.replace(/^https?:\/\//, '').replace(/\/$/, '')
}

// Per-tool row layout. Mechanism verified in drafts/2026-07-31-served-not-shown/: a
// component style block (hashed by the site build, admitted by the policy) plus SVG
// presentation attributes (fill=, width=, x=, y=) survive the site's style-src; an inline
// styling attribute does not.
//
// The row LABEL and the row VALUE are HTML, not SVG text, and that is deliberate. SVG text
// is scaled by the viewBox-to-viewport factor exactly as the bars are, so inside a fluid
// chart it shrinks with the container even though its CSS font-size never changes: a
// Skeptic measured 19px at a 900px container and 10px at ~405px. The first fix attempted
// here was a max-width media query raising the user-unit size; it could not be verified,
// because this runtime's headless browser clamps its layout viewport at 500px and the
// query never fires (tested, not assumed). So the dependency was removed instead of
// patched: only the two rects live in the SVG, where scaling is what you want, and every
// character on the row is HTML at a constant size at any width.
const ROW_PITCH = 7
const BAR_VIEWBOX_W = 300

type Tool = (typeof tools)[number]

function toolChart(tool: Tool) {
  const rows = [
    { label: 'spec', value: tool.claim_fpr, barClass: 'cc-chart-bar--spec', valClass: 'cc-val--spec' },
    { label: 'measured', value: tool.independent_fpr, barClass: 'cc-chart-bar--meas', valClass: 'cc-val--meas' },
  ]
  if (tool.nnes_fpr !== null) {
    rows.push({ label: 'NNES*', value: tool.nnes_fpr, barClass: 'cc-chart-bar--nnes', valClass: 'cc-val--nnes' })
  }
  return rows.map(r => ({
    label: r.label,
    barClass: r.barClass,
    valClass: r.valClass,
    width: barLen(r.value),
    formatted: fmt(r.value),
  }))
}

// Every figure on a row is also spoken as ordinary text, so the bars carry no meaning a
// reader without them would lose. The group label states the comparison once.
function toolAria(tool: Tool): string {
  return `${tool.name}: vendor specification ${fmt(tool.claim_fpr)}, independent measurement `
    + `${fmt(tool.independent_fpr)}`
    + (tool.nnes_fpr !== null ? `, NNES ${fmt(tool.nnes_fpr)}` : '')
    + `, false positive rate, scale 0 to ${CAP} percent`
}
---

<div class="cc">

  <!-- Header -->
  <div class="cc-header">
    <div class="cc-eyebrow">
      THE MEASURING FIELD / MERIDIAN / INSTRUMENT 001
    </div>
    <h1 class="cc-title">
      CALIBRATION CERTIFICATE
    </h1>
    <p class="cc-subtitle">
      AI Text Detection — Independent Audit Against Vendor Specifications
    </p>
    <p class="cc-refdate">
      Reference date: {data.generated} · Scale: 0–{data.fpr_scale_cap}% FPR
    </p>

    <!-- Stamp -->
    <div class="cc-stamp">
      OUT OF SPEC
    </div>
  </div>

  <!-- FPR Matrix -->
  <div class="cc-matrix">
    <div class="cc-matrix-title">
      FALSE POSITIVE RATE — CLAIM vs. INDEPENDENT MEASUREMENT
    </div>

    <div class="cc-legend">
      <span>
        <span class="cc-swatch cc-swatch--spec"></span>
        vendor specification
      </span>
      <span>
        <span class="cc-swatch cc-swatch--meas"></span>
        independent (general)
      </span>
    </div>

    {tools.map(tool => {
      const chart = toolChart(tool)
      return (
        <div class="cc-tool">
          <div class="cc-tool-head">
            <span class="cc-tool-name">{tool.name}</span>
            <span class="cc-tool-stats">
              spec: {fmt(tool.claim_fpr)} · measured: {fmt(tool.independent_fpr)}
            </span>
          </div>

          <div class="cc-rows" role="group" aria-label={toolAria(tool)}>
            {chart.map(r => (
              <div class="cc-row">
                <span class="cc-row-lbl">{r.label}</span>
                <svg class="cc-row-bar" viewBox={`0 0 ${BAR_VIEWBOX_W} ${ROW_PITCH}`}
                     preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <rect x="0" y="0" width={BAR_VIEWBOX_W} height={ROW_PITCH} class="cc-chart-track" />
                  <rect x="0" y="0" width={r.width} height={ROW_PITCH} class:list={['cc-chart-bar', r.barClass]} />
                </svg>
                <span class:list={['cc-row-val', r.valClass]}>{r.formatted}</span>
              </div>
            ))}
          </div>

          {'spec_flag' in tool && (
            <div class="cc-specflag">{tool.spec_flag}</div>
          )}

          <div class="cc-finding">
            {tool.key_finding}
          </div>

          <details class="cc-method">
            <summary class="cc-method-tag">method, sources and what was corrected on this row</summary>
            <div class="cc-method-body">{tool.confidence_note}</div>
            {'claim_accuracy_status' in tool && (
              <div class="cc-method-body">{tool.claim_accuracy_status}</div>
            )}
          </details>
        </div>
      )
    })}

    <div class="cc-matrix-footnote">
      NNES = Non-Native English Speakers. No per-tool NNES false-positive rate survived the
      2026-07-03 re-verification; the cross-detector NNES evidence (61.22% seven-detector average,
      Liang et al., Cell Patterns 2023) is in the measurement sources below.
      Confidence ratings vary; each tool's methodology note is printed under its own chart above.
    </div>
  </div>

  <!-- Harm Register -->
  <div class="cc-harm">
    <div class="cc-harm-title">
      FIELD OBSERVATIONS — DOCUMENTED HARM REGISTER
    </div>

    {cases.map(c => (
      <div class="cc-case">
        <div class="cc-case-head">
          {c.institution} · {c.year}
        </div>
        <div class="cc-case-sub">
          {c.scale === 'institutional' && c.allegations !== null
            ? `${c.allegations.toLocaleString()} allegations${c.dismissed_pct !== null ? ` · ${c.dismissed_pct}% dismissed` : ''}`
            : c.detector}
        </div>
        <div class="cc-case-outcome">
          {c.outcome}
        </div>
        {'caveat' in c && (
          <div class="cc-case-caveat">
            {c.caveat}
          </div>
        )}
        <div class="cc-case-source">
          {c.source}
        </div>
        <div class="cc-case-source">
          <a class="cc-link" href={c.source_url}>{shortUrl(c.source_url)}</a>
          {'source_url_secondary' in c && (
            <span> · <a class="cc-link" href={c.source_url_secondary}>{shortUrl(c.source_url_secondary)}</a></span>
          )}
        </div>
        {'access_note' in c && (
          <div class="cc-case-access">
            {c.access_note}
          </div>
        )}
      </div>
    ))}
  </div>

  <!-- Specification sources -->
  <div class="cc-sources">
    <div class="cc-sources-title">
      SPECIFICATION SOURCES — WHERE THE CLAIM BARS COME FROM
    </div>

    <div class="cc-spec-lede">
      Supplied 2026-08-01. From 2026-07-01 to that date the specification side of this certificate —
      the bars the measurements are compared against — carried no source of any kind. A calibration
      certificate whose specification half is unsourced is half an instrument, and this practice
      found that against itself rather than being told.
    </div>

    {specs.map(sp => (
      <div class="cc-spec">
        <div class="cc-spec-head">
          <span class="cc-spec-tool">{sp.tool}</span>
          <span class="cc-spec-claim">{sp.claim_shown}</span>
        </div>
        {sp.verbatim && (
          <div class="cc-spec-quote">&ldquo;{sp.verbatim}&rdquo;</div>
        )}
        {sp.url && (
          <div class="cc-spec-url"><a class="cc-link" href={sp.url}>{shortUrl(sp.url)}</a></div>
        )}
        <div class="cc-spec-caveat">{sp.caveat}</div>
      </div>
    ))}
  </div>

  <!-- Sources -->
  <div class="cc-sources">
    <div class="cc-sources-title">
      MEASUREMENT SOURCES
    </div>

    {sources.map(s => (
      <div class="cc-source-row">
        <span class="cc-source-name">{s.name}</span>
        <span class="cc-source-finding">
          {s.finding}
          {s.url && (
            <span> · <a class="cc-link" href={s.url}>{shortUrl(s.url)}</a></span>
          )}
        </span>
      </div>
    ))}

    <div class="cc-correction">
      CORRECTION (2026-07-03): the Originality.ai row previously displayed a vendor claim of 0.2% FPR
      against an independent measurement of 37% FPR ("a 185x gap"). Neither figure is retrievable in the
      cited RAID paper or in vendor marketing; the row now shows what the sources actually state — the
      vendor's own "under 3%" FPR claim holds on RAID's clean corpus (0.07–0.47%), while claimed accuracy
      collapses out-of-domain (8.5% on code, 55.8% on unseen domains, at 5% FPR). Additionally, the GPTZero
      row previously displayed 61% as a GPTZero-specific NNES false-positive rate — that figure is Liang
      et al.'s seven-detector average (61.22%), now correctly framed in the sources list; and the same
      source line previously said "one detector flagged 98%" where the paper's 97.8% is the fraction of
      essays flagged by at least one of seven detectors. The discarded figures are ledgered in the
      research archive (memory/discarded.md, session 06).
    </div>

    <div class="cc-note">
      RE-VERIFICATION COMPLETED (2026-07-03, session 07): every remaining pre-constitution figure was
      re-checked against live primary sources. Changes: GPTZero's measured bar corrected 15% → 18% and
      re-pinned to its actual primary source (Ibrahim et al., Scientific Reports 2023 — the previously
      cited commercial aggregator itself states 18%, citing that study); Turnitin's measured bar corrected
      5% → 4% (the vendor's own sentence-level admission — a sentence-level figure, disclosed as such
      beside document-level bars); Turnitin's NNES 30% bar removed (no retrievable study supports a
      Turnitin-specific NNES rate — the foundational cross-detector study excluded Turnitin, and the
      vendor's own research reports no statistically significant ELL bias at 300+ words); an unattributed
      "real-world accuracy 85–90%" line removed as unsourced; ZeroGPT's measured bar corrected 28% →
      16.67% (the previous attribution was unretrievable; now Pratama 2025, PeerJ CS); the Perkins et al.
      17.4% restated as a 17.4-percentage-point mean drop (39.5% → 22.2%), not a resulting accuracy — the
      same error is corrected in the research archive's claims ledger; a "no better than random guessing"
      paraphrase-in-quotation-marks restricted to the tool the paper applies it to (DetectGPT); the two
      individual harm cases narrowed to what court records and local reporting state. The FPR scale was
      re-capped 65% → 20% after the removals. Verified figures that stood: both vendors' spec claims, the
      Perkins 46.1% and Weber-Wulff 59% accuracy figures, all source-list lines, and the core facts of all
      three harm cases. Discards ledgered in memory/discarded.md (session 07).
    </div>

    <div class="cc-note">
      REVISION (2026-07-12, session 33): two changes to the harm register, on a binding team steer and a
      downstream correction report (the lab's production wing, via REQUESTS.md). First, the register no
      longer carries personal names of the individuals in its own voice — the two individual cases now read
      as role + institution + consequence, with the official case captions moved into the source lines as
      citations (named-individuals policy, team, 2026-07-12; the underlying reporting is unchanged and
      linked). Second, the Minnesota row now carries the appellate record's load-bearing caveat at display
      prominence: the disciplinary panel did not rely on AI-detection evidence — the case documents a
      detector figuring in an accusation, not a consequence the courts attributed to a detector. The
      collective's own field sweep had already recorded this framing ("grader judgment, explicitly not
      detector output alone", FIELD.md); the register row had never been updated to match. Gauntlet re-run
      on the revised state per the standing rule; record in journal/2026-07-12.md, session 33.
    </div>

    <div class="cc-note">
      REPAIR (2026-08-01, session 77): this work was checked against itself before being offered to a
      reader outside this practice, and failed that check in seven ways — the published page did not
      draw its chart at all under the site's security policy; it printed none of the source
      identifiers it held; and the specification side of a calibration certificate was unsourced,
      which on sourcing turned out to include one composite claim and one specification the vendor
      had already retired. All seven are set out, with what each check does and does not establish,
      in CORRECTIONS.md in this work's directory — a dated register, not an edit:
      github.com/frankbueltge/field-research/blob/main/works/2026-07-01-calibration-gap/CORRECTIONS.md
      No measurement changed. The deliberation, including the hostile review that struck down the
      first version of this repair, is in journal/2026-07-31.md, session 77.
    </div>

    <div class="cc-footer-note">
      This certificate is itself a measurement instrument — it documents the gap between specification
      and performance in tools now deployed to judge the authenticity of human writing.
      Method and data are open: frankbueltge.de/field / github.com/frankbueltge/field-research
    </div>
  </div>

</div>

<style>
  .cc {
    font-family: ui-monospace, "DejaVu Sans Mono", "SFMono-Regular", Menlo, Consolas, "Liberation Mono", "Courier New", monospace;
    font-size: 0.875rem;
    line-height: 1.625;
    background: #0d0d0d;
    color: #d4d4d4;
    padding: 2rem;
    max-width: 860px;
    margin: 0 auto;
  }

  .cc-header {
    position: relative;
    border-bottom: 1px solid #3f3f3f;
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
  }


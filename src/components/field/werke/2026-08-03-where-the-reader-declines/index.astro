---
// Where the Reader Declines — an instrument that seats you in the same chair.
//
// Sixty arXiv abstracts. One claim. Four definitions, locked before anyone
// read anything. A sibling practice labelled all sixty blind. A machine reader
// then classified the same sixty under the same definitions.
//
// The page does not tell you the machine evades. It gives you the excerpt and
// the definitions, lets you decide, and only then shows you what the two
// readers said. Everything is drawn at build time from the committed join
// (`data.json`, built by `build_data.py`); nothing is fetched, nothing is
// random, no client-side computation.
import data from './data.json'
import second from './second-reader-2026-08-04.json'

const RELATIONS = ['supports', 'contradicts', 'qualifies', 'contextualizes'] as const
type Relation = (typeof RELATIONS)[number]

const cases = data.cases
const inPop = cases.filter((c) => c.in_population)

// --- the 2026-08-04 correction, counted here for the same reason everything else on this
// page is counted here: so the figure on the page cannot drift from the file it describes.
// The published split is unchanged; these are what two independent blind readers returned.
// `as const` on the pair: without it TypeScript widens the entry to (string | object)[]
// and `new Map(...)` will not accept it. The build gate catches this; a shipped work of
// this practice's already kept the whole ecology's gate red for days on exactly this kind
// of type error, so it is fixed here rather than discovered there.
const secondByCase = new Map(second.cases.map((c) => [c.case_id, c] as const))
const readerPop = (who: 'R1' | 'R2') =>
  cases.filter((c) => secondByCase.get(c.case_id)?.[who] === 'IN')
const readerCtx = (who: 'R1' | 'R2', side: 'gold' | 'machine') =>
  readerPop(who).filter((c) => c[side].relation === 'contextualizes').length
const disputed = cases.filter(
  (c) => c.in_population_status && c.in_population_status.startsWith('DISPUTED'),
).length

// The definitions come out of JSON as `{}`; name their shape once here rather
// than casting at each use site.
const defs = data.criteria.definitions as Record<Relation, string>

// --- the confusion grid, counted here so the figure cannot drift from it ----
const grid: Record<string, Record<string, number>> = {}
for (const g of [...RELATIONS, 'undecidable']) {
  grid[g] = {}
  for (const m of [...RELATIONS, 'undecidable']) grid[g][m] = 0
}
for (const c of cases) {
  const g = c.gold.relation ?? 'undecidable'
  const m = c.machine.relation ?? 'undecidable'
  grid[g][m] += 1
}

const tally = (list: typeof cases, who: 'gold' | 'machine') => {
  const out: Record<string, number> = {}
  for (const r of [...RELATIONS, 'undecidable']) out[r] = 0
  for (const c of list) out[c[who].relation ?? 'undecidable'] += 1
  return out
}
const goldIn = tally(inPop, 'gold')
const machineIn = tally(inPop, 'machine')

const decidable = cases.filter((c) => c.gold.relation)
const agreed = decidable.filter((c) => c.gold.relation === c.machine.relation).length
const accuracy = agreed / decidable.length

// The floor a classifier reaches by always naming the commonest gold label.
const goldCounts = tally(decidable, 'gold')
const floor = Math.max(...RELATIONS.map((r) => goldCounts[r])) / decidable.length

const pct = (n: number, d: number) => `${((100 * n) / d).toFixed(0)}%`
const maxCell = Math.max(...Object.values(grid).flatMap((row) => Object.values(row)))
---

<article class="wrd">
  <header>
    <p class="kicker">Instrument · sixty cases, two readers</p>
    <h1>Where the Reader Declines</h1>
    <p class="lede">
      One claim, sixty published abstracts, and four definitions locked before anyone read
      anything. A sibling practice labelled all sixty <strong>blind</strong>. Then a machine read
      the same sixty under the same definitions. This page seats you between them.
    </p>
    <blockquote class="claim">{data.claim}</blockquote>
    <p class="correction">
      <strong>Correction, 2026-08-04.</strong> The population this page computes its §2 figures
      over — {inPop.length} of {cases.length} sources — <strong>was not reproduced</strong>. Two
      readers who had never seen it re-made the judgement blind, from the same excerpts and the
      same question, and each returned <strong>{readerPop('R1').length}</strong>. They agreed with
      each other far more closely than either agreed with this split, and neither of them added a
      single source this split excludes. The published numbers below are left exactly as they were
      published; what changes is what may be concluded from them. Full record:{' '}
      <code>CORRECTIONS.md</code>, entry 2026-08-04.
    </p>
  </header>

  <section>
    <h2>1 · The four definitions</h2>
    <p>
      Both readers worked from these, verbatim, version <code>{data.criteria.version}</code>, locked
      {data.criteria.locked_at.slice(0, 10)} — before the labelling.
    </p>
    <dl class="defs">
      {RELATIONS.map((r) => (
        <div>
          <dt data-rel={r}>{r}</dt>
          <dd>{defs[r]}</dd>
        </div>
      ))}
    </dl>
    <p class="aside">
      A fifth move exists and is not a category: a reader may declare a case <em>undecidable</em>
      when the excerpt does not settle it. The blind reader used it three times. The machine used
      it <strong>never</strong>.
    </p>
  </section>

  <section>
    <h2>2 · Where the two readers landed</h2>
    <p>
      Only the <strong>{inPop.length} sources whose own system does research</strong> — forms
      hypotheses, runs experiments, analyses, writes up, reviews. The claim is about those. The
      other {cases.length - inPop.length} are about reasoning, code, robotics, arithmetic, computer
      operation, fact-checking, negotiation and style; they are kept in the data and marked, not
      dropped.
    </p>
    <p class="correction">
      <strong>And this is the number the 2026-08-04 correction lands on.</strong> Read blind, the
      two independent readers put {readerPop('R1').length} and {readerPop('R2').length} sources in
      this population, not {inPop.length}; {disputed} of the {cases.length} cases are disputed by
      at least one of them, and every dispute runs the same way — this split including something
      they would not. Recomputed on their narrower populations the gap does not close: the machine
      still puts {readerCtx('R1', 'machine')} and {readerCtx('R2', 'machine')} sources in{' '}
      <em>contextualizes</em> while the blind reader puts {readerCtx('R1', 'gold')} and{' '}
      {readerCtx('R2', 'gold')} there. <strong>So the figure below is wrong; the finding it carries
      is not.</strong> Whether the gap is genuinely <em>wider</em> on the narrower populations was
      claimed here on 2026-08-04 and withdrawn the same day — the reviewers' own arithmetic put the
      denominators at {readerCtx('R1', 'gold')} and {readerCtx('R2', 'gold')} cases and no
      comparison reached significance. Each case's row marks its own status.
    </p>

    <div class="bars" role="img" aria-label={`Distribution of the ${inPop.length} in-population cases. Blind reader: ${RELATIONS.map((r) => `${r} ${goldIn[r]}`).join(', ')}. Machine reader: ${RELATIONS.map((r) => `${r} ${machineIn[r]}`).join(', ')}.`}>
      {[
        { who: 'The blind reader', t: goldIn },
        { who: 'The machine', t: machineIn },
      ].map((row) => (
        <div class="barrow">
          <span class="who">{row.who}</span>
          <div class="track">
            {[...RELATIONS, 'undecidable'].map((r) =>
              row.t[r] > 0 ? (
                <span
                  class="seg"
                  data-rel={r}
                  data-n={row.t[r]}
                  title={`${r}: ${row.t[r]}`}
                >
                  {row.t[r] >= 3 ? row.t[r] : ''}
                </span>
              ) : null
            )}
          </div>
        </div>
      ))}
    </div>

    <p class="finding">
      The blind reader spread the {inPop.length} across every category. The machine put
      <strong> {machineIn.contextualizes} of {inPop.length} ({pct(machineIn.contextualizes, inPop.length)})</strong>
      into <em>contextualizes</em> — the one category that means <em>takes no position on the
      claim</em>. The blind reader put {goldIn.contextualizes} there.
    </p>

    <table class="tbl">
      <caption>The same figure as numbers — {inPop.length} in-population cases</caption>
      <thead>
        <tr><th scope="col">Relation</th><th scope="col">Blind reader</th><th scope="col">Machine</th></tr>
      </thead>
      <tbody>
        {[...RELATIONS, 'undecidable'].map((r) => (
          <tr>
            <th scope="row" data-rel={r}>{r}</th>
            <td>{goldIn[r]}</td>
            <td>{machineIn[r]}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section>
    <h2>3 · Every case, all {cases.length}</h2>
    <p>
      Read the excerpt. Decide, against the four definitions above, before you open the fold.
      Then see what the two readers said and why. The fold is the whole instrument: it is the
      moment you find out whether the difficulty you just felt is the same difficulty the machine
      had.
    </p>

    {cases.map((c) => (
      <article class="case" id={`case-${c.position}`}>
        <h3>
          <span class="num">{String(c.position).padStart(2, '0')}</span>
          {c.title}
          {!c.in_population && <span class="outpop" title={'Not in the claim’s population'}>outside the population</span>}
          {c.in_population_status?.startsWith('DISPUTED') && (
            <span
              class="disputed"
              title={`Blind re-reading 2026-08-04 — R1: ${secondByCase.get(c.case_id)?.R1}, R2: ${secondByCase.get(c.case_id)?.R2}`}
            >
              population disputed 2026-08-04
            </span>
          )}
        </h3>
        <p class="meta">
          arXiv <code>{c.arxiv}</code> · excerpt <code>{c.excerpt_sha256.slice(0, 19)}…</code>
          {c.population_reason && <> · <span class="why">{c.population_reason}</span></>}
        </p>
        <blockquote class="excerpt">{c.excerpt}</blockquote>
        <details>
          <summary>What the two readers said</summary>
          <div class="verdicts">
            <div class="verdict">
              <p class="vhead">
                Blind reader —
                <strong data-rel={c.gold.relation ?? 'undecidable'}>
                  {c.gold.relation ?? 'undecidable'}
                </strong>
              </p>
              <p>{c.gold.undecidable ? c.gold.undecidable_reason : c.gold.rationale}</p>
              {c.gold.decided_by && <p class="by">decided by: {c.gold.decided_by}{c.gold.tie_with && <> · runner-up: {c.gold.tie_with}</>}</p>}
            </div>
            <div class="verdict">
              <p class="vhead">
                Machine —
                <strong data-rel={c.machine.relation ?? 'undecidable'}>
                  {c.machine.relation ?? 'undecidable'}
                </strong>
                {c.gold.relation && c.machine.relation !== c.gold.relation && (
                  <span class="miss">differs</span>
                )}
              </p>
              <p>{c.machine.rationale}</p>
              {c.machine.decided_by && <p class="by">decided by: {c.machine.decided_by}{c.machine.tie_with && <> · runner-up: {c.machine.tie_with}</>}</p>}
            </div>
          </div>
        </details>
      </article>
    ))}
  </section>

  <section>
    <h2>4 · The grid</h2>
    <p>
      All {cases.length} cases: rows are what the blind reader said, columns what the machine
      said. A perfect machine fills only the diagonal.
    </p>
    <table class="grid">
      <caption>
        Rows = blind reader · columns = machine · agreement on the diagonal
        ({agreed} of {decidable.length}, {(100 * accuracy).toFixed(1)}%, against a
        majority-class floor of {(100 * floor).toFixed(1)}%)
      </caption>
      <thead>
        <tr>
          <th scope="col"><span class="vh">blind \ machine</span></th>
          {[...RELATIONS, 'undecidable'].map((m) => <th scope="col">{m}</th>)}
        </tr>
      </thead>
      <tbody>
        {[...RELATIONS, 'undecidable'].map((g) => (
          <tr>
            <th scope="row" data-rel={g}>{g}</th>
            {[...RELATIONS, 'undecidable'].map((m) => (
              <td
                class={g === m ? 'diag' : ''}
                data-w={grid[g][m] ? Math.round((grid[g][m] / maxCell) * 20) : null}
              >
                {grid[g][m] || ''}
              </td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="finding">
      The heavy column is <em>contextualizes</em>: {grid.contradicts.contextualizes} of the blind
      reader's contradictions and {grid.qualifies.contextualizes} of its qualifications ended
      there. Both are moves <em>away</em> from committing to the claim. The machine's accuracy —
      {(100 * accuracy).toFixed(1)}% against a floor of {(100 * floor).toFixed(1)}% — is only
      {((100 * (accuracy - floor))).toFixed(1)} points above what a classifier reaches by naming
      the commonest label every time.
    </p>
  </section>

  <footer>
    <h2>Provenance</h2>
    <p>
      Built by <code>build_data.py</code> from four committed files in the Meridian runtime, joined
      deterministically — no network, no clock, no model at build time.
    </p>
    <ul>
      {Object.entries(data.sources).map(([k, v]: [string, any]) => (
        <li><code>{v.path}</code> — <code>{v.sha256.slice(0, 23)}…</code></li>
      ))}
    </ul>
    <p>
      The labels were made by <strong>{data.labelling.practice}</strong>, blind, on
      {' '}{data.labelling.labelled_at.slice(0, 10)}. The machine is
      {' '}<code>{data.sources.predictions.model_name}</code>.
    </p>
    <p class="limits">
      <strong>What this does not license.</strong> That the machine <em>avoids</em> commitment.
      <code>contextualizes</code> is a broad definition — five disjuncts, from a background
      measurement to a statement about something adjacent — and a reader applying it literally
      will land there often and be right by the letter each time. Both readers had that same
      definition. Nothing here separates <em>applies a broad category literally</em> from
      <em>declines to commit</em>. What is measured is the distribution; the disposition is not
      established, and would need a third reader or an ablation on the category's width.
    </p>
    <p class="limits">
      <strong>What is not independently checked.</strong> The split in §2 — which sources are in
      the claim's population — is one person's reading. Every one of the sixty carries its
      one-line reason, in both directions, so any single line can be disputed without
      reconstructing the rest. But <em>disclosed</em> is not <em>verified</em>: no second reader
      has made that judgement independently, and an earlier automated attempt at the same split
      put the single <code>supports</code> case on the wrong side. This work ships with that hole
      open and named.
    </p>
    <p class="limits">
      <strong>Which reader, and which field.</strong> The machine is not a representative
      reader: it is the one that answered on a free tier without spending a quota another
      practice depends on. Two stronger candidates were excluded for allowance reasons, not
      for capability. Read this as <em>the floor of what is reachable without paying</em>, not
      the middle of the market. And the sixty were drawn from a pool assembled by fourteen
      frozen phrase searches — work that never uses those phrases is not merely absent from
      this instrument, it is invisible to it, and nothing here estimates how much that is.
    </p>
    <p class="limits">
      <strong>Limits.</strong> These are abstracts, not papers — what a source <em>says about
      itself</em> in 200 words, which is roughly a quarter of a paper's own checkable claims. One
      labelling practice, one machine, one run: a second run of the same machine over the same
      frozen inputs scored 52.6% where this one scored 54.4%, so differences under about two
      points are noise. The population split in §2 is a human judgement, written out case by case
      in <code>build_data.py</code> so it can be contested line by line — an earlier automated
      version of that same split was wrong about the single most consequential case.
    </p>
  </footer>
</article>

<style>
  .wrd {
    --supports: #1b7f5a;
    --contradicts: #a8324a;
    --qualifies: #b4741c;
    --contextualizes: #4a5568;
    --undecidable: #7c6f9e;
    max-width: 46rem;
    margin: 0 auto;
    padding: 2rem 1rem 4rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    line-height: 1.6;
  }
  @media (prefers-color-scheme: dark) {
    .wrd {
      --supports: #4fbf92;
      --contradicts: #e87a90;
      --qualifies: #e0a44c;
      --contextualizes: #9aa5b8;
      --undecidable: #b4a8d8;
    }
  }
  .kicker { text-transform: uppercase; letter-spacing: .18em; font-size: .7rem; opacity: .7; margin: 0 0 .4rem; }
  h1 { font-size: 1.9rem; line-height: 1.15; margin: 0 0 .8rem; }
  h2 { font-size: 1.05rem; margin: 2.6rem 0 .6rem; }
  h3 { font-size: .95rem; margin: 0 0 .3rem; font-weight: 600; }
  .lede { font-size: 1rem; }
  .claim { margin: 1.2rem 0; padding: .9rem 1.1rem; border-left: 3px solid currentColor; font-style: italic; }
  .aside, .meta, .by, .limits { font-size: .8rem; opacity: .8; }

  .defs { margin: 1rem 0; }
  .defs > div { margin-bottom: .8rem; }
  .defs dt { font-weight: 700; }
  .defs dd { margin: .15rem 0 0; font-size: .85rem; }

  [data-rel='supports'] { color: var(--supports); }
  [data-rel='contradicts'] { color: var(--contradicts); }
  [data-rel='qualifies'] { color: var(--qualifies); }
  [data-rel='contextualizes'] { color: var(--contextualizes); }
  [data-rel='undecidable'] { color: var(--undecidable); }

  .bars { margin: 1.2rem 0; }
  .barrow { display: flex; align-items: center; gap: .6rem; margin-bottom: .45rem; }
  .who { flex: 0 0 8.5rem; font-size: .78rem; text-align: right; }
  .track { display: flex; flex: 1; height: 1.5rem; border: 1px solid currentColor; }
  .seg { display: grid; place-items: center; font-size: .7rem; color: #fff; }
  .seg[data-rel='supports'] { background: var(--supports); }
  .seg[data-rel='contradicts'] { background: var(--contradicts); }
  .seg[data-rel='qualifies'] { background: var(--qualifies); }
  .seg[data-rel='contextualizes'] { background: var(--contextualizes); }
  .seg[data-rel='undecidable'] { background: var(--undecidable); }

  /* Segment width and cell tint used to ride on inline style attributes. The site's CSP carries
     style hashes, which makes its 'unsafe-inline' inert, and it has no 'unsafe-hashes' — so the
     browser dropped both and the bars sized to their labels while the grid stayed blank. A
     component <style> block IS hashed, but it cannot be generated at build time (Astro does not
     hash a <style set:html>), so the values have to meet CSS that is written out in full. Counts
     are exact; the tint is quantised into twentieths, and since it tops out at 22% one step is
     about a percent of tint. No number this work reports changed. */
  .seg[data-n='1'] { flex: 1 } .seg[data-n='2'] { flex: 2 } .seg[data-n='3'] { flex: 3 }
  .seg[data-n='4'] { flex: 4 } .seg[data-n='5'] { flex: 5 } .seg[data-n='6'] { flex: 6 }
  .seg[data-n='7'] { flex: 7 } .seg[data-n='8'] { flex: 8 } .seg[data-n='9'] { flex: 9 }
  .seg[data-n='10'] { flex: 10 } .seg[data-n='11'] { flex: 11 } .seg[data-n='12'] { flex: 12 }
  .seg[data-n='13'] { flex: 13 } .seg[data-n='14'] { flex: 14 } .seg[data-n='15'] { flex: 15 }
  .seg[data-n='16'] { flex: 16 } .seg[data-n='17'] { flex: 17 } .seg[data-n='18'] { flex: 18 }
  .seg[data-n='19'] { flex: 19 } .seg[data-n='20'] { flex: 20 } .seg[data-n='21'] { flex: 21 }
  .seg[data-n='22'] { flex: 22 } .seg[data-n='23'] { flex: 23 } .seg[data-n='24'] { flex: 24 }
  .seg[data-n='25'] { flex: 25 } .seg[data-n='26'] { flex: 26 } .seg[data-n='27'] { flex: 27 }
  .seg[data-n='28'] { flex: 28 } .seg[data-n='29'] { flex: 29 } .seg[data-n='30'] { flex: 30 }
  .seg[data-n='31'] { flex: 31 } .seg[data-n='32'] { flex: 32 } .seg[data-n='33'] { flex: 33 }
  .seg[data-n='34'] { flex: 34 } .seg[data-n='35'] { flex: 35 } .seg[data-n='36'] { flex: 36 }
  .seg[data-n='37'] { flex: 37 } .seg[data-n='38'] { flex: 38 } .seg[data-n='39'] { flex: 39 }
  .seg[data-n='40'] { flex: 40 } .seg[data-n='41'] { flex: 41 } .seg[data-n='42'] { flex: 42 }
  .seg[data-n='43'] { flex: 43 } .seg[data-n='44'] { flex: 44 } .seg[data-n='45'] { flex: 45 }
  .seg[data-n='46'] { flex: 46 } .seg[data-n='47'] { flex: 47 } .seg[data-n='48'] { flex: 48 }
  .seg[data-n='49'] { flex: 49 } .seg[data-n='50'] { flex: 50 } .seg[data-n='51'] { flex: 51 }
  .seg[data-n='52'] { flex: 52 } .seg[data-n='53'] { flex: 53 } .seg[data-n='54'] { flex: 54 }
  .seg[data-n='55'] { flex: 55 } .seg[data-n='56'] { flex: 56 } .seg[data-n='57'] { flex: 57 }
  .seg[data-n='58'] { flex: 58 } .seg[data-n='59'] { flex: 59 } .seg[data-n='60'] { flex: 60 }

  .finding { border-top: 1px solid currentColor; padding-top: .7rem; margin-top: 1rem; }

  .tbl, .grid { border-collapse: collapse; width: 100%; font-size: .8rem; margin: 1rem 0; }
  .tbl th, .tbl td, .grid th, .grid td { border: 1px solid currentColor; padding: .3rem .5rem; text-align: right; }
  .tbl th[scope='row'], .grid th[scope='row'] { text-align: left; }
  caption { caption-side: bottom; font-size: .75rem; opacity: .8; padding-top: .5rem; text-align: left; }
  .grid td { background: color-mix(in srgb, currentColor calc(var(--w, 0) * 22%), transparent); }
  .grid td[data-w='1'] { --w: .05 } .grid td[data-w='2'] { --w: .1 }
  .grid td[data-w='3'] { --w: .15 } .grid td[data-w='4'] { --w: .2 }
  .grid td[data-w='5'] { --w: .25 } .grid td[data-w='6'] { --w: .3 }
  .grid td[data-w='7'] { --w: .35 } .grid td[data-w='8'] { --w: .4 }
  .grid td[data-w='9'] { --w: .45 } .grid td[data-w='10'] { --w: .5 }
  .grid td[data-w='11'] { --w: .55 } .grid td[data-w='12'] { --w: .6 }
  .grid td[data-w='13'] { --w: .65 } .grid td[data-w='14'] { --w: .7 }
  .grid td[data-w='15'] { --w: .75 } .grid td[data-w='16'] { --w: .8 }
  .grid td[data-w='17'] { --w: .85 } .grid td[data-w='18'] { --w: .9 }
  .grid td[data-w='19'] { --w: .95 } .grid td[data-w='20'] { --w: 1 }
  .grid td.diag { outline: 2px solid currentColor; outline-offset: -2px; }

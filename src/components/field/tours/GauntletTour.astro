---
// src/components/field/tours/GauntletTour.astro — the Field's guided tour of the gauntlet week,
// composed: the WP5 tour engine (components/dataviz/Tour.astro) driving a KONTROLLBLATT — the
// practice's own record-strip grammar (src/lib/field/strip.ts buildControlSvg) — with the scene
// sequence and its verbatim quotes coming from src/lib/tour/field-gauntlet.ts.
//
// Why the Kontrollblatt and not the claim figure below it (the studio's tour drives its one
// signature figure; this one deliberately does not): these six scenes are a RECORD OVER FIVE
// WALL-CLOCK DAYS — an instrument entering service, two sessions, a power check, a review cut, a
// second instrument shipping — and the Kontrollblatt is the field's approved grammar for exactly
// that. The claim plate underneath has no time axis; putting five days of chronicle on it would
// have meant inventing marks it does not carry. The last scene is the hinge: it lifts the filter,
// selects the plate's own claim mark, and the claim figure below opens that same claim up.
//
// The progressive-enhancement ladder, in this composition's own terms:
//   1. NO JS — the tour's figure column stays `hidden`, and each scene shows its own build-time
//      still: the SAME builder the live plate uses, with that scene's focus baked in, so a still
//      can never drift from the figure it stands in for. Under the scenes, the plate's whole record
//      as a table, every mark with the file it was read from. Complete, readable straight through.
//   2. WITH JS — the stills hide, ONE plate becomes sticky beside the scenes and is driven scene by
//      scene (filter / select / dim). The last scene lifts the filter, so a visitor who read to the
//      end is left looking at the whole week.
//
// The record (table + provenance) is rendered HERE rather than beside the figure, because the
// tour's figure column is `hidden` without JS and the data floor must never be the thing that
// disappears.
import Tour from '@/components/dataviz/Tour.astro'
import TableFallback from '@/components/dataviz/TableFallback.astro'
import { buildControlSvg, type ControlInput } from '@/lib/field/strip'
import {
  GAUNTLET_COLUMNS,
  GAUNTLET_FIGURE,
  gauntletRows,
  gauntletTour,
} from '@/lib/tour/field-gauntlet'
import type { Scene } from '@/lib/tour/types'
import { FIELD_NARRATIVE } from '@/config/field-wording'

export interface Props {
  plate: ControlInput
}

const { plate } = Astro.props
const w = FIELD_NARRATIVE.tour.plate

/** One scene's build-time still: the same plate, with that scene's own focus baked in and every
 *  focus hook stripped (a still is not a tab stop). `filter: null` is the tour's "lift the filter"
 *  signal, which for a still simply means every mark at full strength. */
const renderStill = (scene: Scene): string =>
  buildControlSvg({
    ...plate,
    still: true,
    svgId: `gauntlet-still-${scene.id}`,
    label: `${scene.heading} — ${w.altText}`,
    focus: {
      filter: scene.focus.filter ?? undefined,
      dim: scene.focus.dim,
      select: scene.focus.select,
    },
  })

// the live plate carries no baked focus: every mark starts on, and the client script repaints it
const liveSvg = buildControlSvg({ ...plate, svgId: GAUNTLET_FIGURE })
const rows = gauntletRows(plate)
const provenance = `${w.provenancePrefix} ${gauntletTour.provenance.join(' · ')}`
---

<div id="tour-the-gauntlet" class="fd-tour-wrap">
  <Tour tour={gauntletTour} renderStill={renderStill}>
    <div slot="figure" class="fd-gauntlet-plate" data-gp-root>
      <div class="fd-gauntlet-scroll"><div data-gp-svg set:html={liveSvg} /></div>
    </div>
  </Tour>

  <TableFallback
    summary={w.tableSummary}
    caption={w.tableCaption}
    columns={GAUNTLET_COLUMNS}
    rows={rows}
    provenance={provenance}
  />
</div>

<style>
  .fd-tour-wrap {
    scroll-margin-top: 3rem;
  }
</style>

<script>
  import { isOn } from '@/lib/dataviz/filter'
  import type { FocusState } from '@/lib/tour/types'

  // The plate opts INTO being driven — it imports nothing from the tour engine and knows nothing
  // about any tour; it only dispatches the `dv:figure-ready` handshake engine.ts documents. Its
  // whole vocabulary is three attributes: data-on (in this scene's filter), data-dim, data-sel.
  for (const root of document.querySelectorAll<HTMLElement>('[data-gp-root]')) {
    const svg = root.querySelector<SVGSVGElement>('[data-gp-svg] svg')
    if (!svg) continue
    const groups = [...svg.querySelectorAll<SVGGElement>('[data-key]')]
    if (groups.length === 0) continue

    // the mark KINDS a scene filters by, read off the drawn glyph rather than a second payload:
    // an instrument triangle, a caveat flag, a splice, a move stamp
    const kindOf = (g: SVGGElement): string =>
      g.querySelector('.splice') ? 'splicein' : g.querySelector('.flag') ? 'flag' : g.querySelector('.stamp') ? 'stamp' : 'instr'

    let filter: string[] = []
    let dim: string[] = []
    let selected: string | null = null

    const paint = () => {
      for (const g of groups) {
        const key = g.dataset.key ?? ''
        g.toggleAttribute('data-on', isOn(filter, kindOf(g)))
        g.toggleAttribute('data-dim', dim.includes(key))
        g.toggleAttribute('data-sel', selected === key)
      }
    }

    const apply = (focus: FocusState) => {
      // `filter: null` explicitly clears; `undefined` means this scene does not touch the filter
      if (focus.filter !== undefined) filter = focus.filter ?? []
      dim = focus.dim ?? []
      selected = focus.select ?? null
      paint()
    }

    paint()
    window.dispatchEvent(new CustomEvent('dv:figure-ready', { detail: { id: svg.id, apply } }))
  }
</script>

<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nächtlicher Atlas-Scout auf dem eigenen Rechner, 05:20 Ortszeit.

  Einrichten:
    cp pipelines/atlas-scout/de.frankbueltge.atlas-scout.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/de.frankbueltge.atlas-scout.plist

  Abschalten:
    launchctl unload ~/Library/LaunchAgents/de.frankbueltge.atlas-scout.plist

  Läuft der Rechner zur Startzeit nicht, holt launchd den Lauf beim nächsten Aufwachen
  nach (RunAtLoad ist bewusst aus — sonst startet jeder Login einen Lauf).
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.frankbueltge.atlas-scout</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/frankbultge/Documents/GitHub/frankbueltge.de/pipelines/atlas-scout/nachtlauf.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>5</integer>
        <key>Minute</key><integer>20</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/frankbultge/Documents/GitHub/frankbueltge.de/pipelines/atlas-scout/nachtlauf.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/frankbultge/Documents/GitHub/frankbueltge.de/pipelines/atlas-scout/nachtlauf.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>

{
  "name": "frankbueltge.de",
  "type": "module",
  "version": "0.2.0",
  "private": true,
  "description": "Frank Bültge — Data Engineering & Analytics. Static Astro site, English-only, Git as the archive.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "climate:refresh": "tsx scripts/fetch-climate.ts",
    "pulse:refresh": "tsx scripts/fetch-pulse.ts",
    "ueberflug:refresh": "tsx scripts/fetch-ueberflug.ts",
    "protokoll:dry": "pipelines/protokoll/.venv/bin/python -m protokoll.run --dry-run --repo-root .",
    "consensus:refresh": "python3 pipelines/consensus/refresh.py",
    "meridian:refresh": "pipelines/meridian/.venv/bin/python pipelines/meridian/refresh.py",
    "correction:refresh": "python3 pipelines/revision/refresh.py",
    "tell:refresh": "python3 pipelines/tell/refresh.py",
    "pattern:refresh": "python3 pipelines/pattern/refresh.py",
    "redaction:refresh": "pipelines/redaction/.venv/bin/python -m redaction.run --repo-root .",
    "round-number:refresh": "pipelines/round-number/.venv/bin/python -m round_number.run --repo-root .",
    "ghost-fleet:refresh": "pipelines/ghost-fleet/.venv/bin/python -m ghost_fleet.run --repo-root .",
    "beifang:refresh": "pipelines/beifang/.venv/bin/python -m beifang.run --repo-root .",
    "trending:refresh": "pipelines/trending/.venv/bin/python -m trending.run --repo-root .",
    "beifang:leser": "pipelines/beifang/.venv/bin/python -m beifang.run --repo-root . --vantage leser",
    "graph:build": "tsx scripts/build-graph.ts && tsx scripts/build-graph-view.ts",
    "graph": "tsx scripts/graph-query.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/react": "5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@deck.gl/core": "9.3.11",
    "@deck.gl/layers": "9.3.11",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/space-grotesk": "^5.2.10",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^6.4.8",
    "astro-og-canvas": "^0.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "github-slugger": "^2.0.0",
    "lenis": "^1.3.23",
    "lucide-react": "1.39.0",
    "markdown-it": "^14.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "satellite.js": "^7.0.1",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "^4.3.1",
    "topojson-client": "3.1.0",
    "tw-animate-css": "1.4.0",
    "world-atlas": "2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/d3": "7.4.3",
    "@types/geojson": "7946.0.16",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "@tailwindcss/vite": {
      "vite": "^6.0.0"
    }
  }
}

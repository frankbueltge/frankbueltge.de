# build output
dist/
.astro/

# dependencies (no trailing slash: a git worktree often carries node_modules as a
# symlink to the main checkout's, and a directory-only pattern would not ignore it)
node_modules

# archived Next.js build (kept locally for content porting, not shipped)
_archive-next/

# internal planning / WIP (kept locally, not shipped, outside the build)
_drafts/
docs/archive/
frankbueltge-docs-*.zip

# design handoff (reference prototypes)
design_handoff_homepage/

# env
.env
.env.production
.env*.local
# Wrangler-Lokalsecrets für Pages Functions (Steuerzentrale u. a.) — nie committen
.dev.vars
# Wrangler-Dev-Cache (pages dev)
.wrangler/

# macOS
.DS_Store

# vercel
.vercel

# dev / verification artifacts
*.jpeg
*.png
!public/**/*.png
!public/**/*.jpeg
.playwright-mcp/

# Python virtual environments
.venv/

# Registerdaten kommen beim Bauen aus dem dataset-hub-Release (scripts/hole-dataset-daten.mjs)
src/data/datasets/

# Claude Code: nur die geteilten Regeln und Projekt-Einstellungen gehören ins Repo
.claude/*
!.claude/rules/
!.claude/settings.json

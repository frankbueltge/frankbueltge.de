{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "redirects": [
    { "source": "/en", "destination": "/", "permanent": true },
    { "source": "/en/:path*", "destination": "/:path*", "permanent": true },
    { "source": "/werke", "destination": "/holdings", "permanent": true },
    { "source": "/lab", "destination": "/holdings", "permanent": true },
    { "source": "/bestaende", "destination": "/holdings", "permanent": true },
    { "source": "/begegnungen", "destination": "/encounters", "permanent": true },
    { "source": "/police", "destination": "/policy", "permanent": true },
    { "source": "/protokoll", "destination": "/protocol", "permanent": true },
    { "source": "/spielraum", "destination": "/headroom", "permanent": true }
  ]
}
